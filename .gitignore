# Python 缓存与构建产物
__pycache__/
*.py[cod]
*.pyo

# 虚拟环境
venv/
.venv/

# 本地数据库文件
chat.db
chat.db-shm
chat.db-wal

# 日志与本地运行产物
app.log
*.log
.local-runs/

# 本地爬虫运行状态(由 src/main.py / 维护脚本在 archive/ 下生成)
# 每次本地维护都会重写,git diff 会一直吵;不入库
archive/arxiv_seen.json
archive/crawl_state.json

# 本地环境配置与密钥
.env
secret.private

# 临时/测试文件
test.pdf
tmp-*.pdf

# Tencent Cloud EdgeOne
.edgeone/*
!.edgeone/project.json
.tef_dist/*
deploy_edgeone.sh

# Astro / Node 构建产物
node_modules/
.astro/
dist/

# 同步自 docs/assets/ 的图片副本(由 copy-docs-assets.mjs 在 build 前生成)
# 不入库:docs/assets/ 才是源,这里只是给 Astro 构建用
public/assets/

# 同步自 docs/papers/*.txt 的论文正文副本(由 copy-docs-assets.mjs 在 build 前生成)
# 用途:paper-chat 全文模式优先读 /papers/{id}.txt 喂 LLM,比 ar5iv 快、不依赖 8123 代理
# 不入库:docs/papers/*.txt 才是源,这里只是给 Astro 构建用
public/papers/

# prebuild 自动生成的索引文件(build-arxiv-index.mjs 跑出来的)
public/arxiv-index.json

# PR-5 Concept Backlinks 产物(由 backfill_concepts.py 生成 + copy 到 public/)
# wiki/concepts/ 是源,public/wiki/ 是 Astro 构建副本,都不入库
wiki/concepts/
public/wiki/

# LLM usage 日志(每次 LLM call 追加,体积增长,不入库)
archive/llm_usage_*.jsonl

# Bun 锁文件格式
# 当前用文本 bun.lock (1.2+);如未来切回二进制格式,启用此行
bun.lockb

# 用户私有配置覆盖(由 PR #7 引入,见 README "fork 配置工作流")
config.user.yaml

# 项目自带临时调试目录,放一次性测试脚本/手工脚本
# 整目录忽略,不再用后缀逐文件匹配
.scratch/

# smoke-test-real-data.mjs 的 tsc 编译产物目录(每次跑重新生成,不入库)
.smoke-out/

# macOS 自动元文件
.DS_Store
*.DS_Store
