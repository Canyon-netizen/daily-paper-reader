{
  "step_id": "3.rank",
  "checks": [
    { "kind": "no_error" },
    { "kind": "exit_code", "value": 0 },
    { "kind": "artifact_exists", "key": "archive/${RUN_DATE}/rank/arxiv_papers_${RUN_DATE}.json" },
    { "kind": "schema_valid", "field": "papers", "required_keys": ["paper_id", "global_score"] },
    { "kind": "min_count", "field": "papers", "value": 1 }
  ],
  "rubric_enabled": false,
  "on_fail": "mark_needs_review"
}