# Fork 用户运行态文件：自动同步上游时，如发生冲突，默认保留用户 fork 中的版本。
config.yaml merge=ours
docs/config.yaml merge=ours
docs/README.md merge=ours
docs/_sidebar.md merge=ours
docs/_home_notice.md merge=ours
docs/_home_promo.md merge=ours

# 推荐结果与运行状态属于用户数据，避免上游更新覆盖用户历史。
archive/carryover.json merge=ours
archive/crawl_state.json merge=ours
archive/arxiv_seen.json merge=ours
archive/*_crawl_state.json merge=ours
archive/*_seen.json merge=ours
archive/*/recommend/*.json merge=ours

# 本地密钥文件不应由上游同步覆盖。
secret.private merge=ours

# ---------------------------------------------------------------
# Large tracked assets
# ---------------------------------------------------------------
# Daily-pipeline writes a small PDF-text cache next to each
# paper note under docs/<period>/<arxiv-id>-<slug>.txt. The
# contents are deterministic re-derivable from arxiv.org (if
# lost, `src/6.generate_docs.py` regenerates them on the next
# run), so we route them through Git LFS to keep `git clone`
# fast and avoid bloating PR diffs.
#
# After this rule lands, NEW .txt files committed will be
# stored as LFS pointers. The ~80 files already tracked will
# continue to live in normal git until they're re-pushed via
# `git lfs migrate` (a follow-up PR if repo maintainers agree;
# not done in this PR because it rewrites git history).
docs/**/*.txt filter=lfs diff=lfs merge=lfs -text
