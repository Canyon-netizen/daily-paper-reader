---
// 顶部导航栏
// 简化版:品牌 logo + 4 个主入口 + 主题切换。
// 渲染期通过当前 URL 推断 active 项,避免每次都靠 caller 传 currentPath。
interface Props {
  currentPath?: string;
}
const { currentPath } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');

// 推断当前路径(去掉 base 前缀,得到站内相对路径)
const rawPath = Astro.url.pathname;
const path = rawPath.startsWith(base) ? rawPath.slice(base.length) : rawPath;
const isActive = (target: string): boolean => {
  if (target === '/') return path === '/' || path === '';
  return path === target || path.startsWith(target);
};
---

<header class="navbar">
  <div class="navbar-inner">
    <a href={base + '/'} class="navbar-brand" aria-label="Daily Paper Reader 首页">
      <span class="brand-mark" aria-hidden="true">
        <img src={`${base}/brand-mark.svg`} width="28" height="28" alt="" />
      </span>
      <span class="brand-text">
        <span class="brand-title">Daily Paper Reader</span>
        <span class="brand-sub">arXiv · AI · 每日</span>
      </span>
    </a>

    <nav class="navbar-links" aria-label="主导航">
      <a href={base + '/'} class={isActive('/') ? 'active' : ''}>首页</a>
      <a href={base + '/paper-analyzer/'} class={isActive('/paper-analyzer') ? 'active' : ''}>论文分析</a>
      <a href={base + '/papers/'} class={isActive('/papers') ? 'active' : ''}>论文库</a>
      <a href={base + '/topic/'} class={isActive('/topic') ? 'active' : ''}>主题探索</a>
      <a href={base + '/settings/'} class={isActive('/settings') ? 'active' : ''}>设置</a>
      <a href={base + '/tutorial/'} class={isActive('/tutorial') ? 'active' : ''}>使用教程</a>
      <a href={base + '/zotero-usage/'} class={isActive('/zotero-usage') ? 'active' : ''}>Zotero</a>
      <a
        href="https://github.com/Canyon-netizen/daily-paper-reader"
        target="_blank"
        rel="noopener"
        class="navbar-ext"
      >GitHub ↗</a>
    </nav>

    <div class="navbar-actions">
      <button id="theme-toggle" class="theme-toggle-btn" aria-label="切换主题" type="button">
        <span class="theme-icon-light">☀</span>
        <span class="theme-icon-dark">🌙</span>
        <span class="theme-icon-contrast">◐</span>
      </button>
    </div>
  </div>
</header>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg-elevated) 88%, transparent);
    border-bottom: 1px solid var(--border);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  .navbar-inner {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0.75rem 1.5rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .navbar-brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    color: var(--fg);
    flex-shrink: 0;
  }
  .navbar-brand:hover { text-decoration: none; }
  .brand-mark {
    display: inline-flex;
    border-radius: 8px;
    box-shadow: 0 2px 6px rgba(179, 27, 27, 0.25);
    transition: transform var(--transition);
  }
  .navbar-brand:hover .brand-mark { transform: rotate(-4deg) scale(1.05); }
  .brand-text { display: flex; flex-direction: column; line-height: 1.15; }
  .brand-title { font-weight: 700; font-size: 1.02rem; letter-spacing: -0.01em; }
  .brand-sub { font-size: 0.7rem; color: var(--fg-subtle); letter-spacing: 0.04em; }

  .navbar-links {
    display: flex;
    gap: 0.15rem;
    margin-left: auto;
    flex-wrap: wrap;
  }
  .navbar-links a {
    padding: 0.4rem 0.85rem;
    border-radius: var(--radius-md);
    color: var(--fg-muted);
    font-size: 0.92rem;
    font-weight: 500;
    transition: all var(--transition);
    text-decoration: none;
  }
  .navbar-links a:hover {
    background: var(--bg-muted);
    color: var(--fg);
  }
  .navbar-links a.active {
    background: var(--accent-soft);
    color: var(--accent);
  }
  .navbar-links a.navbar-ext {
    color: var(--fg-subtle);
  }

  .theme-toggle-btn {
    padding: 0.4rem 0.65rem;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    color: var(--fg-muted);
    cursor: pointer;
    font-size: 1rem;
    line-height: 1;
    transition: all var(--transition);
  }
  .theme-toggle-btn:hover {
    background: var(--bg-muted);
    color: var(--fg);
    border-color: var(--border-strong);
  }

  /* 三主题图标 */
  [data-theme='light'] .theme-icon-light,
  [data-theme='dark'] .theme-icon-dark,
  [data-theme='contrast'] .theme-icon-contrast { display: inline; }
  [data-theme='light'] .theme-icon-dark,
  [data-theme='light'] .theme-icon-contrast,
  [data-theme='dark'] .theme-icon-light,
  [data-theme='dark'] .theme-icon-contrast,
  [data-theme='contrast'] .theme-icon-light,
  [data-theme='contrast'] .theme-icon-dark { display: none; }

  @media (max-width: 720px) {
    .navbar-inner { padding: 0.55rem 0.9rem; gap: 0.75rem; }
    .brand-sub { display: none; }
    .navbar-links a { padding: 0.3rem 0.55rem; font-size: 0.85rem; }
  }
  @media (max-width: 460px) {
    .brand-text { display: none; }
  }
</style>
