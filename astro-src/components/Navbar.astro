---
// 顶部导航栏
// 渲染期通过当前 URL 推断 active 项,避免每次都靠 caller 传 currentPath。
// 8 个站内入口 + 1 个 GitHub 外链 — 中等宽度下 nav 会换行,
// 这里给 .navbar-links 加 fade-mask + overflow-x:auto,
// 让窄屏可横向滚动而不是折行打乱栅格。链接表统一放在 frontmatter,
// 避免模板和未来 JS 重新硬编码两份。
interface Props {
  currentPath?: string;
}
const { currentPath } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');

const rawPath = Astro.url.pathname;
const path = rawPath.startsWith(base) ? rawPath.slice(base.length) : rawPath;
const isActive = (target: string): boolean => {
  if (target === '/') return path === '/' || path === '';
  return path === target || path.startsWith(target);
};

// 同一份链接表,模板和 JS 都引,避免硬编码两份
const links = [
  { href: '/libraries/',      label: '文献库',      match: '/libraries' },
  { href: '/papers/',         label: '全部论文',    match: '/papers' },
  { href: '/library/',        label: '我的图书馆',  match: '/library' },
  { href: '/topic/',          label: '主题探索',    match: '/topic' },
  { href: '/conferences/',    label: '会议',        match: '/conferences' },
  { href: '/concepts/',       label: '概念',        match: '/concepts' },
  { href: '/settings/',       label: '设置',        match: '/settings' },
  { href: '/tutorial/',       label: '使用教程',    match: '/tutorial' },
  { href: '/zotero-usage/',   label: 'Zotero',      match: '/zotero-usage' },
];
---

<header class="navbar">
  <div class="navbar-inner">
    <a href={base + '/'} class="navbar-brand" aria-label="Daily Paper Reader 首页">
      <span class="brand-mark" aria-hidden="true">
        <img src={`${base}/brand-mark.svg`} width="28" height="28" alt="" />
      </span>
      <span class="brand-text">
        <span class="brand-title">Daily Paper Reader</span>
        <span class="brand-sub">arXiv · AI · 每日</span>
      </span>
    </a>

    <nav class="navbar-links" aria-label="主导航">
      {links.map((l) => (
        <a
          href={base + l.href}
          class={isActive(l.match) ? 'active' : ''}
          aria-current={isActive(l.match) ? 'page' : undefined}
        >{l.label}</a>
      ))}
      <a
        href="https://github.com/Canyon-netizen/daily-paper-reader"
        target="_blank"
        rel="noopener"
        class="navbar-ext"
      >GitHub ↗</a>
    </nav>

    <div class="navbar-actions">
      <button id="theme-toggle" class="theme-toggle-btn" aria-label="切换主题" type="button" title="切换主题 (light → dark → contrast)">
        <span class="theme-icon theme-icon--light" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
          </svg>
        </span>
        <span class="theme-icon theme-icon--dark" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
          </svg>
        </span>
        <span class="theme-icon theme-icon--contrast" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="9" />
            <path d="M12 3v18M12 3a9 9 0 0 0 0 18" fill="currentColor" stroke="none" />
          </svg>
        </span>
      </button>
    </div>
  </div>
</header>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg-elevated) 86%, transparent);
    border-bottom: 1px solid var(--border);
    backdrop-filter: saturate(180%) blur(14px);
    -webkit-backdrop-filter: saturate(180%) blur(14px);
  }
  .navbar-inner {
    max-width: var(--shell-max-width);
    margin: 0 auto;
    padding: 0 var(--space-6);
    display: flex;
    align-items: center;
    gap: var(--space-5);
    min-height: var(--navbar-height);
  }
  .navbar-brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    color: var(--fg);
    flex-shrink: 0;
  }
  .navbar-brand:hover { text-decoration: none; }
  .brand-mark {
    display: inline-flex;
    border-radius: 8px;
    box-shadow: 0 2px 8px var(--accent-glow);
    transition: transform var(--transition);
  }
  .navbar-brand:hover .brand-mark { transform: rotate(-4deg) scale(1.06); }
  .brand-text { display: flex; flex-direction: column; line-height: 1.15; }
  .brand-title { font-weight: 700; font-size: 1.02rem; letter-spacing: -0.01em; }
  .brand-sub { font-size: 0.7rem; color: var(--fg-subtle); letter-spacing: 0.04em; }

  .navbar-links {
    display: flex;
    gap: 0.15rem;
    margin-left: auto;
    align-items: center;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
    mask-image: linear-gradient(to right, black 0, black calc(100% - 24px), transparent 100%);
    -webkit-mask-image: linear-gradient(to right, black 0, black calc(100% - 24px), transparent 100%);
  }
  .navbar-links::-webkit-scrollbar { display: none; }
  .navbar-links a {
    padding: 0.45rem 0.85rem;
    border-radius: var(--radius-md);
    color: var(--fg-muted);
    font-size: 0.92rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    position: relative;
    transition: color var(--transition), background var(--transition);
  }
  .navbar-links a:hover {
    background: var(--bg-muted);
    color: var(--fg);
    text-decoration: none;
  }
  .navbar-links a.active {
    background: var(--accent-soft);
    color: var(--accent);
  }
  /* active 项下加一根 accent 横条,视觉锚定 */
  .navbar-links a.active::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -2px;
    width: 16px;
    height: 2px;
    background: var(--accent);
    border-radius: 2px;
    transform: translateX(-50%);
    transition: width var(--transition);
  }
  .navbar-links a.active:hover::after { width: 28px; }
  .navbar-links a.navbar-ext {
    color: var(--fg-subtle);
  }

  /* 极窄屏(< 920)把链接全部收起来避免折行;这里不做汉堡菜单(避免引入 JS),保留滚动 */
  @media (max-width: 920px) {
    .navbar-links a { padding: 0.4rem 0.65rem; font-size: 0.85rem; }
    .navbar-inner { gap: var(--space-3); padding: 0 var(--space-4); }
  }

  .navbar-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-shrink: 0;
  }

  .theme-toggle-btn {
    width: 36px;
    height: 36px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    color: var(--fg-muted);
    cursor: pointer;
    transition: background var(--transition), color var(--transition), border-color var(--transition), transform var(--transition);
  }
  .theme-toggle-btn:hover {
    background: var(--bg-muted);
    color: var(--fg);
    border-color: var(--border-strong);
  }
  .theme-toggle-btn:active { transform: scale(0.95); }

  /* SVG 主题图标切换
   * 关键陷阱:Astro scoped CSS 会给选择器自动加 [data-astro-cid-xxx] 前缀,
   * 编译后变成 [data-astro-cid-xxx][data-theme=light] — 需要同一元素同时
   * 拥有 cid + data-theme,然而 data-theme 在 <html>,cid 在 navbar 子元素,
   * 永远不匹配 → 3 个 SVG 全 display:none。
   * 用 :global() 让 [data-theme] 选择器穿透,不再被加 cid 前缀。
   */
  .theme-icon { display: none; line-height: 0; }
  :global([data-theme='light'])    .theme-icon--light    { display: inline-flex; }
  :global([data-theme='dark'])     .theme-icon--dark     { display: inline-flex; }
  :global([data-theme='contrast']) .theme-icon--contrast { display: inline-flex; }
  /* 兜底:data-theme 为空串/null/未识别值时,默认显示 light,避免整框空白 */
  :global(:root:not([data-theme])) .theme-icon--light,
  :global(:root[data-theme='']) .theme-icon--light { display: inline-flex; }

  @media (max-width: 720px) {
    .brand-sub { display: none; }
    .navbar-inner { padding: 0 var(--space-3); gap: var(--space-3); }
  }
  @media (max-width: 460px) {
    .brand-text { display: none; }
  }
</style>