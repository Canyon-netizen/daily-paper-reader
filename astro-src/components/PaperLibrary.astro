---
// PaperLibrary - 分屏:左列表 + 右网络,加抽屉编辑标签。
// 数据从 script#papers-data 注入(SSR 时序列化),客户端渲染。
// cytoscape 通过 dynamic import('cytoscape') 加载(按需,不阻塞首屏)。
// 用户标签:localStorage 优先(key 'dpr_user_tags_v1'),Gist 同步由 user-tags.ts 内部处理。
---

<div class="papers-library-host" data-papers-library>
  <!-- 左侧列表 -->
  <aside class="papers-list-panel" aria-label="论文列表">
    <div class="papers-list-toolbar">
      <input
        type="search"
        class="papers-search"
        placeholder="搜索标题 / 中文标题 / TLDR..."
        data-papers-search
        autocomplete="off"
        spellcheck="false"
      />
      <div class="papers-tag-filter" data-papers-tag-filter role="group" aria-label="按标签筛选"></div>
      <div class="papers-toolbar-meta" data-papers-toolbar-meta></div>
    </div>
    <div class="papers-list-viewport" data-papers-viewport>
      <div class="papers-list-spacer" data-papers-spacer>
        <div class="papers-list-empty" data-papers-list-empty hidden>暂无匹配论文</div>
      </div>
    </div>
  </aside>

  <!-- 右侧网络 -->
  <section class="papers-graph-panel" aria-label="节点网络">
    <div id="cy"></div>
    <div class="papers-graph-loading" data-papers-graph-loading>
      <div class="papers-graph-loading-spinner" aria-hidden="true"></div>
      <div data-papers-graph-loading-text>计算节点网络…</div>
    </div>
    <div class="papers-graph-toolbar" role="group" aria-label="算法切换">
      <button type="button" class="papers-graph-btn is-active" data-papers-algorithm="jaccard">Jaccard 标签</button>
      <button type="button" class="papers-graph-btn" data-papers-algorithm="tfidf">TF-IDF 文本</button>
      <button type="button" class="papers-graph-btn" data-papers-algorithm="hybrid">混合</button>
      <button type="button" class="papers-graph-btn" data-papers-graph-fit title="适应屏幕">⤢</button>
    </div>
    <div class="papers-graph-meta" data-papers-graph-meta></div>
    <div class="papers-graph-legend" data-papers-graph-legend hidden></div>
  </section>

  <!-- 右侧抽屉 -->
  <aside class="papers-drawer" data-papers-drawer aria-hidden="true" aria-label="论文详情与标签编辑">
    <header class="papers-drawer-header">
      <h3 class="papers-drawer-title" data-papers-drawer-title>论文详情</h3>
      <button type="button" class="papers-drawer-close" data-papers-drawer-close aria-label="关闭抽屉">✕</button>
    </header>
    <div class="papers-drawer-body" data-papers-drawer-body>
      <div class="papers-drawer-section">
        <h4 class="papers-drawer-title-zh" data-papers-drawer-title-zh>—</h4>
        <p class="papers-drawer-title-en" data-papers-drawer-title-en hidden></p>
        <div class="papers-drawer-meta">
          <div><span data-papers-drawer-arxiv></span></div>
          <div><span data-papers-drawer-authors></span></div>
          <div><span data-papers-drawer-date></span></div>
        </div>
        <a class="papers-drawer-link" data-papers-drawer-pdf target="_blank" rel="noopener" hidden>↗ 打开 PDF</a>
      </div>
      <div class="papers-drawer-section">
        <div class="papers-drawer-section-label">TLDR</div>
        <div class="papers-drawer-tldr" data-papers-drawer-tldr>—</div>
      </div>
      <div class="papers-drawer-section papers-tag-editor">
        <div class="papers-drawer-section-label">用户标签(本地 + Gist 同步)</div>
        <div class="papers-tag-list" data-papers-tag-list></div>
        <div class="papers-tag-edit-input-row">
          <input
            type="text"
            class="papers-tag-edit-kind-input"
            placeholder="kind (topic / status / interest)"
            data-papers-tag-kind
            autocomplete="off"
            spellcheck="false"
          />
          <input
            type="text"
            class="papers-tag-edit-label-input"
            placeholder="label (RL / to-read / ...)"
            data-papers-tag-label
            autocomplete="off"
            spellcheck="false"
          />
          <button type="button" class="papers-tag-edit-add" data-papers-tag-add>添加</button>
          <span class="papers-tag-edit-saved" data-papers-tag-saved hidden>已保存 ✓</span>
        </div>
      </div>
    </div>
  </aside>
</div>

<script>
  import '../scripts/paper-library';
</script>