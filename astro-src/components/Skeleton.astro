---
// components/Skeleton.astro
//
// R7 H.2.3: 加载骨架屏组件。
//
// 设计要点:
//   - 占位条形:宽度可调(默认 80%),可选行数(默认 1)
//   - shimmer 动画;prefers-reduced-motion 时关掉
//   - aria-hidden=true 让屏幕阅读器跳过

export interface Props {
  /** CSS width,默认 '80%'。可写 '100%' / '12rem' / '60%' 等。 */
  width?: string;
  /** 高度,默认 '0.9rem'(单行文本高度) */
  height?: string;
  /** 行数(>1 时自动生成多行,最后一行 60% 宽度) */
  lines?: number;
  /** 圆角,默认 4px */
  radius?: string;
  /** 自定义 class */
  class?: string;
}

const {
  width = '80%',
  height = '0.9rem',
  lines = 1,
  radius = '4px',
  class: extraClass = '',
} = Astro.props as Props;
---

{lines === 1 ? (
  <span
    class:list={['skeleton', 'skeleton-line', extraClass]}
    style={`width: ${width}; height: ${height}; border-radius: ${radius};`}
    aria-hidden="true"
  ></span>
) : (
  <span
    class:list={['skeleton', 'skeleton-block', extraClass]}
    aria-hidden="true"
  >
    {Array.from({ length: lines }, (_, i) => (
      <span
        class="skeleton-line"
        style={`width: ${i === lines - 1 ? '60%' : '100%'}; height: ${height}; border-radius: ${radius};`}
      ></span>
    ))}
  </span>
)}

<style>
  .skeleton {
    display: inline-block;
    background: linear-gradient(
      90deg,
      var(--skeleton-bg, rgba(0, 0, 0, 0.06)) 25%,
      var(--skeleton-shimmer, rgba(0, 0, 0, 0.12)) 50%,
      var(--skeleton-bg, rgba(0, 0, 0, 0.06)) 75%
    );
    background-size: 200% 100%;
    animation: skeleton-shimmer 1.5s ease-in-out infinite;
  }
  .skeleton-block {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .skeleton-block .skeleton-line {
    display: block;
  }
  @keyframes skeleton-shimmer {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .skeleton {
      animation: none;
      background: var(--skeleton-bg, rgba(0, 0, 0, 0.08));
    }
  }
</style>