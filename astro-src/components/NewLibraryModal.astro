---
// /components/NewLibraryModal.astro — 新建 / 编辑文献库弹窗(2026-08 升级)
//
// 双模式:同一个 modal 既能「新建」也能「编辑」某条已有 library。
// 模式由 modal 根上的 `data-edit-id="<libraryId>"` 决定:有值 = 编辑,空 = 新建。
// JS 控制器 user-libraries-ui.ts 的 setupLibraryFormModal() 通用接管。
//
// 对照 Polaris NewLibraryModal.tsx + InclusionSettingsForm 的字段:
//
// 必填:
//   - name              1-32 字(Polaris 也要求)
//   - statement         1-200 字(Polaris 强调,挑论文/打分都靠它)
// 可选(基础):
//   - hue               7 色挑一,卡片左竖条颜色
//   - visibility        personal / pending / public(Polaris 的 status 状态机,DPR 单人站保留语义)
//   - cadence           manual / daily / weekly / monthly(Polaris 也用,DPR 仅 UI label)
// P8a LibraryDefinition(Polaris direction_libraries.definition JSONB):
//   - goals[]           库目标(最多 3 条)
//   - inScope[]         范围内主题(最多 8 条)
//   - outOfScope[]      范围外(最多 8 条)
//   - questions[]       要回答的研究问题(最多 8 条)
//   - anchors[]         种子论文(arxiv/doi/free,带 note)
// 其余字段沿用 v1 老 schema:categories / inclusionKeywords / exclusionKeywords / rubric
//
// 不做:
//   - AI 访谈生成 statement —— Polaris 的 LLM hook,本仓库静态站无服务端 LLM,
//     用户手写 statement 即可,留作 follow-up。
//   - 申请转公共文献库 / anchor / admin —— Polaris DB 后端语义,单人静态站
//     不需要(详见 types.ts 的「Polaris 字段映射」注释)。
//
// SSR 渲染空 modal 壳(display:none,JS 控制可见);客户端 user-libraries-ui.ts
// 接管所有交互(打开/关闭/提交/校验/创建 + chips 增删)。
//
// 引入方式:
//   1. 在 BaseLayout 之前 import(不必要);2. 在 /libraries/ / 首页 footer 之前
//   直接 <NewLibraryModal /> 一次(全局唯一实例)。点 [data-open-new-library]
//   任意位置的按钮都会打开它;点 [data-edit-library="<id>"] 会打开编辑模式。
---

<div
  class="dpr-modal-backdrop"
  data-new-library-modal
  style="display: none;"
  role="dialog"
  aria-modal="true"
  aria-labelledby="new-library-modal-title"
>
  <div class="dpr-modal">
    <div class="dpr-modal-header">
      <h3 class="dpr-modal-title" id="new-library-modal-title">新建文献库</h3>
      <p class="dpr-modal-sub">
        创建后是你的个人文献库,跨设备同步走 Gist。名称和方向描述都是必填 ——
        「标题 + 一句话」让你以后翻找时一眼认出来。
      </p>
    </div>
    <form>
      <div class="dpr-modal-body">
        <div class="lib-field">
          <label class="lib-field-label" for="new-lib-name">名称 <span style="color:#dc2626;">*</span></label>
          <input
            id="new-lib-name"
            class="lib-input"
            type="text"
            maxlength="32"
            placeholder="如:稀疏注意力 / ICLR 2025 收藏 / 我的 RLHF 周更"
            data-modal-name
            required
          />
          <div class="lib-field-error" data-modal-name-err></div>
        </div>
        <div class="lib-field">
          <label class="lib-field-label" for="new-lib-statement">方向描述 <span style="color:#dc2626;">*</span></label>
          <textarea
            id="new-lib-statement"
            class="lib-textarea"
            maxlength="200"
            rows="3"
            placeholder="研究什么问题、关注什么子问题、偏重哪类方法。写给未来的自己看 —— 越具体越好认。"
            data-modal-statement
            required
          ></textarea>
          <div class="lib-field-hint">1-200 字。这句话会显示在卡片上,让你以后翻找时一眼认出来。</div>
          <div class="lib-field-error" data-modal-stmt-err></div>
        </div>

        {/* 可见性 + 同步频率 —— Polaris 把这两项放在 definition JSON 里,
            UI 上贴近基础信息更直观。 */}
        <div class="lib-field-row">
          <div class="lib-field">
            <label class="lib-field-label" for="new-lib-visibility">可见性</label>
            <select id="new-lib-visibility" class="lib-input" data-modal-visibility>
              <option value="personal">个人(仅本机 + Gist)</option>
              <option value="pending">申请公开(请求中)</option>
              <option value="public">公开(已发布)</option>
            </select>
            <div class="lib-field-hint">Polaris 状态机;DPR 客户端标记,跨设备同步时对齐。</div>
          </div>
          <div class="lib-field">
            <label class="lib-field-label" for="new-lib-cadence">同步节奏</label>
            <select id="new-lib-cadence" class="lib-input" data-modal-cadence>
              <option value="manual">手动</option>
              <option value="daily">每日</option>
              <option value="weekly">每周</option>
              <option value="monthly">每月</option>
            </select>
            <div class="lib-field-hint">纯 label,无服务端 cron。</div>
          </div>
        </div>

        {/* P8a definition 字段:goals / inScope / outOfScope / questions
            都是自由文本行,逗号 / 回车分隔。Polaris 用同样的粒度。 */}
        <div class="lib-field">
          <label class="lib-field-label">库目标(goals)</label>
          <textarea
            class="lib-textarea"
            rows="2"
            maxlength="600"
            placeholder="如:整理今年 ICML 的 agent 工作;跟踪稀疏注意力进展。每行一条,最多 3 条。"
            data-modal-goals
          ></textarea>
          <div class="lib-field-hint">驱动 digest 生成的上下文。</div>
        </div>
        <div class="lib-field">
          <label class="lib-field-label">范围内主题(in scope)</label>
          <textarea
            class="lib-textarea"
            rows="2"
            maxlength="600"
            placeholder="如:LLM agent / 多智能体协作 / 思维链推理。每行一条,最多 8 条。"
            data-modal-in-scope
          ></textarea>
        </div>
        <div class="lib-field">
          <label class="lib-field-label">范围外(out of scope)</label>
          <textarea
            class="lib-textarea"
            rows="2"
            maxlength="600"
            placeholder="如:语音识别 / 图像超分。每行一条,最多 8 条。"
            data-modal-out-of-scope
          ></textarea>
          <div class="lib-field-hint">命中即剔除 —— 比关键词排除更宽。</div>
        </div>
        <div class="lib-field">
          <label class="lib-field-label">要回答的研究问题</label>
          <textarea
            class="lib-textarea"
            rows="2"
            maxlength="800"
            placeholder="如:稀疏注意力在 8K context 上能否保持线性推理开销?每行一条,最多 8 条。"
            data-modal-questions
          ></textarea>
          <div class="lib-field-hint">驱动 ingest 拉论文的 prompt 上下文。</div>
        </div>

        {/* anchors:种子论文清单。Polaris 强制 included。 */}
        <div class="lib-field">
          <label class="lib-field-label">锚点论文(anchors)</label>
          <div class="lib-anchor-rows" data-anchor-rows></div>
          <div class="lib-chip-input-wrap">
            <select class="lib-input lib-anchor-kind" data-anchor-kind>
              <option value="arxiv">arxiv-id</option>
              <option value="doi">DOI</option>
              <option value="free">free text</option>
            </select>
            <input
              type="text"
              class="lib-chip-input"
              placeholder="如 2503.12345 或 10.1109/... 或 'OpenAI o1'"
              data-anchor-value
            />
            <button type="button" class="lib-chip-add" data-anchor-add>+ 添加锚点</button>
          </div>
          <div class="lib-field-hint">最多 32 条,带「为什么是锚点」备注。</div>
        </div>
        <div class="lib-field">
          <label class="lib-field-label">arXiv 分类</label>
          <div class="lib-chip-row" data-categories-presets>
            <button type="button" class="lib-chip" data-cat-preset="cs.CL">cs.CL</button>
            <button type="button" class="lib-chip" data-cat-preset="cs.AI">cs.AI</button>
            <button type="button" class="lib-chip" data-cat-preset="cs.LG">cs.LG</button>
            <button type="button" class="lib-chip" data-cat-preset="cs.CV">cs.CV</button>
            <button type="button" class="lib-chip" data-cat-preset="cs.MA">cs.MA</button>
            <button type="button" class="lib-chip" data-cat-preset="stat.ML">stat.ML</button>
          </div>
          <div class="lib-chip-input-wrap" data-categories-wrap>
            <span class="lib-chip-input-prefix">自定义分类</span>
            <input
              type="text"
              class="lib-chip-input"
              placeholder="如 cs.IR"
              maxlength="16"
              data-categories-input
            />
            <button type="button" class="lib-chip-add" data-categories-add aria-label="添加分类">添加</button>
          </div>
          <div class="lib-tag-list" data-categories-tags></div>
          <input type="hidden" data-modal-categories />
          <div class="lib-field-hint">已选分类会用 <code>arxiv:cat</code> 命中。空 = 不过滤分类。</div>
        </div>
        <div class="lib-field">
          <label class="lib-field-label">包括关键词</label>
          <div class="lib-chip-input-wrap">
            <span class="lib-chip-input-prefix">包括</span>
            <input
              type="text"
              class="lib-chip-input"
              placeholder="输入关键词后回车或逗号添加,如 agent"
              maxlength="32"
              data-incl-input
            />
            <button type="button" class="lib-chip-add" data-incl-add aria-label="添加关键词">添加</button>
          </div>
          <div class="lib-tag-list" data-incl-tags></div>
          <input type="hidden" data-modal-incl />
          <div class="lib-field-hint">命中就不收,检索、打分、每日同步三处都生效。用来挡掉和本方向偏向的其他领域,宁缺毋滥。</div>
        </div>
        <div class="lib-field">
          <label class="lib-field-label">排除关键词</label>
          <div class="lib-chip-input-wrap">
            <span class="lib-chip-input-prefix">排除</span>
            <input
              type="text"
              class="lib-chip-input"
              placeholder="输入后回车或逗号添加,如 speech recognition"
              maxlength="32"
              data-excl-input
            />
            <button type="button" class="lib-chip-add" data-excl-add aria-label="添加关键词">添加</button>
          </div>
          <div class="lib-tag-list" data-excl-tags></div>
          <input type="hidden" data-modal-excl />
          <div class="lib-field-hint">命中就不收,检索、打分、每日同步三处都生效。用来挡掉和本方向偏向的其他领域,宁缺毋滥。</div>
        </div>
        <div class="lib-field">
          <label class="lib-field-label">打分标准</label>
          <div class="lib-tag-list" data-rubric-rows></div>
          <div class="lib-chip-input-wrap" data-rubric-input-wrap>
            <span class="lib-chip-input-prefix">维度</span>
            <input
              type="text"
              class="lib-chip-input"
              placeholder="如 新颖性 / 实验完备度 / 可复现性"
              maxlength="32"
              data-rubric-input
            />
            <button type="button" class="lib-chip-add" data-rubric-add aria-label="添加维度">+ 添加维度</button>
          </div>
          <input type="hidden" data-modal-rubric />
          <div class="lib-field-hint">未设维度:只按方向说明判定相关性。添加的维度会按维度名打分,日后可以重排 / 增删。</div>
        </div>
        <div class="lib-field">
          <label class="lib-field-label">卡片颜色</label>
          <div class="lib-hue-picker" data-hue-picker>
            <button type="button" class="lib-hue-chip hue-orange"  data-hue="orange"  aria-label="orange"></button>
            <button type="button" class="lib-hue-chip hue-cyan"    data-hue="cyan"    aria-label="cyan"></button>
            <button type="button" class="lib-hue-chip hue-purple"  data-hue="purple"  aria-label="purple"></button>
            <button type="button" class="lib-hue-chip hue-emerald active" data-hue="emerald" aria-label="emerald"></button>
            <button type="button" class="lib-hue-chip hue-amber"   data-hue="amber"   aria-label="amber"></button>
            <button type="button" class="lib-hue-chip hue-rose"    data-hue="rose"    aria-label="rose"></button>
            <button type="button" class="lib-hue-chip hue-sky"     data-hue="sky"     aria-label="sky"></button>
          </div>
          <input type="hidden" data-modal-hue value="emerald" />
        </div>
      </div>
      <div class="dpr-modal-footer">
        <button type="button" class="btn btn-ghost" data-modal-close>取消</button>
        <button type="submit" class="btn btn-primary" data-modal-submit>创建个人文献库</button>
      </div>
    </form>
  </div>
</div>
