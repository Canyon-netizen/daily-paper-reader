---
/**
 * DailyCalendar — 首页日历视图
 * 数据源:SSR 时调用方传入 papers (listPapers({sortBy:'date', dedup:true}) 的精简结果)。
 * 多版本同 arxiv id 由 listPapers 默认 dedup 处理 —— 取 v# 最大的那条 date。
 *
 * 渲染:多月份瀑布,默认 open 最近 1 个月,老月份 <details> 折叠。
 * 点击某日 → 客户端 JS 渲染当日论文卡片墙 (.paper-card 复用 home.css)。
 * 数据通过 <script id="daily-data"> 序列化,客户端不 fetch。
 */

interface LeanPaper {
  date: string;
  slug: string;
  arxivId: string;
  title?: string;
  title_zh?: string;
  score?: number;
  venue?: string;
  accepted?: boolean;
  tags?: string[];
  /** categories.task[0],供客户端主题筛选;null 表示归到"其他"。 */
  task?: string | null;
}

interface Props {
  base: string;
  papers: LeanPaper[];
}

const { base, papers } = Astro.props as Props;

// 1) 过滤无 date 的论文(理论上已被 caller 过滤一次,这里兜底)
const valid = papers.filter((p) => !!p.date && /^\d{4}-\d{2}-\d{2}$/.test(p.date));

// 2) 按 date desc 排序,然后按 YYYY-MM 分桶
const sortedDates = Array.from(new Set(valid.map((p) => p.date))).sort((a, b) => (a < b ? 1 : -1));
const monthSet = new Set<string>();
for (const d of sortedDates) monthSet.add(d.slice(0, 7));
const monthKeys = Array.from(monthSet).sort((a, b) => (a < b ? 1 : -1));

// 2b) 按年聚合,用于联动下拉:year -> [month, ...]
const yearToMonths = new Map<string, number[]>();
for (const ym of monthKeys) {
  const [yStr, mStr] = ym.split('-');
  const y = yStr;
  const m = parseInt(mStr, 10);
  const arr = yearToMonths.get(y) || [];
  arr.push(m);
  yearToMonths.set(y, arr);
}
const years = Array.from(yearToMonths.keys()).sort((a, b) => (a < b ? 1 : -1));
const yearMonthJson = JSON.stringify(
  Object.fromEntries(
    years.map((y) => [y, Array.from(new Set(yearToMonths.get(y)!)).sort((a, b) => b - a)])
  )
);

// 3) date -> papers[] 索引(已 dedup,自动按 score desc 二次排)
const byDate = new Map<string, LeanPaper[]>();
for (const p of valid) {
  const arr = byDate.get(p.date) || [];
  arr.push(p);
  byDate.set(p.date, arr);
}
for (const arr of byDate.values()) {
  arr.sort((a, b) => (b.score ?? 0) - (a.score ?? 0));
}

// 4) 月份桶
interface MonthBucket {
  key: string;          // YYYY-MM
  year: number;
  month: number;        // 1-12
  totalCount: number;
  daysWithPapers: number;
  cells: DayCell[];
}

interface DayCell {
  /** YYYY-MM-DD or '' for pad */
  date: string;
  /** day number 1-31 or 0 for pad */
  dayNum: number;
  /** papers of this day (already dedup'd, score desc) */
  papers: LeanPaper[];
  /** highest score paper of this day or null */
  topPaper: LeanPaper | null;
  /** is today (UTC date match) */
  isToday: boolean;
}

function buildMonthGrid(ym: string): DayCell[] {
  const [yStr, mStr] = ym.split('-');
  const year = parseInt(yStr, 10);
  const month = parseInt(mStr, 10); // 1-12
  // Date.UTC: month is 0-indexed, day=0 means last day of previous month
  const firstWeekday = new Date(Date.UTC(year, month - 1, 1)).getUTCDay(); // 0=Sun
  const daysInMonth = new Date(Date.UTC(year, month, 0)).getUTCDate();

  const todayStr = new Date().toISOString().slice(0, 10);
  const cells: DayCell[] = [];

  // leading padding
  for (let i = 0; i < firstWeekday; i++) {
    cells.push({ date: '', dayNum: 0, papers: [], topPaper: null, isToday: false });
  }
  for (let d = 1; d <= daysInMonth; d++) {
    const date = `${ym}-${String(d).padStart(2, '0')}`;
    const ps = byDate.get(date) || [];
    cells.push({
      date,
      dayNum: d,
      papers: ps,
      topPaper: ps[0] || null,
      isToday: date === todayStr,
    });
  }
  // trailing padding to fill 6 rows (42 cells max)
  while (cells.length < 42 && cells.length % 7 !== 0) {
    cells.push({ date: '', dayNum: 0, papers: [], topPaper: null, isToday: false });
  }
  // if still < 42 (e.g. month fits in 4 rows + tail pads), allow up to 42
  while (cells.length < 42) {
    cells.push({ date: '', dayNum: 0, papers: [], topPaper: null, isToday: false });
  }
  return cells;
}

const months: MonthBucket[] = monthKeys.map((ym) => {
  const [yStr, mStr] = ym.split('-');
  const cells = buildMonthGrid(ym);
  let totalCount = 0;
  let daysWithPapers = 0;
  for (const c of cells) {
    if (c.papers.length > 0) {
      totalCount += c.papers.length;
      daysWithPapers += 1;
    }
  }
  return { key: ym, year: parseInt(yStr, 10), month: parseInt(mStr, 10), totalCount, daysWithPapers, cells };
});

// 5) 默认 open 最近 1 个月(老月份 <details> 折叠),避免页面初始被 3 个月
// × 6 行日历同时撑得很长(老用户累积了十几二十个月时尤其明显)。
const OPEN_COUNT = 1;

// 6) 序列化的 papers 数组(只含渲染所需字段,不再含 date/score 二次索引)
const dataForClient = sortedDates.map((d) => [d, byDate.get(d)!] as [string, LeanPaper[]]);

// 7) 渲染 helpers
function scoreBucket(p: LeanPaper): 'high' | 'mid' | 'low' {
  const s = p.score;
  if (s === undefined || s === null) return 'low';
  if (s >= 7) return 'high';
  if (s >= 5) return 'mid';
  return 'low';
}

function topTitle(p: LeanPaper | null): string {
  if (!p) return '';
  const t = (p.title_zh || p.title || '').trim();
  if (t.length <= 14) return t;
  return t.slice(0, 13) + '…';
}

function escapeHtml(s: string): string {
  return s
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

function cellLabel(c: DayCell): string {
  if (!c.date) return '';
  const [y, m, d] = c.date.split('-');
  const n = c.papers.length;
  if (n === 0) return `${y} 年 ${parseInt(m, 10)} 月 ${parseInt(d, 10)} 日,无新论文`;
  const top = c.topPaper ? `,最高分 ${c.topPaper.title_zh || c.topPaper.title || ''}` : '';
  return `${y} 年 ${parseInt(m, 10)} 月 ${parseInt(d, 10)} 日,${n} 篇${top}`;
}

// 8) 总览统计
const totalDays = months.reduce((s, m) => s + m.daysWithPapers, 0);
const grandTotal = months.reduce((s, m) => s + m.totalCount, 0);

// 9) 主题 → 篇数 统计(用于头部 chip 排序)。
//    来源:listAllPapersByTag 在 index.astro 也用过口径(key = categories.task[0])。
//    这里按 vali dLeanPaper.task 重新聚合,保证 chip N 与"按主题分类"段一致。
const TOPIC_CHIPS = [
  ['rl', '强化学习'],
  ['mas', '多智能体系统'],
  ['llm-agent', 'LLM Agent'],
  ['agent', '智能体'],
  ['reasoning', '推理增强'],
  ['gui', 'GUI'],
  ['vision', '视觉'],
  ['game-ai', '游戏 AI'],
  ['robotics', '机器人'],
  ['code', '代码生成'],
  ['self-distillation', '自蒸馏'],
  ['intervention', '激活干预'],
] as const;

const taskCounts = new Map<string, number>();
for (const p of valid) {
  const t = p.task || '其他';
  taskCounts.set(t, (taskCounts.get(t) || 0) + 1);
}
const topicChips = TOPIC_CHIPS.map(([key, label]) => ({
  key,
  label,
  count: taskCounts.get(key) || 0,
})).filter((c) => c.count > 0);
---

<section id="daily" class="section daily-section">
  <div class="section-header">
    <div>
      <h2>📅 日历视图</h2>
      <p class="section-sub">
        按发布日期排布论文,点击某天查看当日详情。多版本取最新 v# 的日期。
      </p>
    </div>
    <div class="cal-section-right">
      {months.length > 0 && (
        <div class="cal-jump">
          <select
            id="cal-jump-year"
            class="cal-year-select"
            aria-label="切换年份"
          >
            {years.map((y) => (
              <option value={y} selected={y === String(months[0].year)}>{y} 年</option>
            ))}
          </select>
          <select
            id="cal-jump-month"
            class="cal-month-select"
            aria-label="切换月份"
          >
            {(yearToMonths.get(String(months[0].year)) || []).map((mm) => (
              <option
                value={`${months[0].year}-${String(mm).padStart(2, '0')}`}
                selected={mm === months[0].month}
              >{mm} 月</option>
            ))}
          </select>
          {topicChips.length > 0 && (
            <select
              id="cal-jump-topic"
              class="cal-topic-select"
              aria-label="按主题过滤日历"
            >
              <option value="__all__">主题:全部</option>
              {topicChips.map((c) => (
                <option value={c.key}>主题:{c.label}（{c.count}）</option>
              ))}
            </select>
          )}
        </div>
      )}
      <span class="section-tag" id="cal-grand-count">{grandTotal} 篇 / {totalDays} 天</span>
    </div>
  </div>

  {topicChips.length > 0 && (
    <div class="topic-filter-status-row" id="topic-filter-status-row" hidden>
      <span class="topic-filter-status" id="topic-filter-status">
        <span class="topic-filter-status-text">
          只看 <strong id="topic-filter-status-label">—</strong>
        </span>
        <button type="button" class="topic-filter-status-clear" id="topic-filter-status-clear" aria-label="清除主题过滤">
          ✕
        </button>
      </span>
    </div>
  )}

  {months.length === 0 ? (
    <div class="empty-card">
      <div class="empty-icon">📅</div>
      <h3>还没有论文入库</h3>
      <p>
        数据通过 GitHub Actions 每日 UTC 00:00 抓取,首次部署完成后约 1 小时内会有内容。
      </p>
    </div>
  ) : (
    <>
      <div class="cal-months" id="cal-months">
      {months.map((m, idx) => (
        <div
          class="cal-month"
          data-month={m.key}
          style={idx < OPEN_COUNT ? '' : 'display:none'}
        >
          <div class="cal-month-head">
            <span class="cal-month-title">{m.year} 年 {m.month} 月</span>
            <span class="cal-month-count">{m.totalCount} 篇 · {m.daysWithPapers} 天有更新</span>
          </div>
          <div class="cal-grid-wrap">
            <div class="cal-weekdays" aria-hidden="true">
              {['日', '一', '二', '三', '四', '五', '六'].map((w) => (
                <div class="cal-weekday">{w}</div>
              ))}
            </div>
            <div class="cal-grid" role="grid" aria-label={`${m.year} 年 ${m.month} 月 论文日历`}>
              {m.cells.map((c) => {
                if (!c.date) {
                  return <div class="cal-cell cal-cell--pad" aria-hidden="true"></div>;
                }
                const n = c.papers.length;
                const bucket = n === 0 ? 'empty' : scoreBucket(c.topPaper!);
                const cls = [
                  'cal-cell',
                  `cal-cell--${bucket}`,
                  c.isToday ? 'cal-cell--today' : '',
                ].filter(Boolean).join(' ');
                return (
                  <button
                    type="button"
                    class={cls}
                    data-day={c.date}
                    data-month={m.key}
                    aria-expanded="false"
                    aria-label={cellLabel(c)}
                    disabled={false}
                  >
                    <span class="cal-cell-day">{c.dayNum}</span>
                    {n > 0 && <span class="cal-cell-count" aria-hidden="true">{n}</span>}
                    {n > 0 && c.topPaper && (
                      <span class="cal-cell-title">{topTitle(c.topPaper)}</span>
                    )}
                  </button>
                );
              })}
            </div>
          </div>
        </div>
      ))}
    </div>
    </>
  )}

  <div class="daily-detail" id="daily-detail" hidden aria-live="polite">
    <div class="daily-detail-head">
      <div>
        <div class="daily-detail-date" id="daily-detail-date">—</div>
        <div class="daily-detail-meta" id="daily-detail-meta">—</div>
      </div>
      <button type="button" class="daily-detail-close" id="daily-detail-close" aria-label="关闭当日详情">关闭 ✕</button>
    </div>
    <div class="daily-detail-grid" id="daily-detail-grid"></div>
  </div>

  {/* 客户端脚本:读 daily-data,绑定 cell 交互,渲染卡片墙 */}
  <script type="application/json" id="daily-data" set:html={JSON.stringify(dataForClient)}></script>
  <script type="application/json" id="cal-jump-data" set:html={yearMonthJson}></script>
</section>

<script>
/* eslint-disable */
// Client-side logic — runs only in browser. Astro bundles & hashes it.
// 数据全部来自 <script id="daily-data"> JSON,无 fetch。

type Paper = {
  date: string;
  slug: string;
  arxivId: string;
  title?: string;
  title_zh?: string;
  score?: number;
  venue?: string;
  accepted?: boolean;
  tags?: string[];
  task?: string | null;
};

const $ = <T extends Element = Element>(sel: string, root: Document | Element = document) =>
  root.querySelector(sel) as T | null;
const $$ = <T extends Element = Element>(sel: string, root: Document | Element = document) =>
  Array.from(root.querySelectorAll(sel)) as T[];

const dataEl = $<HTMLScriptElement>('#daily-data');
if (!dataEl) {
  console.warn('[DailyCalendar] #daily-data script tag not found');
} else {
  const raw: Array<[string, Paper[]]> = JSON.parse(dataEl.textContent || '[]');
  const dayMap = new Map<string, Paper[]>(raw);

  const detailEl = $<HTMLElement>('#daily-detail');
  const detailDate = $<HTMLElement>('#daily-detail-date');
  const detailMeta = $<HTMLElement>('#daily-detail-meta');
  const detailGrid = $<HTMLElement>('#daily-detail-grid');
  const closeBtn = $<HTMLButtonElement>('#daily-detail-close');

  // ---- 主题过滤 state ----
  // topicKey 为 null = 不筛选。过滤由 #topic=<key> 与 'dpr-topic-filter-change' 事件双向同步。
  // 客户端不 import 桥文件,直接 dispatch / addEventListener — 因为本页 <script> 与
  // index.astro 的 <script> 共享同一页面 ESM graph,import 还是会拉桥模块。
  let topicKey: string | null = null;
  const TOPIC_FILTER_EVENT = 'dpr-topic-filter-change';

  function getDayPapers(date: string): Paper[] {
    const all = dayMap.get(date) || [];
    if (!topicKey) return all;
    return all.filter((p) => (p.task || null) === topicKey);
  }

  function getFilteredDayMap(): Map<string, Paper[]> {
    const out = new Map<string, Paper[]>();
    for (const [d, ps] of dayMap.entries()) {
      const f = topicKey ? ps.filter((p) => (p.task || null) === topicKey) : ps;
      if (f.length > 0) out.set(d, f);
    }
    return out;
  }

  function escapeHtml(s: string): string {
    return s
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function fmtDateZh(d: string): string {
    const [y, m, day] = d.split('-');
    return `${y} 年 ${parseInt(m, 10)} 月 ${parseInt(day, 10)} 日`;
  }

  function tagsForCard(p: Paper): string[] {
    const tags = (p.tags || []).filter(Boolean);
    return tags.slice(0, 3).map((t) => t.replace(/^query:/, ''));
  }

  function renderCard(p: Paper, rank: number): string {
    const titleZh = p.title_zh || p.title || '（无标题）';
    const titleEn = p.title_zh && p.title && p.title !== p.title_zh ? p.title : '';
    const href = `${import.meta.env.BASE_URL.replace(/\/+$/, '')}/papers/${p.slug}/`;
    const dateShort = p.date
      ? new Date(p.date).toLocaleDateString('zh-CN', { month: 'short', day: 'numeric' })
      : '';
    const venueHtml = p.venue
      ? `<span class="${p.accepted ? 'venue-chip venue-chip--accepted' : 'venue-chip'}">${escapeHtml(p.venue)}${p.accepted ? ' ✓' : ''}</span>`
      : '';
    const dateHtml = dateShort
      ? `<span class="paper-date">${escapeHtml(dateShort)}</span>`
      : '';
    const scoreHtml = p.score !== undefined
      ? `<div class="paper-score"><span class="paper-score-star">★</span><span class="paper-score-value">${p.score.toFixed(1)}</span></div>`
      : '';
    const evidenceHtml = p.tags && p.tags[0]
      ? ''
      : '';
    const tags = tagsForCard(p);
    const tagsHtml = tags.length > 0
      ? `<div class="paper-tags">${tags.map((t) => `<span class="tag">${escapeHtml(t)}</span>`).join('')}</div>`
      : '<span />';

    return `
      <li class="paper-card" data-rank="${rank}" data-arxiv-id="${escapeHtml(p.arxivId)}">
        <a href="${escapeHtml(href)}" class="paper-card-link">
          <div class="paper-card-topline" aria-hidden="true"></div>
          <div class="paper-card-head">
            <div class="paper-rank-block">
              <span class="paper-rank-num">${String(rank).padStart(2, '0')}</span>
              <span class="paper-rank-label">当日推荐</span>
            </div>
            ${scoreHtml}
          </div>
          ${(venueHtml || dateHtml) ? `<div class="paper-meta-row">${venueHtml}${dateHtml}</div>` : ''}
          <h3 class="paper-title">${escapeHtml(titleZh)}</h3>
          ${titleEn ? `<p class="paper-title-en">${escapeHtml(titleEn)}</p>` : ''}
          ${evidenceHtml}
          <div class="paper-card-foot">
            ${tagsHtml}
            <span class="paper-cta">阅读
              <svg class="paper-cta-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14M13 5l7 7-7 7" />
              </svg>
            </span>
          </div>
        </a>
      </li>`;
  }

  function openDay(date: string): void {
    // 单选:关闭其它
    $$('.cal-cell[aria-expanded="true"]').forEach((el) => {
      if (el.getAttribute('data-day') !== date) {
        el.setAttribute('aria-expanded', 'false');
      }
    });

    const targetBtn = $(`.cal-cell[data-day="${date}"]`) as HTMLButtonElement | null;
    if (!targetBtn) return;

    const papers = getDayPapers(date);
    // 若 papers 为空:仍允许点击(展示空状态),但确保 selected 视觉一致
    targetBtn.setAttribute('aria-expanded', 'true');

    // 只显示对应月份,其它月 display:none 整体藏起来 — 点选 / hash 还原后页面只剩一个月的日历
    const monthKey = targetBtn.getAttribute('data-month');
    if (monthKey) {
      const monthDetails = $(`.cal-month[data-month="${monthKey}"]`) as HTMLElement | null;
      if (monthDetails) {
        $$<HTMLElement>('.cal-month').forEach((d) => {
          d.style.display = d === monthDetails ? '' : 'none';
        });
      }
    }

    // 填充 detail head
    if (detailDate) detailDate.textContent = fmtDateZh(date);
    if (detailMeta) {
      detailMeta.textContent = papers.length === 0
        ? '当日无新推荐'
        : `共 ${papers.length} 篇,按 LLM 评分倒序`;
    }
    if (detailGrid) {
      if (papers.length === 0) {
        detailGrid.innerHTML = `<div class="daily-detail-empty">📭 当日无新推荐论文</div>`;
      } else {
        const list = papers.map((p, i) => renderCard(p, i + 1)).join('');
        detailGrid.innerHTML = list;
      }
    }

    if (detailEl) {
      detailEl.hidden = false;
      // 通知其它模块(全局过滤/收藏)有新内容
      window.dispatchEvent(new CustomEvent('daily-day-opened', { detail: { date } }));
    }

    // hash + scroll — 与主题过滤 hash 共存格式('#day=' 而非旧 '#day-')
    try {
      const cur = readHashSegments();
      const parts: string[] = [];
      if (topicKey) parts.push('topic=' + encodeURIComponent(topicKey));
      parts.push('day=' + date);
      history.replaceState(null, '', '#' + parts.join('&'));
    } catch (_) {
      window.location.hash = `#day=${date}`;
    }
    if (detailEl) {
      // 用 rAF 避免 layout shift 抖
      requestAnimationFrame(() => {
        detailEl?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    }
  }

  function closeDay(): void {
    $$('.cal-cell[aria-expanded="true"]').forEach((el) => {
      el.setAttribute('aria-expanded', 'false');
    });
    if (detailEl) detailEl.hidden = true;
    // 清 #day= 但保留 #topic= (setTopic 切换不应该把详情也清掉)
    try {
      const parts: string[] = [];
      if (topicKey) parts.push('topic=' + encodeURIComponent(topicKey));
      const next = parts.length ? '#' + parts.join('&') : '';
      const { pathname, search } = window.location;
      const target = next ? pathname + search + next : pathname + (search || '');
      history.replaceState(null, '', target);
    } catch (_) {
      // ignore
    }
  }

  // ---- 绑定 cell click + keyboard ----
  $$<HTMLButtonElement>('.cal-cell[data-day]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const day = btn.getAttribute('data-day');
      if (!day) return;
      if (btn.getAttribute('aria-expanded') === 'true') {
        closeDay();
      } else {
        openDay(day);
      }
    });

    btn.addEventListener('keydown', (ev) => {
      const cells = $$<HTMLButtonElement>('.cal-cell[data-day]');
      const idx = cells.indexOf(btn);
      if (idx < 0) return;
      let target = -1;
      if (ev.key === 'ArrowRight') target = idx + 1;
      else if (ev.key === 'ArrowLeft') target = idx - 1;
      else if (ev.key === 'ArrowDown') target = idx + 7;
      else if (ev.key === 'ArrowUp') target = idx - 7;
      else if (ev.key === 'Enter' || ev.key === ' ') {
        ev.preventDefault();
        const day = btn.getAttribute('data-day');
        if (day) openDay(day);
        return;
      } else {
        return;
      }
      ev.preventDefault();
      if (target >= 0 && target < cells.length && cells[target].getAttribute('data-day')) {
        cells[target].focus();
      }
    });
  });

  // ---- close ----
  if (closeBtn) closeBtn.addEventListener('click', closeDay);
  document.addEventListener('keydown', (ev) => {
    if (ev.key === 'Escape' && detailEl && !detailEl.hidden) {
      closeDay();
    }
  });

  // ---- hash 还原 ----
  // 旧:L596 仅识别 #day=YYYY-MM-DD。
  // 新:同时识别 #topic=<key> 与 #day=YYYY-MM-DD,两者用 & 共存
  //     ('#day=2026-07-13&topic=rl')。topic 触发 setTopic(noHash=true) — 避免写回循环。
  function readHashSegments(): { day: string | null; topic: string | null } {
    const raw = window.location.hash.replace(/^#/, '');
    if (!raw) return { day: null, topic: null };
    let day: string | null = null;
    let topic: string | null = null;
    for (const seg of raw.split('&')) {
      const [k, ...rest] = seg.split('=');
      const v = decodeURIComponent(rest.join('='));
      if (k === 'day' && /^\d{4}-\d{2}-\d{2}$/.test(v)) day = v;
      else if (k === 'topic') topic = v || null;
    }
    return { day, topic };
  }

  function tryRestoreFromHash(): void {
    const { day, topic } = readHashSegments();
    if (topic !== null && topic !== topicKey) {
      // 走 setTopic 的 noHash 分支:不重新写 hash,也不 dispatch(本就是因 hash 变化触发)
      topicKey = topic;
      applyCellVisualFilter();
      updateSectionCounts();
      updateSelectActive();
      updateFilterStatus();
    }
    if (day && dayMap.has(day)) {
      openDay(day);
    }
  }
  tryRestoreFromHash();
  window.addEventListener('hashchange', tryRestoreFromHash);

  // ---- 主题过滤实现 ----
  function applyCellVisualFilter(): void {
    const cells = $$<HTMLButtonElement>('.cal-cell[data-day]');
    for (const cell of cells) {
      const d = cell.getAttribute('data-day');
      if (!d) continue;
      const list = getDayPapers(d);
      const n = list.length;
      // 移除旧的 bucket class
      cell.classList.remove(
        'cal-cell--empty',
        'cal-cell--high',
        'cal-cell--mid',
        'cal-cell--low',
      );
      const countEl = cell.querySelector<HTMLElement>('.cal-cell-count');
      const titleEl = cell.querySelector<HTMLElement>('.cal-cell-title');
      if (n === 0) {
        cell.classList.add('cal-cell--empty');
        if (countEl) countEl.textContent = '';
        if (titleEl) titleEl.textContent = '';
        cell.disabled = true;
      } else {
        const top = list[0];
        const s = top?.score;
        if (s !== undefined && s !== null && s >= 7) cell.classList.add('cal-cell--high');
        else if (s !== undefined && s !== null && s >= 5) cell.classList.add('cal-cell--mid');
        else cell.classList.add('cal-cell--low');
        if (countEl) countEl.textContent = String(n);
        if (titleEl) titleEl.textContent = top ? topTitleClient(top) : '';
        cell.disabled = false;
      }
      // a11y label 重算
      cell.setAttribute('aria-label', makeCellAriaLabel(d, n));
    }
  }

  function updateSectionCounts(): void {
    const grandEl = $<HTMLElement>('#cal-grand-count');
    if (grandEl) {
      const filtered = getFilteredDayMap();
      let totalCount = 0;
      for (const arr of filtered.values()) totalCount += arr.length;
      const daysWith = filtered.size;
      grandEl.textContent = `${totalCount} 篇 / ${daysWith} 天`;
    }
    $$<HTMLElement>('.cal-month').forEach((mEl) => {
      const countEl = mEl.querySelector<HTMLElement>('.cal-month-count');
      if (!countEl) return;
      const monthKey = mEl.getAttribute('data-month');
      if (!monthKey) return;
      let total = 0;
      let days = 0;
      for (const [d, ps] of dayMap.entries()) {
        if (!d.startsWith(monthKey)) continue;
        const f = topicKey ? ps.filter((p) => (p.task || null) === topicKey) : ps;
        if (f.length > 0) {
          total += f.length;
          days += 1;
        }
      }
      countEl.textContent = `${total} 篇 · ${days} 天有更新`;
    });
  }

  function updateSelectActive(): void {
    const sel = $<HTMLSelectElement>('#cal-jump-topic');
    if (!sel) return;
    const target = topicKey === null ? '__all__' : topicKey;
    if (sel.value !== target) sel.value = target;
  }

  function updateFilterStatus(): void {
    const rowEl = $<HTMLElement>('#topic-filter-status-row');
    const statusEl = $<HTMLElement>('#topic-filter-status');
    const labelEl = $<HTMLElement>('#topic-filter-status-label');
    if (!rowEl || !statusEl || !labelEl) return;
    if (!topicKey) {
      rowEl.hidden = true;
      statusEl.hidden = true;
      return;
    }
    const sel = $<HTMLSelectElement>('#cal-jump-topic');
    const opt = sel?.querySelector<HTMLOptionElement>(`option[value="${CSS.escape(topicKey)}"]`);
    const raw = opt?.textContent?.trim() || topicKey;
    // "主题:强化学习(87)" → "强化学习"
    const label = raw.replace(/^主题[::]/, '').replace(/[（(]\d+[）)]\s*$/, '').trim() || topicKey;
    labelEl.textContent = label;
    rowEl.hidden = false;
    statusEl.hidden = false;
  }

  function topTitleClient(p: Paper): string {
    const t = (p.title_zh || p.title || '').trim();
    if (t.length <= 14) return t;
    return t.slice(0, 13) + '…';
  }

  function makeCellAriaLabel(d: string, n: number): string {
    const [y, m, day] = d.split('-');
    if (n === 0) return `${y} 年 ${parseInt(m, 10)} 月 ${parseInt(day, 10)} 日,无新论文`;
    return `${y} 年 ${parseInt(m, 10)} 月 ${parseInt(day, 10)} 日,${n} 篇`;
  }

  function setTopic(key: string | null, opts: { silent?: boolean } = {}): void {
    topicKey = key;
    applyCellVisualFilter();
    updateSectionCounts();
    updateSelectActive();
    updateFilterStatus();
    if (!opts.silent) {
      // 写 hash
      const cur = readHashSegments();
      const day = cur.day;
      const parts: string[] = [];
      if (key) parts.push('topic=' + encodeURIComponent(key));
      if (day) parts.push('day=' + day);
      const nextHash = parts.length ? '#' + parts.join('&') : '';
      const { pathname, search } = window.location;
      const target = nextHash ? pathname + search + nextHash : pathname + (search || '');
      if (window.location.hash !== nextHash) {
        try { history.replaceState(null, '', target); } catch (_) { /* ignore */ }
      }
      // 广播(其它脚本 / tag-jump 按钮反向同步 UI)
      document.dispatchEvent(
        new CustomEvent(TOPIC_FILTER_EVENT, { detail: { topic: key } }),
      );
    }
  }

  // chip 点击 → 切 / 取消
  // select 变更 → 切主题(同 value = 取消,即全部 → 全部依然是 null)
  const topicSel = $<HTMLSelectElement>('#cal-jump-topic');
  if (topicSel) {
    topicSel.addEventListener('change', () => {
      const k = topicSel.value;
      // "全部" = null;其它就是该主题 key(没有 toggle 语义,select 不允许多次点同一选项)
      // 同主题重复选择这种语义在原生 select 里不发生(change 只触发值改变);保持简洁不做 toggle。
      setTopic(k === '__all__' ? null : k);
    });
  }

  // 状态条 ✕ 清除
  const statusClearBtn = $<HTMLButtonElement>('#topic-filter-status-clear');
  if (statusClearBtn) {
    statusClearBtn.addEventListener('click', () => setTopic(null));
  }

  // 监听 index.astro 的 tag-jump 按钮(以及其它可能的 emit)
  document.addEventListener(TOPIC_FILTER_EVENT, (e) => {
    const ev = e as CustomEvent<{ topic: string | null }>;
    const next = ev.detail?.topic ?? null;
    if (next === topicKey) return; // 已同步
    setTopic(next, { silent: true });
  });

  // ---- 月份切换:全局「年 + 月」联动下拉 ----
  function switchMonth(ym: string): void {
    if (!ym) return;
    const target = $(`.cal-month[data-month="${ym}"]`) as HTMLElement | null;
    if (!target) return;
    // 只显示目标月,其它月 display:none
    $$<HTMLElement>('.cal-month').forEach((d) => {
      d.style.display = d === target ? '' : 'none';
    });
    // 同步头部 select 跟实际显示的月一致
    const monthSel = $<HTMLSelectElement>('#cal-jump-month');
    if (monthSel) monthSel.value = ym;
    requestAnimationFrame(() => {
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  }

  // 解析年→月数组(已按月份 desc 排好)
  type YearMonthMap = Record<string, number[]>;
  const jumpDataEl = $<HTMLScriptElement>('#cal-jump-data');
  let yearMonthMap: YearMonthMap = {};
  try {
    yearMonthMap = jumpDataEl ? JSON.parse(jumpDataEl.textContent || '{}') : {};
  } catch (_) {
    yearMonthMap = {};
  }

  // 重填月 select(年份变更后调用)
  function rebuildMonthSelect(yearSel: HTMLSelectElement): void {
    const monthSel = $<HTMLSelectElement>('#cal-jump-month');
    if (!monthSel) return;
    const y = yearSel.value;
    const months = (yearMonthMap[y] || []).slice().sort((a, b) => b - a);
    monthSel.innerHTML = months
      .map((mm) => `<option value="${y}-${String(mm).padStart(2, '0')}">${mm} 月</option>`)
      .join('');
  }

  // 绑定:全局 #cal-jump-year + #cal-jump-month 联动
  const yearSel = $<HTMLSelectElement>('#cal-jump-year');
  const monthSel = $<HTMLSelectElement>('#cal-jump-month');
  if (yearSel) {
    yearSel.addEventListener('change', () => {
      rebuildMonthSelect(yearSel);
      // 年变更后,自动跳到该年第一个月
      const monthSelFresh = $<HTMLSelectElement>('#cal-jump-month');
      if (monthSelFresh && monthSelFresh.options.length > 0) {
        switchMonth(monthSelFresh.value);
      }
    });
  }
  if (monthSel) {
    monthSel.addEventListener('change', () => {
      switchMonth(monthSel.value);
    });
  }
}
</script>