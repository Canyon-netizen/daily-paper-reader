---
// 首页(2026-08-02 重构:仿照 Polaris /libraries,公共库 + 个人库合并展示)
//
// 之前:今日推荐 + 编辑精选 + 主题日历(以"每日推送"为中心)
// 然后:文献库卡片流(以"按主题查阅"为中心) + 顶部一行快捷入口 +
//      "今日新增"与"维护方"两枚状态 chip(commit 77d858c)
// 现在(本次):仿照 Polaris LibrariesPage.tsx 风格,加「+ 新建文献库」按钮 +
//      「我的文献库」section 客户端水合 + type filter(全部/公共/个人) +
//      NewLibraryModal 全局弹窗;同时把快捷行 chip 改成 Polaris 风格(去掉
//      「我的图书馆」chip,因为它现在就是默认页)。
//
// 数据:
//   - buildLibraryDigests(items): 派生"公共库 → 论文数 + 最近 3 篇"
//   - 我的文献库 SSR 期无数据,客户端水合读 localStorage 渲染
//   - 统计:论文总数、库数、今日新增
//   - 不再做编辑精选 Top 6 —— 移到 /libraries/<热门 id>/ 看更精准

import { defaultPaperRepository } from '../lib/paper-repository';
import { getLastUpdatedDate } from '../lib/lastUpdated';
import { buildLibraryDigests } from '../lib/libraries';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import NewLibraryModal from '../components/NewLibraryModal.astro';
import '../styles/home.css';
import '../styles/libraries.css';
import '../styles/user-libraries.css';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const repo = defaultPaperRepository;

const items = await repo.list({ sortBy: 'date', dedup: true, base });
const digests = buildLibraryDigests(items);
const totalPapers = items.length;
const libraryCount = digests.length;
const lastUpdated = await getLastUpdatedDate();

// 今日新增(按 date 匹配今天 UTC,简单起见用昨日更新兜底)
const today = new Date().toISOString().slice(0, 10);
const newToday = items.filter((p) => p.date === today).length;
---

<BaseLayout
  title="文献库 · Daily Paper Reader"
  description="按领域 / 主题 / 任务组织的论文集合:强化学习、多智能体、博弈 AI、大模型代理、推理与对齐、机器人、视觉等。"
>
  <Navbar />

  <main class="libraries-page">
    <header class="libraries-hero">
      <h1>文献库</h1>
      <p class="lead">
        按 <strong>领域 / 主题 / 任务</strong>组织的论文集合。共收录
        <strong>{totalPapers}</strong> 篇,展示 <strong>{libraryCount}</strong> 个非空公共主题库。
        在下面可以新建自己的个人文献库,把想精读 / 反复查阅的论文收在一起,跨设备同步走 Gist。
      </p>
      <div class="libraries-shortcuts" aria-label="状态">
        <span class="shortcut">📅 今日新增 <strong>{newToday}</strong></span>
        <span class="shortcut">🕒 最近更新 {lastUpdated || '—'}</span>
        <a class="shortcut" href={base + '/papers/'}>📚 全部论文</a>
        <a class="shortcut" href={base + '/topic/'}>🎯 主题探索</a>
      </div>
    </header>

    <div class="libraries-actionbar">
      <span class="lib-segmented" data-type-filter data-type-filter-target="#all-libraries">
        <button class="lib-segment active" type="button" data-type-value="all">全部</button>
        <button class="lib-segment" type="button" data-type-value="public">🌐 公共</button>
        <button class="lib-segment" type="button" data-type-value="personal">⭐ 我的</button>
      </span>
      <span class="libraries-actionbar-spacer"></span>
      <button type="button" class="btn btn-primary btn-sm" data-open-new-library>
        ➕ 新建文献库
      </button>
    </div>

    <div id="all-libraries">
      <!-- 公共主题库 section -->
      <section class="libraries-section">
        <h2 class="libraries-section-title">
          🌐 公共主题库
          <span class="count">{libraryCount} 个</span>
        </h2>
        <p class="libraries-section-desc">
          由维护者从 <code>docs/papers/**</code> frontmatter 的 task / method 标签派生;
          不需要手动建,改一行配置即可新增。
        </p>
        <div class="libraries-grid">
          {digests.map((d) => (
            <a class={`library-card hue-${d.library.hue}`}
               href={base + '/libraries/' + d.library.id + '/'}
               data-dim={d.library.dimension}
               data-lib-type="public">
              <h2 class="lib-title">
                <span class="lib-title-row">
                  <span class="lib-name">{d.library.title}</span>
                  <span class="lib-type-badge lib-type-badge--public">公共</span>
                </span>
                <span class="lib-count">{d.paperCount} 篇</span>
              </h2>
              <p class="lib-title-zh">{d.library.titleZh}</p>
              <p class="lib-statement">{d.library.descriptionZh}</p>
              <div class="lib-stats">
                <span><strong>{d.paperCount}</strong> 篇论文</span>
                <span><strong>{d.conceptCount}</strong> 个概念</span>
                <span>更新于 {d.latestDate ? d.latestDate.slice(5) : '—'}</span>
              </div>
              <div class="lib-meta">
                <div class="lib-tags">
                  {d.library.tags.slice(0, 2).map((t) => <span class="lib-tag">{t}</span>)}
                </div>
                <span>维护 · {d.library.curator}</span>
              </div>
            </a>
          ))}
        </div>
      </section>

      <!-- 我的文献库 section(客户端水合;SSR 期显示空状态) -->
      <section class="libraries-section" data-user-libraries-section>
        <h2 class="libraries-section-title">
          ⭐ 我的文献库
          <span class="count" data-user-libraries-counter>0 个</span>
        </h2>
        <p class="libraries-section-desc">
          在这里新建的文献库 ——
          存在浏览器 localStorage 里(单人静态站,无服务器),跨设备同步走
          Gist(<a href={base + '/settings/'}>设置页</a>配置)。
        </p>
        <div data-user-libraries-empty style="display: none;">
          <div class="libraries-empty">
            <div class="libraries-empty-icon">📂</div>
            <h3 class="libraries-empty-title">还没有个人文献库</h3>
            <p class="libraries-empty-desc">
              点右上角「➕ 新建文献库」开始 ——
              名字 + 一句话方向描述,30 秒搞定。
            </p>
            <button type="button" class="btn btn-primary btn-sm" data-open-new-library>➕ 新建文献库</button>
          </div>
        </div>
        <div class="libraries-grid" data-user-libraries-grid></div>
      </section>
    </div>

    <div style="margin-top: 2rem; text-align: center;">
      <a href={base + '/libraries/'} style="color: var(--accent); text-decoration: none; font-weight: 500;">
        → 完整文献库列表 + 各库独立导出
      </a>
    </div>
  </main>

  <Footer />
  <NewLibraryModal />

  <script>
    import '../scripts/user-libraries-ui';
  </script>
</BaseLayout>
