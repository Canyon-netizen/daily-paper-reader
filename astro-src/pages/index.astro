---
// 首页(2026-08-01 重构:文献库作为主入口)
//
// 之前:今日推荐 + 编辑精选 + 主题日历(以"每日推送"为中心)
// 现在:文献库卡片流(以"按主题查阅"为中心) + 顶部一行快捷入口 +
//      "今日新增"与"维护方"两枚状态 chip
//
// 对照 Polaris:Polaris 的 /libraries 是首页主体,DPR 也走同一抽象。
// 用户看首页 → 选一个文献库 → 进工作台。这是科研阅读场景的主路径。
//
// 数据:
//   - buildLibraryDigests(items): 派生"库 → 论文数 + 最近 3 篇"
//   - 统计:论文总数、库数、今日新增
//   - 不再做编辑精选 Top 6 —— 移到 /libraries/<热门 id>/ 看更精准

import { defaultPaperRepository } from '../lib/paper-repository';
import { getLastUpdatedDate } from '../lib/lastUpdated';
import { buildLibraryDigests } from '../lib/libraries';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/home.css';
import '../styles/libraries.css';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const repo = defaultPaperRepository;

const items = await repo.list({ sortBy: 'date', dedup: true, base });
const digests = buildLibraryDigests(items);
const totalPapers = items.length;
const libraryCount = digests.length;
const lastUpdated = await getLastUpdatedDate();

// 今日新增(按 date 匹配今天 UTC,简单起见用昨日更新兜底)
const today = new Date().toISOString().slice(0, 10);
const newToday = items.filter((p) => p.date === today).length;
---

<BaseLayout
  title="文献库 · Daily Paper Reader"
  description="按领域 / 主题 / 任务组织的论文集合:强化学习、多智能体、博弈 AI、大模型代理、推理与对齐、机器人、视觉等。"
>
  <Navbar />

  <main class="libraries-page">
    <header class="libraries-hero">
      <h1>文献库</h1>
      <p class="lead">
        按 <strong>领域 / 主题 / 任务</strong>组织的论文集合。共收录
        <strong>{totalPapers}</strong> 篇,展示 <strong>{libraryCount}</strong> 个非空库。
        <strong>个人图书馆</strong>(星标 / 笔记 / 高亮)走 <a href={base + '/library/'}>这里</a>。
      </p>
      <div class="libraries-shortcuts" aria-label="状态">
        <span class="shortcut">📅 今日新增 <strong>{newToday}</strong></span>
        <span class="shortcut">🕒 最近更新 {lastUpdated || '—'}</span>
        <a class="shortcut" href={base + '/library/'}>⭐ 我的图书馆</a>
        <a class="shortcut" href={base + '/topic/'}>🎯 主题探索</a>
      </div>
    </header>

    <div class="libraries-grid">
      {digests.map((d) => (
        <a class={`library-card hue-${d.library.hue}`} href={base + '/libraries/' + d.library.id + '/'}>
          <h2 class="lib-title">
            <span>{d.library.title}</span>
            <span class="lib-count">{d.paperCount} 篇</span>
          </h2>
          <p class="lib-title-zh">{d.library.titleZh}</p>
          <p class="lib-desc">{d.library.descriptionZh}</p>
          <div class="lib-meta">
            <div class="lib-tags">
              {d.library.tags.slice(0, 2).map((t) => <span class="lib-tag">{t}</span>)}
            </div>
            <span>维护 · {d.library.curator}</span>
          </div>
        </a>
      ))}
    </div>

    <div style="margin-top: 2rem; text-align: center;">
      <a href={base + '/libraries/'} style="color: var(--accent); text-decoration: none; font-weight: 500;">
        → 完整文献库列表 + 各库独立导出
      </a>
    </div>
  </main>

  <Footer />
</BaseLayout>