---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/page.css';
import '../styles/concepts-graph.css';
---

<BaseLayout
  title="概念图谱 · Daily Paper Reader"
  description="Daily Paper Reader 收录论文中提炼的核心概念图谱。"
>
  <Navbar />

  <main class="concepts-page">
    <header class="concepts-intro">
      <strong>概念图谱</strong> · 从收录的论文笔记中提炼的核心概念共现网络。
      节点大小 = 出处论文数,边 = 两个概念在同一篇论文里同时出现。
      拖动节点可推动周围概念重新排布,点击节点跳到概念详情页。
      <a class="concepts-intro-link" href={import.meta.env.BASE_URL + 'papers/'}>(论文库 →)</a>
    </header>

    <section class="concepts-toolbar">
      <input
        type="search"
        id="concept-search"
        class="concepts-search"
        placeholder="搜索概念,在图里高亮..."
        autocomplete="off"
      />
      <span class="concepts-count" id="concepts-count"></span>
    </section>

    {/* 主视图:弹力图(fcose 持续受力模拟) + 图例
        - 高度 70vh,最小 560px,占满 viewport
        - 之前把卡片网格放在下面被用户说"为啥还有下面这个文字内容",
          这次直接去掉,只保留图本身;搜索框改成"图内高亮"而非"列表过滤"。 */}
    <section class="concepts-graph-section">
      <div id="concepts-graph" class="concepts-graph"></div>
      <div class="concepts-graph-legend" id="concepts-graph-legend"></div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script>
  /** Category → 颜色(对应 CSS .concept-card[data-cat=] 的 hue 一致) */
  const CATEGORY_COLOR: Record<string, string> = {
    method: '#7c5cff',
    problem: '#ef4444',
    dataset: '#0891b2',
    metric: '#059669',
    methodology: '#d97706',
    task: '#0284c7',
    other: '#9ca3af',
  };
  const CATEGORY_LABEL: Record<string, string> = {
    method: 'method · 方法',
    problem: 'problem · 问题',
    dataset: 'dataset · 数据集',
    metric: 'metric · 指标',
    methodology: 'methodology · 方法论',
    task: 'task · 任务',
    other: 'other · 其它',
  };

  type RawNode = {
    id: string;
    label?: string;
    kind?: string;
    weight?: number;
    category?: string;
  };
  type RawEdge = { source?: string; target?: string; kind?: string };

  let cy: any = null;
  let allConceptIds: string[] = [];

  /** 拉 _graph.json + 过滤 paper 节点 + 客户端重算 concept→concept 共现边 */
  async function fetchAndBuildGraph() {
    const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
    const res = await fetch(`${base}/wiki/concepts/_graph.json`);
    if (!res.ok) return null;
    const graph = await res.json();
    const nodes: RawNode[] = Array.isArray(graph?.nodes) ? graph.nodes : [];
    const edges: RawEdge[] = Array.isArray(graph?.edges) ? graph.edges : [];
    if (!nodes.length) return null;

    const concepts = nodes.filter((n) => n.kind === 'concept');
    const conceptIds = new Set(concepts.map((c) => c.id));
    if (!concepts.length) return null;

    // paper → 它提到的 concepts
    const paperToConcepts = new Map<string, string[]>();
    for (const e of edges) {
      if (!e.source || !e.target) continue;
      if (!conceptIds.has(e.target)) continue;
      if (!paperToConcepts.has(e.source)) paperToConcepts.set(e.source, []);
      paperToConcepts.get(e.source)!.push(e.target);
    }

    // concept → concept 共现边
    const cooccur = new Map<string, number>();
    let papersUsed = 0;
    for (const cs of paperToConcepts.values()) {
      if (cs.length < 2) continue;
      papersUsed++;
      cs.sort();
      for (let i = 0; i < cs.length; i++) {
        for (let j = i + 1; j < cs.length; j++) {
          const key = `${cs[i]}||${cs[j]}`;
          cooccur.set(key, (cooccur.get(key) || 0) + 1);
        }
      }
    }

    const conceptElements = concepts.map((c) => ({
      data: {
        id: c.id,
        label: cleanConceptLabel(c.label || c.id),
        kind: 'concept',
        weight: c.weight || 1,
        category: c.category || 'other',
        color: CATEGORY_COLOR[c.category || 'other'] || CATEGORY_COLOR.other,
      },
    }));
    const edgeElements: any[] = [];
    let idx = 0;
    for (const [key, count] of cooccur.entries()) {
      const [a, b] = key.split('||');
      edgeElements.push({
        data: { id: `ce${idx++}`, source: a, target: b, kind: 'cooccur', weight: count },
      });
    }

    return { concepts, conceptElements, edgeElements, papersUsed };
  }

  /** 清洗 concept label
   *  - 治"论文标题被当 concept 名"(长度 > 50 + 含 ':'):取冒号前部分
   *  - 治"label 过长"(> 40 字符):截到 ≤ 35 字符,优先在空格处断
   *  - 治"末尾脏字符"(… / - / 空格):trim 掉
   *  - ≤ 40 字符且无冒号:原样返回(常见合法英文概念名直接放过) */
  function cleanConceptLabel(raw: string): string {
    let s = (raw || '').trim();
    if (!s) return s;
    // 1) 论文标题模式:有冒号且超过 50 字符,取前半段
    if (s.length > 50 && s.includes(':')) {
      s = s.split(':')[0].trim();
    }
    // 2) 长度兜底 (40+ 才截)
    if (s.length > 40) {
      const cut = s.slice(0, 35);
      // 优先在最后一个空格处断
      const lastSpace = cut.lastIndexOf(' ');
      s = (lastSpace > 12 ? cut.slice(0, lastSpace) : cut).trim() + '…';
    }
    // 3) 末尾脏字符
    s = s.replace(/[…\-\s]+$/, '');
    return s;
  }

  /** 渲染图例 ——
   *  category 色板 + 共现边示意 + 交互提示(可拖动 / 滚轮缩放 / 高亮邻居 / 搜索) */
  function renderLegend(conceptCount: number, edgeCount: number, papersUsed: number) {
    const legendEl = document.getElementById('concepts-graph-legend');
    if (!legendEl) return;
    const order = ['method', 'problem', 'dataset', 'metric', 'methodology', 'task', 'other'];
    const catItems = order
      .map(
        (cat) => `
        <span class="legend-item">
          <span class="legend-dot" style="background:${CATEGORY_COLOR[cat] || CATEGORY_COLOR.other};"></span>
          <span>${CATEGORY_LABEL[cat] || cat}</span>
        </span>`,
      )
      .join('');
    legendEl.innerHTML = `
      ${catItems}
      <span class="legend-item">
        <span class="legend-line"></span>
        <span>共现(同篇论文)</span>
      </span>
      <span class="legend-tip">${conceptCount} 概念 · ${edgeCount} 共现边 · ${papersUsed} 论文驱动 · 拖动节点 / 滚轮缩放 / 点击节点跳转</span>
    `;
  }

  async function init() {
    const data = await fetchAndBuildGraph();
    if (!data) {
      renderLegend(0, 0, 0);
      const countEl = document.getElementById('concepts-count');
      if (countEl) countEl.textContent = '暂未生成概念图谱';
      return;
    }
    const { concepts, conceptElements, edgeElements, papersUsed } = data;
    allConceptIds = concepts.map((c) => c.id);

    // 动态 import cytoscape + fcose(避免 SSR 报错;fcose 提供持续受力模拟,
    // 拖动节点时周围的边和节点会跟着"弹"过去,符合用户要的"弹力图"语义)。
    let cytoscape: any;
    let fcose: any;
    try {
      cytoscape = (await import('cytoscape')).default;
      fcose = (await import('cytoscape-fcose')).default;
    } catch (e) {
      console.warn('[concepts] cytoscape/fcose not available:', e);
      return;
    }
    cytoscape.use(fcose);

    const container = document.getElementById('concepts-graph');
    if (!container) return;

    cy = cytoscape({
      container,
      elements: [...conceptElements, ...edgeElements],
      style: [
        {
          selector: 'node[kind = "concept"]',
          style: {
            'background-color': 'data(color)',
            'label': 'data(label)',
            'font-size': '12px',
            'font-weight': 600,
            'color': '#1f2937',
            'text-valign': 'bottom',
            'text-halign': 'center',
            'text-margin-y': 6,
            'width': 'mapData(weight, 1, 50, 18, 56)',
            'height': 'mapData(weight, 1, 50, 18, 56)',
            'text-background-color': '#fff',
            'text-background-opacity': 0.9,
            'text-background-padding': 3,
            'text-background-shape': 'roundrectangle',
            'text-wrap': 'wrap',
            'text-max-width': '110px',
            'border-color': '#fff',
            'border-width': 2,
            'border-opacity': 0.6,
          },
        },
        {
          selector: 'node[kind = "concept"]:selected',
          style: {
            'border-color': '#1f2937',
            'border-width': 3,
            'border-opacity': 1,
            'background-blacken': -0.15,
          },
        },
        {
          selector: 'node[kind = "concept"].faded',
          style: { opacity: 0.15 },
        },
        {
          selector: 'node[kind = "concept"].matched',
          style: {
            'border-color': '#f59e0b',
            'border-width': 3,
            'border-opacity': 1,
          },
        },
        {
          selector: 'edge[kind = "cooccur"]',
          style: {
            'line-color': '#94a3b8',
            'width': 'mapData(weight, 1, 10, 1, 5)',
            'curve-style': 'straight',
            'opacity': 0.55,
          },
        },
        {
          selector: 'edge.faded',
          style: { opacity: 0.06 },
        },
      ],
      layout: {
        name: 'fcose',
        animate: true,
        animationDuration: 600,
        randomize: true,
        fit: true,
        padding: 40,
        nodeSeparation: 90,
        idealEdgeLength: 110,
        nodeRepulsion: 8000,
        gravity: 0.25,
        gravityRangeCompound: 1.5,
        numIter: 2500,
        tile: true,
        // 关键:drag any node 时启用持续模拟,其它节点会被弹力推动
        // (fcose 内置支持,无需自己写拖拽 handler)
      },
      wheelSensitivity: 0.2,
      // 节点默认可拖动;拖动时 cytoscape 自动维持 edge 弹性
      // (fcose 在 drag 时会重新局部施加 force 推动邻居)
    });

    // 点击 concept 节点 → 跳详情页
    cy.on('tap', 'node[kind = "concept"]', (evt: any) => {
      const slug = evt.target.id();
      const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
      window.location.href = `${base}/wiki/concepts/${encodeURIComponent(slug)}/`;
    });

    // hover 高亮邻居
    cy.on('mouseover', 'node[kind = "concept"]', (evt: any) => {
      const node = evt.target;
      const nhd = node.closedNeighborhood();
      cy.elements().not(nhd).addClass('faded');
    });
    cy.on('mouseout', 'node[kind = "concept"]', () => {
      cy.elements().removeClass('faded');
    });

    // 搜索:输入文字 → 把 label 匹配的节点加 .matched,其它 .faded
    const searchEl = document.getElementById('concept-search') as HTMLInputElement | null;
    const countEl = document.getElementById('concepts-count');
    if (countEl) countEl.textContent = `${concepts.length} 个概念`;
    searchEl?.addEventListener('input', () => {
      const q = (searchEl.value || '').trim().toLowerCase();
      if (!q) {
        cy.elements().removeClass('faded matched');
        return;
      }
      cy.nodes().forEach((n: any) => {
        const label = (n.data('label') || '').toLowerCase();
        const id = (n.id() || '').toLowerCase();
        const hit = label.includes(q) || id.includes(q);
        if (hit) n.removeClass('faded').addClass('matched');
        else n.addClass('faded').removeClass('matched');
      });
      cy.edges().addClass('faded');
    });

    renderLegend(concepts.length, edgeElements.length, papersUsed);
  }

  init();
</script>
