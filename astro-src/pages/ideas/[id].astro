---
// /ideas/[id]/ — Idea detail page
import { ideasPaths } from '../../lib/paths.generated';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/ideas.css';

// Generate static paths from docs/ideas/*.md files (auto-generated)
export async function getStaticPaths() {
  return ideasPaths.map((id) => ({ params: { id } }));
}

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');

// SSR-side: render a shell that the client will hydrate
// The idea ID comes from the URL path
const { id } = Astro.params;

// For SSR, we pass the ID to the client which will load from localStorage
---

<BaseLayout
  title={`想法详情 · Daily Paper Reader`}
  description="想法详情页"
>
  <Navbar />

  <main class="idea-detail-page">
    <div class="idea-detail-container" data-idea-id={id}>
      <a href={base + '/ideas/'} class="back-link">← 所有想法</a>

      <div id="idea-detail-content">
        <!-- Client-side rendered -->
        <noscript>
          <p class="ideas-nojs">
            想法详情需要 JavaScript 渲染 — 数据存在浏览器 localStorage。
          </p>
        </noscript>
      </div>
    </div>
  </main>

  <Footer />

  <script define:vars={{ ideaId: id, baseUrl: base }}>
    import { getIdea, updateIdea, deleteIdea, listIdeas } from '../../lib/ideas';
    import type { Idea, IdeaStatus } from '../../lib/ideas/types';
    import { renderMarkdownBody } from '../../lib/markdown/render';
    import { getAllExperiments } from '../../lib/experiments';
    import { listWritings } from '../../lib/writing';

    const statusLabels: Record<IdeaStatus, string> = {
      draft: '草稿',
      active: '进行中',
      promoted: '已推荐',
      archived: '已归档',
    };
    const statusTooltips: Record<IdeaStatus, string> = {
      draft: '起草中的想法，尚未开始验证',
      active: '正在验证或探索的想法',
      promoted: '已验证成功，值得分享或进一步发展',
      archived: '已搁置或不再活跃的想法',
    };
    const statusIcons: Record<IdeaStatus, string> = {
      draft: '📝',
      active: '🚀',
      promoted: '⭐',
      archived: '📦',
    };

    function renderDetail(idea: Idea): void {
      const container = document.getElementById('idea-detail-content');
      if (!container) return;

      const date = new Date(idea.updatedAt).toLocaleDateString('zh-CN', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
      });
      const createdDate = new Date(idea.createdAt).toLocaleDateString('zh-CN', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
      });

      const papersHtml = idea.relatedPapers.length > 0
        ? `<div class="idea-detail-section">
            <h4>关联论文</h4>
            <div class="idea-papers-list">
              ${idea.relatedPapers.map((pid) => `
                <a href="${baseUrl}/papers/${pid}/" class="idea-paper-link" target="_blank">
                  <span class="paper-id">${pid}</span>
                  <span class="paper-arrow">→</span>
                </a>
              `).join('')}
            </div>
          </div>`
        : '';

      const conceptsHtml = idea.relatedConcepts.length > 0
        ? `<div class="idea-detail-section">
            <h4>关联概念</h4>
            <div class="idea-concepts-list">
              ${idea.relatedConcepts.map((slug) => `
                <a href="${baseUrl}/wiki/concepts/${slug}/" class="idea-concept-link">${slug}</a>
              `).join('')}
            </div>
          </div>`
        : '';

      const tagsHtml = idea.tags.length > 0
        ? `<div class="idea-detail-tags">
            ${idea.tags.map((t) => `<span class="idea-detail-tag">${escapeHtml(t)}</span>`).join('')}
          </div>`
        : '';

      container.innerHTML = `
        <div class="idea-detail-header">
          <div class="idea-detail-status">
            <span class="status-icon">${statusIcons[idea.status]}</span>
            <span class="status-label" title="${statusTooltips[idea.status]}">${statusLabels[idea.status]}</span>
            <span class="status-tooltip" title="${statusTooltips[idea.status]}">?</span>
          </div>
          <h1 class="idea-detail-title">${escapeHtml(idea.title)}</h1>
          ${tagsHtml}
        </div>

        <div class="idea-detail-meta">
          <span>创建于 ${createdDate}</span>
          <span>更新于 ${date}</span>
        </div>

        <div class="idea-detail-body">
          <div class="idea-detail-section">
            <h4>描述</h4>
            <div class="idea-description-content">${renderMarkdownBody(idea.description)}</div>
          </div>

          ${papersHtml}
          ${conceptsHtml}
          ${renderDerivedTrackingHtml(idea)}
        </div>

        <div class="idea-detail-actions">
          <button type="button" class="btn btn-ghost" data-edit-idea>✏️ 编辑</button>
          <button type="button" class="btn btn-primary" data-create-experiment>🔬 创建实验</button>
          <button type="button" class="btn btn-ghost" data-export-json>📋 导出 JSON</button>
          <div class="idea-status-actions">
            ${idea.status !== 'active' ? `<button type="button" class="btn btn-sm" data-status="active">🚀 进行中</button>` : ''}
            ${idea.status !== 'promoted' ? `<button type="button" class="btn btn-sm" data-status="promoted">⭐ 推荐</button>` : ''}
            ${idea.status !== 'archived' ? `<button type="button" class="btn btn-sm" data-status="archived">📦 归档</button>` : ''}
            ${idea.status !== 'draft' ? `<button type="button" class="btn btn-sm" data-status="draft">📝 草稿</button>` : ''}
          </div>
          <button type="button" class="btn btn-danger-ghost" data-delete-idea>🗑️ 删除</button>
        </div>
      `;

      // Attach event listeners
      container.querySelector<HTMLButtonElement>('[data-edit-idea]')?.addEventListener('click', () => {
        openEditModal(idea);
      });

      container.querySelector<HTMLButtonElement>('[data-create-experiment]')?.addEventListener('click', () => {
        // Navigate to experiments page with prefill data via URL params
        const params = new URLSearchParams();
        params.set('prefill_idea_id', idea.id);
        params.set('prefill_title', idea.title);
        params.set('prefill_hypothesis', idea.description);
        params.set('prefill_papers', idea.relatedPapers.join(','));
        window.location.href = `${baseUrl}/experiments/?${params.toString()}`;
      });

      // Export JSON handler
      container.querySelector<HTMLButtonElement>('[data-export-json]')?.addEventListener('click', () => {
        const json = JSON.stringify(idea, null, 2);
        const blob = new Blob([json], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `${idea.id}.json`;
        a.click();
        URL.revokeObjectURL(url);
      });

      container.querySelectorAll<HTMLButtonElement>('[data-status]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const newStatus = btn.dataset.status as IdeaStatus;
          if (newStatus) {
            updateIdea(idea.id, { status: newStatus });
            const updated = getIdea(idea.id);
            if (updated) renderDetail(updated);
          }
        });
      });

      container.querySelector<HTMLButtonElement>('[data-delete-idea]')?.addEventListener('click', () => {
        if (confirm('确定要归档这个想法吗？归档后可从「已归档」筛选恢复。')) {
          updateIdea(idea.id, { status: 'archived' });
          // Re-fetch and re-render
          const updated = getIdea(idea.id);
          if (updated) renderDetail(updated);
        }
      });
    }

    function openEditModal(idea: Idea): void {
      const modal = document.getElementById('idea-edit-modal') || createEditModal();
      const form = modal.querySelector<HTMLFormElement>('#idea-edit-form');
      if (!form) return;

      (form.querySelector('#edit-idea-title') as HTMLInputElement).value = idea.title;
      (form.querySelector('#edit-idea-description') as HTMLTextAreaElement).value = idea.description;
      (form.querySelector('#edit-idea-tags') as HTMLInputElement).value = idea.tags.join(', ');
      (form.querySelector('#edit-idea-papers') as HTMLInputElement).value = idea.relatedPapers.join(', ');

      // iter #403: <dialog> showModal
      if (typeof modal.showModal === 'function') {
        if (!modal.open) modal.showModal();
      } else {
        modal.setAttribute('open', '');
      }

      form.onsubmit = (e) => {
        e.preventDefault();
        const formData = new FormData(form);
        const title = formData.get('title') as string;
        const description = formData.get('description') as string;
        const tagsStr = formData.get('tags') as string;
        const papersStr = formData.get('relatedPapers') as string;

        const tags = tagsStr ? tagsStr.split(',').map((t) => t.trim()).filter(Boolean) : [];
        const relatedPapers = papersStr
          ? papersStr.split(',').map((p) => p.trim().replace(/^(\d+\.\d+v?\d*).*$/, '$1')).filter(Boolean)
          : [];

        updateIdea(idea.id, { title, description, tags, relatedPapers });
        const updated = getIdea(idea.id);
        if (updated) {
          renderDetail(updated);
        }
        // iter #403: <dialog> close
        if (typeof modal.close === 'function') modal.close();
        else modal.removeAttribute('open');
      };

      modal.querySelector('.modal-close')?.addEventListener('click', () => {
        // iter #403: <dialog> close
        if (typeof modal.close === 'function') modal.close();
        else modal.removeAttribute('open');
      });
    }

    function createEditModal(): HTMLElement {
      const modal = document.createElement('dialog');
      modal.id = 'idea-edit-modal';
      modal.className = 'idea-modal';
      modal.innerHTML = `
        <div class="modal-content">
          <div class="modal-header">
            <h2>编辑想法</h2>
            <button type="button" class="modal-close" aria-label="关闭">×</button>
          </div>
          <form id="idea-edit-form">
            <div class="form-group">
              <label for="edit-idea-title">标题</label>
              <input type="text" id="edit-idea-title" name="title" required maxlength="100" />
            </div>
            <div class="form-group">
              <label for="edit-idea-description">描述</label>
              <textarea id="edit-idea-description" name="description" required rows="6"></textarea>
            </div>
            <div class="form-group">
              <label for="edit-idea-papers">关联论文 (arXiv ID, 逗号分隔)</label>
              <input type="text" id="edit-idea-papers" name="relatedPapers" placeholder="1706.03762, 20088.11826" />
            </div>
            <div class="form-group">
              <label for="edit-idea-tags">标签 (逗号分隔)</label>
              <input type="text" id="edit-idea-tags" name="tags" placeholder="architecture, theory" />
            </div>
            <div class="form-actions">
              <button type="button" class="btn btn-ghost modal-cancel">取消</button>
              <button type="submit" class="btn btn-primary">保存</button>
            </div>
          </form>
        </div>
      `;
      document.body.appendChild(modal);

      modal.addEventListener('click', (e) => {
        // iter #403: <dialog> close on backdrop
        if (e.target === modal) {
          if (typeof modal.close === 'function') modal.close();
          else modal.removeAttribute('open');
        }
      });

      return modal;
    }

    function escapeHtml(str: string): string {
      return str
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    /** Render derived tracking section - shows experiments and writings derived from this idea */
    function renderDerivedTrackingHtml(idea: Idea): string {
      const derivedExperiments = getAllExperiments().filter(e =>
        e.relatedIdeas?.includes(idea.id)
      );
      const derivedWritings = listWritings().filter(w =>
        w.relatedIdeas?.includes(idea.id)
      );

      if (derivedExperiments.length === 0 && derivedWritings.length === 0) {
        return `<div class="idea-detail-section derived-tracking-section">
          <h4>🔗 派生追踪</h4>
          <p class="derived-empty">还没有派生的实验或写作。</p>
          <div class="derived-cta">
            <a href="${baseUrl}/experiments/?prefill_idea_id=${encodeURIComponent(idea.id)}&prefill_title=${encodeURIComponent(idea.title)}" class="btn btn-sm">🧪 创建实验</a>
            <a href="${baseUrl}/writing/?prefill_idea_id=${encodeURIComponent(idea.id)}&prefill_title=${encodeURIComponent(idea.title)}" class="btn btn-sm">📝 创建写作</a>
          </div>
        </div>`;
      }

      // Count summary
      const expCount = derivedExperiments.length;
      const writingCount = derivedWritings.length;
      const countSummary = `派生 ${expCount} 个实验 ${writingCount > 0 ? `+ ${writingCount} 个写作` : ''}`;

      // Status order for sorting
      const expStatusOrder: Record<string, number> = { active: 0, running: 1, completed: 2, planning: 3, failed: 4, paused: 5, archived: 6 };
      const writingStatusOrder: Record<string, number> = { review: 0, draft: 1, final: 2 };

      // Sort experiments by status group then by createdAt descending
      const sortedExperiments = [...derivedExperiments].sort((a, b) => {
        const aOrder = expStatusOrder[a.status] ?? 99;
        const bOrder = expStatusOrder[b.status] ?? 99;
        if (aOrder !== bOrder) return aOrder - bOrder;
        return new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime();
      });

      // Sort writings by status group then by updatedAt descending
      const sortedWritings = [...derivedWritings].sort((a, b) => {
        const aOrder = writingStatusOrder[a.status] ?? 99;
        const bOrder = writingStatusOrder[b.status] ?? 99;
        if (aOrder !== bOrder) return aOrder - bOrder;
        return b.updatedAt - a.updatedAt;
      });

      // Group experiments by status for collapsible sections
      const expGroups: Record<string, typeof derivedExperiments> = {};
      for (const exp of sortedExperiments) {
        const status = exp.status;
        if (!expGroups[status]) expGroups[status] = [];
        expGroups[status].push(exp);
      }

      // Group writings by status
      const writingGroups: Record<string, typeof derivedWritings> = {};
      for (const w of sortedWritings) {
        const status = w.status;
        if (!writingGroups[status]) writingGroups[status] = [];
        writingGroups[status].push(w);
      }

      const expStatusLabels: Record<string, string> = { planning: '规划中', running: '进行中', completed: '已完成', failed: '失败', paused: '暂停' };
      const writingStatusLabels: Record<string, string> = { draft: '草稿', review: '审核中', final: '已完成' };

      // Default expanded statuses
      const defaultExpandedStatuses = ['completed', 'promoted'];

      let experimentsHtml = '';
      for (const [status, exps] of Object.entries(expGroups)) {
        const isExpanded = defaultExpandedStatuses.includes(status);
        experimentsHtml += `
          <div class="derived-status-group" data-status="${status}">
            <button type="button" class="derived-group-header" data-toggle-group="${status}">
              <span class="derived-group-toggle">${isExpanded ? '▼' : '▶'}</span>
              <span class="derived-group-status">${expStatusLabels[status] || status}</span>
              <span class="derived-group-count">(${exps.length})</span>
            </button>
            <div class="derived-group-content" ${isExpanded ? '' : 'hidden'}>
              ${exps.map(exp => `
                <a href="${baseUrl}/experiments/${exp.id}/" class="derived-item">
                  <span class="derived-item-title">${escapeHtml(exp.title)}</span>
                  <span class="derived-item-badge derived-item-badge--${exp.status}">${expStatusLabels[exp.status] || exp.status}</span>
                  <span class="derived-item-date">${new Date(exp.createdAt).toLocaleDateString('zh-CN')}</span>
                </a>
              `).join('')}
            </div>
          </div>`;
      }

      let writingsHtml = '';
      for (const [status, ws] of Object.entries(writingGroups)) {
        const isExpanded = defaultExpandedStatuses.includes(status);
        writingsHtml += `
          <div class="derived-status-group" data-status="${status}">
            <button type="button" class="derived-group-header" data-toggle-group="${status}">
              <span class="derived-group-toggle">${isExpanded ? '▼' : '▶'}</span>
              <span class="derived-group-status">${writingStatusLabels[status] || status}</span>
              <span class="derived-group-count">(${ws.length})</span>
            </button>
            <div class="derived-group-content" ${isExpanded ? '' : 'hidden'}>
              ${ws.map(w => `
                <a href="${baseUrl}/writing/${w.id}/" class="derived-item">
                  <span class="derived-item-title">${escapeHtml(w.title)}</span>
                  <span class="derived-item-badge derived-item-badge--writing">${writingStatusLabels[w.status] || w.status}</span>
                  <span class="derived-item-date">${new Date(w.updatedAt).toLocaleDateString('zh-CN')}</span>
                </a>
              `).join('')}
            </div>
          </div>`;
      }

      return `<div class="idea-detail-section derived-tracking-section">
        <h4>🔗 派生追踪</h4>
        <p class="derived-count-summary">${countSummary}</p>
        ${experimentsHtml ? `<div class="derived-list derived-experiments">${experimentsHtml}</div>` : ''}
        ${writingsHtml ? `<div class="derived-list derived-writings">${writingsHtml}</div>` : ''}
      </div>`;
    }

    // Setup toggle handlers for derived tracking groups
    function setupDerivedTrackingToggles(): void {
      document.querySelectorAll<HTMLButtonElement>('[data-toggle-group]').forEach(btn => {
        btn.addEventListener('click', () => {
          const status = btn.dataset.toggleGroup;
          const content = btn.parentElement?.querySelector('.derived-group-content');
          const toggle = btn.querySelector('.derived-group-toggle');
          if (content && toggle) {
            const isHidden = content.hasAttribute('hidden');
            content.toggleAttribute('hidden', !isHidden);
            toggle.textContent = isHidden ? '▼' : '▶';
          }
        });
      });
    }

    // Initialize
    const idea = getIdea(ideaId);
    if (idea) {
      renderDetail(idea);
      setupDerivedTrackingToggles();
    } else {
      const container = document.getElementById('idea-detail-content');
      if (container) {
        container.innerHTML = `
          <div class="idea-not-found">
            <h2>想法不存在</h2>
            <p>找不到 ID 为 "${ideaId}" 的想法。</p>
            <a href="${baseUrl}/ideas/" class="btn btn-primary">返回想法列表</a>
          </div>
        `;
      }
    }
  </script>
</BaseLayout>
