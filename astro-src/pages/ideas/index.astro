---
// /ideas/ — Ideas list page (grid of idea cards)

import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/ideas.css';

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');

// SSR-side: we can't read localStorage, so just render an empty shell
// The client-side JS (ideas-ui.ts) will hydrate and load ideas from localStorage
---

<BaseLayout
  title="想法 · Daily Paper Reader"
  description="记录和管理你的研究想法 — 从论文阅读中产生的 idea、工作实验计划、写作素材。"
>
  <Navbar />

  <main class="ideas-page">
    <header class="ideas-hero">
      <h1>想法</h1>
      <p class="lead">
        记录和管理你的 <strong>研究想法</strong>。
        从论文阅读中产生的 idea、实验计划、写作素材，都在这里。
      </p>
    </header>

    <div class="ideas-actionbar">
      <div class="ideas-filter" data-ideas-filter>
        <button type="button" class="filter-pill active" data-idea-filter="all">全部</button>
        <button type="button" class="filter-pill" data-idea-filter="draft">
          草稿
          <span class="status-tooltip" data-tooltip="起草中的想法，尚未开始验证">?</span>
        </button>
        <button type="button" class="filter-pill" data-idea-filter="active">
          进行中
          <span class="status-tooltip" data-tooltip="正在验证或探索的想法">?</span>
        </button>
        <button type="button" class="filter-pill" data-idea-filter="promoted">
          推荐
          <span class="status-tooltip" data-tooltip="已验证成功，值得分享或进一步发展">?</span>
        </button>
        <button type="button" class="filter-pill" data-idea-filter="archived">
          归档
          <span class="status-tooltip" data-tooltip="已搁置或不再活跃的想法">?</span>
        </button>
      </div>
      <span class="ideas-count" data-idea-count>加载中...</span>
      <button type="button" class="btn btn-primary btn-sm" data-open-new-idea>
        ➕ 新建想法
      </button>
      <button type="button" class="btn btn-sm" data-batch-create-experiments>
        🚀 批量建实验
      </button>
      <button type="button" class="btn btn-sm" data-export-all>
        💾 导出全部
      </button>
    </div>

    <div id="batch-selection-bar" class="batch-selection-bar" hidden>
      <span data-batch-count>已选 0 个</span>
      <button type="button" class="btn btn-primary btn-sm" data-batch-create-selected>
        🚀 批量创建实验
      </button>
      <button type="button" class="btn btn-ghost btn-sm" data-batch-clear>
        清除选择
      </button>
    </div>

    <div id="ideas-empty-hint" class="ideas-empty-hint" hidden>
      <p class="ideas-empty-hint-text">
        还没有想法？读完论文后在 paper-analyzer 点「💡 保存为想法」，或在主题报告点「💡 提炼为想法」。
      </p>
    </div>

    <div id="ideas-grid" class="ideas-grid">
      <!-- Client-side rendered -->
      <noscript>
        <p class="ideas-nojs">
          想法功能需要 JavaScript 渲染 — 数据存在浏览器 localStorage。
        </p>
      </noscript>
    </div>
  </main>

  <Footer />

  <!-- New Idea Modal -->
  <dialog id="idea-modal" class="idea-modal">
    <div class="modal-content">
      <div class="modal-header">
        <h2>新建想法</h2>
        <button type="button" class="modal-close" aria-label="关闭">×</button>
      </div>
      <form id="idea-form" class="idea-form">
        <div class="form-group">
          <label for="idea-title">标题</label>
          <input
            type="text"
            id="idea-title"
            name="title"
            required
            placeholder="例如: Transformer 注意力机制的可解释性改进"
            maxlength="100"
          />
        </div>
        <div class="form-group">
          <label for="idea-description">描述</label>
          <textarea
            id="idea-description"
            name="description"
            required
            rows="6"
            placeholder="详细描述这个想法的背景、目标和预期价值..."
          ></textarea>
        </div>
        <div class="form-group">
          <label for="idea-related-papers">
            关联论文 (arXiv ID, 逗号分隔)
            <span class="field-hint">支持如 1706.03762, 2008.11826</span>
          </label>
          <input
            type="text"
            id="idea-related-papers"
            name="relatedPapers"
            placeholder="1706.03762, 2008.11826"
          />
        </div>
        <div class="form-group">
          <label for="idea-tags">标签 (逗号分隔)</label>
          <input
            type="text"
            id="idea-tags"
            name="tags"
            placeholder="architecture, theory, nlp"
          />
        </div>

        <!-- Methodology Section (collapsible) -->
        <details class="methodology-details">
          <summary class="methodology-summary">
            <span>方法论 (可选)</span>
            <button type="button" class="btn btn-ghost btn-sm methodology-template-btn" data-methodology-template="observation-hypothesis">
              📝 观察→假设 模板
            </button>
          </summary>
          <div class="methodology-fields">
            <div class="form-group">
              <label for="idea-methodology-observation">观察 (Observation)</label>
              <textarea
                id="idea-methodology-observation"
                name="methodology_observation"
                rows="2"
                placeholder="描述你观察到的现象..."
              ></textarea>
            </div>
            <div class="form-group">
              <label for="idea-methodology-hypothesis">假设 (Hypothesis)</label>
              <textarea
                id="idea-methodology-hypothesis"
                name="methodology_hypothesis"
                rows="2"
                placeholder="基于观察提出的假设..."
              ></textarea>
            </div>
            <div class="form-group">
              <label for="idea-methodology-method">方法 (Method)</label>
              <textarea
                id="idea-methodology-method"
                name="methodology_method"
                rows="2"
                placeholder="验证假设的方法..."
              ></textarea>
            </div>
            <div class="form-group">
              <label for="idea-methodology-findings">发现 (Findings)</label>
              <textarea
                id="idea-methodology-findings"
                name="methodology_findings"
                rows="2"
                placeholder="实验发现..."
              ></textarea>
            </div>
          </div>
        </details>

        <div class="form-actions">
          <button type="button" class="btn btn-ghost modal-cancel">取消</button>
          <button type="submit" class="btn btn-primary">创建想法</button>
        </div>
      </form>
    </div>
  </dialog>

  <!-- Batch Create Experiments Modal -->
  <dialog id="batch-experiment-modal" class="batch-experiment-modal">
    <div class="modal-content">
      <div class="modal-header">
        <h2>批量创建实验</h2>
        <button type="button" class="modal-close" aria-label="关闭">×</button>
      </div>
      <form id="batch-experiment-form" class="batch-experiment-form">
        <div class="form-group">
          <label for="batch-title-prefix">实验标题前缀</label>
          <input
            type="text"
            id="batch-title-prefix"
            name="titlePrefix"
            placeholder="实验: "
            value="实验: "
          />
        </div>
        <div class="form-group">
          <label for="batch-method">公共实验方法</label>
          <textarea
            id="batch-method"
            name="method"
            rows="3"
            placeholder="待设计"
          ></textarea>
        </div>
        <div class="form-group">
          <label for="batch-tags">公共标签 (逗号分隔)</label>
          <input
            type="text"
            id="batch-tags"
            name="tags"
            placeholder=""
          />
        </div>
        <div class="form-group">
          <label for="batch-description-prefix">公共描述前缀</label>
          <textarea
            id="batch-description-prefix"
            name="descriptionPrefix"
            rows="2"
            placeholder=""
          ></textarea>
        </div>
        <div id="batch-preview-container" class="batch-preview-container" hidden>
          <h4>预览生成的实验</h4>
          <pre id="batch-preview" class="batch-experiment-preview"></pre>
        </div>
        <div class="form-actions">
          <button type="button" class="btn btn-ghost modal-cancel">取消</button>
          <button type="button" id="batch-preview-btn" class="btn btn-secondary">📋 预览</button>
          <button type="submit" class="btn btn-primary">🚀 一键创建</button>
        </div>
      </form>
    </div>
  </dialog>

  <script>
    import '../../scripts/ideas-ui';
    import { updateCounts } from '../../scripts/ideas-ui';

    // Initialize counts on page load
    document.addEventListener('DOMContentLoaded', () => {
      updateCounts();
    });
  </script>
</BaseLayout>
