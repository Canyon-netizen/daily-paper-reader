---
// /ideas/ — Ideas list page (SSR from docs/ideas/*.md)
//
// SSR-side: reads markdown files from docs/ideas/, parses frontmatter and body preview.
// Supports filter by tag or title keyword.

import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { parseFrontmatter } from '../../lib/paper-frontmatter/parse';
import '../../styles/ideas.css';

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
const IDEAS_DIR = path.resolve('./docs/ideas');

interface IdeaSummary {
  id: string;
  title: string;
  titleZh: string;
  status: 'draft' | 'active' | 'promoted' | 'archived';
  tags: string[];
  description: string;
  paperCount: number;
  updatedAt: string;
}

/** Extract paper count from ## 关联论文 section */
function countRelatedPapers(body: string): number {
  const match = body.match(/## 关联论文\n([\s\S]*?)(?=\n## |\n#$)/);
  if (!match) return 0;
  const lines = match[1].split('\n');
  return lines.filter(l => /^\- \d{4}\.\d{4}/.test(l.trim())).length;
}

/** Get first 200 chars of description (strip ## headings) */
function getDescriptionPreview(body: string): string {
  // Remove all ## headings and get first 200 chars
  const cleaned = body
    .replace(/^## .+$/gm, '')
    .replace(/^# .+$/gm, '')
    .replace(/\n+/g, ' ')
    .trim();
  return cleaned.length > 200 ? cleaned.slice(0, 200) + '...' : cleaned;
}

/** Load all ideas from docs/ideas/*.md */
function loadIdeasFromDisk(): IdeaSummary[] {
  if (!fs.existsSync(IDEAS_DIR)) {
    return [];
  }

  const files = fs.readdirSync(IDEAS_DIR).filter(f => f.endsWith('.md'));
  const ideas: IdeaSummary[] = [];

  for (const file of files) {
    try {
      const filePath = path.join(IDEAS_DIR, file);
      const content = fs.readFileSync(filePath, 'utf-8');
      const parsed = parseFrontmatter(content);

      if ('error' in parsed) {
        console.warn(`[ideas] Failed to parse ${file}: ${parsed.error}`);
        continue;
      }

      const fm = parsed.data as Record<string, unknown>;
      const body = parsed.body;
      const id = (fm.id as string) || file.replace(/\.md$/, '');

      ideas.push({
        id,
        title: (fm.title as string) || id,
        titleZh: (fm.title_zh as string) || '',
        status: (fm.status as IdeaSummary['status']) || 'draft',
        tags: Array.isArray(fm.tags) ? (fm.tags as string[]) : [],
        description: getDescriptionPreview(body),
        paperCount: countRelatedPapers(body),
        updatedAt: (fm.updatedAt as string) || (fm.createdAt as string) || new Date().toISOString(),
      });
    } catch (err) {
      console.warn(`[ideas] Error loading ${file}:`, err);
    }
  }

  // Sort by updatedAt descending
  ideas.sort((a, b) => b.updatedAt.localeCompare(a.updatedAt));
  return ideas;
}

const allIdeas = loadIdeasFromDisk();

// Status labels
const statusLabels: Record<string, string> = {
  draft: '草稿',
  active: '进行中',
  promoted: '推荐',
  archived: '归档',
};

// Tag counts for filter pills
const tagCounts = new Map<string, number>();
for (const idea of allIdeas) {
  for (const tag of idea.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
  }
}
const popularTags = Array.from(tagCounts.entries())
  .sort((a, b) => b[1] - a[1])
  .slice(0, 10)
  .map(([tag, count]) => ({ tag, count }));
---

<BaseLayout
  title="想法 · Daily Paper Reader"
  description="从 docs/ideas/ 加载的研究想法列表，支持按标签或标题过滤。"
>
  <Navbar />

  <main class="ideas-page">
    <header class="ideas-hero">
      <h1>想法</h1>
      <p class="lead">
        从论文阅读中产生的 <strong>研究想法</strong>。
        共 <strong>{allIdeas.length}</strong> 个想法，已 SSR 渲染。
      </p>
    </header>

    <div class="ideas-actionbar">
      <!-- Filter input -->
      <div class="ideas-search">
        <input
          type="text"
          id="ideas-filter-input"
          class="ideas-filter-input"
          placeholder="按标题或标签过滤..."
          autocomplete="off"
        />
      </div>

      <!-- Status filter pills -->
      <div class="ideas-filter-pills" data-status-filter>
        <button type="button" class="filter-pill active" data-status="all">全部</button>
        <button type="button" class="filter-pill" data-status="draft">草稿</button>
        <button type="button" class="filter-pill" data-status="active">进行中</button>
        <button type="button" class="filter-pill" data-status="promoted">推荐</button>
        <button type="button" class="filter-pill" data-status="archived">归档</button>
      </div>

      <span class="ideas-count" data-idea-count>{allIdeas.length} 个想法</span>
    </div>

    <!-- Popular tags -->
    {popularTags.length > 0 && (
      <div class="ideas-tags-bar">
        <span class="ideas-tags-label">热门标签:</span>
        {popularTags.map(({ tag, count }) => (
          <button type="button" class="tag-pill" data-tag={tag}>
            {tag} <span class="tag-count">({count})</span>
          </button>
        ))}
      </div>
    )}

    <!-- Ideas grid -->
    <div id="ideas-grid" class="ideas-grid">
      {allIdeas.map((idea) => (
        <a href={`${base}/ideas/${idea.id}/`} class="idea-card" data-id={idea.id} data-status={idea.status} data-tags={JSON.stringify(idea.tags)}>
          <div class="idea-card-header">
            <span class={`idea-status-badge idea-status--${idea.status}`}>
              {statusLabels[idea.status] || idea.status}
            </span>
          </div>
          <h3 class="idea-title">{idea.titleZh || idea.title}</h3>
          {idea.titleZh && idea.title !== idea.titleZh && (
            <p class="idea-title-en">{idea.title}</p>
          )}
          <p class="idea-description">{idea.description}</p>
          {idea.tags.length > 0 && (
            <div class="idea-tags">
              {idea.tags.slice(0, 5).map((tag) => (
                <span class="idea-tag">{tag}</span>
              ))}
              {idea.tags.length > 5 && <span class="idea-tag">+{idea.tags.length - 5}</span>}
            </div>
          )}
          <div class="idea-meta">
            <span class="idea-paper-count">📄 {idea.paperCount} 篇论文</span>
          </div>
        </a>
      ))}
    </div>

    <div id="ideas-empty" class="ideas-empty" hidden>
      <div class="ideas-empty-icon">💡</div>
      <h3 class="ideas-empty-title">没有匹配的想法</h3>
      <p class="ideas-empty-desc">试试调整过滤条件</p>
    </div>
  </main>

  <Footer />

  <script>
    // Client-side filter logic
    const filterInput = document.getElementById('ideas-filter-input') as HTMLInputElement;
    const statusPills = document.querySelectorAll<HTMLButtonElement>('[data-status]');
    const tagPills = document.querySelectorAll<HTMLButtonElement>('[data-tag]');
    const cards = document.querySelectorAll<HTMLAnchorElement>('.idea-card');
    const countEl = document.querySelector('[data-idea-count]');
    const emptyEl = document.getElementById('ideas-empty');

    let currentStatus = 'all';
    let currentTag: string | null = null;
    let currentSearch = '';

    function filterCards() {
      let visibleCount = 0;
      const searchLower = currentSearch.toLowerCase();

      cards.forEach(card => {
        const status = card.dataset.status || '';
        const tags = JSON.parse(card.dataset.tags || '[]') as string[];
        const title = card.querySelector('.idea-title')?.textContent || '';
        const titleEn = card.querySelector('.idea-title-en')?.textContent || '';

        const matchStatus = currentStatus === 'all' || status === currentStatus;
        const matchTag = !currentTag || tags.includes(currentTag);
        const matchSearch = !searchLower ||
          title.toLowerCase().includes(searchLower) ||
          titleEn.toLowerCase().includes(searchLower) ||
          tags.some(t => t.toLowerCase().includes(searchLower));

        const visible = matchStatus && matchTag && matchSearch;
        card.style.display = visible ? '' : 'none';
        if (visible) visibleCount++;
      });

      if (countEl) {
        countEl.textContent = `${visibleCount} 个想法`;
      }
      if (emptyEl) {
        emptyEl.hidden = visibleCount > 0;
      }
    }

    // Status pill click
    statusPills.forEach(pill => {
      pill.addEventListener('click', () => {
        statusPills.forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
        currentStatus = pill.dataset.status || 'all';
        filterCards();
      });
    });

    // Tag pill click
    tagPills.forEach(pill => {
      pill.addEventListener('click', () => {
        const tag = pill.dataset.tag || null;
        if (currentTag === tag) {
          currentTag = null;
          pill.classList.remove('active');
        } else {
          tagPills.forEach(p => p.classList.remove('active'));
          pill.classList.add('active');
          currentTag = tag;
        }
        filterCards();
      });
    });

    // Search input
    if (filterInput) {
      filterInput.addEventListener('input', () => {
        currentSearch = filterInput.value;
        filterCards();
      });
    }
  </script>
</BaseLayout>
