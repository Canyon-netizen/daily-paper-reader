---
// /agents/recent.astro — iter #115:recent edits / changes
//
// 列出 archive/* 按 mtime 倒序,按时间窗口(24h/72h/7d/30d)分组

import { readFile, readdir, stat } from 'node:fs/promises';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import '../../styles/agents.css';

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');

const files = [];
const root = join(process.cwd(), 'archive');

if (existsSync(root)) {
  const sids = await readdir(root).catch(() => []);
  for (const sid of sids) {
    const sd = join(root, sid);
    if (!existsSync(join(sd, 'meta.json'))) continue;
    const top = await readdir(sd, { withFileTypes: true }).catch(() => []);
    for (const e of top) {
      if (e.name === 'meta.json') {
        const s = await stat(join(sd, e.name)).catch(() => null);
        if (s) files.push({ sid, rel: e.name, mtime: s.mtimeMs, size: s.size, kind: 'meta' });
      } else if (e.isDirectory()) {
        const sub = await readdir(join(sd, e.name)).catch(() => []);
        for (const f of sub) {
          const fp = join(sd, e.name, f);
          const s = await stat(fp).catch(() => null);
          if (!s) continue;
          let kind = 'other';
          if (e.name === 'rounds' && /^round_\d+\.json$/.test(f)) kind = 'round';
          else if (e.name === 'synthesis' && /^synthesis_\d+\.md$/.test(f)) kind = 'synthesis';
          else if (e.name === 'deliverables') kind = 'deliverable';
          else if (e.name === 'export') kind = 'exportFile';
          files.push({ sid, rel: `${e.name}/${f}`, mtime: s.mtimeMs, size: s.size, kind });
        }
      }
    }
  }
}

files.sort((a, b) => b.mtime - a.mtime);

const now = Date.now();
const windows = [
  { label: '🕐 过去 24 小时', min: 24 * 3600 * 1000 },
  { label: '📅 过去 72 小时', min: 72 * 3600 * 1000 },
  { label: '🗓 过去 7 天', min: 7 * 86_400_000 },
  { label: '📆 过去 30 天', min: 30 * 86_400_000 },
];
const grouped = windows.map((w) => ({
  label: w.label,
  files: files.filter((f) => now - f.mtime <= w.min),
}));

function fmtBytes(n) {
  if (n < 1024) return n + ' B';
  if (n < 1024 * 1024) return (n / 1024).toFixed(1) + ' KB';
  return (n / (1024 * 1024)).toFixed(1) + ' MB';
}
function agoStr(ts) {
  if (!ts) return '—';
  const sec = Math.floor((now - ts) / 1000);
  if (sec < 60) return sec + ' 秒前';
  if (sec < 3600) return Math.floor(sec / 60) + ' 分钟前';
  if (sec < 86400) return Math.floor(sec / 3600) + ' 小时前';
  if (sec < 7 * 86400) return Math.floor(sec / 86400) + ' 天前';
  if (sec < 30 * 86400) return Math.floor(sec / (7 * 86400)) + ' 周前';
  return Math.floor(sec / (30 * 86400)) + ' 个月前';
}
function esc(s) {
  return String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({ '&': '&', '<': '<', '>': '>', '"': '"', "'": '&#39;' }[c] || c));
}

const kindIcon = {
  meta: '📋', round: '🔄', synthesis: '📝', deliverable: '🎁', exportFile: '📤', other: '📄',
};
---

<BaseLayout title="Recent Edits · Agents">
  <Navbar />
  <main class="shell agents-shell">
    <nav class="agents-breadcrumb">
      <a href={`${base}/agents/`}>← 多智能体控制台</a>
      <span class="muted"> / recent</span>
    </nav>

    <header class="agents-header">
      <h1>🕐 Recent Edits <span class="muted" style="font-size:0.6em">(iter #115)</span></h1>
      <p class="agents-sub">
        列出 archive/ 里按 mtime 倒序的所有文件,按时间窗口(24h / 72h / 7d / 30d)分组。
      </p>
    </header>

    <section class="agents-session-section">
      <h2>📊 总览</h2>
      <div class="agents-rc-stats">
        <span>总文件: <strong>{files.length}</strong></span>
        {grouped.map((g) => (
          <span>{g.label.replace(/^[^\s]+ /, '')}: <strong>{g.files.length}</strong></span>
        ))}
      </div>
    </section>

    {grouped.map((g) => (
      <section class="agents-session-section">
        <h2>{g.label} <span class="muted" style="font-size:0.7em">({g.files.length} 文件)</span></h2>
        {g.files.length === 0 ? (
          <p class="muted">这个时间窗口内没有修改。</p>
        ) : (
          <table class="agents-session-table">
            <thead>
              <tr><th>kind</th><th>session</th><th>path</th><th>size</th><th>mtime</th></tr>
            </thead>
            <tbody>
              {g.files.slice(0, 50).map((f) => {
                let href = `${base}/agents/${f.sid}/`;
                if (f.kind === 'round') {
                  const m = f.rel.match(/round_(\d+)\.json/);
                  if (m) href = `${base}/agents/${f.sid}/pipeline/#round-${m[1]}`;
                } else if (f.kind === 'synthesis') {
                  const m = f.rel.match(/synthesis_(\d+)\.md/);
                  if (m) href = `${base}/agents/${f.sid}/synthesis/${m[1].padStart(3, '0')}/`;
                } else if (f.kind === 'deliverable') {
                  href = `${base}/agents/${f.sid}/deliverables/`;
                }
                return (
                  <tr>
                    <td>{kindIcon[f.kind] || '📄'}</td>
                    <td><a href={`${base}/agents/${f.sid}/`}><code>{esc(f.sid)}</code></a></td>
                    <td><a href={href}><small><code>{esc(f.rel)}</code></small></a></td>
                    <td><small>{fmtBytes(f.size)}</small></td>
                    <td><small>{agoStr(f.mtime)}</small></td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        )}
        {g.files.length > 50 && (
          <p class="muted"><small>... 还有 {g.files.length - 50} 个文件未显示。</small></p>
        )}
      </section>
    ))}
  </main>
</BaseLayout>

<style>
  .agents-rc-stats {
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
  }
  .agents-rc-stats strong {
    color: #4f46e5;
    font-family: ui-monospace, monospace;
    margin: 0 0.3rem;
  }
</style>