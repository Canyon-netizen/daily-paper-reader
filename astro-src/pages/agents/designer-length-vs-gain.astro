---
// /agents/designer-length-vs-gain.astro — iter #374:Pearson(designer output length, round gain)

import { readFile, readdir } from 'node:fs/promises';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import '../../styles/agents.css';

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');

interface SessCorr {
  sid: string;
  goal: string;
  lengths: number[];
  gains: number[];
  pearson: number;
  totalRounds: number;
}

const root = join(process.cwd(), 'archive');
const sessions: SessCorr[] = [];

if (existsSync(root)) {
  const sids = await readdir(root).catch(() => []);
  for (const sid of sids) {
    const rd = join(root, sid, 'rounds');
    if (!existsSync(rd)) continue;
    const rfs = await readdir(rd).catch(() => []);
    const rNums: number[] = [];
    for (const rf of rfs) {
      const m = rf.match(/^round_(\d+)\.json$/);
      if (m) rNums.push(parseInt(m[1], 10));
    }
    if (rNums.length < 4) continue;
    rNums.sort((a, b) => a - b);

    const lengths: number[] = [];
    const scores: number[] = [];
    for (const rn of rNums) {
      try {
        const r = JSON.parse(await readFile(join(rd, `round_${rn}.json`), 'utf8'));
        let len = 0;
        // designer output: prefer designer.design field, fall back to text fields
        const ds = r.designer ?? {};
        const designStr = ds.design ?? ds.output ?? ds.text ?? ds.content ?? '';
        if (typeof designStr === 'string') len = designStr.length;
        else if (typeof designStr === 'object') len = JSON.stringify(designStr).length;
        lengths.push(len);

        const arr: number[] = [];
        for (const persona of r.feedback?.personas ?? []) {
          for (const p of persona.proposals ?? []) {
            if (typeof p.total === 'number') arr.push(p.total);
          }
        }
        scores.push(arr.length > 0 ? arr.reduce((a, b) => a + b, 0) / arr.length : 0);
      } catch (e) { /* */ }
    }
    if (lengths.length < 4) continue;

    const gains: number[] = [];
    for (let i = 1; i < scores.length; i++) gains.push(scores[i] - scores[i - 1]);

    // Pearson
    const n = Math.min(lengths.length - 1, gains.length);
    if (n < 3) continue;
    const xs = lengths.slice(0, n);
    const ys = gains;
    const mx = xs.reduce((s, v) => s + v, 0) / n;
    const my = ys.reduce((s, v) => s + v, 0) / n;
    let num = 0;
    let dx = 0;
    let dy = 0;
    for (let i = 0; i < n; i++) {
      num += (xs[i] - mx) * (ys[i] - my);
      dx += (xs[i] - mx) ** 2;
      dy += (ys[i] - my) ** 2;
    }
    const pearson = dx > 0 && dy > 0 ? num / Math.sqrt(dx * dy) : 0;

    let goal = '';
    const mp = join(root, sid, 'meta.json');
    if (existsSync(mp)) {
      try { goal = JSON.parse(await readFile(mp, 'utf8')).goal ?? ''; } catch (e) { /* */ }
    }
    sessions.push({ sid, goal, lengths, gains, pearson, totalRounds: rNums.length });
  }
}

sessions.sort((a, b) => b.pearson - a.pearson);

const total = sessions.length;
const positive = sessions.filter((s) => s.pearson > 0.3).length;
const negative = sessions.filter((s) => s.pearson < -0.3).length;
const neutral = sessions.length - positive - negative;

const allPearsons = sessions.map((s) => s.pearson);
const avgPearson = allPearsons.length > 0 ? allPearsons.reduce((s, v) => s + v, 0) / allPearsons.length : 0;

function sparkline(arr: number[], width = 14): string {
  if (arr.length === 0) return '·'.repeat(width);
  const chars = ['▁', '▂', '▃', '▄', '▅', '▆', '▇', '█'];
  const out: string[] = [];
  const lo = Math.min(...arr);
  const hi = Math.max(...arr);
  const range = hi - lo || 1;
  for (let i = 0; i < width; i++) {
    const idx = Math.floor((i / (width - 1)) * (arr.length - 1));
    const v = arr[Math.max(0, Math.min(arr.length - 1, idx))];
    const ratio = (v - lo) / range;
    out.push(chars[Math.min(chars.length - 1, Math.floor(ratio * (chars.length - 1)))]);
  }
  return out.join('');
}

function esc(s: any): string {
  const str = String(s == null ? '' : s);
  return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}
---

<BaseLayout title="Designer Length vs Gain · Agents">
  <Navbar />
  <main class="shell agents-shell">
    <nav class="agents-breadcrumb">
      <a href={`${base}/agents/`}>← 多智能体控制台</a>
      <span class="muted"> / designer-length-vs-gain</span>
    </nav>

    <header class="agents-header">
      <h1>📏 Designer Length vs Gain <span class="muted" style="font-size:0.6em">(iter #374)</span></h1>
      <p class="agents-sub">
        每 session:designer 输出字符长度 vs round-to-round gain 的 Pearson。
        正相关 = 长 designer 输出带来更大 gain;负相关 = 越长越糟。
      </p>
    </header>

    <section class="agents-session-section">
      <h2>📊 全局</h2>
      <div class="agents-dlvg-globals">
        <span>sessions analyzed: <strong>{total}</strong></span>
        <span>avg pearson: <strong>{avgPearson.toFixed(3)}</strong></span>
        <span>positive (&gt;0.3): <strong style="color:#10b981">{positive}</strong></span>
        <span>negative (&lt;-0.3): <strong style="color:#ef4444">{negative}</strong></span>
        <span>neutral: <strong>{neutral}</strong></span>
      </div>
    </section>

    <section class="agents-session-section">
      <h2>📈 Top 15 most positive correlation</h2>
      <table class="agents-session-table">
        <thead>
          <tr><th>sid</th><th>pearson</th><th>rounds</th><th>lengths</th><th>gains</th><th>goal</th></tr>
        </thead>
        <tbody>
          {sessions.slice(0, 15).map((s) => (
            <tr>
              <td><a href={`${base}/agents/${s.sid}/`}><code>{esc(s.sid.slice(0, 8))}</code></a></td>
              <td><strong style="color:#10b981">{s.pearson.toFixed(3)}</strong></td>
              <td>{s.totalRounds}</td>
              <td><code style="font-size:0.7em">{sparkline(s.lengths, 10)}</code></td>
              <td><code style="font-size:0.7em">{sparkline(s.gains, 10)}</code></td>
              <td><small class="muted">{esc(s.goal.slice(0, 14))}{s.goal.length > 14 ? '…' : ''}</small></td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="agents-session-section">
      <h2>📉 Top 15 most negative correlation</h2>
      <table class="agents-session-table">
        <thead>
          <tr><th>sid</th><th>pearson</th><th>rounds</th><th>lengths</th><th>gains</th><th>goal</th></tr>
        </thead>
        <tbody>
          {sessions.slice().reverse().slice(0, 15).map((s) => (
            <tr>
              <td><a href={`${base}/agents/${s.sid}/`}><code>{esc(s.sid.slice(0, 8))}</code></a></td>
              <td><strong style="color:#ef4444">{s.pearson.toFixed(3)}</strong></td>
              <td>{s.totalRounds}</td>
              <td><code style="font-size:0.7em">{sparkline(s.lengths, 10)}</code></td>
              <td><code style="font-size:0.7em">{sparkline(s.gains, 10)}</code></td>
              <td><small class="muted">{esc(s.goal.slice(0, 14))}{s.goal.length > 14 ? '…' : ''}</small></td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="agents-session-section">
      <h2>💡 解读</h2>
      <ul>
        <li>正相关 session:designer 写得越长,后续 gain 越大</li>
        <li>负相关 session:designer 输出越冗长反而越糟(可能 verbosity 拖垮评分)</li>
        <li>对照 <a href={`${base}/agents/designer-output-length/`}>Designer Output Length</a></li>
        <li>对照 <a href={`${base}/agents/designer-edit-magnitude/`}>Designer Edit Magnitude</a></li>
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .agents-dlvg-globals {
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
  }
  .agents-dlvg-globals strong {
    color: #4f46e5;
    font-family: ui-monospace, monospace;
    margin: 0 0.3rem;
  }
</style>