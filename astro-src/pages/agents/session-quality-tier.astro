---
// /agents/session-quality-tier.astro — iter #351:S/A/B/C/D tier per session
//
// 综合: gain + cost efficiency + consistency
//   S = high gain + low cost + steady
//   A = 较好
//   B = 中等
//   C = 较差
//   D = 退步 / 高成本

import { readFile, readdir } from 'node:fs/promises';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import '../../styles/agents.css';

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');

interface SessTier {
  sid: string;
  goal: string;
  gain: number;
  totalCost: number;
  totalRounds: number;
  scoreVolatility: number;
  gainZ: number;
  costZ: number;
  volZ: number;
  score: number;
  tier: 'S' | 'A' | 'B' | 'C' | 'D';
}

const root = join(process.cwd(), 'archive');
const sessions: SessTier[] = [];

if (existsSync(root)) {
  const sids = await readdir(root).catch(() => []);
  for (const sid of sids) {
    const rd = join(root, sid, 'rounds');
    if (!existsSync(rd)) continue;
    const rfs = await readdir(rd).catch(() => []);
    const rNums: number[] = [];
    for (const rf of rfs) {
      const m = rf.match(/^round_(\d+)\.json$/);
      if (m) rNums.push(parseInt(m[1], 10));
    }
    if (rNums.length < 2) continue;
    rNums.sort((a, b) => a - b);

    const scores: number[] = [];
    let totalCost = 0;
    for (const rn of rNums) {
      try {
        const r = JSON.parse(await readFile(join(rd, `round_${rn}.json`), 'utf8'));
        const arr: number[] = [];
        for (const persona of r.feedback?.personas ?? []) {
          for (const p of persona.proposals ?? []) {
            if (typeof p.total === 'number') arr.push(p.total);
          }
        }
        if (arr.length > 0) scores.push(arr.reduce((a, b) => a + b, 0) / arr.length);
        if (typeof r.cost === 'number') totalCost += r.cost;
        if (typeof r.tokens === 'number') totalCost += r.tokens;
        if (r.usage) totalCost += (r.usage.input_tokens ?? 0) + (r.usage.output_tokens ?? 0);
      } catch (e) { /* */ }
    }
    if (scores.length < 2) continue;
    const gain = scores[scores.length - 1] - scores[0];

    // volatility = stdev of gains
    const gains: number[] = [];
    for (let i = 1; i < scores.length; i++) gains.push(scores[i] - scores[i - 1]);
    const gm = gains.reduce((s, v) => s + v, 0) / gains.length;
    const vol = Math.sqrt(gains.reduce((s, v) => s + (v - gm) ** 2, 0) / Math.max(1, gains.length - 1));

    let goal = '';
    const mp = join(root, sid, 'meta.json');
    if (existsSync(mp)) {
      try { goal = JSON.parse(await readFile(mp, 'utf8')).goal ?? ''; } catch (e) { /* */ }
    }

    sessions.push({
      sid, goal,
      gain, totalCost,
      totalRounds: scores.length,
      scoreVolatility: vol,
      gainZ: 0, costZ: 0, volZ: 0, // filled below
      score: 0, tier: 'B',
    });
  }
}

function meanStd(arr: number[]): { mean: number; std: number } {
  const m = arr.reduce((s, v) => s + v, 0) / Math.max(1, arr.length);
  const sd = Math.sqrt(arr.reduce((s, v) => s + (v - m) ** 2, 0) / Math.max(1, arr.length));
  return { mean: m, std: sd };
}

function zScore(v: number, m: number, sd: number): number {
  return sd > 0 ? (v - m) / sd : 0;
}

const gains = sessions.map((s) => s.gain);
const costs = sessions.map((s) => s.totalCost);
const vols = sessions.map((s) => s.scoreVolatility);

const gStats = meanStd(gains);
const cStats = meanStd(costs);
const vStats = meanStd(vols);

for (const s of sessions) {
  s.gainZ = zScore(s.gain, gStats.mean, gStats.std);
  s.costZ = zScore(s.totalCost, cStats.mean, cStats.std);
  s.volZ = zScore(s.scoreVolatility, vStats.mean, vStats.std);
  // Higher = better
  s.score = s.gainZ - s.costZ - s.volZ;
}

sessions.sort((a, b) => b.score - a.score);

// Tier thresholds
const scores = sessions.map((s) => s.score);
const sorted = [...scores].sort((a, b) => a - b);
const p20 = sorted[Math.floor(sorted.length * 0.20)];
const p40 = sorted[Math.floor(sorted.length * 0.40)];
const p60 = sorted[Math.floor(sorted.length * 0.60)];
const p80 = sorted[Math.floor(sorted.length * 0.80)];

for (const s of sessions) {
  if (s.score >= p80) s.tier = 'S';
  else if (s.score >= p60) s.tier = 'A';
  else if (s.score >= p40) s.tier = 'B';
  else if (s.score >= p20) s.tier = 'C';
  else s.tier = 'D';
}

const tierCounts: Record<string, number> = { S: 0, A: 0, B: 0, C: 0, D: 0 };
for (const s of sessions) tierCounts[s.tier] += 1;

function bar(n: number, max: number, width = 22): string {
  if (!max) return '░'.repeat(width);
  const filled = Math.round((n / max) * width);
  return '█'.repeat(filled) + '░'.repeat(width - filled);
}

function fmt(n: number): string {
  if (n > 1000) return `${(n / 1000).toFixed(1)}K`;
  return n.toFixed(0);
}

function esc(s: any): string {
  const str = String(s == null ? '' : s);
  return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}
---

<BaseLayout title="Session Quality Tier · Agents">
  <Navbar />
  <main class="shell agents-shell">
    <nav class="agents-breadcrumb">
      <a href={`${base}/agents/`}>← 多智能体控制台</a>
      <span class="muted"> / session-quality-tier</span>
    </nav>

    <header class="agents-header">
      <h1>🏅 Session Quality Tier <span class="muted" style="font-size:0.6em">(iter #351)</span></h1>
      <p class="agents-sub">
        综合 score = z(gain) - z(cost) - z(volatility)。
        S/A/B/C/D 5 档(基于 quintile 切分)。
      </p>
    </header>

    <section class="agents-session-section">
      <h2>📊 Tier 分布</h2>
      <pre class="agents-sqt-flow">{(['S', 'A', 'B', 'C', 'D'] as const).map((t) => {
        const c = tierCounts[t] ?? 0;
        const pct = sessions.length > 0 ? ((c / sessions.length) * 100).toFixed(1) : '0.0';
        return `${t.padEnd(4)} ${bar(c, Math.max(...Object.values(tierCounts), 1), 22)}  ${c.toString().padStart(4)} (${pct}%)`;
      }).join('\n')}</pre>
    </section>

    <section class="agents-session-section">
      <h2>🏆 Top 10 S-tier sessions</h2>
      <table class="agents-session-table">
        <thead>
          <tr><th>#</th><th>tier</th><th>sid</th><th>gain</th><th>cost</th><th>vol</th><th>score</th><th>goal</th></tr>
        </thead>
        <tbody>
          {sessions.filter((s) => s.tier === 'S').slice(0, 10).map((s, i) => (
            <tr>
              <td>{i + 1}</td>
              <td><strong style="color:#fbbf24;font-size:1.2em">{s.tier}</strong></td>
              <td><a href={`${base}/agents/${s.sid}/`}><code>{esc(s.sid.slice(0, 10))}</code></a></td>
              <td>{s.gain.toFixed(2)}</td>
              <td>{fmt(s.totalCost)}</td>
              <td>{s.scoreVolatility.toFixed(3)}</td>
              <td><strong style="color:#10b981">{s.score.toFixed(2)}</strong></td>
              <td><small class="muted">{esc(s.goal.slice(0, 18))}{s.goal.length > 18 ? '…' : ''}</small></td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="agents-session-section">
      <h2>💀 Bottom 8 D-tier sessions</h2>
      <table class="agents-session-table">
        <thead>
          <tr><th>#</th><th>tier</th><th>sid</th><th>gain</th><th>cost</th><th>score</th><th>goal</th></tr>
        </thead>
        <tbody>
          {sessions.filter((s) => s.tier === 'D').slice(0, 8).map((s, i) => (
            <tr>
              <td>{i + 1}</td>
              <td><strong style="color:#ef4444;font-size:1.2em">{s.tier}</strong></td>
              <td><a href={`${base}/agents/${s.sid}/`}><code>{esc(s.sid.slice(0, 10))}</code></a></td>
              <td><strong style="color:#ef4444">{s.gain.toFixed(2)}</strong></td>
              <td>{fmt(s.totalCost)}</td>
              <td><strong style="color:#ef4444">{s.score.toFixed(2)}</strong></td>
              <td><small class="muted">{esc(s.goal.slice(0, 18))}{s.goal.length > 18 ? '…' : ''}</small></td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="agents-session-section">
      <h2>💡 解读</h2>
      <ul>
        <li>S-tier = 高 gain + 低 cost + 低 volatility(系统对这类 session 处理很好)</li>
        <li>D-tier = 系统在该 session 上"事倍功半"</li>
        <li>tier 分布用于质量监控</li>
        <li>对照 <a href={`${base}/agents/top-improvers/`}>Top Improvers</a></li>
        <li>对照 <a href={`${base}/agents/cost-per-score-point/`}>Cost Per Score Point</a></li>
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .agents-sqt-flow {
    background: rgba(0,0,0,0.4);
    color: #c9d1d9;
    padding: 0.8rem;
    border-radius: 4px;
    font-family: ui-monospace, "JetBrains Mono", monospace;
    font-size: 0.78rem;
    line-height: 1.4;
    overflow-x: auto;
    white-space: pre;
  }
</style>