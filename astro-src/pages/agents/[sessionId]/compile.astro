---
// /agents/[sessionId]/compile.astro — iter #62: browser-side paper compile page.
//
// iter #61 给 CLI 加了 --compile-paper,把 session 碎片装配成可编译 LaTeX + markdown + .bib;
// 本页是它的浏览器版本 —— 用户在 /agents/<sid>/compile/ 直接看 PaperDraft 实时渲染,
// 切 LaTeX / markdown 格式预览,Download 三个文件。
//
// 设计:
//   - 与 export.astro (iter #58) 同模式:SSR 列所有有 meta 的 session,
//     客户端 import 同一份 paper-compiler.mjs(保证与 CLI 字节级一致)
//   - 数据源:localStorage 优先(round 由浏览器跑过);fallback 到 CLI 提示
//   - 格式切换:format 按钮组(latex / markdown / bib),实时重新渲染
//   - Download:3 个文件各自独立下载(trigger <a download> blob)
//
// 注:此页本身不写文件,不调 LLM,纯 SSR + client-side script。

import { readFile, readdir } from 'node:fs/promises';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navbar from '../../../components/Navbar.astro';
import '../../../styles/agents.css';

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');

// ---------------------------------------------------------------------------
// getStaticPaths:enumerate sessions under archive/ that have meta.json
// ---------------------------------------------------------------------------

export async function getStaticPaths() {
  const root = join(process.cwd(), 'archive');
  if (!existsSync(root)) return [];
  const out: { params: { sessionId: string }; props: { hasArchive: boolean } }[] = [];
  let sessions: string[] = [];
  try { sessions = await readdir(root); } catch { return []; }
  for (const sid of sessions) {
    const metaPath = join(root, sid, 'meta.json');
    if (existsSync(metaPath)) out.push({ params: { sessionId: sid }, props: { hasArchive: true } });
  }
  return out;
}

const { sessionId } = Astro.params;
const { hasArchive } = Astro.props;
---

<BaseLayout title={`Compile ${sessionId} — Agents`}>
  <Navbar />
  <main class="shell agents-shell">
    <nav class="agents-breadcrumb">
      <a href={`${base}/agents/`}>← Agents Console</a>
      <span class="agents-breadcrumb-sep">/</span>
      <a href={`${base}/agents/${sessionId}/`}>{sessionId}</a>
      <span class="agents-breadcrumb-sep">/</span>
      <span>compile</span>
    </nav>

    <header class="agents-header">
      <h1>📄 Compile session <code>{sessionId}</code></h1>
      <p class="agents-sub">
        把 3 智能体循环撒下的碎片 markdown 装配成一篇论文 —— 与 CLI <code>--compile-paper</code> 同实现,
        实时预览 LaTeX / markdown / .bib,一键下载 3 个文件。
      </p>
    </header>

    <section class="agents-stats">
      <div class="agents-stats-row">
        <span class="agents-stat"><strong id="compile-rounds">0</strong> rounds</span>
        <span class="agents-stat"><strong id="compile-deliverables">0</strong> deliverables</span>
        <span class="agents-stat"><strong id="compile-references">0</strong> references</span>
        <span class="agents-stat"><strong id="compile-sections">0</strong> / 5 sections</span>
        <span class="agents-stat" id="compile-source-tag"></span>
      </div>
    </section>

    <section class="agents-controls">
      <div class="agents-controls-row">
        <label class="agents-controls-label">
          <span>format</span>
          <select id="compile-format">
            <option value="latex">LaTeX (paper.tex)</option>
            <option value="markdown">Markdown (paper.md)</option>
            <option value="bib">BibTeX (refs.bib)</option>
          </select>
        </label>
        <label class="agents-controls-label">
          <span>document class</span>
          <select id="compile-class">
            <option value="article">article (default)</option>
            <option value="acmart">acmart (ACM)</option>
            <option value="ieeeconf">IEEE conference</option>
            <option value="iclr2026">iclr2026 (placeholder)</option>
          </select>
        </label>
        <button class="button primary" id="compile-download-btn" title="下载当前格式(以及附加的 .tex+.bib 套件)">
          ⬇️ Download
        </button>
        <button class="button" id="compile-copy-btn" title="把当前预览内容写到剪贴板">
          📋 Copy
        </button>
        <button class="button" id="compile-refresh-btn" title="重新读取 localStorage 重建 PaperDraft">
          🔄 Refresh
        </button>
        <a class="button" href={`${base}/agents/${sessionId}/`} title="回到 session 详情">← Back</a>
      </div>
    </section>

    <section class="agents-export-section">
      <h3 id="compile-preview-title">LaTeX preview</h3>
      <p id="compile-empty-warn" class="agents-help-warn" hidden>
        ⚠️ 本 session 没有任何 localStorage round 或 archive deliverable,PaperDraft 是空的(只有 introduction 章节)。
        用 CLI 跑几轮: <code>node astro-src/scripts/agents-run.mjs --session {sessionId} --rounds 3</code>
      </p>
      <textarea id="compile-preview-area" rows="28" placeholder="点 🔄 Refresh 装配 PaperDraft" readonly></textarea>
    </section>

    <section class="agents-help">
      <h3>💡 CLI 等价命令</h3>
      <p>在仓库根目录运行(产出 archive/&lt;sid&gt;/paper/ 整套):</p>
      <pre><code>node astro-src/scripts/agents-run.mjs --session {sessionId} --compile-paper</code></pre>
      <p>或只导出 markdown / LaTeX / JSON:</p>
      <pre><code>node astro-src/scripts/agents-run.mjs --session {sessionId} --compile-paper --paper-format markdown
node astro-src/scripts/agents-run.mjs --session {sessionId} --compile-paper --paper-format latex
node astro-src/scripts/agents-run.mjs --session {sessionId} --compile-paper --json</code></pre>
      <p>下载后可编译:<code>cd archive/&lt;sid&gt;/paper &amp;&amp; pdflatex paper.tex</code> (含中文改用 xelatex + 取消 <code>ctex</code> 注释)</p>
    </section>

    <section class="agents-help">
      <h3>📚 这是什么?</h3>
      <p>iter #61 引入 <code>--compile-paper</code> CLI(iter #61 <code>lib/agents/paper-compiler.{mjs,ts}</code>),
        把 <code>archive/&lt;sid&gt;/{drafts,reviews,experiments,paper_additions,rebuttals}/</code> + <code>synthesis/</code>
        按 deliverable kind 路由到 5 个标准论文章节(Intro / Related Work / Method / Results / Limitations),
        装上 LaTeX / markdown / .bib。</p>
      <p>本页面(iter #62)把同一份 paper-compiler 实现搬到浏览器:</p>
      <ul>
        <li>数据源:localStorage 优先(round 由浏览器跑过),fallback 到空 PaperDraft + 提示</li>
        <li>实时切换 LaTeX / markdown / .bib 三种格式预览</li>
        <li>下载按钮触发浏览器 &lt;a download&gt;,文件名 &lt;sid&gt;-paper.{tex|md|bib}</li>
        <li>document class 选择器控制 LaTeX 模板(article / acmart / ieeeconf / iclr2026 占位)</li>
        <li>与 CLI 端 字节级一致 —— 同一份 buildPaperDraft / formatPaperLatex / formatPaperMarkdown / formatBibtex</li>
      </ul>
      <p class={hasArchive ? '' : 'agents-help-warn'}>
        {hasArchive
          ? '✓ 检测到 server 端 archive/' + sessionId + '/;但浏览器读不到文件系统 —— 仍需先在浏览器跑 round 或用 CLI 导出 archive。'
          : '⚠ Server 端无 archive/' + sessionId + '/;依赖 localStorage 中的 round。'}
      </p>
    </section>
  </main>

  <script id="session-id-data" type="application/json" set:html={JSON.stringify({ sessionId, hasArchive })}></script>

  <script>
    /* eslint-disable */
    // -----------------------------------------------------------------------
    // 客户端 paper compile — iter #62
    // -----------------------------------------------------------------------
    //
    // 与 export.astro (iter #58) 同结构:从同一份 paper-compiler.mjs 导入纯函数,
    // 保证与 CLI 端 --compile-paper 输出字节级一致。
    //
    // 关键差异:
    //   - 数据源只有 localStorage(浏览器跑的 round),因为浏览器读不到文件系统
    //   - deliverables 也不存 localStorage(只有 round),所以 PaperDraft 的章节
    //     只来自 round 里的 proposal.type 元数据,而非实际 deliverable 文本。
    //     这是 iter #62 的已知限制:浏览器版 = 章节骨架(无完整正文),CLI 版 = 完整装配
    //   - 用户在 round 里跑出 proposal 后,本页能展示章节结构 + 统计,
    //     但要看具体 deliverable 正文需切到 round 详情页或用 CLI
    //
    // 未来增强(iter #62+):如果 session 有 archive/,尝试 fetch SSR 内联的 deliverables JSON
    // -----------------------------------------------------------------------

    const sessionIdMeta = JSON.parse(document.getElementById('session-id-data').textContent);
    const sessionId = sessionIdMeta.sessionId;
    const hasArchive = sessionIdMeta.hasArchive;

    const ROUNDS_KEY = (sid) => `dpr_agents_rounds_${sid}`;
    const META_KEY = (sid) => `dpr_agents_meta_${sid}`;

    import {
      PAPER_SECTIONS,
      buildPaperDraft,
      formatPaperLatex,
      formatPaperMarkdown,
      formatBibtex,
    } from '../../../../lib/agents/paper-compiler.mjs';

    // -----------------------------------------------------------------------
    // 数据源:localStorage 优先(浏览器跑的 round),fallback 到空 + 提示
    // -----------------------------------------------------------------------

    function readLocalMeta() {
      try {
        const raw = localStorage.getItem(META_KEY(sessionId));
        if (!raw) return null;
        return JSON.parse(raw);
      } catch { return null; }
    }
    function readLocalRounds() {
      try {
        const raw = localStorage.getItem(ROUNDS_KEY(sessionId));
        if (!raw) return [];
        return JSON.parse(raw);
      } catch { return []; }
    }

    /**
     * 从 localStorage round 抽出"伪 deliverable" entries
     *
     * iter #62 限制:浏览器侧没有 deliverable 正文(只有 round JSON 里的 proposal 元数据),
     * 所以我们根据 proposal.type + decision 把每个 promoted/candidate proposal 假装成
     * 一份 deliverable,放进对应章节。这样能展示章节路由 + 引文 + 统计,
     * 但章节内容是 proposal.rationale 而非完整 deliverable 正文。
     *
     * CLI 版用 archive/<sid>/{drafts,reviews,...}/*.md 真实 deliverable —— 更丰富。
     * 这里走"最小可用的章节装配",用户能在浏览器里看"这篇论文会怎么组织"。
     */
    function extractDeliverableLikeFromRounds(rounds) {
      const out = [];
      for (const r of rounds ?? []) {
        for (const p of r?.designer?.proposals ?? []) {
          // 决定 kind:proposal.type 是 5 个 ProposalType 值,正好和 DELIVERABLE_DIRS 1-1 映射
          const kind = p.type ?? 'draft';
          if (!['draft', 'review', 'experiment', 'paper_addition', 'rebuttal'].includes(kind)) continue;
          const title = p.title ?? '(untitled)';
          const body = [
            `### ${title}`,
            '',
            `**Type:** \`${kind}\` · **Decision:** \`${p.decision ?? 'unknown'}\` · **Round ${r.round}**`,
            '',
            '**Rationale**',
            '',
            p.rationale ?? '_(no rationale provided)_',
            '',
            '**Evidence**',
            '',
            (p.evidence?.paperIds ?? []).length
              ? (p.evidence.paperIds.map((id) => `- ${id}`).join('\n'))
              : '- (no paperIds cited)',
            '',
            '**Risk**',
            '',
            p.risk ?? '_(unstated)_',
            '',
            '_注:这是浏览器侧"伪 deliverable",由 localStorage round JSON 合成。',
            '完整 deliverable 正文(Modifier 写的 drafts/reviews/etc)需在 CLI 端 `node agents-run.mjs --compile-paper` 才会出现在 PaperDraft 里。_',
          ].join('\n');
          out.push({
            kind,
            round: r.round,
            idx: out.filter((x) => x.kind === kind && x.round === r.round).length,
            raw: [
              '---',
              `title: "${title.replace(/"/g, '\\"')}"`,
              `type: ${kind}`,
              `decision: ${p.decision ?? 'unknown'}`,
              `session_id: "${sessionId}"`,
              `round: ${r.round}`,
              '---',
              '',
              `# ${title}`,
              '',
              body,
            ].join('\n'),
          });
        }
      }
      return out;
    }

    function buildCurrentDraft() {
      const meta = readLocalMeta();
      const rounds = readLocalRounds();
      const deliverables = extractDeliverableLikeFromRounds(rounds);
      const source = rounds.length > 0
        ? `localStorage (${rounds.length} round${rounds.length === 1 ? '' : 's'}, browser-synthesized)`
        : 'empty (no localStorage rounds; run a round first)';
      const draft = buildPaperDraft({
        meta,
        rounds,
        deliverables,
        syntheses: [],  // browser 侧没存 synthesis
        generatedAt: new Date().toISOString(),
      });
      return { draft, source };
    }

    function renderStats(draft, source) {
      document.getElementById('compile-rounds').textContent = String(draft.stats.rounds);
      document.getElementById('compile-deliverables').textContent = String(draft.stats.deliverables);
      document.getElementById('compile-references').textContent = String(draft.stats.references);
      document.getElementById('compile-sections').textContent = String(draft.stats.sectionsWithContent);
      const tag = document.getElementById('compile-source-tag');
      tag.textContent = `source: ${source}${hasArchive ? ' (server has archive)' : ' (no server archive)'}`;
      // 空 PaperDraft 提示
      const warn = document.getElementById('compile-empty-warn');
      if (draft.stats.rounds === 0) warn.hidden = false;
      else warn.hidden = true;
    }

    function getCurrentFormat() {
      return /** @type {HTMLSelectElement} */ (document.getElementById('compile-format')).value;
    }
    function getCurrentClass() {
      return /** @type {HTMLSelectElement} */ (document.getElementById('compile-class')).value;
    }

    function renderPreview(draft, format, docClass) {
      const title = document.getElementById('compile-preview-title');
      const ta = /** @type {HTMLTextAreaElement} */ (document.getElementById('compile-preview-area'));
      if (format === 'latex') {
        title.textContent = `LaTeX preview (\\documentclass{${docClass}})`;
        ta.value = formatPaperLatex(draft, { documentclass: docClass });
      } else if (format === 'markdown') {
        title.textContent = 'Markdown preview (paper.md)';
        ta.value = formatPaperMarkdown(draft);
      } else {
        title.textContent = 'BibTeX preview (refs.bib)';
        ta.value = formatBibtex(draft.bibliography);
      }
    }

    function downloadFile(filename, content, mime) {
      const blob = new Blob([content], { type: `${mime};charset=utf-8` });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;
      a.style.display = 'none';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      setTimeout(() => URL.revokeObjectURL(url), 1000);
    }

    async function copyToClipboard(text) {
      try {
        await navigator.clipboard.writeText(text);
        return true;
      } catch (err) {
        console.warn('clipboard write failed:', err);
        return false;
      }
    }

    // -----------------------------------------------------------------------
    // Wire UI
    // -----------------------------------------------------------------------

    let lastDraft = null;
    let lastText = '';

    document.getElementById('compile-format').addEventListener('change', () => {
      if (!lastDraft) return;
      renderPreview(lastDraft, getCurrentFormat(), getCurrentClass());
    });
    document.getElementById('compile-class').addEventListener('change', () => {
      if (!lastDraft) return;
      // document class 只对 LaTeX 生效
      if (getCurrentFormat() === 'latex') {
        renderPreview(lastDraft, 'latex', getCurrentClass());
      }
    });

    document.getElementById('compile-download-btn').addEventListener('click', () => {
      if (!lastDraft) return;
      const sid = sessionId;
      // 一次下载 3 个文件(LaTeX + BibTeX + Markdown),让用户能完整复刻 CLI 输出
      const format = getCurrentFormat();
      const docClass = getCurrentClass();
      const latex = formatPaperLatex(lastDraft, { documentclass: docClass });
      const md = formatPaperMarkdown(lastDraft);
      const bib = formatBibtex(lastDraft.bibliography);
      // 优先按当前 format 单文件下载;若用户想要套件,按当前 format 主文件 + 补另外两个
      if (format === 'latex') {
        downloadFile(`${sid}-paper.tex`, latex, 'text/x-tex');
      } else if (format === 'markdown') {
        downloadFile(`${sid}-paper.md`, md, 'text/markdown');
      } else {
        downloadFile(`${sid}-refs.bib`, bib, 'application/x-bibtex');
      }
      // 附加下载另外 2 个(让用户能完整复刻 CLI 套件)
      if (format === 'latex') {
        downloadFile(`${sid}-paper.md`, md, 'text/markdown');
        downloadFile(`${sid}-refs.bib`, bib, 'application/x-bibtex');
      } else if (format === 'markdown') {
        downloadFile(`${sid}-paper.tex`, latex, 'text/x-tex');
        downloadFile(`${sid}-refs.bib`, bib, 'application/x-bibtex');
      } else {
        downloadFile(`${sid}-paper.tex`, latex, 'text/x-tex');
        downloadFile(`${sid}-paper.md`, md, 'text/markdown');
      }
    });

    document.getElementById('compile-copy-btn').addEventListener('click', async () => {
      if (!lastText) return;
      const ok = await copyToClipboard(lastText);
      const btn = document.getElementById('compile-copy-btn');
      const original = btn.textContent;
      btn.textContent = ok ? '✓ Copied!' : '✗ Copy failed';
      setTimeout(() => { btn.textContent = original; }, 1500);
    });

    document.getElementById('compile-refresh-btn').addEventListener('click', () => {
      const { draft, source } = buildCurrentDraft();
      lastDraft = draft;
      renderStats(draft, source);
      renderPreview(draft, getCurrentFormat(), getCurrentClass());
      lastText = document.getElementById('compile-preview-area').value;
    });

    // Boot
    (function boot() {
      const { draft, source } = buildCurrentDraft();
      lastDraft = draft;
      renderStats(draft, source);
      renderPreview(draft, getCurrentFormat(), getCurrentClass());
      lastText = document.getElementById('compile-preview-area').value;
    })();
  </script>
</BaseLayout>
