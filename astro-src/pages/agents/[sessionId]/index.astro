---
// astro-src/pages/agents/[sessionId]/index.astro
//
// iter #43 — Session overview dashboard.
//
// Aggregates one session's archive/<sid>/{meta.json, rounds/*.json, synthesis/*.md}
// into a single page so they can see the big picture before drilling into rounds.
//
// Shows:
//   - Session header (meta)
//   - Convergence verdict (judgement: converging / stalled / fresh)
//   - 3 mini-charts: directive_count, avg score, tokens (all per cycle)
//   - Top promoted proposals table (aggregated from all rounds, deduped by id)
//   - Recent applied actions (latest 8 with deliverable links)

import { readFile, readdir } from 'node:fs/promises';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navbar from '../../../components/Navbar.astro';
import '../../../styles/agents.css';

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');

// ---------------------------------------------------------------------------
// getStaticPaths: enumerate all sessions under archive/
// ---------------------------------------------------------------------------

export async function getStaticPaths() {
  const root = join(process.cwd(), 'archive');
  if (!existsSync(root)) return [];
  let sessions: string[] = [];
  try { sessions = await readdir(root); } catch { return []; }
  const out: { params: { sessionId: string } }[] = [];
  for (const sid of sessions) {
    const metaPath = join(root, sid, 'meta.json');
    if (existsSync(metaPath)) out.push({ params: { sessionId: sid } });
  }
  return out;
}

const { sessionId } = Astro.params;

// ---------------------------------------------------------------------------
// Types (mirror RoundRecord; keep optional so old records don't crash)
// ---------------------------------------------------------------------------

interface ModifierAction {
  id: string;
  kind: string;
  proposal_id: string;
  payload: Record<string, unknown>;
  applied_at: number;
}
interface Critique { total: number; proposal_id: string; }
interface RoundRecord {
  round: number;
  started_at: number;
  finished_at: number;
  designer: { proposals: { id: string; title: string; type: string; rationale: string }[]; model: string };
  feedback: { critiques: Critique[]; judge_calls: number; total_tokens: number };
  gate: { promoted: string[]; candidate: string[]; sketch: string[]; rejected: string[] };
  modifier: { applied: ModifierAction[]; skipped: { proposal_id: string; reason: string }[] };
  telemetry?: { duration_ms: number; llm_calls: number; approx_tokens: number };
  meta: { session_id: string; dry_run: boolean };
}

interface SessionMeta {
  session_id: string;
  goal: string;
  created_at: number;
  rounds_requested?: number;
  dry_run?: boolean;
}

interface CycleStat {
  cycle: number;             // 1..N
  roundN: number;            // round_NNN.json 里的 round number
  directiveCount: number;    // 0 if no synthesis yet for that cycle
  avgScore: number;          // -1 if no critiques
  totalTokens: number;
  appliedCount: number;
  synthesisPath: string | null;
  durationMs: number;
}

// ---------------------------------------------------------------------------
// Load meta + all rounds + all syntheses
// ---------------------------------------------------------------------------

const sessionDir = join(process.cwd(), 'archive', sessionId);

let meta: SessionMeta | null = null;
try {
  meta = JSON.parse(await readFile(join(sessionDir, 'meta.json'), 'utf8')) as SessionMeta;
} catch { meta = null; }

let rounds: RoundRecord[] = [];
try {
  const files = (await readdir(join(sessionDir, 'rounds'))).filter((f) => /^round_\d+\.json$/.test(f)).sort();
  rounds = (await Promise.all(
    files.map((f) => readFile(join(sessionDir, 'rounds', f), 'utf8').then((raw) => JSON.parse(raw) as RoundRecord))
  )).sort((a, b) => a.round - b.round);
} catch { rounds = []; }

// syntheses — file basenames look like synthesis_001.md
let syntheses: { idx: number; path: string; raw: string }[] = [];
try {
  const sfiles = (await readdir(join(sessionDir, 'synthesis'))).filter((f) => /^synthesis_\d+\.md$/.test(f)).sort();
  syntheses = await Promise.all(
    sfiles.map(async (f) => {
      const m = f.match(/^synthesis_(\d+)\.md$/);
      const idx = m ? Number(m[1]) : 0;
      const path = join(sessionDir, 'synthesis', f);
      const raw = await readFile(path, 'utf8');
      return { idx, path, raw };
    }),
  );
} catch { syntheses = []; }

// ---------------------------------------------------------------------------
// Aggregate per-cycle stats
// ---------------------------------------------------------------------------

function countDirectivesInSynthesis(md: string): number {
  // 数 ## 下一步建议 + ## Gap & 矛盾 下面的 bullet
  let count = 0;
  const inSection = (headerRe: RegExp) => (s: string) => s.match(headerRe);
  const sections = md.split(/^##\s+/m);
  for (const sec of sections) {
    if (sec.startsWith('下一步建议') || sec.startsWith('Gap &') || sec.startsWith('Gaps &')) {
      // bullets + checkbox bullets
      const m = sec.match(/^[-*\s]\s+(?:\[[ x]\]\s+)?.+$/gm);
      if (m) count += m.filter((l) => !/^\s*[-*]\s+\(/.test(l) && !/^\s*[-*]\s+\(无\)/.test(l) && !/^\s*[-*]\s+\(stub/.test(l)).length;
    }
  }
  return count;
}

const cycleStats: CycleStat[] = rounds.map((r, i) => {
  // Match synthesis index i+1 → cycle i+1
  const synth = syntheses.find((s) => s.idx === i + 1) ?? null;
  const avg = r.feedback.critiques.length
    ? r.feedback.critiques.reduce((a, c) => a + c.total, 0) / r.feedback.critiques.length
    : -1;
  return {
    cycle: i + 1,
    roundN: r.round,
    directiveCount: synth ? countDirectivesInSynthesis(synth.raw) : 0,
    avgScore: avg,
    totalTokens: r.feedback.total_tokens ?? 0,
    appliedCount: r.modifier.applied.length,
    synthesisPath: synth?.path ?? null,
    durationMs: r.telemetry?.duration_ms ?? (r.finished_at - r.started_at),
  };
});

// Convergence verdict
function judgeConvergence(stats: CycleStat[]): { verdict: string; reason: string; cls: string } {
  if (stats.length === 0) return { verdict: '暂无数据', reason: '尚无 round', cls: 'muted' };
  if (stats.length === 1) return { verdict: '起步', reason: '只跑了 1 个 cycle,继续观察', cls: 'mid' };
  const dirCounts = stats.map((s) => s.directiveCount);
  const allZero = dirCounts.every((n) => n === 0);
  if (allZero) return { verdict: '已收敛', reason: '所有 cycle 均无 directive,研究目标已基本饱和', cls: 'high' };
  const last = dirCounts[dirCounts.length - 1];
  const first = dirCounts[0];
  // 单调下降(允许小幅波动)
  let decreasing = true;
  for (let i = 1; i < dirCounts.length; i++) {
    if (dirCounts[i] > dirCounts[i - 1]) { decreasing = false; break; }
  }
  if (last === 0) return { verdict: '已收敛', reason: '最近一轮无 directive,研究目标已基本饱和', cls: 'high' };
  if (decreasing) return { verdict: '收敛中', reason: `directive 数从 ${first} 单调下降至 ${last},趋势良好`, cls: 'high' };
  if (last < first) return { verdict: '部分收敛', reason: `directive 从 ${first} 降至 ${last},但中间有反弹`, cls: 'mid' };
  return { verdict: '停滞', reason: `directive 数 ${first} → ${last},无明显收敛`, cls: 'low' };
}

const convergence = judgeConvergence(cycleStats);

// Top promoted proposals (deduped by id, scored by max avg from any round)
const proposalBestScore = new Map<string, { id: string; title: string; type: string; rationale: string; bestScore: number; rounds: number[] }>();
for (const r of rounds) {
  for (const p of r.designer.proposals) {
    if (!r.gate.promoted.includes(p.id)) continue;
    const cs = r.feedback.critiques.filter((c) => c.proposal_id === p.id);
    const avg = cs.length ? cs.reduce((a, c) => a + c.total, 0) / cs.length : 0;
    const existing = proposalBestScore.get(p.id);
    if (!existing || avg > existing.bestScore) {
      proposalBestScore.set(p.id, {
        id: p.id, title: p.title, type: p.type, rationale: p.rationale,
        bestScore: avg,
        rounds: [...(existing?.rounds ?? []), r.round],
      });
    } else if (existing) {
      existing.rounds.push(r.round);
    }
  }
}
const topPromoted = [...proposalBestScore.values()]
  .sort((a, b) => b.bestScore - a.bestScore)
  .slice(0, 8);

// Recent applied (latest 8, across all rounds)
const allApplied = rounds.flatMap((r) =>
  r.modifier.applied.map((a) => ({ ...a, roundN: r.round })),
).sort((a, b) => (b.applied_at ?? 0) - (a.applied_at ?? 0)).slice(0, 8);

// ---------------------------------------------------------------------------
// iter #52 — Round comparison matrix
// ---------------------------------------------------------------------------
//
// 给定 N 个 round,两两比较:
//   - titles_jaccard = |A ∩ B| / |A ∪ B|(用 proposal 标题集合)
//   - applied_jaccard = |A.applied ∩ B.applied| / |A.applied ∪ B.applied|
//   - avg_score_delta = B.avg_score - A.avg_score
//   - elapsed_delta_ms = B.elapsed - A.elapsed
// 用 jaccard 0..1 作为相似度;1 - jaccard 作为分歧度。

interface RoundSig {
  roundN: number;
  titles: Set<string>;
  applied: Set<string>;
  avgScore: number;
  durationMs: number;
}

const roundSigs: RoundSig[] = rounds.map((r) => {
  const titles = new Set(r.designer.proposals.map((p) => p.title));
  const applied = new Set(r.modifier.applied.map((a) => a.proposal_id));
  const cs = r.feedback.critiques;
  const avg = cs.length ? cs.reduce((a, c) => a + c.total, 0) / cs.length : -1;
  return {
    roundN: r.round,
    titles,
    applied,
    avgScore: avg,
    durationMs: r.telemetry?.duration_ms ?? (r.finished_at - r.started_at),
  };
});

function jaccard(a: Set<string>, b: Set<string>): number {
  if (a.size === 0 && b.size === 0) return 1;
  let inter = 0;
  for (const x of a) if (b.has(x)) inter++;
  const uni = a.size + b.size - inter;
  return uni === 0 ? 1 : inter / uni;
}

interface PairStat {
  a: number;
  b: number;
  titleJaccard: number;
  appliedJaccard: number;
  avgScoreDelta: number | null;
  elapsedDeltaMs: number;
}

const pairStats: PairStat[] = [];
for (let i = 0; i < roundSigs.length; i++) {
  for (let j = i + 1; j < roundSigs.length; j++) {
    const A = roundSigs[i];
    const B = roundSigs[j];
    pairStats.push({
      a: A.roundN,
      b: B.roundN,
      titleJaccard: jaccard(A.titles, B.titles),
      appliedJaccard: jaccard(A.applied, B.applied),
      avgScoreDelta: A.avgScore < 0 || B.avgScore < 0 ? null : B.avgScore - A.avgScore,
      elapsedDeltaMs: B.durationMs - A.durationMs,
    });
  }
}

// 设计漂移:title_jaccard 两两的标准差(衡量研究方向的稳定性)
function stdev(xs: number[]): number {
  if (xs.length === 0) return 0;
  const mean = xs.reduce((a, b) => a + b, 0) / xs.length;
  const v = xs.reduce((a, b) => a + (b - mean) ** 2, 0) / xs.length;
  return Math.sqrt(v);
}
const designDrift = stdev(pairStats.map((p) => p.titleJaccard));
const meanJaccard = pairStats.length === 0
  ? 0
  : pairStats.reduce((a, b) => a + b.titleJaccard, 0) / pairStats.length;
const driftBucket = designDrift < 0.05 ? '稳定' : designDrift < 0.15 ? '轻微漂移' : '明显漂移';
const driftCls = designDrift < 0.05 ? 'agents-drift-low' : designDrift < 0.15 ? 'agents-drift-mid' : 'agents-drift-high';

// ---------------------------------------------------------------------------
// iter #53 — paper × persona score matrix
// ---------------------------------------------------------------------------
//
// 每行 = 出现过在本 session 任意 round evidence.paperIds 里的 paper
// 每列 = 3 个 persona (methodologist / engineer / skeptic)
// 单元格 = 所有 critique 中,proposal evidence 含该 paper 的 critique 的对应
//          persona 平均分。如果该 paper 在某 persona 列没有任何评分 → null。
//   "score_total_avg" 列: 该 paper 的所有 critique total 分平均。

interface PaperPersonaRow {
  paperId: string;
  rounds: number[];                       // 出现过的 round 列表
  proposalCount: number;                  // 该 paper 参与 proposal 的次数
  evidenceOnly: boolean;                  // true = 仅出现在 evidence,没进入 critique
  m: number | null;                       // methodologist
  e: number | null;                       // engineer
  s: number | null;                       // skeptic
  totalAvg: number | null;                // total mean
  totalSamples: number;                   // 参与 critique 总数
}

const PERSONAS = ['m', 'e', 's'] as const;

// paper_id → { rounds, proposalIds, critiqueIds }
interface PaperAgg {
  paperId: string;
  rounds: Set<number>;
  proposalIds: Set<string>;
  critiqueIds: Set<string>;
}

const paperAggMap = new Map<string, PaperAgg>();
for (const r of rounds) {
  for (const p of r.designer.proposals) {
    // 防御:rebuttal / paper_draft 等 proposal 可能没 evidence 字段
    const paperIds = Array.isArray(p.evidence?.paperIds) ? p.evidence.paperIds : [];
    for (const pid of paperIds) {
      let agg = paperAggMap.get(pid);
      if (!agg) {
        agg = { paperId: pid, rounds: new Set(), proposalIds: new Set(), critiqueIds: new Set() };
        paperAggMap.set(pid, agg);
      }
      agg.rounds.add(r.round);
      agg.proposalIds.add(p.id);
      const cr = r.feedback.critiques.find((c) => c.proposal_id === p.id);
      if (cr) agg.critiqueIds.add(cr.proposal_id);
    }
  }
}

const paperRows: PaperPersonaRow[] = [...paperAggMap.values()].map((agg) => {
  // 把该 paper 关联的所有 critique 拿过来,求各 persona 平均
  let mSum = 0, eSum = 0, sSum = 0, tSum = 0;
  let mN = 0, eN = 0, sN = 0, tN = 0;
  for (const r of rounds) {
    for (const p of r.designer.proposals) {
      if (!agg.proposalIds.has(p.id)) continue;
      const cr = r.feedback.critiques.find((c) => c.proposal_id === p.id);
      if (!cr) continue;
      const sc = cr.scores as { methodologist: number; engineer: number; skeptic: number };
      if (sc.methodologist != null) { mSum += sc.methodologist; mN++; }
      if (sc.engineer != null)     { eSum += sc.engineer;     eN++; }
      if (sc.skeptic != null)      { sSum += sc.skeptic;      sN++; }
      if (cr.total != null)        { tSum += cr.total;        tN++; }
    }
  }
  return {
    paperId: agg.paperId,
    rounds: [...agg.rounds].sort((a, b) => a - b),
    proposalCount: agg.proposalIds.size,
    evidenceOnly: agg.critiqueIds.size === 0,
    m: mN === 0 ? null : mSum / mN,
    e: eN === 0 ? null : eSum / eN,
    s: sN === 0 ? null : sSum / sN,
    totalAvg: tN === 0 ? null : tSum / tN,
    totalSamples: tN,
  };
}).sort((a, b) => {
  // totalAvg 大的在前(null 排到末尾)
  if (a.totalAvg === null && b.totalAvg === null) return a.paperId.localeCompare(b.paperId);
  if (a.totalAvg === null) return 1;
  if (b.totalAvg === null) return -1;
  return b.totalAvg - a.totalAvg;
});

// 顶部 / 底部:最看好 / 最看空(只看有 totalAvg 的,且参与 ≥1 critique)
const withScores = paperRows.filter((r) => r.totalAvg !== null && r.totalSamples > 0);
const topPicked = withScores.filter((r) => (r.totalAvg ?? 0) >= 7);
const topSkeptical = withScores.filter((r) => (r.totalAvg ?? 0) < 5);

function scoreCls(n: number | null): string {
  if (n === null) return 'agents-matrix-na';
  if (n >= 8) return 'agents-matrix-cell-high';
  if (n >= 6) return 'agents-matrix-cell-mid';
  return 'agents-matrix-cell-low';
}

// Chart geometry — SVG viewport, max values for normalization
const N = Math.max(1, cycleStats.length);
const CHART_W = Math.max(280, N * 80);
const CHART_H = 120;
const PAD = 28;
const innerW = CHART_W - PAD * 2;
const xStep = N > 1 ? innerW / (N - 1) : 0;
const maxDir = Math.max(1, ...cycleStats.map((s) => s.directiveCount));
const maxTokens = Math.max(1, ...cycleStats.map((s) => s.totalTokens));

function escapeHtml(s: string): string {
  return String(s ?? '').replace(/[&<>"']/g, (c) => ({
    '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
  }[c] ?? c));
}

function actionHref(a: { kind: string; payload: Record<string, unknown> }): string | null {
  const p = a.payload as Record<string, string>;
  if (a.kind === 'create_draft_outline' && p.writing_id) return `${base}/writing/${p.writing_id}/`;
  if (a.kind === 'archive_round_summary' && p.experiment_id) return `${base}/experiments/${p.experiment_id}/`;
  if (a.kind === 'add_paper_to_stage' && p.paper_id) return `${base}/papers/${p.paper_id}/`;
  return null;
}

// 在 JSX 模板里不能用 `.reduce<any>(...)`(泛型 <any> 会被 JSX 解析器当自定义标签),
// 抽到 helper 里避免 Astro 编译器误判。返回 any[],在 JSX 里用 {...arr} 展开渲染。
function joinJsxLinks(els: any[]): any[] {
  return els.reduce((acc: any[], el: any, i: number) => acc.concat(i > 0 ? [', '] : [], el), []);
}
---

<BaseLayout title={meta ? `${sessionId} · Session Dashboard` : 'Session Dashboard'}>
  <Navbar />
  <main class="shell agents-shell">
    <nav class="agents-breadcrumb">
      <a href={`${base}/agents/`}>← 多智能体控制台</a>
      <span class="muted"> / </span>
      <a href={`${base}/agents/auto/`}>自治模式</a>
      <span class="muted"> / {sessionId}</span>
    </nav>

    {!meta ? (
      <section class="agents-status">
        <p class="agents-status-text">⚠️ session <code>{sessionId}</code> 没有 meta.json,可能未完成 bootstrap。</p>
      </section>
    ) : (
      <>
        <header class="agents-session-header">
          <h1>📂 {escapeHtml(sessionId)}</h1>
          <p class="muted">
            goal: <strong>{escapeHtml(meta.goal)}</strong>
            · 创建于 {new Date(meta.created_at).toLocaleString()}
            {meta.rounds_requested && <span> · 计划 rounds: {meta.rounds_requested}</span>}
            {meta.dry_run && <span class="badge badge-low" style="margin-left:0.5rem">DRY-RUN</span>}
            <span class="agents-ann-badge" id="agents-ann-count-badge" data-sid={sessionId}>📝 备注 加载中…</span>
          </p>
        </header>

        <section class="agents-session-section agents-session-verdict">
          <h2>🎯 收敛判定</h2>
          <p>
            <span class={`agents-verdict-badge agents-verdict-${convergence.cls}`}>{convergence.verdict}</span>
            <span class="muted" style="margin-left:0.5rem">{convergence.reason}</span>
          </p>
        </section>

        <section class="agents-session-section">
          <h2>📈 趋势</h2>
          {cycleStats.length === 0 ? (
            <p class="muted">尚无 round 数据</p>
          ) : (
            <div class="agents-session-charts">
              <div class="agents-session-chart">
                <h3>Directives / cycle</h3>
                <svg viewBox={`0 0 ${CHART_W} ${CHART_H}`} class="agents-session-svg" role="img" aria-label="directive count per cycle">
                  <line x1={PAD} y1={CHART_H - PAD} x2={CHART_W - PAD} y2={CHART_H - PAD} stroke="#ccc" />
                  <line x1={PAD} y1={PAD} x2={PAD} y2={CHART_H - PAD} stroke="#ccc" />
                  <text x={PAD - 4} y={PAD + 4} text-anchor="end" font-size="10" fill="#666">{maxDir}</text>
                  <text x={PAD - 4} y={CHART_H - PAD + 4} text-anchor="end" font-size="10" fill="#666">0</text>
                  <polyline
                    points={cycleStats.map((s, i) => `${PAD + i * xStep},${CHART_H - PAD - (s.directiveCount / maxDir) * (CHART_H - PAD * 2)}`).join(' ')}
                    stroke="#3b82f6" stroke-width="2" fill="none"
                  />
                  {cycleStats.map((s, i) => (
                    <g key={s.cycle}>
                      <circle cx={PAD + i * xStep} cy={CHART_H - PAD - (s.directiveCount / maxDir) * (CHART_H - PAD * 2)} r="3" fill="#3b82f6" />
                      <text x={PAD + i * xStep} y={CHART_H - PAD + 14} text-anchor="middle" font-size="10" fill="#666">c{s.cycle}</text>
                    </g>
                  ))}
                </svg>
              </div>

              <div class="agents-session-chart">
                <h3>Avg score / round</h3>
                <svg viewBox={`0 0 ${CHART_W} ${CHART_H}`} class="agents-session-svg" role="img" aria-label="avg score per round">
                  <line x1={PAD} y1={CHART_H - PAD} x2={CHART_W - PAD} y2={CHART_H - PAD} stroke="#ccc" />
                  <line x1={PAD} y1={PAD} x2={PAD} y2={CHART_H - PAD} stroke="#ccc" />
                  <text x={PAD - 4} y={PAD + 4} text-anchor="end" font-size="10" fill="#666">10</text>
                  <text x={PAD - 4} y={CHART_H - PAD + 4} text-anchor="end" font-size="10" fill="#666">0</text>
                  {(() => {
                    const valid = cycleStats.filter((s) => s.avgScore >= 0);
                    if (valid.length === 0) return <text x={CHART_W / 2} y={CHART_H / 2} text-anchor="middle" font-size="11" fill="#999">无评分</text>;
                    const pts = cycleStats.map((s, i) => {
                      const score = s.avgScore < 0 ? null : s.avgScore;
                      if (score === null) return null;
                      return `${PAD + i * xStep},${CHART_H - PAD - (score / 10) * (CHART_H - PAD * 2)}`;
                    }).filter(Boolean).join(' ');
                    return <>
                      <polyline points={pts} stroke="#10b981" stroke-width="2" fill="none" />
                      {cycleStats.map((s, i) => s.avgScore >= 0 && (
                        <circle key={s.cycle} cx={PAD + i * xStep} cy={CHART_H - PAD - (s.avgScore / 10) * (CHART_H - PAD * 2)} r="3" fill="#10b981" />
                      ))}
                    </>;
                  })()}
                  {cycleStats.map((s, i) => (
                    <text key={s.cycle} x={PAD + i * xStep} y={CHART_H - PAD + 14} text-anchor="middle" font-size="10" fill="#666">r{s.roundN}</text>
                  ))}
                </svg>
              </div>

              <div class="agents-session-chart">
                <h3>Tokens / round</h3>
                <svg viewBox={`0 0 ${CHART_W} ${CHART_H}`} class="agents-session-svg" role="img" aria-label="tokens per round">
                  <line x1={PAD} y1={CHART_H - PAD} x2={CHART_W - PAD} y2={CHART_H - PAD} stroke="#ccc" />
                  <text x={PAD - 4} y={CHART_H - PAD + 4} text-anchor="end" font-size="10" fill="#666">0</text>
                  <text x={PAD - 4} y={PAD + 4} text-anchor="end" font-size="10" fill="#666">{(maxTokens / 1000).toFixed(1)}k</text>
                  {cycleStats.map((s, i) => {
                    const barH = (s.totalTokens / maxTokens) * (CHART_H - PAD * 2);
                    const x = PAD + i * xStep - 14;
                    const y = CHART_H - PAD - barH;
                    return (
                      <g key={s.cycle}>
                        <rect x={x} y={y} width="28" height={barH} fill="#a78bfa" rx="2" />
                        <text x={x + 14} y={CHART_H - PAD + 14} text-anchor="middle" font-size="10" fill="#666">r{s.roundN}</text>
                      </g>
                    );
                  })}
                </svg>
              </div>
            </div>
          )}
        </section>

        <section class="agents-session-section">
          <h2>🏆 Top promoted proposals ({topPromoted.length})</h2>
          {topPromoted.length === 0 ? (
            <p class="muted">尚无 promoted proposal</p>
          ) : (
            <table class="agents-session-table">
              <thead>
                <tr>
                  <th>Title</th>
                  <th>Type</th>
                  <th>Best avg</th>
                  <th>Rounds</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                {topPromoted.map((p) => (
                  <tr>
                    <td>
                      <strong>{escapeHtml(p.title)}</strong>
                      <br />
                      <small class="muted">{escapeHtml(p.rationale.slice(0, 100))}{p.rationale.length > 100 ? '…' : ''}</small>
                    </td>
                    <td><code>{escapeHtml(p.type)}</code></td>
                    <td>{p.bestScore.toFixed(2)}</td>
                    <td>{p.rounds.map((r) => `r${r}`).join(', ')}</td>
                    <td>
                      {p.rounds.length > 0 && (
                        <a class="button small" href={`${base}/agents/${sessionId}/${String(p.rounds[0]).padStart(3, '0')}/`}>
                          查看 r{p.rounds[0]}
                        </a>
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          )}
        </section>

        <section class="agents-session-section">
          <h2>🔁 Round Comparison Matrix (iter #52)</h2>
          <p class="muted">
            N×N 矩阵,每格是两两 round 的 proposal 标题 <strong>Jaccard 相似度</strong>
            (1=完全相同研究方向,0=完全不同)。同时给出 applied proposal 相似度 + 平均分差 + 用时差。
            <br />
            本 session 设计漂移: <span class={driftCls}>{designDrift.toFixed(3)} ({driftBucket})</span>
            · 平均 Jaccard: <code>{meanJaccard.toFixed(3)}</code>
            · pair 数: <code>{pairStats.length}</code>
          </p>
          {roundSigs.length < 2 ? (
            <p class="muted">少于 2 个 round,无法比较。</p>
          ) : (
            <div class="agents-matrix-wrapper">
              <table class="agents-matrix-table">
                <thead>
                  <tr>
                    <th class="agents-matrix-corner">r ⨯ r</th>
                    {roundSigs.map((s) => <th>r{s.roundN}</th>)}
                  </tr>
                </thead>
                <tbody>
                  {roundSigs.map((rowSig) => (
                    <tr>
                      <th>r{rowSig.roundN}</th>
                      {roundSigs.map((colSig) => {
                        if (rowSig.roundN === colSig.roundN) {
                          return <td class="agents-matrix-diag"><span class="muted">—</span></td>;
                        }
                        // 找 pair
                        const ps = pairStats.find((p) =>
                          (p.a === rowSig.roundN && p.b === colSig.roundN) ||
                          (p.a === colSig.roundN && p.b === rowSig.roundN)
                        );
                        if (!ps) return <td class="muted">?</td>;
                        const j = ps.titleJaccard;
                        const bg = `rgba(59, 130, 246, ${0.15 + j * 0.7})`;
                        const cellCls = j >= 0.7 ? 'agents-matrix-cell-high'
                                      : j >= 0.3 ? 'agents-matrix-cell-mid'
                                      : 'agents-matrix-cell-low';
                        return (
                          <td class={`agents-matrix-cell ${cellCls}`}
                              style={`background:${bg}`}
                              title={`titles ∩: ${(j * 100).toFixed(0)}%  · applied ∩: ${(ps.appliedJaccard * 100).toFixed(0)}%  · Δscore: ${ps.avgScoreDelta === null ? '—' : ps.avgScoreDelta.toFixed(2)}  · Δtime: ${(ps.elapsedDeltaMs / 1000).toFixed(1)}s`}>
                            <a href={`${base}/agents/${sessionId}/${String(rowSig.roundN).padStart(3, '0')}/`}
                               class="agents-matrix-link">{j.toFixed(2)}</a>
                          </td>
                        );
                      })}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}

          {pairStats.length > 0 && (
            <details class="agents-matrix-pair-details">
              <summary>📋 全部 pair 详情 ({pairStats.length})</summary>
              <table class="agents-session-table">
                <thead>
                  <tr>
                    <th>rA</th><th>rB</th>
                    <th>titles Jaccard</th>
                    <th>applied Jaccard</th>
                    <th>Δ avg score</th>
                    <th>Δ time</th>
                  </tr>
                </thead>
                <tbody>
                  {pairStats
                    .slice()
                    .sort((x, y) => x.titleJaccard - y.titleJaccard)
                    .map((p) => (
                      <tr>
                        <td>r{p.a}</td>
                        <td>r{p.b}</td>
                        <td>{p.titleJaccard.toFixed(3)}</td>
                        <td>{p.appliedJaccard.toFixed(3)}</td>
                        <td>{p.avgScoreDelta === null ? <span class="muted">—</span> : p.avgScoreDelta.toFixed(2)}</td>
                        <td>{(p.elapsedDeltaMs / 1000).toFixed(1)}s</td>
                      </tr>
                    ))}
                </tbody>
              </table>
              <p class="muted"><small>默认按 titles Jaccard 升序(分歧最大的在前)。</small></p>
            </details>
          )}
        </section>

        <section class="agents-session-section">
          <h2>📚 Paper × Persona Matrix (iter #53)</h2>
          <p class="muted">
            行 = 本 session 出现在任意 round <code>evidence.paperIds</code> 里的论文。
            列 = 3 个 persona。<strong>单元格</strong>是该论文关联 proposal 的 critique 中对应 persona 的平均分(0..10)。
            灰色行表示该论文仅出现在 evidence、未参与 critique。
          </p>
          {paperRows.length === 0 ? (
            <p class="muted">尚无 paper 出现在 evidence 里。</p>
          ) : (
            <>
              <div class="agents-paper-persona-wrapper">
                <table class="agents-paper-persona-table">
                  <thead>
                    <tr>
                      <th>paper</th>
                      <th>rounds</th>
                      <th>proposals</th>
                      <th title="methodologist">m</th>
                      <th title="engineer">e</th>
                      <th title="skeptic">s</th>
                      <th title="total avg (desc)">total</th>
                      <th>n</th>
                    </tr>
                  </thead>
                  <tbody>
                    {paperRows.map((r) => (
                      <tr class={r.evidenceOnly ? 'agents-paper-persona-evidence-only' : ''}>
                        <td class="agents-paper-persona-id">
                          <a href={`${base}/papers/${r.paperId}/`} target="_blank" rel="noopener">{r.paperId}</a>
                          {r.evidenceOnly && <small class="muted" title="该 paper 只出现于 evidence,未进入 critique"> (evidence-only)</small>}
                        </td>
                        <td><small>{r.rounds.length > 0 ? r.rounds.map((n) => `r${n}`).join(', ') : <span class="muted">—</span>}</small></td>
                        <td>{r.proposalCount}</td>
                        <td class={scoreCls(r.m)}>{r.m === null ? <span class="muted">—</span> : r.m.toFixed(2)}</td>
                        <td class={scoreCls(r.e)}>{r.e === null ? <span class="muted">—</span> : r.e.toFixed(2)}</td>
                        <td class={scoreCls(r.s)}>{r.s === null ? <span class="muted">—</span> : r.s.toFixed(2)}</td>
                        <td class={scoreCls(r.totalAvg)}><strong>{r.totalAvg === null ? <span class="muted">—</span> : r.totalAvg.toFixed(2)}</strong></td>
                        <td><small>{r.totalSamples}</small></td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>

              {(topPicked.length > 0 || topSkeptical.length > 0) && (
                <div class="agents-paper-persona-summary">
                  {topPicked.length > 0 && (
                    <p>
                      <span class="agents-drift-low">👍 最看好 (total ≥ 7):</span>{' '}
                      {joinJsxLinks(topPicked.map((r) => (
                        <a href={`${base}/papers/${r.paperId}/`} target="_blank" rel="noopener" class="agents-paper-link">{r.paperId}</a>
                      )))}
                    </p>
                  )}
                  {topSkeptical.length > 0 && (
                    <p>
                      <span class="agents-drift-high">👎 最看空 (total &lt; 5):</span>{' '}
                      {joinJsxLinks(topSkeptical.map((r) => (
                        <a href={`${base}/papers/${r.paperId}/`} target="_blank" rel="noopener" class="agents-paper-link">{r.paperId}</a>
                      )))}
                    </p>
                  )}
                </div>
              )}
            </>
          )}
        </section>

        <section class="agents-session-section">
          <h2>🛠 Recent applied actions ({allApplied.length})</h2>
          {allApplied.length === 0 ? (
            <p class="muted">尚无 applied action</p>
          ) : (
            <table class="agents-session-table">
              <thead>
                <tr>
                  <th>Kind</th>
                  <th>Round</th>
                  <th>Applied at</th>
                  <th>Proposal</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                {allApplied.map((a) => {
                  const href = actionHref(a);
                  const title = (a.payload?.title as string) ?? a.proposal_id;
                  return (
                    <tr>
                      <td><code>{escapeHtml(a.kind)}</code></td>
                      <td>
                        <a href={`${base}/agents/${sessionId}/${String(a.roundN).padStart(3, '0')}/`}>r{a.roundN}</a>
                      </td>
                      <td><small>{new Date(a.applied_at).toLocaleString()}</small></td>
                      <td>{escapeHtml(String(title))}</td>
                      <td>
                        {href ? <a class="button small" href={href}>查看产物</a> : <span class="muted">—</span>}
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          )}
        </section>

        <section class="agents-session-section">
          <h2>📅 Proposal Timeline</h2>
          <p class="muted">
            <a href={`${base}/agents/${sessionId}/timeline/`}>查看每个 proposal 的逐轮生命周期 →</a>
          </p>
        </section>

        <section class="agents-session-section">
          <h2>📜 Synthesis 历史</h2>
          <p class="muted">
            <a href={`${base}/agents/${sessionId}/synthesis/`}>查看全部 {syntheses.length} 份 synthesis →</a>
          </p>
        </section>

        <section class="agents-session-section">
          <h2>🔁 继续 / resume</h2>
          <p class="muted">基于当前 session 继续跑下一个 cycle,沿用 gaps 作为下轮 Designer 的 directive。</p>
          <pre class="agents-auto-cmd" tabindex="0">node astro-src/scripts/agents-run.mjs --auto "{escapeHtml(meta.goal)}" \
  --auto-resume --session {sessionId} \
  --max-cycles 1</pre>
        </section>

        <section class="agents-session-section">
          <h2>📦 导出</h2>
          <p class="muted">
            <a href={`${base}/agents/${sessionId}/export/`}>📦 浏览器下载 .md bundle / 复制到剪贴板 (iter #58) →</a>
          </p>
          <p class="muted">
            <a href={`${base}/agents/${sessionId}/compile/`}>📄 浏览器装配 LaTeX / Markdown / .bib (iter #62) →</a>
          </p>
          <p class="muted">
            <a href={`${base}/agents/${sessionId}/pdf/`}>📑 浏览器合成 PDF (打印就绪 HTML, iter #63) →</a>
          </p>
          <p class="muted">
            <a href={`${base}/agents/${sessionId}/pipeline/`}>🔬 7-stage pipeline 进度( iter #73) →</a>
          </p>
          <p class="muted">
            <a href={`${base}/agents/${sessionId}/score/`}>📊 Session 质量评分 (iter #75) →</a>
          </p>
          <p class="muted">
            <a href={`${base}/agents/${sessionId}/brief/`}>📋 Session 1 页 brief (iter #79,可复制为 markdown) →</a>
          </p>
          <p class="muted">
            <a href={`${base}/agents/${sessionId}/papers/`}>📚 Session 论文库 (iter #83,按引用次数排序) →</a>
          </p>
          <p class="muted">
            <a href={`${base}/agents/${sessionId}/deliverables/`}>🛠 Session deliverables (iter #84,Modifier 实际产出) →</a>
          </p>
          <p class="muted">
            CLI 等价:<code>node astro-src/scripts/agents-run.mjs --export-md --session {sessionId}</code>
            <br />
            <code>node astro-src/scripts/agents-run.mjs --compile-paper --session {sessionId}</code>
            <br />
            <code>node astro-src/scripts/agents-run.mjs --export-pdf --session {sessionId}</code>
            <br />
            <code>node astro-src/scripts/agents-run.mjs --full-pipeline --session {sessionId}</code>
          </p>
        </section>

        <section class="agents-session-section">
          <h2>📝 Annotations (iter #51)</h2>
          <p class="muted">
            浏览器 localStorage 备注。每轮可独立写一段 markdown,系统会保留历史版本 + 导出 JSON bundle。
          </p>
          <table class="agents-session-table" id="agents-ann-table">
            <thead>
              <tr><th>Round</th><th>备注条数</th><th>最近更新</th><th>预览</th><th></th></tr>
            </thead>
            <tbody>
              <tr><td colspan="5" class="muted">加载中…</td></tr>
            </tbody>
          </table>
          <p class="muted">
            <a href={`${base}/agents/${sessionId}/${String(rounds[0]?.round ?? 1).padStart(3, '0')}/annotations/`}>在 round 1 打开编辑器 →</a>
            <span style="margin-left:0.5rem">·</span>
            <button type="button" class="button small" id="agents-ann-export-all">📋 导出所有 round 备注 (JSON)</button>
          </p>
        </section>
      </>
    )}
  </main>
</BaseLayout>

<script>
  // iter #51 — session-level annotation count widget
  document.addEventListener('DOMContentLoaded', () => {
    const badge = document.getElementById('agents-ann-count-badge');
    const table = document.getElementById('agents-ann-table');
    const exportBtn = document.getElementById('agents-ann-export-all');
    if (!badge || !table) return;
    const sid = badge.getAttribute('data-sid') ?? '';
    const tbody = table.querySelector('tbody');

    function esc(s) {
      return String(s ?? '').replace(/[&<>"']/g, (c) => ({
        '&': '&', '<': '<', '>': '>', '"': '"', "'": '&#39;',
      }[c] ?? c));
    }

    // Enumerate known round numbers by trying common range up to 99
    const maxGuess = 99;
    const counts = new Map();
    const latest = new Map();
    const previews = new Map();

    for (let r = 1; r <= maxGuess; r++) {
      const padded = String(r).padStart(3, '0');
      const KEY = `dpr_agents_annotations_${sid}_${padded}`;
      let arr = [];
      try { arr = JSON.parse(localStorage.getItem(KEY) ?? '[]'); } catch {}
      if (arr.length === 0) continue;
      counts.set(r, arr.length);
      latest.set(r, arr[arr.length - 1].saved_at);
      previews.set(r, arr[arr.length - 1].body ?? '');
    }

    const total = [...counts.values()].reduce((a, n) => a + n, 0);
    const numRounds = counts.size;
    badge.textContent = `📝 备注 ${total} 条 / ${numRounds} 轮`;

    if (numRounds === 0) {
      tbody.innerHTML = `<tr><td colspan="5" class="muted">尚无备注。打开任一 round 详情,在右上方"📝 备注"小部件里写一条。</td></tr>`;
    } else {
      const rows = [...counts.keys()].sort((a, b) => a - b).map((r) => {
        const padded = String(r).padStart(3, '0');
        const dt = new Date(latest.get(r)).toLocaleString();
        const prev = (previews.get(r) ?? '').slice(0, 60).replace(/\n/g, ' ');
        return `<tr>
          <td>r${r}</td>
          <td>${counts.get(r)}</td>
          <td><small>${dt}</small></td>
          <td><small class="muted">${esc(prev)}${(previews.get(r) ?? '').length > 60 ? '…' : ''}</small></td>
          <td><a class="button small" href="/agents/${sid}/${padded}/annotations/">打开 →</a></td>
        </tr>`;
      }).join('');
      tbody.innerHTML = rows;
    }

    exportBtn?.addEventListener('click', () => {
      const bundle = { session: sid, exported_at: new Date().toISOString(), rounds: {} };
      for (const r of counts.keys()) {
        const padded = String(r).padStart(3, '0');
        const KEY = `dpr_agents_annotations_${sid}_${padded}`;
        let arr = [];
        try { arr = JSON.parse(localStorage.getItem(KEY) ?? '[]'); } catch {}
        bundle.rounds[padded] = arr;
      }
      const text = JSON.stringify(bundle, null, 2);
      const blob = new Blob([text], { type: 'application/json' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `annotations-${sid}.json`;
      a.click();
      setTimeout(() => URL.revokeObjectURL(a.href), 5000);
    });
  });
</script>