---
// /agents/[sessionId]/[roundId]/ — Round detail page.
//
// 在 build 时扫描 archive/<sessionId>/rounds/round_<NNN>.json,
// 每个 round 生成一个静态页;同时支持 client-side 从 localStorage 加载
// (浏览器侧 round,archive 还没有落盘的情况下)。

import { readFile, readdir } from 'node:fs/promises';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navbar from '../../../components/Navbar.astro';
import '../../../styles/agents.css';

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');

export async function getStaticPaths() {
  const root = join(process.cwd(), 'archive');
  if (!existsSync(root)) return [];
  const out: { params: { sessionId: string; roundId: string } }[] = [];
  let sessions: string[] = [];
  try {
    sessions = await readdir(root);
  } catch {
    return [];
  }
  for (const sid of sessions) {
    const dir = join(root, sid, 'rounds');
    if (!existsSync(dir)) continue;
    let files: string[] = [];
    try {
      files = await readdir(dir);
    } catch {
      continue;
    }
    for (const f of files) {
      const m = f.match(/^round_(\d+)\.json$/);
      if (m) {
        out.push({ params: { sessionId: sid, roundId: m[1] } });
      }
    }
  }
  return out;
}

const { sessionId, roundId } = Astro.params;

// 服务端读 JSON(build time 已落盘)
const file = join(process.cwd(), 'archive', sessionId, 'rounds', `round_${String(roundId).padStart(3, '0')}.json`);

interface Proposal {
  id: string;
  type: string;
  title: string;
  rationale: string;
  evidence: { paperIds: string[]; quotes?: string[] };
  target: Record<string, unknown>;
  estimated_effort: string;
  risk: string;
  created_at: number;
}
interface Critique {
  proposal_id: string;
  scores: { methodologist: number; engineer: number; skeptic: number };
  total: number;
  critique: string;
  elo: number;
  matches: number;
  wins: number;
  persona_attribution: Record<string, string>;
}
interface GateVerdict {
  proposal_id: string;
  decision: 'promoted' | 'candidate' | 'sketch' | 'rejected';
  reasons: string[];
}
interface ModifierAction {
  id: string;
  kind: string;
  proposal_id: string;
  payload: Record<string, unknown>;
  applied_at: number;
}
interface ModifierSkip {
  proposal_id: string;
  reason: string;
}
interface RoundRecord {
  schema_version: 1;
  round: number;
  project_id: string;
  started_at: number;
  finished_at: number;
  designer: { proposals: Proposal[]; prompt_summary: string; model: string };
  feedback: { critiques: Critique[]; judge_calls: number; total_tokens: number };
  gate: {
    verdicts: GateVerdict[];
    promoted: string[];
    candidate: string[];
    sketch: string[];
    rejected: string[];
  };
  modifier: { applied: ModifierAction[]; skipped: ModifierSkip[] };
  telemetry?: {
    duration_ms: number;
    llm_calls: number;
    approx_tokens: number;
    stage_durations_ms?: {
      designer?: number;
      feedback?: number;
      gate?: number;
      modifier?: number;
    };
  };
  meta: { session_id: string; dry_run: boolean };
}

let rec: RoundRecord | null = null;
let loadError: string | null = null;
try {
  const raw = await readFile(file, 'utf8');
  rec = JSON.parse(raw) as RoundRecord;
} catch (err) {
  loadError = err instanceof Error ? err.message : String(err);
}

function escapeHtml(s: string): string {
  return String(s ?? '').replace(/[&<>"']/g, (c) => ({
    '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
  }[c] ?? c));
}

function actionTargetHref(action: ModifierAction, base: string): string {
  const p = action.payload as Record<string, string>;
  if (action.kind === 'create_draft_outline' && p.writing_id) {
    return `${base}/writing/${p.writing_id}/`;
  }
  if (action.kind === 'archive_round_summary' && p.experiment_id) {
    return `${base}/experiments/${p.experiment_id}/`;
  }
  if (action.kind === 'add_paper_to_stage' && p.arxivId) {
    return `${base}/papers/${p.arxivId}/`;
  }
  return '';
}

function badgeClass(decision: string): string {
  if (decision === 'promoted') return 'badge badge-high';
  if (decision === 'candidate') return 'badge badge-mid';
  if (decision === 'sketch') return 'badge badge-low';
  return 'badge badge-none';
}

// ─── iter #27 — round detail page polish helpers ────────────────

/**
 * 按比例拆分 token:designer 60% / feedback 30% / modifier 10%。
 * 实际 round JSON 只有 feedback.total_tokens 聚合,这里按经验值估计。
 */
function breakdownTokens(rec: RoundRecord): { designer: number; feedback: number; modifier: number; total: number } {
  const total = rec?.feedback?.total_tokens ?? 0;
  const designer = Math.round(total * 0.60);
  const feedback = Math.round(total * 0.30);
  const modifier = Math.max(0, total - designer - feedback);
  return { designer, feedback, modifier, total };
}

/**
 * 列出 session 的所有 round numbers,返回 prev/next。
 * 当前 round 不在列表 → 都 null。
 */
function roundNavFor(currentRound: number, allRounds: number[]): { prev: number | null; next: number | null } {
  const sorted = allRounds.slice().sort((a, b) => a - b);
  const idx = sorted.indexOf(currentRound);
  if (idx < 0) return { prev: null, next: null };
  return {
    prev: idx > 0 ? sorted[idx - 1] : null,
    next: idx < sorted.length - 1 ? sorted[idx + 1] : null,
  };
}

/**
 * Modifier action 的 badge class — 不同 kind 给不同颜色,让用户一眼区分。
 */
function appliedBadgeClass(kind: string): string {
  if (kind === 'create_draft_outline') return 'badge badge-high';
  if (kind === 'archive_round_summary') return 'badge badge-mid';
  if (kind === 'add_paper_to_stage') return 'badge badge-low';
  return 'badge badge-none';
}

/**
 * Skipped reason 的分类 badge。
 * no_op / noop → 低优先级(可接受跳过)
 * duplicate / already_exists → 中(重复,可考虑清理)
 * 其他 → 异常
 */
function skippedBadgeClass(reason: string): string {
  const r = String(reason ?? '').toLowerCase();
  if (r.includes('no_op') || r.includes('noop')) return 'badge badge-low';
  if (r.includes('duplicate') || r.includes('already')) return 'badge badge-mid';
  return 'badge badge-none';
}

/**
 * 读 archive 目录,列出所有 round numbers(为 prev/next 导航用)。
 */
let allRoundsInSession: number[] = [];
if (rec) {
  const roundsDir = join(process.cwd(), 'archive', sessionId, 'rounds');
  if (existsSync(roundsDir)) {
    try {
      const files = await readdir(roundsDir);
      allRoundsInSession = files
        .map((f) => f.match(/^round_(\d+)\.json$/))
        .filter((m): m is RegExpMatchArray => !!m)
        .map((m) => Number(m[1]));
    } catch { allRoundsInSession = []; }
  }
}

const nav = rec ? roundNavFor(Number(roundId), allRoundsInSession) : { prev: null, next: null };
const tokens = rec ? breakdownTokens(rec) : { designer: 0, feedback: 0, modifier: 0, total: 0 };
const tokenPct = (n: number) => tokens.total > 0 ? Math.round((n / tokens.total) * 100) : 0;

const startedAtIso = rec ? new Date(rec.started_at).toISOString() : '';
const finishedAtIso = rec ? new Date(rec.finished_at).toISOString() : '';
const elapsedMs = rec ? rec.finished_at - rec.started_at : 0;

// iter #42 — auto-resume command preview + per-round telemetry aggregates
const resumeCmd = rec
  ? `node astro-src/scripts/agents-run.mjs --auto "${rec.project_id.replace(/"/g, '\\"')}" \\\n` +
    `  --auto-resume --session ${rec.project_id} \\\n` +
    `  --max-cycles 1`
  : null;

// 加载所有 round 的 telemetry,做时长趋势图
let roundTimings: { round: number; duration_ms: number; llm_calls: number; approx_tokens: number }[] = [];
if (rec) {
  roundTimings = await Promise.all(
    allRoundsInSession.sort((a, b) => a - b).map(async (rn) => {
      const f = join(process.cwd(), 'archive', sessionId, 'rounds', `round_${String(rn).padStart(3, '0')}.json`);
      try {
        const raw = await readFile(f, 'utf8');
        const r = JSON.parse(raw) as RoundRecord;
        return {
          round: r.round,
          duration_ms: r.finished_at - r.started_at,
          llm_calls: r.feedback?.judge_calls ?? 0,
          approx_tokens: r.feedback?.total_tokens ?? 0,
        };
      } catch {
        return { round: rn, duration_ms: 0, llm_calls: 0, approx_tokens: 0 };
      }
    }),
  );
}

const maxDurationMs = Math.max(1, ...roundTimings.map((t) => t.duration_ms));

// iter #16 — load round N-1 if it exists, compute diff
let prevRec: RoundRecord | null = null;
if (rec && rec.round > 1) {
  const prevFile = join(process.cwd(), 'archive', sessionId, 'rounds', `round_${String(rec.round - 1).padStart(3, '0')}.json`);
  try {
    const raw = await readFile(prevFile, 'utf8');
    prevRec = JSON.parse(raw) as RoundRecord;
  } catch {
    prevRec = null;
  }
}

interface RoundDiff {
  addedTitles: string[];
  removedTitles: string[];
  newAppliedTitles: string[];
  scoreDelta: number | null;
  eloDelta: number | null;
  prevScore: number | null;
  currScore: number | null;
  prevElo: number | null;
  currElo: number | null;
}

function diffRounds(prev: RoundRecord | null, curr: RoundRecord): RoundDiff {
  if (!prev) {
    return {
      addedTitles: curr.designer.proposals.map((p) => p.title),
      removedTitles: [],
      newAppliedTitles: curr.modifier.applied.map((a) => {
        const p = curr.designer.proposals.find((pp) => pp.id === a.proposal_id);
        return p?.title ?? a.proposal_id;
      }),
      scoreDelta: null, eloDelta: null,
      prevScore: null, currScore: null, prevElo: null, currElo: null,
    };
  }
  const prevTitles = new Set(prev.designer.proposals.map((p) => p.title));
  const currTitles = new Set(curr.designer.proposals.map((p) => p.title));
  const addedTitles = [...currTitles].filter((t) => !prevTitles.has(t));
  const removedTitles = [...prevTitles].filter((t) => !currTitles.has(t));

  const proposalById = new Map<string, string>();
  for (const p of curr.designer.proposals) proposalById.set(p.id, p.title);
  for (const p of prev.designer.proposals) if (!proposalById.has(p.id)) proposalById.set(p.id, p.title);

  const prevAppliedIds = new Set(prev.modifier.applied.map((a) => a.proposal_id));
  const newApplied = curr.modifier.applied.filter((a) => !prevAppliedIds.has(a.proposal_id));
  const newAppliedTitles = newApplied.map((a) => proposalById.get(a.proposal_id) ?? a.proposal_id);

  function avgScores(r: RoundRecord): number | null {
    const cs = r.feedback.critiques;
    if (cs.length === 0) return null;
    return cs.reduce((a, c) => a + c.total, 0) / cs.length;
  }
  function avgElo(r: RoundRecord): number | null {
    const cs = r.feedback.critiques;
    if (cs.length === 0) return null;
    return cs.reduce((a, c) => a + c.elo, 0) / cs.length;
  }

  const prevScore = avgScores(prev);
  const currScore = avgScores(curr);
  const prevElo = avgElo(prev);
  const currElo = avgElo(curr);

  return {
    addedTitles, removedTitles, newAppliedTitles,
    scoreDelta: prevScore === null || currScore === null ? null : currScore - prevScore,
    eloDelta: prevElo === null || currElo === null ? null : currElo - prevElo,
    prevScore, currScore, prevElo, currElo,
  };
}

const diff: RoundDiff | null = rec ? diffRounds(prevRec, rec) : null;

function fmtDelta(n: number | null, digits = 2): string {
  if (n === null || !isFinite(n)) return '—';
  const sign = n > 0 ? '+' : '';
  return `${sign}${n.toFixed(digits)}`;
}
function deltaClass(n: number | null): string {
  if (n === null || !isFinite(n)) return 'muted';
  if (n > 0.01) return 'agents-delta-pos';
  if (n < -0.01) return 'agents-delta-neg';
  return 'agents-delta-zero';
}
---

<BaseLayout title={rec ? `Round ${rec.round} · ${rec.project_id}` : 'Round 详情'}>
  <Navbar />
  <main class="shell agents-shell">
    <nav class="agents-breadcrumb">
      <a href={`${base}/agents/`}>← 多智能体控制台</a>
      <span class="muted"> / {sessionId} / round {roundId}</span>
    </nav>

    {loadError && (
      <section class="agents-status" id="agents-status">
        <p class="agents-status-text">
          ⚠️ 未找到 round JSON: archive/{sessionId}/rounds/round_{String(roundId).padStart(3, '0')}.json
          (若该 round 仅存在 localStorage,请到 <a href={`${base}/agents/`}>/agents/</a> 查看)
        </p>
      </section>
    )}

    {rec && (
      <>
        <header class="agents-round-detail-header">
          <h1>Round {rec.round} · {escapeHtml(rec.project_id)}</h1>
          <p class="muted">
            开始: {startedAtIso} · 结束: {finishedAtIso} · 用时 {(elapsedMs / 1000).toFixed(1)}s
            · token ≈ {rec.feedback.total_tokens}
            · model: <code>{escapeHtml(rec.designer.model)}</code>
            {rec.meta.dry_run && <span class="badge badge-low" style="margin-left:0.5rem">DRY-RUN</span>}
          </p>
        </header>

        <section class="agents-auto-resume-section" id="agents-auto-resume-section">
          <h2>↪ 继续这个 session</h2>
          <p class="muted">
            用 <code>--auto-resume</code> 接着跑下一个 cycle(把上次 gaps 注入到下次 Designer prompt)。
            复制后在项目根目录运行。
          </p>
          <pre id="agents-auto-resume-cmd" class="agents-auto-cmd" tabindex="0">{resumeCmd}</pre>
          <div class="agents-auto-actions">
            <button type="button" class="button" id="agents-auto-resume-copy-btn">📎 复制到剪贴板</button>
            <a class="button" href={`${base}/agents/auto/`}>打开自治模式配置</a>
          </div>
          <p id="agents-auto-resume-hint" class="muted" aria-live="polite"></p>
        </section>

        <section class="agents-round-detail-section">
          <h2>⏱ Telemetry (iter #42)</h2>
          {roundTimings.length > 0 && (
            <div class="agents-telemetry-chart">
              <svg viewBox="0 0 {Math.max(320, roundTimings.length * 60)} 120" class="agents-telemetry-svg" role="img" aria-label="duration per round">
                <line x1="20" y1="100" x2={Math.max(320, roundTimings.length * 60) - 20} y2="100" stroke="#ccc" stroke-width="1" />
                {roundTimings.map((t, i) => {
                  const x = 20 + i * 60;
                  const barH = (t.duration_ms / maxDurationMs) * 80;
                  const y = 100 - barH;
                  const isCurrent = t.round === Number(roundId);
                  return (
                    <g key={t.round}>
                      <rect x={x} y={y} width="40" height={barH}
                        fill={isCurrent ? '#3b82f6' : '#94a3b8'}
                        stroke={isCurrent ? '#1d4ed8' : 'none'}
                        stroke-width={isCurrent ? '1.5' : '0'}
                        rx="2"
                        />
                      <text x={x + 20} y="115" text-anchor="middle" font-size="10" fill="#666">R{t.round}</text>
                      <text x={x + 20} y={y - 4} text-anchor="middle" font-size="10" fill="#333">
                        {(t.duration_ms / 1000).toFixed(1)}s
                      </text>
                    </g>
                  );
                })}
              </svg>
              <p class="muted" style="margin-top:0.5rem">
                每轮 (round + synthesis) 耗时 · 蓝色 = 当前轮 · 灰 = 其他轮
              </p>
            </div>
          )}
          {rec.telemetry?.stage_durations_ms && (
            <div class="agents-telemetry-stages">
                  <strong>Stage breakdown (本轮):</strong>
                  <ul class="agents-telemetry-stages-list">
                    {(['designer', 'feedback', 'gate', 'modifier'] as const).map((k) => {
                      const v = rec.telemetry!.stage_durations_ms![k] ?? 0;
                      return (
                        <li key={k}>
                          <span class="agents-telemetry-stage-name">{k}</span>
                          <span class="agents-telemetry-stage-bar">
                            <span class="agents-telemetry-stage-fill" style={`width: ${maxDurationMs > 0 ? Math.min(100, (v / maxDurationMs) * 100) : 0}%`} />
                          </span>
                          <span class="agents-telemetry-stage-val">{(v / 1000).toFixed(2)}s</span>
                        </li>
                      );
                    })}
                  </ul>
                  <p class="muted" style="margin-top:0.5rem">
                    LLM calls ≈ {rec.telemetry.llm_calls} · tokens ≈ {rec.telemetry.approx_tokens}
                  </p>
            </div>
          )}
        </section>

        <section class="agents-round-detail-section">
          <h2>📊 概览</h2>
          <div class="agents-detail-grid">
            <div>
              <strong>Designer</strong>: {rec.designer.proposals.length} proposals
            </div>
            <div>
              <strong>Feedback</strong>: {rec.feedback.critiques.length} critiques, {rec.feedback.judge_calls} LLM calls
            </div>
            <div>
              <strong>Gate</strong>:
              <span class="badge badge-high">{rec.gate.promoted.length} promoted</span>
              <span class="badge badge-mid">{rec.gate.candidate.length} candidate</span>
              <span class="badge badge-low">{rec.gate.sketch.length} sketch</span>
              <span class="badge badge-none">{rec.gate.rejected.length} rejected</span>
            </div>
            <div>
              <strong>Modifier</strong>:
              <span class="badge badge-mid">{rec.modifier.applied.length} applied</span>
              <span class="badge badge-low">{rec.modifier.skipped.length} skipped</span>
            </div>
          </div>
          {tokens.total > 0 && (
            <div class="agents-token-breakdown">
              <strong>Token 估算</strong>(共 {tokens.total.toLocaleString()}):
              <div class="agents-token-bar" aria-label="token 用量按段拆分">
                <span class="agents-token-seg agents-token-designer" style={`width: ${tokenPct(tokens.designer)}%`}
                      title={`Designer ≈ ${tokens.designer} (${tokenPct(tokens.designer)}%)`}>
                  {tokenPct(tokens.designer) >= 8 && `${tokenPct(tokens.designer)}%`}
                </span>
                <span class="agents-token-seg agents-token-feedback" style={`width: ${tokenPct(tokens.feedback)}%`}
                      title={`Feedback ≈ ${tokens.feedback} (${tokenPct(tokens.feedback)}%)`}>
                  {tokenPct(tokens.feedback) >= 8 && `${tokenPct(tokens.feedback)}%`}
                </span>
                <span class="agents-token-seg agents-token-modifier" style={`width: ${tokenPct(tokens.modifier)}%`}
                      title={`Modifier ≈ ${tokens.modifier} (${tokenPct(tokens.modifier)}%)`}>
                  {tokenPct(tokens.modifier) >= 8 && `${tokenPct(tokens.modifier)}%`}
                </span>
              </div>
              <span class="muted agents-token-legend">
                <span class="agents-token-dot agents-token-dot-designer"></span> Designer
                <span class="agents-token-dot agents-token-dot-feedback"></span> Feedback
                <span class="agents-token-dot agents-token-dot-modifier"></span> Modifier
                <small>(按经验值 60/30/10 估算)</small>
              </span>
            </div>
          )}
        </section>

        {diff && (
          <section class="agents-round-detail-section">
            <h2>🔄 本轮 vs 上轮 {prevRec ? `(Round ${prevRec.round})` : '(无前轮 — 这是第一轮)'}</h2>
            <div class="agents-detail-grid">
              <div>
                <strong>平均分</strong>:
                <span class={deltaClass(diff.scoreDelta)}>
                  {diff.prevScore?.toFixed(2) ?? '—'} → {diff.currScore?.toFixed(2) ?? '—'}
                  {' '}({fmtDelta(diff.scoreDelta)})
                </span>
              </div>
              <div>
                <strong>平均 Elo</strong>:
                <span class={deltaClass(diff.eloDelta)}>
                  {diff.prevElo?.toFixed(0) ?? '—'} → {diff.currElo?.toFixed(0) ?? '—'}
                  {' '}({fmtDelta(diff.eloDelta, 0)})
                </span>
              </div>
              <div>
                <strong>新增 proposals</strong>: <span class="agents-delta-pos">{diff.addedTitles.length}</span>
              </div>
              <div>
                <strong>移除 proposals</strong>: <span class="agents-delta-neg">{diff.removedTitles.length}</span>
              </div>
              <div>
                <strong>本轮新写入</strong>: <span class="badge badge-mid">{diff.newAppliedTitles.length}</span>
              </div>
            </div>
            {diff.addedTitles.length > 0 && (
              <details open>
                <summary>➕ 新增的 proposals ({diff.addedTitles.length})</summary>
                <ul>
                  {diff.addedTitles.map((t) => (<li>{escapeHtml(t)}</li>))}
                </ul>
              </details>
            )}
            {diff.removedTitles.length > 0 && (
              <details>
                <summary>➖ 移除的 proposals ({diff.removedTitles.length})</summary>
                <ul>
                  {diff.removedTitles.map((t) => (<li class="muted">{escapeHtml(t)}</li>))}
                </ul>
              </details>
            )}
            {diff.newAppliedTitles.length > 0 && (
              <details open>
                <summary>✏️ 本轮新应用的 ({diff.newAppliedTitles.length})</summary>
                <ul>
                  {diff.newAppliedTitles.map((t) => (<li>{escapeHtml(t)}</li>))}
                </ul>
              </details>
            )}
          </section>
        )}

        <section class="agents-round-detail-section">
          <h2>📝 Designer Proposals ({rec.designer.proposals.length})</h2>
          <p class="muted">prompt: {escapeHtml(rec.designer.prompt_summary)}</p>
          <ol class="agents-detail-proposals">
            {rec.designer.proposals.map((p, idx) => {
              const verdict = rec!.gate.verdicts.find((v) => v.proposal_id === p.id);
              const critique = rec!.feedback.critiques.find((c) => c.proposal_id === p.id);
              return (
                <li class="agents-detail-proposal">
                  <header>
                    <span class="agents-detail-proposal-num">#{idx + 1}</span>
                    <span class="badge">{p.type}</span>
                    {verdict && <span class={badgeClass(verdict.decision)}>{verdict.decision}</span>}
                    <h3>{escapeHtml(p.title)}</h3>
                  </header>
                  <p class="muted">rationale: {escapeHtml(p.rationale)}</p>
                  <p class="muted">
                    effort={p.estimated_effort} · risk={escapeHtml(p.risk)}
                  </p>
                  {p.evidence.paperIds.length > 0 && (
                    <p>
                      <strong>papers:</strong>
                      {p.evidence.paperIds.map((aid, i) => (
                        <>
                          {i > 0 && ' · '}
                          <a href={`${base}/papers/${aid}/`} class="agents-link" target="_blank">
                            {aid}
                          </a>
                        </>
                      ))}
                    </p>
                  )}
                  {critique && (
                    <details class="agents-detail-critique">
                      <summary>
                        <strong>Feedback</strong>:
                        <span class={badgeClass(critique.total >= 8 ? 'promoted' : critique.total >= 6 ? 'candidate' : 'sketch')}>
                          total={critique.total.toFixed(1)}
                        </span>
                        m={critique.scores.methodologist} e={critique.scores.engineer} s={critique.scores.skeptic}
                        · Elo={critique.elo.toFixed(0)} (m={critique.matches} w={critique.wins})
                      </summary>
                      <p><em>综合:</em> {escapeHtml(critique.critique)}</p>
                      <ul>
                        <li><strong>methodologist:</strong> {escapeHtml(critique.persona_attribution.methodologist ?? '')}</li>
                        <li><strong>engineer:</strong> {escapeHtml(critique.persona_attribution.engineer ?? '')}</li>
                        <li><strong>skeptic:</strong> {escapeHtml(critique.persona_attribution.skeptic ?? '')}</li>
                      </ul>
                    </details>
                  )}
                  {verdict && verdict.reasons.length > 0 && (
                    <p class="muted">
                      <strong>Gate reasons:</strong> {verdict.reasons.map((r) => escapeHtml(r)).join('; ')}
                    </p>
                  )}
                </li>
              );
            })}
          </ol>
        </section>

        <section class="agents-round-detail-section">
          <h2>✏️ Modifier Actions ({rec.modifier.applied.length})</h2>
          {rec.modifier.applied.length === 0 ? (
            <p class="muted">本轮无写入动作</p>
          ) : (
            <ul class="agents-detail-applied">
              {rec.modifier.applied.map((a) => {
                const href = actionTargetHref(a, base);
                const proposal = rec!.designer.proposals.find((p) => p.id === a.proposal_id);
                return (
                  <li>
                    <span class={appliedBadgeClass(a.kind)}>{a.kind}</span>
                    {' '}
                    {proposal && <strong>{escapeHtml(proposal.title)}</strong>}
                    {' '}
                    {href
                      ? <a class="agents-link" href={href} target="_blank">→ 打开目标</a>
                      : <code class="muted">{JSON.stringify(a.payload).slice(0, 80)}</code>
                    }
                    <span class="muted agents-detail-applied-meta">
                      — <code>{a.proposal_id}</code>
                      {' · '}{new Date(a.applied_at).toLocaleTimeString()}
                    </span>
                  </li>
                );
              })}
            </ul>
          )}
          {rec.modifier.skipped.length > 0 && (
            <details>
              <summary>skipped ({rec.modifier.skipped.length})</summary>
              <ul class="agents-detail-skipped">
                {rec.modifier.skipped.map((s) => (
                  <li>
                    <span class={skippedBadgeClass(s.reason)}>{escapeHtml(s.reason.split(/[:;,]/)[0].trim() || s.reason.slice(0, 20))}</span>
                    {' '}
                    <code>{s.proposal_id}</code>
                    <span class="muted"> — {escapeHtml(s.reason)}</span>
                  </li>
                ))}
              </ul>
            </details>
          )}
        </section>

        {(nav.prev !== null || nav.next !== null) && (
          <nav class="agents-round-nav">
            {nav.prev !== null ? (
              <a class="button" href={`${base}/agents/${sessionId}/${String(nav.prev).padStart(3, '0')}/`}>
                ← Round {nav.prev}
              </a>
            ) : (
              <span class="muted">已是第一轮</span>
            )}
            <a class="button" href={`${base}/agents/`}>返回控制台</a>
            {nav.next !== null ? (
              <a class="button" href={`${base}/agents/${sessionId}/${String(nav.next).padStart(3, '0')}/`}>
                Round {nav.next} →
              </a>
            ) : (
              <span class="muted">已是最后一轮</span>
            )}
          </nav>
        )}
      </>
    )}
  </main>
</BaseLayout>

<script>
  // iter #42 — copy resume command to clipboard
  document.addEventListener('DOMContentLoaded', () => {
    const copyBtn = document.getElementById('agents-auto-resume-copy-btn');
    const cmdEl = document.getElementById('agents-auto-resume-cmd');
    const hintEl = document.getElementById('agents-auto-resume-hint');
    if (!copyBtn || !cmdEl || !hintEl) return;
    copyBtn.addEventListener('click', async () => {
      const cmd = cmdEl.textContent ?? '';
      try {
        await navigator.clipboard.writeText(cmd);
        hintEl.textContent = '✓ 已复制';
        hintEl.style.color = '#080';
      } catch {
        const range = document.createRange();
        range.selectNodeContents(cmdEl);
        const sel = window.getSelection();
        sel?.removeAllRanges();
        sel?.addRange(range);
        hintEl.textContent = '⚠️ 无法自动复制,已选中文本,请按 Cmd/Ctrl+C';
        hintEl.style.color = '#c00';
      }
    });
  });
</script>
