---
// /agents/round-entropy.astro — iter #202:per-round score entropy
//
// 每轮 proposal 评分的熵(entropy):
//   - 高熵 = 评分分布均匀(多种可能都被接受)
//   - 低熵 = 评分集中(几乎都给同一档)
//   - 与 variance 不同:entropy 看分布形状,不看数值范围

import { readFile, readdir } from 'node:fs/promises';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import '../../styles/agents.css';

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');

interface RoundEntropy {
  sid: string;
  roundIdx: number;
  scores: number[];
  entropy: number;
  count: number;
}

function entropy(scores: number[]): number {
  if (scores.length === 0) return 0;
  // 把 score 分到 10 个 bin(0-10,每 1 分一档)
  const buckets = new Array(10).fill(0);
  for (const s of scores) {
    const idx = Math.min(9, Math.max(0, Math.floor(s)));
    buckets[idx] += 1;
  }
  const total = scores.length;
  let h = 0;
  for (const c of buckets) {
    if (c === 0) continue;
    const p = c / total;
    h -= p * Math.log2(p);
  }
  return h;
}

const root = join(process.cwd(), 'archive');
const records: RoundEntropy[] = [];

if (existsSync(root)) {
  const sids = await readdir(root).catch(() => []);
  for (const sid of sids) {
    const rd = join(root, sid, 'rounds');
    if (!existsSync(rd)) continue;
    const rfs = await readdir(rd).catch(() => []);
    const rNum: number[] = [];
    for (const rf of rfs) {
      const m = rf.match(/^round_(\d+)\.json$/);
      if (m) rNum.push(parseInt(m[1], 10));
    }
    rNum.sort((a, b) => a - b);
    for (const ri of rNum) {
      try {
        const r = JSON.parse(await readFile(join(rd, `round_${ri}.json`), 'utf8'));
        const scores: number[] = [];
        for (const persona of r.feedback?.personas ?? []) {
          for (const p of persona.proposals ?? []) {
            if (typeof p.total === 'number') scores.push(p.total);
          }
        }
        if (scores.length < 2) continue;
        records.push({
          sid, roundIdx: ri,
          scores,
          entropy: entropy(scores),
          count: scores.length,
        });
      } catch (e) { /* */ }
    }
  }
}

const total = records.length;
const avgEntropy = records.length > 0 ? records.reduce((s, r) => s + r.entropy, 0) / records.length : 0;

// 直方图
const buckets = [
  { label: 'H = 0 (极端集中)', min: 0, max: 0.01, count: 0 },
  { label: '0 < H ≤ 1.0', min: 0.01, max: 1.0, count: 0 },
  { label: '1.0 < H ≤ 2.0', min: 1.0, max: 2.0, count: 0 },
  { label: '2.0 < H ≤ 3.0', min: 2.0, max: 3.0, count: 0 },
  { label: 'H > 3.0 (高熵)', min: 3.0, max: 99, count: 0 },
];
for (const r of records) {
  for (const b of buckets) {
    if (r.entropy > b.min && r.entropy <= b.max) {
      b.count += 1;
      break;
    }
  }
}
const maxBucket = Math.max(...buckets.map((b) => b.count), 1);

const topHigh = [...records].sort((a, b) => b.entropy - a.entropy).slice(0, 10);
const topLow = [...records].sort((a, b) => a.entropy - b.entropy).slice(0, 10);

function bar(n: number, max: number, width = 24): string {
  if (!max) return '░'.repeat(width);
  const filled = Math.round((n / max) * width);
  return '█'.repeat(filled) + '░'.repeat(width - filled);
}
function esc(s: any): string {
  return String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({ '&': '&', '<': '<', '>': '>', '"': '"', "'": '&#39;' }[c] || c));
}
---

<BaseLayout title="Round Score Entropy · Agents">
  <Navbar />
  <main class="shell agents-shell">
    <nav class="agents-breadcrumb">
      <a href={`${base}/agents/`}>← 多智能体控制台</a>
      <span class="muted"> / round-entropy</span>
    </nav>

    <header class="agents-header">
      <h1>🎲 Round Score Entropy <span class="muted" style="font-size:0.6em">(iter #202)</span></h1>
      <p class="agents-sub">
        每轮 proposal 评分的 Shannon 熵。
        高熵 = 评分分布均匀;低熵 = 集中于某一档。
      </p>
    </header>

    <section class="agents-session-section">
      <h2>📊 全局</h2>
      <div class="agents-re-globals">
        <span>总 rounds: <strong>{total}</strong></span>
        <span>avg entropy (bits): <strong>{avgEntropy.toFixed(3)}</strong></span>
      </div>
    </section>

    <section class="agents-session-section">
      <h2>📊 熵分布</h2>
      <pre class="agents-re-flow">{buckets.map((b) => {
        return `${b.label.padEnd(22)} ${bar(b.count, maxBucket, 24)}  ${String(b.count).padStart(4)}`;
      }).join('\n')}</pre>
    </section>

    <section class="agents-session-section">
      <h2>🎲 top 10 高熵 rounds(评分分布广)</h2>
      <table class="agents-session-table">
        <thead>
          <tr><th>sid</th><th>round</th><th>H (bits)</th><th>count</th></tr>
        </thead>
        <tbody>
          {topHigh.map((r) => (
            <tr>
              <td><a href={`${base}/agents/${r.sid}/`}><code>{esc(r.sid.slice(0, 14))}</code></a></td>
              <td>R{r.roundIdx}</td>
              <td><strong>{r.entropy.toFixed(3)}</strong></td>
              <td>{r.count}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="agents-session-section">
      <h2>🎯 top 10 低熵 rounds(评分集中)</h2>
      <table class="agents-session-table">
        <thead>
          <tr><th>sid</th><th>round</th><th>H (bits)</th><th>count</th></tr>
        </thead>
        <tbody>
          {topLow.map((r) => (
            <tr>
              <td><a href={`${base}/agents/${r.sid}/`}><code>{esc(r.sid.slice(0, 14))}</code></a></td>
              <td>R{r.roundIdx}</td>
              <td><strong>{r.entropy.toFixed(3)}</strong></td>
              <td>{r.count}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="agents-session-section">
      <h2>💡 解读</h2>
      <ul>
        <li>bin = 0-10 每 1 分一档,共 10 档</li>
        <li>理论最大 H = log2(10) ≈ 3.32 bits</li>
        <li>H = 0 = 所有评分相同档</li>
        <li>对照 <a href={`${base}/agents/round-variance/`}>Round Variance</a> 看数值 σ</li>
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .agents-re-globals {
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
  }
  .agents-re-globals strong {
    color: #4f46e5;
    font-family: ui-monospace, monospace;
    margin: 0 0.3rem;
  }
  .agents-re-flow {
    background: rgba(0,0,0,0.4);
    color: #c9d1d9;
    padding: 0.8rem;
    border-radius: 4px;
    font-family: ui-monospace, "JetBrains Mono", monospace;
    font-size: 0.78rem;
    line-height: 1.4;
    overflow-x: auto;
    white-space: pre;
  }
</style>