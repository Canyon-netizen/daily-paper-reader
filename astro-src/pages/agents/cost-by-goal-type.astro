---
// /agents/cost-by-goal-type.astro — iter #297:cost per goal type
//
// 每个 goal type 的成本分布:
//   - 总 cost
//   - avg cost per session
//   - avg cost per round
//   - cost efficiency (gain per dollar)

import { readFile, readdir } from 'node:fs/promises';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import '../../styles/agents.css';

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');

const SONNET_PRICE = 6;
const TYPE_KEYWORDS: Record<string, string[]> = {
  research: ['论文', '研究', '调研', '分析', 'paper', 'research', 'survey', 'review'],
  code: ['代码', '实现', '编程', 'code', 'implement', 'build', 'develop', 'api'],
  write: ['写', '文章', '博客', 'write', 'essay', 'blog', 'draft'],
  analyze: ['分析', '统计', 'analyze', 'analysis', 'statistics', 'metrics'],
  design: ['设计', '架构', 'design', 'architecture', 'plan'],
  other: [],
};

function classifyGoal(goal: string): string {
  const gl = goal.toLowerCase();
  for (const [type, kws] of Object.entries(TYPE_KEYWORDS)) {
    if (type === 'other') continue;
    for (const kw of kws) {
      if (gl.includes(kw.toLowerCase())) return type;
    }
  }
  return 'other';
}

interface TypeCost {
  name: string;
  count: number;
  totalCost: number;
  totalRounds: number;
  totalGain: number;
  avgCostPerSession: number;
  avgCostPerRound: number;
  avgGain: number;
  costEfficiency: number; // totalGain / totalCost
}

const root = join(process.cwd(), 'archive');
const typeMap = new Map<string, TypeCost>();

for (const t of Object.keys(TYPE_KEYWORDS)) {
  typeMap.set(t, {
    name: t, count: 0, totalCost: 0, totalRounds: 0, totalGain: 0,
    avgCostPerSession: 0, avgCostPerRound: 0, avgGain: 0, costEfficiency: 0,
  });
}

if (existsSync(root)) {
  const sids = await readdir(root).catch(() => []);
  for (const sid of sids) {
    const sp = join(root, sid);
    if (!existsSync(sp)) continue;
    const mp = join(sp, 'meta.json');
    if (!existsSync(mp)) continue;
    let goal = '';
    try { goal = JSON.parse(await readFile(mp, 'utf8')).goal ?? ''; } catch (e) { continue; }
    if (!goal) continue;
    const type = classifyGoal(goal);
    const t = typeMap.get(type)!;
    t.count += 1;

    const rd = join(sp, 'rounds');
    if (!existsSync(rd)) continue;
    const rfs = await readdir(rd).catch(() => []);
    const rNums: number[] = [];
    for (const rf of rfs) {
      const m = rf.match(/^round_(\d+)\.json$/);
      if (m) rNums.push(parseInt(m[1], 10));
    }
    if (rNums.length < 2) continue;
    rNums.sort((a, b) => a - b);
    t.totalRounds += rNums.length;

    const scores: number[] = [];
    for (const rn of rNums) {
      try {
        const r = JSON.parse(await readFile(join(rd, `round_${rn}.json`), 'utf8'));
        const tokens = r.feedback?.total_tokens ?? 0;
        t.totalCost += (tokens / 1_000_000) * SONNET_PRICE;
        const arr: number[] = [];
        for (const persona of r.feedback?.personas ?? []) {
          for (const p of persona.proposals ?? []) {
            if (typeof p.total === 'number') arr.push(p.total);
          }
        }
        if (arr.length > 0) scores.push(arr.reduce((a, b) => a + b, 0) / arr.length);
      } catch (e) { /* */ }
    }
    if (scores.length >= 2) {
      t.totalGain += scores[scores.length - 1] - scores[0];
    }
  }
}

for (const t of typeMap.values()) {
  if (t.count > 0) {
    t.avgCostPerSession = t.totalCost / t.count;
    t.avgCostPerRound = t.totalRounds > 0 ? t.totalCost / t.totalRounds : 0;
    t.avgGain = t.totalGain / t.count;
    t.costEfficiency = t.totalCost > 0 ? t.totalGain / t.totalCost : 0;
  }
}

const arr = [...typeMap.values()].filter((t) => t.count > 0).sort((a, b) => b.totalCost - a.totalCost);
const maxCost = Math.max(...arr.map((t) => t.totalCost), 1);

function bar(n: number, max: number, width = 22): string {
  if (!max) return '░'.repeat(width);
  const filled = Math.round((n / max) * width);
  return '█'.repeat(filled) + '░'.repeat(width - filled);
}
---

<BaseLayout title="Cost by Goal Type · Agents">
  <Navbar />
  <main class="shell agents-shell">
    <nav class="agents-breadcrumb">
      <a href={`${base}/agents/`}>← 多智能体控制台</a>
      <span class="muted"> / cost-by-goal-type</span>
    </nav>

    <header class="agents-header">
      <h1>💰 Cost by Goal Type <span class="muted" style="font-size:0.6em">(iter #297)</span></h1>
      <p class="agents-sub">
        每个 goal type 的成本分布 + 性价比(gain/$)。
      </p>
    </header>

    <section class="agents-session-section">
      <h2>📊 全局</h2>
      <div class="agents-cbgt-globals">
        <span>types: <strong>{arr.length}</strong></span>
        <span>总 cost: <strong>${arr.reduce((s, t) => s + t.totalCost, 0).toFixed(2)}</strong></span>
      </div>
    </section>

    <section class="agents-session-section">
      <h2>💰 总 cost 分布</h2>
      <pre class="agents-cbgt-flow">{arr.map((t) => {
        return `${t.name.padEnd(10)} ${bar(t.totalCost, maxCost, 22)}  $${t.totalCost.toFixed(2)}  (n=${t.count})`;
      }).join('\n')}</pre>
    </section>

    <section class="agents-session-section">
      <h2>📋 详细</h2>
      <table class="agents-session-table">
        <thead>
          <tr><th>type</th><th>sessions</th><th>rounds</th><th>total cost</th><th>$/session</th><th>$/round</th><th>avg gain</th><th>gain/$</th></tr>
        </thead>
        <tbody>
          {arr.map((t) => (
            <tr>
              <td><strong style="color:#4f46e5">{t.name}</strong></td>
              <td>{t.count}</td>
              <td>{t.totalRounds}</td>
              <td><strong>${t.totalCost.toFixed(2)}</strong></td>
              <td>${t.avgCostPerSession.toFixed(3)}</td>
              <td>${t.avgCostPerRound.toFixed(3)}</td>
              <td>{t.avgGain >= 0 ? '+' : ''}{t.avgGain.toFixed(2)}</td>
              <td style={t.costEfficiency > 0 ? 'color:#10b981' : ''}><strong>{t.costEfficiency.toFixed(2)}</strong></td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="agents-session-section">
      <h2>💡 解读</h2>
      <ul>
        <li>$/session 高 = 系统在该 type 上开销大</li>
        <li>gain/$ 高 = 性价比好</li>
        <li>对照 <a href={`${base}/agents/goal-type-token-density/`}>Goal Type Token Density</a></li>
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .agents-cbgt-globals {
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
  }
  .agents-cbgt-globals strong {
    color: #4f46e5;
    font-family: ui-monospace, monospace;
    margin: 0 0.3rem;
  }
  .agents-cbgt-flow {
    background: rgba(0,0,0,0.4);
    color: #c9d1d9;
    padding: 0.8rem;
    border-radius: 4px;
    font-family: ui-monospace, "JetBrains Mono", monospace;
    font-size: 0.78rem;
    line-height: 1.4;
    overflow-x: auto;
    white-space: pre;
  }
</style>