---
// /agents/designer-feedback-alignment.astro — iter #341:designer ↔ feedback alignment
//
// 对每个 session,看 designer output 文本的 token 集合与 feedback proposals 的 token 集合 Jaccard。
// 高 = designer 准确回应 feedback。

import { readFile, readdir } from 'node:fs/promises';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import '../../styles/agents.css';

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');

const STOP = new Set(['the', 'a', 'an', 'and', 'or', 'but', 'in', 'on', 'at', 'to', 'for', 'of', 'with', 'is', 'are', 'be', 'this', 'that', 'it', 'as', 'by', 'from']);
const CN_RE = /[一-鿿]/;

function tokenize(s: string): Set<string> {
  const out = new Set<string>();
  if (!s) return out;
  for (const seg of s.split(/\s+/)) {
    if (CN_RE.test(seg)) {
      const chars = Array.from(seg);
      for (let i = 0; i + 2 <= chars.length; i++) out.add(chars.slice(i, i + 2).join(''));
      for (const c of chars) out.add(c);
    } else {
      const t = seg.toLowerCase().replace(/[^\w]/g, '');
      if (t && !STOP.has(t) && t.length > 2) out.add(t);
    }
  }
  return out;
}

function jaccard(a: Set<string>, b: Set<string>): number {
  if (a.size === 0 && b.size === 0) return 0;
  let inter = 0;
  for (const t of a) if (b.has(t)) inter += 1;
  const union = a.size + b.size - inter;
  return union > 0 ? inter / union : 0;
}

interface SessAlign {
  sid: string;
  goal: string;
  rounds: number;
  alignmentAvg: number;
  alignmentBest: number;
  alignmentWorst: number;
  totalDesignerTokens: number;
  totalFeedbackTokens: number;
}

const root = join(process.cwd(), 'archive');
const sessions: SessAlign[] = [];

if (existsSync(root)) {
  const sids = await readdir(root).catch(() => []);
  for (const sid of sids) {
    const rd = join(root, sid, 'rounds');
    if (!existsSync(rd)) continue;
    const rfs = await readdir(rd).catch(() => []);
    const rNums: number[] = [];
    for (const rf of rfs) {
      const m = rf.match(/^round_(\d+)\.json$/);
      if (m) rNums.push(parseInt(m[1], 10));
    }
    if (rNums.length < 1) continue;
    rNums.sort((a, b) => a - b);

    const aligns: number[] = [];
    let totalDesignerTokens = 0;
    let totalFeedbackTokens = 0;

    for (const rn of rNums) {
      try {
        const r = JSON.parse(await readFile(join(rd, `round_${rn}.json`), 'utf8'));
        // Designer output
        const designerText = r.designer?.output ?? r.designer?.draft ?? r.design?.output ?? '';
        // Feedback proposals
        const fbParts: string[] = [];
        for (const persona of r.feedback?.personas ?? []) {
          for (const p of persona.proposals ?? []) {
            if (typeof p.text === 'string') fbParts.push(p.text);
            if (typeof p.note === 'string') fbParts.push(p.note);
            if (typeof p.description === 'string') fbParts.push(p.description);
          }
        }
        const feedbackText = fbParts.join(' ');

        if (!designerText || !feedbackText) continue;

        const dt = tokenize(designerText);
        const ft = tokenize(feedbackText);
        totalDesignerTokens += dt.size;
        totalFeedbackTokens += ft.size;
        aligns.push(jaccard(dt, ft));
      } catch (e) { /* */ }
    }
    if (aligns.length === 0) continue;

    let goal = '';
    const mp = join(root, sid, 'meta.json');
    if (existsSync(mp)) {
      try { goal = JSON.parse(await readFile(mp, 'utf8')).goal ?? ''; } catch (e) { /* */ }
    }

    sessions.push({
      sid, goal, rounds: aligns.length,
      alignmentAvg: aligns.reduce((s, v) => s + v, 0) / aligns.length,
      alignmentBest: Math.max(...aligns),
      alignmentWorst: Math.min(...aligns),
      totalDesignerTokens,
      totalFeedbackTokens,
    });
  }
}

sessions.sort((a, b) => a.alignmentAvg - b.alignmentAvg);

const total = sessions.length;
const overallAvg = sessions.length > 0 ? sessions.reduce((s, x) => s + x.alignmentAvg, 0) / sessions.length : 0;

// Bucket
const buckets = [
  { label: 'misaligned (<0.05)', min: 0, max: 0.05, count: 0 },
  { label: 'weak (0.05-0.10)', min: 0.05, max: 0.10, count: 0 },
  { label: 'moderate (0.10-0.20)', min: 0.10, max: 0.20, count: 0 },
  { label: 'aligned (0.20-0.35)', min: 0.20, max: 0.35, count: 0 },
  { label: 'strong (0.35+)', min: 0.35, max: 1.01, count: 0 },
];
for (const s of sessions) {
  for (const b of buckets) {
    if (s.alignmentAvg >= b.min && s.alignmentAvg < b.max) { b.count += 1; break; }
  }
}

function bar(n: number, max: number, width = 22): string {
  if (!max) return '░'.repeat(width);
  const filled = Math.round((n / max) * width);
  return '█'.repeat(filled) + '░'.repeat(width - filled);
}

function esc(s: any): string {
  const str = String(s == null ? '' : s);
  return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}
---

<BaseLayout title="Designer Feedback Alignment · Agents">
  <Navbar />
  <main class="shell agents-shell">
    <nav class="agents-breadcrumb">
      <a href={`${base}/agents/`}>← 多智能体控制台</a>
      <span class="muted"> / designer-feedback-alignment</span>
    </nav>

    <header class="agents-header">
      <h1>🤝 Designer ↔ Feedback Alignment <span class="muted" style="font-size:0.6em">(iter #341)</span></h1>
      <p class="agents-sub">
        designer output 与 feedback proposals 的 token Jaccard。
        高 = designer 准确回应了 feedback 的关键点。
      </p>
    </header>

    <section class="agents-session-section">
      <h2>📊 全局</h2>
      <div class="agents-dfa-globals">
        <span>sessions: <strong>{total}</strong></span>
        <span>overall avg alignment: <strong style={`color:${overallAvg >= 0.2 ? '#10b981' : overallAvg >= 0.1 ? '#f59e0b' : '#ef4444'}`}>{overallAvg.toFixed(4)}</strong></span>
      </div>
    </section>

    <section class="agents-session-section">
      <h2>📊 Alignment 桶分布</h2>
      <pre class="agents-dfa-flow">{buckets.map((b) => `${b.label.padEnd(24)} ${bar(b.count, Math.max(...buckets.map((x) => x.count), 1), 22)}  ${b.count}`).join('\n')}</pre>
    </section>

    <section class="agents-session-section">
      <h2>🤝 Top 10 最 aligned</h2>
      <table class="agents-session-table">
        <thead>
          <tr><th>#</th><th>sid</th><th>rounds</th><th>avg</th><th>best</th><th>worst</th><th>goal</th></tr>
        </thead>
        <tbody>
          {sessions.slice().reverse().slice(0, 10).map((s, i) => (
            <tr>
              <td>{i + 1}</td>
              <td><a href={`${base}/agents/${s.sid}/`}><code>{esc(s.sid.slice(0, 10))}</code></a></td>
              <td>{s.rounds}</td>
              <td><strong style="color:#10b981">{s.alignmentAvg.toFixed(3)}</strong></td>
              <td>{s.alignmentBest.toFixed(3)}</td>
              <td>{s.alignmentWorst.toFixed(3)}</td>
              <td><small class="muted">{esc(s.goal.slice(0, 18))}{s.goal.length > 18 ? '…' : ''}</small></td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="agents-session-section">
      <h2>💡 解读</h2>
      <ul>
        <li>avg ≥ 0.2 = designer 高度回应 feedback</li>
        <li>avg &lt; 0.05 = designer 与 feedback 几乎脱节</li>
        <li>best/worst 差距大 = 单 session 内 alignment 不稳定</li>
        <li>对照 <a href={`${base}/agents/persona-agreement/`}>Persona Agreement</a></li>
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .agents-dfa-globals {
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
  }
  .agents-dfa-globals strong {
    color: #4f46e5;
    font-family: ui-monospace, monospace;
    margin: 0 0.3rem;
  }
  .agents-dfa-flow {
    background: rgba(0,0,0,0.4);
    color: #c9d1d9;
    padding: 0.8rem;
    border-radius: 4px;
    font-family: ui-monospace, "JetBrains Mono", monospace;
    font-size: 0.78rem;
    line-height: 1.4;
    overflow-x: auto;
    white-space: pre;
  }
</style>