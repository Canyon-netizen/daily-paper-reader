---
// /agents/designer-edit-magnitude.astro — iter #355:designer output length change per round

import { readFile, readdir } from 'node:fs/promises';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import '../../styles/agents.css';

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');

interface SessEdit {
  sid: string;
  goal: string;
  totalRounds: number;
  lengths: number[];
  deltas: number[];
  avgLength: number;
  avgDelta: number;
  totalGrowth: number;
}

const root = join(process.cwd(), 'archive');
const sessions: SessEdit[] = [];

if (existsSync(root)) {
  const sids = await readdir(root).catch(() => []);
  for (const sid of sids) {
    const rd = join(root, sid, 'rounds');
    if (!existsSync(rd)) continue;
    const rfs = await readdir(rd).catch(() => []);
    const rNums: number[] = [];
    for (const rf of rfs) {
      const m = rf.match(/^round_(\d+)\.json$/);
      if (m) rNums.push(parseInt(m[1], 10));
    }
    if (rNums.length < 2) continue;
    rNums.sort((a, b) => a - b);

    const lengths: number[] = [];
    for (const rn of rNums) {
      try {
        const r = JSON.parse(await readFile(join(rd, `round_${rn}.json`), 'utf8'));
        const text = r.designer?.output ?? r.designer?.draft ?? r.design?.output ?? '';
        lengths.push(text.length);
      } catch (e) { lengths.push(0); }
    }
    if (lengths.length < 2) continue;

    const deltas: number[] = [];
    for (let i = 1; i < lengths.length; i++) deltas.push(lengths[i] - lengths[i - 1]);
    const avgLen = lengths.reduce((s, v) => s + v, 0) / lengths.length;
    const avgDelta = deltas.reduce((s, v) => s + v, 0) / deltas.length;
    const totalGrowth = lengths[lengths.length - 1] - lengths[0];

    let goal = '';
    const mp = join(root, sid, 'meta.json');
    if (existsSync(mp)) {
      try { goal = JSON.parse(await readFile(mp, 'utf8')).goal ?? ''; } catch (e) { /* */ }
    }

    sessions.push({
      sid, goal,
      totalRounds: lengths.length,
      lengths, deltas,
      avgLength: avgLen,
      avgDelta,
      totalGrowth,
    });
  }
}

sessions.sort((a, b) => b.totalGrowth - a.totalGrowth);

const total = sessions.length;
const avgTotalGrowth = sessions.length > 0 ? sessions.reduce((s, x) => s + x.totalGrowth, 0) / sessions.length : 0;
const growingSessions = sessions.filter((s) => s.totalGrowth > 0).length;
const shrinkingSessions = sessions.filter((s) => s.totalGrowth < 0).length;
const stableSessions = sessions.filter((s) => s.totalGrowth === 0).length;

function fmt(n: number): string {
  if (n > 1000) return `${(n / 1000).toFixed(1)}K`;
  return n.toFixed(0);
}

function sparkline(arr: number[], width = 18): string {
  if (arr.length === 0) return '·'.repeat(width);
  const mn = Math.min(...arr);
  const mx = Math.max(...arr);
  const range = mx - mn || 1;
  const chars = ['▁', '▂', '▃', '▄', '▅', '▆', '▇', '█'];
  const out: string[] = [];
  for (let i = 0; i < width; i++) {
    const idx = Math.floor((i / (width - 1)) * (arr.length - 1));
    const v = arr[Math.max(0, Math.min(arr.length - 1, idx))];
    const ratio = (v - mn) / range;
    out.push(chars[Math.min(chars.length - 1, Math.floor(ratio * (chars.length - 1)))]);
  }
  return out.join('');
}

function esc(s: any): string {
  const str = String(s == null ? '' : s);
  return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}
---

<BaseLayout title="Designer Edit Magnitude · Agents">
  <Navbar />
  <main class="shell agents-shell">
    <nav class="agents-breadcrumb">
      <a href={`${base}/agents/`}>← 多智能体控制台</a>
      <span class="muted"> / designer-edit-magnitude</span>
    </nav>

    <header class="agents-header">
      <h1>✏️ Designer Edit Magnitude <span class="muted" style="font-size:0.6em">(iter #355)</span></h1>
      <p class="agents-sub">
        每 round 中 designer output 长度的变化(Δ chars)。
        +Δ = 写得更多(扩展);−Δ = 删减。
      </p>
    </header>

    <section class="agents-session-section">
      <h2>📊 全局</h2>
      <div class="agents-dem-globals">
        <span>sessions: <strong>{total}</strong></span>
        <span>growing: <strong style="color:#10b981">{growingSessions}</strong></span>
        <span>shrinking: <strong style="color:#ef4444">{shrinkingSessions}</strong></span>
        <span>stable: <strong>{stableSessions}</strong></span>
        <span>avg total growth: <strong>{fmt(avgTotalGrowth)}</strong></span>
      </div>
    </section>

    <section class="agents-session-section">
      <h2>📝 8 个 sample 长度 sparkline</h2>
      <pre class="agents-dem-flow">{sessions.slice(0, 8).map((s) => `${esc(s.sid.slice(0, 8))}  ${sparkline(s.lengths, 24)}  ${fmt(s.lengths[0])}→${fmt(s.lengths[s.lengths.length - 1])}`).join('\n')}</pre>
    </section>

    <section class="agents-session-section">
      <h2>🚀 Top 10 most-growing sessions</h2>
      <table class="agents-session-table">
        <thead>
          <tr><th>#</th><th>sid</th><th>rounds</th><th>total growth</th><th>avg length</th><th>avg delta</th><th>goal</th></tr>
        </thead>
        <tbody>
          {sessions.slice(0, 10).map((s, i) => (
            <tr>
              <td>{i + 1}</td>
              <td><a href={`${base}/agents/${s.sid}/`}><code>{esc(s.sid.slice(0, 10))}</code></a></td>
              <td>{s.totalRounds}</td>
              <td><strong style="color:#10b981">+{fmt(s.totalGrowth)}</strong></td>
              <td>{fmt(s.avgLength)}</td>
              <td>{s.avgDelta >= 0 ? '+' : ''}{fmt(s.avgDelta)}</td>
              <td><small class="muted">{esc(s.goal.slice(0, 18))}{s.goal.length > 18 ? '…' : ''}</small></td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="agents-session-section">
      <h2>📉 Top 8 most-shrinking sessions</h2>
      <table class="agents-session-table">
        <thead>
          <tr><th>#</th><th>sid</th><th>rounds</th><th>total growth</th><th>avg length</th><th>goal</th></tr>
        </thead>
        <tbody>
          {sessions.slice().reverse().slice(0, 8).map((s, i) => (
            <tr>
              <td>{i + 1}</td>
              <td><a href={`${base}/agents/${s.sid}/`}><code>{esc(s.sid.slice(0, 10))}</code></a></td>
              <td>{s.totalRounds}</td>
              <td><strong style="color:#ef4444">{fmt(s.totalGrowth)}</strong></td>
              <td>{fmt(s.avgLength)}</td>
              <td><small class="muted">{esc(s.goal.slice(0, 18))}{s.goal.length > 18 ? '…' : ''}</small></td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="agents-session-section">
      <h2>💡 解读</h2>
      <ul>
        <li>total growth &gt; 0 = designer 在扩展内容</li>
        <li>total growth &lt; 0 = designer 在精简内容</li>
        <li>avg delta 接近 0 = designer 几乎不动</li>
        <li>对照 <a href={`${base}/agents/designer-revision-rate/`}>Designer Revision Rate</a></li>
        <li>对照 <a href={`${base}/agents/synthesis-length-statistics/`}>Synthesis Length Statistics</a></li>
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .agents-dem-globals {
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
  }
  .agents-dem-globals strong {
    color: #4f46e5;
    font-family: ui-monospace, monospace;
    margin: 0 0.3rem;
  }
  .agents-dem-flow {
    background: rgba(0,0,0,0.4);
    color: #c9d1d9;
    padding: 0.8rem;
    border-radius: 4px;
    font-family: ui-monospace, "JetBrains Mono", monospace;
    font-size: 0.78rem;
    line-height: 1.4;
    overflow-x: auto;
    white-space: pre;
  }
</style>