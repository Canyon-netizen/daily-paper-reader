---
// /agents/round-cost-hist.astro — iter #177:per-round token cost histogram
//
// 单轮 token 消耗的 log-scale 直方图:
//   - 0-1k / 1k-5k / 5k-20k / 20k-50k / 50k-200k / 200k+
//   - 平均 / 中位
//   - top 10 最贵 rounds
//   - per-session 最贵 round 标注

import { readFile, readdir } from 'node:fs/promises';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import '../../styles/agents.css';

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');

interface RoundCost {
  sid: string;
  roundIdx: number;
  tokens: number;
  goal: string;
}

const root = join(process.cwd(), 'archive');
const rounds: RoundCost[] = [];

if (existsSync(root)) {
  const sids = await readdir(root).catch(() => []);
  for (const sid of sids) {
    let goal = '';
    const mp = join(root, sid, 'meta.json');
    if (existsSync(mp)) {
      try { goal = JSON.parse(await readFile(mp, 'utf8')).goal ?? ''; } catch (e) { /* */ }
    }
    const rd = join(root, sid, 'rounds');
    if (!existsSync(rd)) continue;
    const rfs = await readdir(rd).catch(() => []);
    for (const rf of rfs) {
      const m = rf.match(/^round_(\d+)\.json$/);
      if (!m) continue;
      const idx = parseInt(m[1], 10);
      try {
        const r = JSON.parse(await readFile(join(rd, rf), 'utf8'));
        const tokens = r.feedback?.total_tokens ?? 0;
        rounds.push({ sid, roundIdx: idx, tokens, goal });
      } catch (e) { /* */ }
    }
  }
}

const buckets = [
  { label: '< 1k   ', min: 0, max: 1000, count: 0 },
  { label: '1k-5k ', min: 1000, max: 5000, count: 0 },
  { label: '5k-20k', min: 5000, max: 20000, count: 0 },
  { label: '20k-50k', min: 20000, max: 50000, count: 0 },
  { label: '50k-200k', min: 50000, max: 200000, count: 0 },
  { label: '> 200k', min: 200000, max: Infinity, count: 0 },
];
for (const r of rounds) {
  for (const b of buckets) {
    if (r.tokens >= b.min && r.tokens < b.max) {
      b.count += 1;
      break;
    }
  }
}
const maxBucket = Math.max(...buckets.map((b) => b.count), 1);

const total = rounds.length;
const sum = rounds.reduce((s, r) => s + r.tokens, 0);
const mean = total > 0 ? sum / total : 0;
const sorted = rounds.map((r) => r.tokens).sort((a, b) => a - b);
const median = total > 0 ? (total % 2 === 0 ? (sorted[total / 2 - 1] + sorted[total / 2]) / 2 : sorted[(total - 1) / 2]) : 0;
const max = sorted[sorted.length - 1] ?? 0;

const topExpensive = [...rounds].sort((a, b) => b.tokens - a.tokens).slice(0, 15);

function bar(n: number, max: number, width = 24): string {
  if (!max) return '░'.repeat(width);
  const filled = Math.round((n / max) * width);
  return '█'.repeat(filled) + '░'.repeat(width - filled);
}
function fmt(n: number): string {
  if (n >= 1e6) return (n / 1e6).toFixed(2) + 'M';
  if (n >= 1e3) return (n / 1e3).toFixed(1) + 'k';
  return n.toFixed(0);
}
function esc(s: any): string {
  return String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({ '&': '&', '<': '<', '>': '>', '"': '"', "'": '&#39;' }[c] || c));
}
---

<BaseLayout title="Round Cost Histogram · Agents">
  <Navbar />
  <main class="shell agents-shell">
    <nav class="agents-breadcrumb">
      <a href={`${base}/agents/`}>← 多智能体控制台</a>
      <span class="muted"> / round-cost-hist</span>
    </nav>

    <header class="agents-header">
      <h1>💰 Round Cost Histogram <span class="muted" style="font-size:0.6em">(iter #177)</span></h1>
      <p class="agents-sub">
        单轮 token 消耗的 log-scale 直方图。
        识别哪些 round 异常昂贵。
      </p>
    </header>

    <section class="agents-session-section">
      <h2>📊 全局</h2>
      <div class="agents-rch-globals">
        <span>总 rounds: <strong>{total}</strong></span>
        <span>mean tokens: <strong>{fmt(mean)}</strong></span>
        <span>median: <strong>{fmt(median)}</strong></span>
        <span>max: <strong>{fmt(max)}</strong></span>
        <span>total: <strong>{fmt(sum)}</strong></span>
      </div>
    </section>

    <section class="agents-session-section">
      <h2>📊 直方图(log-scale)</h2>
      <pre class="agents-rch-flow">{buckets.map((b) => {
        const pct = total > 0 ? ((b.count / total) * 100).toFixed(1) : '0';
        return `${b.label} ${bar(b.count, maxBucket, 24)}  ${String(b.count).padStart(4)} (${pct}%)`;
      }).join('\n')}</pre>
    </section>

    <section class="agents-session-section">
      <h2>💸 top 15 最贵 rounds</h2>
      <table class="agents-session-table">
        <thead>
          <tr><th>sid</th><th>round</th><th>tokens</th><th>估算 cost (Sonnet)</th></tr>
        </thead>
        <tbody>
          {topExpensive.map((r) => (
            <tr>
              <td><a href={`${base}/agents/${r.sid}/`}><code>{esc(r.sid.slice(0, 14))}</code></a></td>
              <td>R{r.roundIdx}</td>
              <td><strong>{r.tokens.toLocaleString()}</strong></td>
              <td>${((r.tokens / 1_000_000) * 6).toFixed(2)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="agents-session-section">
      <h2>💡 解读</h2>
      <ul>
        <li>单轮 &gt 200k 通常意味着 feedback prompt 太大 — 看 <a href={`${base}/agents/llm-usage/`}>LLM Usage</a></li>
        <li>如果 &gt 50k 段比例高,说明多数 round 都很贵</li>
        <li>对照 <a href={`${base}/agents/token-efficiency/`}>Token Efficiency</a> 看 session 整体效率</li>
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .agents-rch-globals {
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
  }
  .agents-rch-globals strong {
    color: #4f46e5;
    font-family: ui-monospace, monospace;
    margin: 0 0.3rem;
  }
  .agents-rch-flow {
    background: rgba(0,0,0,0.4);
    color: #c9d1d9;
    padding: 0.8rem;
    border-radius: 4px;
    font-family: ui-monospace, "JetBrains Mono", monospace;
    font-size: 0.78rem;
    line-height: 1.4;
    overflow-x: auto;
    white-space: pre;
  }
</style>