---
// /agents/action-set-diversity.astro — iter #274:per-round action set diversity
//
// 每个 round 应用了多少不同 action?
//   - 0 = no actions
//   - 1-3 = single mode
//   - 4+ = diverse mode

import { readFile, readdir } from 'node:fs/promises';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import '../../styles/agents.css';

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');

interface SessionDiversity {
  sid: string;
  totalRounds: number;
  avgUnique: number;
  maxUnique: number;
  totalDiversity: number;
}

const root = join(process.cwd(), 'archive');
const sessions: SessionDiversity[] = [];

if (existsSync(root)) {
  const sids = await readdir(root).catch(() => []);
  for (const sid of sids) {
    const rd = join(root, sid, 'rounds');
    if (!existsSync(rd)) continue;
    const rfs = await readdir(rd).catch(() => []);
    const rNum: number[] = [];
    for (const rf of rfs) {
      const m = rf.match(/^round_(\d+)\.json$/);
      if (m) rNum.push(parseInt(m[1], 10));
    }
    if (rNum.length === 0) continue;
    let totalUnique = 0;
    let maxUnique = 0;
    for (const rn of rNum) {
      try {
        const r = JSON.parse(await readFile(join(rd, `round_${rn}.json`), 'utf8'));
        const acts = new Set<string>();
        for (const a of (r.modifier?.applied ?? [])) {
          acts.add(a.action ?? a.type ?? 'unknown');
        }
        totalUnique += acts.size;
        if (acts.size > maxUnique) maxUnique = acts.size;
      } catch (e) { /* */ }
    }
    sessions.push({
      sid,
      totalRounds: rNum.length,
      avgUnique: rNum.length > 0 ? totalUnique / rNum.length : 0,
      maxUnique,
      totalDiversity: totalUnique,
    });
  }
}

const total = sessions.length;

// 全局 unique 分布
const buckets = [
  { label: '0 actions', min: 0, max: 0, count: 0 },
  { label: '1', min: 1, max: 2, count: 0 },
  { label: '2', min: 2, max: 3, count: 0 },
  { label: '3', min: 3, max: 4, count: 0 },
  { label: '4', min: 4, max: 5, count: 0 },
  { label: '5+', min: 5, max: 99999, count: 0 },
];
let allRoundCount = 0;
let sumUnique = 0;
let maxSingle = 0;

for (const sid of (await readdir(root).catch(() => []))) {
  const rd = join(root, sid, 'rounds');
  if (!existsSync(rd)) continue;
  const rfs = await readdir(rd).catch(() => []);
  for (const rf of rfs) {
    if (!/^round_\d+\.json$/.test(rf)) continue;
    try {
      const r = JSON.parse(await readFile(join(rd, rf), 'utf8'));
      const acts = new Set<string>();
      for (const a of (r.modifier?.applied ?? [])) {
        acts.add(a.action ?? a.type ?? 'unknown');
      }
      const n = acts.size;
      allRoundCount += 1;
      sumUnique += n;
      if (n > maxSingle) maxSingle = n;
      for (const b of buckets) {
        if (n >= b.min && n < b.max) {
          b.count += 1;
          break;
        }
      }
    } catch (e) { /* */ }
  }
}

const avgUniqueGlobal = allRoundCount > 0 ? sumUnique / allRoundCount : 0;
const maxBucketCount = Math.max(...buckets.map((b) => b.count), 1);

// top by total diversity
const topDiverse = [...sessions].sort((a, b) => b.totalDiversity - a.totalDiversity).slice(0, 12);
const topAvgUnique = [...sessions].filter((s) => s.totalRounds >= 3).sort((a, b) => b.avgUnique - a.avgUnique).slice(0, 12);

function esc(s: any): string {
  const str = String(s == null ? '' : s);
  return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}
function bar(n: number, max: number, width = 18): string {
  if (!max) return '░'.repeat(width);
  const filled = Math.round((n / max) * width);
  return '█'.repeat(filled) + '░'.repeat(width - filled);
}
---

<BaseLayout title="Action Set Diversity · Agents">
  <Navbar />
  <main class="shell agents-shell">
    <nav class="agents-breadcrumb">
      <a href={`${base}/agents/`}>← 多智能体控制台</a>
      <span class="muted"> / action-set-diversity</span>
    </nav>

    <header class="agents-header">
      <h1>🌈 Action Set Diversity <span class="muted" style="font-size:0.6em">(iter #274)</span></h1>
      <p class="agents-sub">
        每个 round 应用了多少不同 action?高 diversity 表示 modifier 尝试多种组合。
      </p>
    </header>

    <section class="agents-session-section">
      <h2>📊 全局</h2>
      <div class="agents-asd-globals">
        <span>总 sessions: <strong>{total}</strong></span>
        <span>总 rounds: <strong>{allRoundCount}</strong></span>
        <span>avg unique actions / round: <strong>{avgUniqueGlobal.toFixed(2)}</strong></span>
        <span>max single round: <strong>{maxSingle}</strong></span>
      </div>
    </section>

    <section class="agents-session-section">
      <h2>📊 unique actions / round 分布</h2>
      <pre class="agents-asd-flow">{buckets.map((b) => {
        return `${b.label.padEnd(10)} ${bar(b.count, maxBucketCount, 22)}  ${b.count}  (${((b.count / allRoundCount) * 100).toFixed(1)}%)`;
      }).join('\n')}</pre>
    </section>

    <section class="agents-session-section">
      <h2>🏆 top 12 累计多样性最大 sessions</h2>
      <table class="agents-session-table">
        <thead>
          <tr><th>total</th><th>rounds</th><th>avg</th><th>max</th><th>sid</th></tr>
        </thead>
        <tbody>
          {topDiverse.map((s) => (
            <tr>
              <td><strong style="color:#10b981">{s.totalDiversity}</strong></td>
              <td>{s.totalRounds}</td>
              <td>{s.avgUnique.toFixed(2)}</td>
              <td>{s.maxUnique}</td>
              <td><a href={`${base}/agents/${s.sid}/`}><code>{esc(s.sid.slice(0, 12))}</code></a></td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="agents-session-section">
      <h2>📈 top 12 avg unique / round 最高 sessions(rounds ≥ 3)</h2>
      <table class="agents-session-table">
        <thead>
          <tr><th>avg</th><th>rounds</th><th>max</th><th>total</th><th>sid</th></tr>
        </thead>
        <tbody>
          {topAvgUnique.map((s) => (
            <tr>
              <td><strong style="color:#10b981">{s.avgUnique.toFixed(2)}</strong></td>
              <td>{s.totalRounds}</td>
              <td>{s.maxUnique}</td>
              <td>{s.totalDiversity}</td>
              <td><a href={`${base}/agents/${s.sid}/`}><code>{esc(s.sid.slice(0, 12))}</code></a></td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="agents-session-section">
      <h2>💡 解读</h2>
      <ul>
        <li>avg &gt; 2.5 = modifier 习惯每次用多种 actions</li>
        <li>avg ≈ 1 = 单 action 模式</li>
        <li>0 actions = 该 round modifier 没动</li>
        <li>对照 <a href={`${base}/agents/action-diversity/`}>Action Diversity</a> 看全局</li>
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .agents-asd-globals {
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
  }
  .agents-asd-globals strong {
    color: #4f46e5;
    font-family: ui-monospace, monospace;
    margin: 0 0.3rem;
  }
  .agents-asd-flow {
    background: rgba(0,0,0,0.4);
    color: #c9d1d9;
    padding: 0.8rem;
    border-radius: 4px;
    font-family: ui-monospace, "JetBrains Mono", monospace;
    font-size: 0.78rem;
    line-height: 1.4;
    overflow-x: auto;
    white-space: pre;
  }
</style>