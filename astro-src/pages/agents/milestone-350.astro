---
// /agents/milestone-350.astro — iter #350:milestone page

import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import '../../styles/agents.css';

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
---

<BaseLayout title="Milestone 350 · Agents">
  <Navbar />
  <main class="shell agents-shell">
    <nav class="agents-breadcrumb">
      <a href={`${base}/agents/`}>← 多智能体控制台</a>
      <span class="muted"> / milestone-350</span>
    </nav>

    <header class="agents-header milestone-celebrate">
      <h1 class="milestone-title">🎉 ITER #350 🎉</h1>
      <p class="agents-sub">
        Triple Century + 50 = 离 Quad-Century (400) 还有 50 步。
      </p>
    </header>

    <section class="agents-session-section milestone-stats">
      <h2>📊 当前进度</h2>
      <div class="milestone-grid">
        <div class="milestone-tile">
          <div class="milestone-num">350</div>
          <div class="milestone-label">iters</div>
        </div>
        <div class="milestone-tile">
          <div class="milestone-num">~350</div>
          <div class="milestone-label">agent pages</div>
        </div>
        <div class="milestone-tile">
          <div class="milestone-num">50</div>
          <div class="milestone-label">to milestone 400</div>
        </div>
      </div>
    </section>

    <section class="agents-session-section">
      <h2>🏆 主要里程碑</h2>
      <ul>
        <li><strong>#100</strong> — first century</li>
        <li><strong>#200</strong> — double century</li>
        <li><strong>#250</strong> — quarter-millennium</li>
        <li><strong>#270</strong> — sprint to 300</li>
        <li><strong>#280</strong> — pre-triple-century</li>
        <li><strong>#299</strong> — one before 300</li>
        <li><strong>#300</strong> — TRIPLE CENTURY 🎉</li>
        <li><strong>#320</strong> — post-triple-century</li>
        <li><strong>#350</strong> — YOU ARE HERE</li>
      </ul>
    </section>

    <section class="agents-session-section">
      <h2>🎯 接下来的方向</h2>
      <ul>
        <li>400 — quad-century</li>
        <li>500 — half-millennium</li>
        <li>1000 — millennium</li>
      </ul>
    </section>

    <section class="agents-session-section">
      <h2>💡 回顾</h2>
      <p>
        过去 ~50 个 iter 集中在:
      </p>
      <ul>
        <li>action 序列分析 (transition / trigram / hot streak)</li>
        <li>persona 维度 (specialty / bias / repetition / agreement)</li>
        <li>cost 维度 (density / cost-by-action / cost-per-score-point)</li>
        <li>score 维度 (convergence / climb rate / volatility)</li>
        <li>designer-feedback 闭环 (alignment / revision rate)</li>
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .milestone-celebrate {
    text-align: center;
    padding: 2rem 1rem;
    background: linear-gradient(135deg, #4f46e5 0%, #8b5cf6 50%, #ec4899 100%);
    border-radius: 12px;
    margin-bottom: 1.5rem;
    color: white;
    box-shadow: 0 6px 24px rgba(79, 70, 229, 0.4);
  }
  .milestone-title {
    font-size: 2.5rem;
    margin: 0;
    font-weight: 800;
    letter-spacing: -0.02em;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
  }
  .milestone-stats {
    background: linear-gradient(180deg, rgba(79, 70, 229, 0.05) 0%, transparent 100%);
  }
  .milestone-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 1rem;
  }
  .milestone-tile {
    background: rgba(79, 70, 229, 0.08);
    border: 1px solid rgba(79, 70, 229, 0.3);
    border-radius: 8px;
    padding: 1.2rem 1rem;
    text-align: center;
  }
  .milestone-num {
    font-size: 2.2rem;
    font-weight: 700;
    color: #4f46e5;
    font-family: ui-monospace, monospace;
    line-height: 1;
  }
  .milestone-label {
    font-size: 0.85rem;
    color: #94a3b8;
    margin-top: 0.4rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
</style>