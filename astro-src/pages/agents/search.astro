---
// /agents/search.astro — iter #172:session search engine
//
// 跨 session 全文搜索:
//   - 搜索 meta.goal + synthesis.md 内容
//   - 显示匹配 sessions + matches
//   - 实时过滤
//   - 高亮匹配词

import { readFile, readdir, stat } from 'node:fs/promises';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import '../../styles/agents.css';

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');

interface SearchResult {
  sid: string;
  goal: string;
  goalLower: string;
  synthPreview: string;
  synthLower: string;
  synthCount: number;
  rounds: number;
  mtime: number;
  goalMatch: boolean;
  synthMatch: boolean;
}

const root = join(process.cwd(), 'archive');
const results: SearchResult[] = [];

if (existsSync(root)) {
  const sids = await readdir(root).catch(() => []);
  for (const sid of sids) {
    let goal = '';
    const mp = join(root, sid, 'meta.json');
    if (!existsSync(mp)) continue;
    try { goal = JSON.parse(await readFile(mp, 'utf8')).goal ?? ''; } catch (e) { /* */ }
    const rd = join(root, sid, 'rounds');
    const sd = join(root, sid, 'synthesis');
    let rounds = 0;
    let lastMtime = 0;
    if (existsSync(rd)) {
      const rfs = await readdir(rd).catch(() => []);
      for (const rf of rfs) {
        if (!/^round_\d+\.json$/.test(rf)) continue;
        rounds += 1;
      }
      try {
        const st = await stat(rd);
        lastMtime = st.mtimeMs;
      } catch (e) { /* */ }
    }
    let synthPreview = '';
    let synthCount = 0;
    if (existsSync(sd)) {
      const sfs = await readdir(sd).catch(() => []);
      const sf = sfs.filter((f) => /^synthesis_\d+\.md$/.test(f)).sort().slice(-1)[0];
      if (sf) {
        try {
          synthPreview = (await readFile(join(sd, sf), 'utf8')).slice(0, 1500);
        } catch (e) { /* */ }
      }
      synthCount = sfs.filter((f) => /^synthesis_\d+\.md$/.test(f)).length;
    }
    results.push({
      sid,
      goal,
      goalLower: goal.toLowerCase(),
      synthPreview,
      synthLower: synthPreview.toLowerCase(),
      synthCount,
      rounds,
      mtime: lastMtime,
      goalMatch: false,
      synthMatch: false,
    });
  }
}

results.sort((a, b) => b.mtime - a.mtime);

function esc(s: any): string {
  return String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({ '&': '&', '<': '<', '>': '>', '"': '"', "'": '&#39;' }[c] || c));
}
---

<BaseLayout title="Session Search · Agents">
  <Navbar />
  <main class="shell agents-shell">
    <nav class="agents-breadcrumb">
      <a href={`${base}/agents/`}>← 多智能体控制台</a>
      <span class="muted"> / search</span>
    </nav>

    <header class="agents-header">
      <h1>🔎 Session Search <span class="muted" style="font-size:0.6em">(iter #172)</span></h1>
      <p class="agents-sub">
        跨 session 全文搜索。匹配 goal + synthesis 内容。
        共 {results.length} 个 session 可搜索。
      </p>
    </header>

    <section class="agents-session-section">
      <h2>🔍 搜索</h2>
      <input id="search-input" type="search" placeholder="关键词 …" autocomplete="off" style="width:100%;padding:0.7rem;border-radius:6px;border:1px solid rgba(99,102,241,0.3);background:rgba(99,102,241,0.05);color:inherit;font-family:inherit;font-size:1rem" />
      <p class="muted"><small>实时过滤。空格分隔多个关键词(全部都要包含)。</small></p>
    </section>

    <section class="agents-session-section">
      <h2>📋 结果(<span id="search-count">{results.length}</span>)</h2>
      <ul class="agents-search-list" id="search-results">
        {results.map((r) => (
          <li class="agents-search-item"
              data-goal={esc(r.goalLower)}
              data-synth={esc(r.synthLower)}
              data-sid={esc(r.sid)}>
            <div class="agents-search-head">
              <a href={`${base}/agents/${r.sid}/`}><code>{esc(r.sid.slice(0, 18))}</code></a>
              <span class="muted">
                <small> · {r.rounds} rounds · {r.synthCount} synth</small>
              </span>
            </div>
            <p class="agents-search-goal">
              <strong>goal:</strong> <span class="goal-text">{esc(r.goal)}</span>
            </p>
            {r.synthPreview && (
              <p class="muted agents-search-synth">
                <small>
                  <strong>synth:</strong> <span class="synth-text">{esc(r.synthPreview.slice(0, 240))}…</span>
                </small>
              </p>
            )}
          </li>
        ))}
      </ul>
    </section>
  </main>
</BaseLayout>

<script>
  const input = document.getElementById('search-input') as HTMLInputElement | null;
  const countEl = document.getElementById('search-count');
  const items = document.querySelectorAll<HTMLElement>('.agents-search-item');

  function escapeHtml(s: string): string {
    return s.replace(/[&<>"']/g, (c) => ({ '&': '&', '<': '<', '>': '>', '"': '"', "'": '&#39;' }[c] || c));
  }

  function escapeReg(s: string): string {
    return s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  }

  function highlight(text: string, q: string): string {
    if (!q) return escapeHtml(text);
    const safe = escapeHtml(text);
    const terms = q.split(/\s+/).filter(Boolean).map(escapeReg);
    if (terms.length === 0) return safe;
    const re = new RegExp(`(${terms.join('|')})`, 'gi');
    return safe.replace(re, '<mark style="background:#facc15;color:#000;padding:0 2px;border-radius:2px">$1</mark>');
  }

  function applyFilter(): void {
    if (!input) return;
    const raw = input.value.trim();
    const q = raw.toLowerCase();
    const terms = q.split(/\s+/).filter(Boolean);
    let shown = 0;

    items.forEach((el) => {
      const goal = el.getAttribute('data-goal') ?? '';
      const synth = el.getAttribute('data-synth') ?? '';
      let match = false;
      if (terms.length === 0) {
        match = true;
      } else {
        match = terms.every((t) => goal.includes(t) || synth.includes(t));
      }
      el.style.display = match ? '' : 'none';
      if (match) {
        shown += 1;
        // 高亮匹配词
        const goalTextEl = el.querySelector('.goal-text');
        const synthTextEl = el.querySelector('.synth-text');
        if (goalTextEl) {
          const original = el.querySelector('.goal-text')?.getAttribute('data-orig') ?? goalTextEl.textContent ?? '';
          if (!el.querySelector('.goal-text')?.hasAttribute('data-orig')) {
            goalTextEl.setAttribute('data-orig', goalTextEl.textContent ?? '');
          }
          const origGoal = goalTextEl.getAttribute('data-orig') ?? '';
          goalTextEl.innerHTML = highlight(origGoal, raw);
        }
        if (synthTextEl) {
          if (!synthTextEl.hasAttribute('data-orig')) {
            synthTextEl.setAttribute('data-orig', synthTextEl.textContent ?? '');
          }
          const origSynth = synthTextEl.getAttribute('data-orig') ?? '';
          synthTextEl.innerHTML = highlight(origSynth, raw);
        }
      }
    });

    if (countEl) countEl.textContent = String(shown);
  }

  input?.addEventListener('input', applyFilter);
</script>

<style>
  .agents-search-list {
    list-style: none;
    padding: 0;
  }
  .agents-search-item {
    background: rgba(99, 102, 241, 0.05);
    border-left: 3px solid rgba(99, 102, 241, 0.4);
    padding: 0.7rem;
    margin-bottom: 0.5rem;
    border-radius: 4px;
  }
  .agents-search-item p {
    margin: 0.2rem 0;
  }
  .agents-search-head {
    margin-bottom: 0.3rem;
  }
</style>