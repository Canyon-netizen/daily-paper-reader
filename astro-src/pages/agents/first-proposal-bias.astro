---
// /agents/first-proposal-bias.astro — iter #216:first proposal scoring bias
//
// 检查每 round 中第一个 proposal 是否评分偏高(primacy bias)
//   - 对每个 round,取 first / last proposal 的 avg score
//   - 比较 first vs last 平均分差
//   - 检测 ordering effect

import { readFile, readdir } from 'node:fs/promises';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import '../../styles/agents.css';

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');

interface BiasDatum {
  sid: string;
  roundIdx: number;
  firstScore: number;
  lastScore: number;
  midScore: number;
  count: number;
  bias: number;  // first - last
}

const root = join(process.cwd(), 'archive');
const records: BiasDatum[] = [];

if (existsSync(root)) {
  const sids = await readdir(root).catch(() => []);
  for (const sid of sids) {
    const rd = join(root, sid, 'rounds');
    if (!existsSync(rd)) continue;
    const rfs = await readdir(rd).catch(() => []);
    const rNum: number[] = [];
    for (const rf of rfs) {
      const m = rf.match(/^round_(\d+)\.json$/);
      if (m) rNum.push(parseInt(m[1], 10));
    }
    rNum.sort((a, b) => a - b);
    for (const ri of rNum) {
      try {
        const r = JSON.parse(await readFile(join(rd, `round_${ri}.json`), 'utf8'));
        const allScores: number[] = [];
        for (const persona of r.feedback?.personas ?? []) {
          for (const p of persona.proposals ?? []) {
            if (typeof p.total === 'number') allScores.push(p.total);
          }
        }
        if (allScores.length < 3) continue;
        const first = allScores[0];
        const last = allScores[allScores.length - 1];
        const mid = allScores.slice(1, -1).reduce((a, b) => a + b, 0) / Math.max(allScores.length - 2, 1);
        records.push({
          sid, roundIdx: ri,
          firstScore: first,
          lastScore: last,
          midScore: mid,
          count: allScores.length,
          bias: first - last,
        });
      } catch (e) { /* */ }
    }
  }
}

const total = records.length;
const avgFirst = records.reduce((s, r) => s + r.firstScore, 0) / Math.max(records.length, 1);
const avgLast = records.reduce((s, r) => s + r.lastScore, 0) / Math.max(records.length, 1);
const avgMid = records.reduce((s, r) => s + r.midScore, 0) / Math.max(records.length, 1);
const avgBias = records.reduce((s, r) => s + r.bias, 0) / Math.max(records.length, 1);

// first 占优 / last 占优 / 中间占优
const firstWins = records.filter((r) => r.bias > 0.5).length;
const lastWins = records.filter((r) => r.bias < -0.5).length;
const neutral = records.filter((r) => Math.abs(r.bias) <= 0.5).length;

const topFirst = [...records].sort((a, b) => b.bias - a.bias).slice(0, 15);
const topLast = [...records].sort((a, b) => a.bias - b.bias).slice(0, 15);

function bar(n: number, max: number, width = 20): string {
  if (!max) return '░'.repeat(width);
  const filled = Math.round((n / max) * width);
  return '█'.repeat(filled) + '░'.repeat(width - filled);
}
function esc(s: any): string {
  return String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({ '&': '&', '<': '<', '>': '>', '"': '"', "'": '&#39;' }[c] || c));
}
---

<BaseLayout title="First Proposal Bias · Agents">
  <Navbar />
  <main class="shell agents-shell">
    <nav class="agents-breadcrumb">
      <a href={`${base}/agents/`}>← 多智能体控制台</a>
      <span class="muted"> / first-proposal-bias</span>
    </nav>

    <header class="agents-header">
      <h1>🥇 First Proposal Bias <span class="muted" style="font-size:0.6em">(iter #216)</span></h1>
      <p class="agents-sub">
        每 round 中第一个 vs 最后一个 proposal 的评分差异。
        正 bias = primacy(开头占优);负 = recency(结尾占优)。
      </p>
    </header>

    <section class="agents-session-section">
      <h2>📊 全局</h2>
      <div class="agents-fpb-globals">
        <span>总 rounds (≥ 3 proposals): <strong>{total}</strong></span>
        <span>avg first score: <strong>{avgFirst.toFixed(2)}</strong></span>
        <span>avg mid score: <strong>{avgMid.toFixed(2)}</strong></span>
        <span>avg last score: <strong>{avgLast.toFixed(2)}</strong></span>
        <span>avg bias (first - last): <strong style={avgBias > 0 ? 'color:#10b981' : 'color:#ef4444'}>{avgBias >= 0 ? '+' : ''}{avgBias.toFixed(3)}</strong></span>
      </div>
    </section>

    <section class="agents-session-section">
      <h2>📊 分布</h2>
      <pre class="agents-fpb-flow">{`first wins (> +0.5):  ${String(firstWins).padStart(4)}  ${bar(firstWins, total, 24)}
last wins (< -0.5):   ${String(lastWins).padStart(4)}  ${bar(lastWins, total, 24)}
neutral:              ${String(neutral).padStart(4)}  ${bar(neutral, total, 24)}`}</pre>
    </section>

    <section class="agents-session-section">
      <h2>🥇 top 15 first 占优 rounds</h2>
      <table class="agents-session-table">
        <thead>
          <tr><th>bias</th><th>first</th><th>last</th><th>count</th><th>sid</th><th>round</th></tr>
        </thead>
        <tbody>
          {topFirst.map((r) => (
            <tr>
              <td><strong style="color:#10b981">+{r.bias.toFixed(2)}</strong></td>
              <td>{r.firstScore.toFixed(2)}</td>
              <td>{r.lastScore.toFixed(2)}</td>
              <td>{r.count}</td>
              <td><a href={`${base}/agents/${r.sid}/`}><code>{esc(r.sid.slice(0, 12))}</code></a></td>
              <td>R{r.roundIdx}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="agents-session-section">
      <h2>🥈 top 15 last 占优 rounds</h2>
      <table class="agents-session-table">
        <thead>
          <tr><th>bias</th><th>first</th><th>last</th><th>count</th><th>sid</th><th>round</th></tr>
        </thead>
        <tbody>
          {topLast.map((r) => (
            <tr>
              <td><strong style="color:#ef4444">{r.bias.toFixed(2)}</strong></td>
              <td>{r.firstScore.toFixed(2)}</td>
              <td>{r.lastScore.toFixed(2)}</td>
              <td>{r.count}</td>
              <td><a href={`${base}/agents/${r.sid}/`}><code>{esc(r.sid.slice(0, 12))}</code></a></td>
              <td>R{r.roundIdx}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="agents-session-section">
      <h2>💡 解读</h2>
      <ul>
        <li>positive bias = designer 开头出强 proposal</li>
        <li>negative bias = 末尾 proposal 占优(可能疲劳后简化)</li>
        <li>|bias| &lt; 0.5 = 无明显 ordering effect</li>
        <li>对照 <a href={`${base}/agents/persona-calibration/`}>Persona Calibration</a> 看分数校准</li>
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .agents-fpb-globals {
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
  }
  .agents-fpb-globals strong {
    color: #4f46e5;
    font-family: ui-monospace, monospace;
    margin: 0 0.3rem;
  }
  .agents-fpb-flow {
    background: rgba(0,0,0,0.4);
    color: #c9d1d9;
    padding: 0.8rem;
    border-radius: 4px;
    font-family: ui-monospace, "JetBrains Mono", monospace;
    font-size: 0.78rem;
    line-height: 1.4;
    overflow-x: auto;
    white-space: pre;
  }
</style>