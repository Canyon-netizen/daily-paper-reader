---
// /agents/cost-distribution.astro — iter #138:session cost distribution
//
// 跨 session 看 token 成本分布:
//   - 直方图(对数分桶)
//   - 统计指标(median, p90, p99, min, max)
//   - 列出最贵的 Top 20 sessions

import { readFile, readdir } from 'node:fs/promises';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import '../../styles/agents.css';

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');

interface CostPoint { sid: string; goal: string; tokens: number; rounds: number; avgScore: number; }

const points: CostPoint[] = [];
const root = join(process.cwd(), 'archive');
if (existsSync(root)) {
  const sids = await readdir(root).catch(() => []);
  for (const sid of sids) {
    const rd = join(root, sid, 'rounds');
    if (!existsSync(rd)) continue;
    let goal = '';
    const mp = join(root, sid, 'meta.json');
    if (existsSync(mp)) {
      try { goal = JSON.parse(await readFile(mp, 'utf8')).goal ?? ''; } catch (e) { /* */ }
    }
    let totalTokens = 0;
    let rounds = 0;
    const allScores: number[] = [];
    const rfs = await readdir(rd).catch(() => []);
    for (const rf of rfs) {
      if (!/^round_\d+\.json$/.test(rf)) continue;
      rounds += 1;
      try {
        const r = JSON.parse(await readFile(join(rd, rf), 'utf8'));
        totalTokens += r.feedback?.total_tokens ?? 0;
        for (const persona of r.feedback?.personas ?? []) {
          for (const p of persona.proposals ?? []) {
            if (typeof p.total === 'number') allScores.push(p.total);
          }
        }
      } catch (e) { /* */ }
    }
    const avgScore = allScores.length > 0 ? allScores.reduce((a, b) => a + b, 0) / allScores.length : 0;
    points.push({ sid, goal, tokens: totalTokens, rounds, avgScore });
  }
}

points.sort((a, b) => b.tokens - a.tokens);

// 对数分桶
const buckets: { label: string; min: number; max: number; count: number }[] = [
  { label: '< 1k',      min: 0,      max: 1_000,    count: 0 },
  { label: '1k-5k',     min: 1_000,  max: 5_000,    count: 0 },
  { label: '5k-10k',    min: 5_000,  max: 10_000,   count: 0 },
  { label: '10k-25k',   min: 10_000, max: 25_000,   count: 0 },
  { label: '25k-50k',   min: 25_000, max: 50_000,   count: 0 },
  { label: '50k-100k',  min: 50_000, max: 100_000,  count: 0 },
  { label: '100k-250k', min: 100_000,max: 250_000,  count: 0 },
  { label: '≥ 250k',    min: 250_000,max: 1e15,     count: 0 },
];
for (const p of points) {
  for (const b of buckets) {
    if (p.tokens >= b.min && p.tokens < b.max) { b.count += 1; break; }
  }
}

function percentile(arr: number[], q: number): number {
  if (arr.length === 0) return 0;
  const sorted = [...arr].sort((a, b) => a - b);
  const idx = Math.min(sorted.length - 1, Math.floor(sorted.length * q));
  return sorted[idx];
}

const tokens = points.map((p) => p.tokens);
const min = tokens.length > 0 ? Math.min(...tokens) : 0;
const max = tokens.length > 0 ? Math.max(...tokens) : 0;
const median = percentile(tokens, 0.5);
const p90 = percentile(tokens, 0.9);
const p95 = percentile(tokens, 0.95);
const p99 = percentile(tokens, 0.99);
const mean = tokens.length > 0 ? tokens.reduce((a, b) => a + b, 0) / tokens.length : 0;

function bar(n: number, max: number, width = 30): string {
  if (!max) return '░'.repeat(width);
  const filled = Math.round((n / max) * width);
  return '█'.repeat(filled) + '░'.repeat(width - filled);
}
function esc(s: any): string {
  return String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({ '&': '&', '<': '<', '>': '>', '"': '"', "'": '&#39;' }[c] || c));
}
---

<BaseLayout title="Cost Distribution · Agents">
  <Navbar />
  <main class="shell agents-shell">
    <nav class="agents-breadcrumb">
      <a href={`${base}/agents/`}>← 多智能体控制台</a>
      <span class="muted"> / cost-distribution</span>
    </nav>

    <header class="agents-header">
      <h1>💸 Cost Distribution <span class="muted" style="font-size:0.6em">(iter #138)</span></h1>
      <p class="agents-sub">
        跨 session 看 token 成本的分布。
        直方图(对数分桶)+ 统计指标(min / median / mean / p90 / p95 / p99 / max)+ Top 20 最贵 sessions。
      </p>
    </header>

    <section class="agents-session-section">
      <h2>📊 统计指标</h2>
      <div class="agents-cd-globals">
        <span>总 sessions: <strong>{points.length}</strong></span>
        <span>min: <strong>{min.toLocaleString()}</strong></span>
        <span>mean: <strong>{mean.toFixed(0).toLocaleString()}</strong></span>
        <span>median: <strong>{median.toLocaleString()}</strong></span>
        <span>p90: <strong>{p90.toLocaleString()}</strong></span>
        <span>p95: <strong>{p95.toLocaleString()}</strong></span>
        <span>p99: <strong>{p99.toLocaleString()}</strong></span>
        <span>max: <strong>{max.toLocaleString()}</strong></span>
      </div>
    </section>

    <section class="agents-session-section">
      <h2>📊 直方图(对数分桶)</h2>
      <pre class="agents-cd-flow">{buckets.map((b) => `${b.label.padEnd(12)} ${bar(b.count, Math.max(...buckets.map((x) => x.count)), 30)}  ${String(b.count).padStart(4)}`).join('\n')}</pre>
    </section>

    <section class="agents-session-section">
      <h2>🏆 Top 20 最贵 sessions</h2>
      <table class="agents-session-table">
        <thead>
          <tr><th>#</th><th>tokens</th><th>rounds</th><th>avg score</th><th>session</th><th>goal</th></tr>
        </thead>
        <tbody>
          {points.slice(0, 20).map((p, i) => (
            <tr>
              <td>{i + 1}</td>
              <td><strong>{p.tokens.toLocaleString()}</strong></td>
              <td>{p.rounds}</td>
              <td>{p.avgScore.toFixed(2)}</td>
              <td><a href={`${base}/agents/${p.sid}/`}><code>{esc(p.sid.slice(0, 14))}</code></a></td>
              <td><small>{esc((p.goal ?? '').slice(0, 50))}{(p.goal ?? '').length > 50 ? '…' : ''}</small></td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="agents-session-section">
      <h2>💡 解读</h2>
      <ul>
        <li><strong>p90</strong> 是大多数 session 的成本上限,新 session 可作参考</li>
        <li><strong>max</strong> 通常是异常值,看是否需要降级到更便宜的模型</li>
        <li>对照 <a href={`${base}/agents/cost-vs-score/`}>Cost vs Score</a> 看贵的 session 是否值得</li>
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .agents-cd-globals {
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
  }
  .agents-cd-globals strong {
    color: #4f46e5;
    font-family: ui-monospace, monospace;
    margin: 0 0.3rem;
  }
  .agents-cd-flow {
    background: rgba(0,0,0,0.4);
    color: #c9d1d9;
    padding: 0.8rem;
    border-radius: 4px;
    font-family: ui-monospace, "JetBrains Mono", monospace;
    font-size: 0.85rem;
    line-height: 1.5;
    overflow-x: auto;
    white-space: pre;
  }
</style>