---
// /agents/goal-type-round-distribution.astro — iter #381:round count distribution per goal type

import { readFile, readdir } from 'node:fs/promises';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import '../../styles/agents.css';

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');

interface TypeStats {
  type: string;
  sessions: number;
  rounds: number[];
  mean: number;
  median: number;
  min: number;
  max: number;
  std: number;
}

const root = join(process.cwd(), 'archive');
const typeMap = new Map<string, number[]>();

if (existsSync(root)) {
  const sids = await readdir(root).catch(() => []);
  for (const sid of sids) {
    const rd = join(root, sid, 'rounds');
    if (!existsSync(rd)) continue;
    const rfs = await readdir(rd).catch(() => []);
    let nRounds = 0;
    for (const rf of rfs) {
      if (rf.match(/^round_\d+\.json$/)) nRounds += 1;
    }
    if (nRounds === 0) continue;
    let type = 'unknown';
    const mp = join(root, sid, 'meta.json');
    if (existsSync(mp)) {
      try { type = JSON.parse(await readFile(mp, 'utf8')).type ?? 'unknown'; } catch (e) { /* */ }
    }
    if (!typeMap.has(type)) typeMap.set(type, []);
    typeMap.get(type)!.push(nRounds);
  }
}

function median(arr: number[]): number {
  if (arr.length === 0) return 0;
  const s = [...arr].sort((a, b) => a - b);
  return s[Math.floor(s.length / 2)];
}

function stddev(arr: number[]): number {
  if (arr.length < 2) return 0;
  const m = arr.reduce((s, v) => s + v, 0) / arr.length;
  return Math.sqrt(arr.reduce((s, v) => s + (v - m) ** 2, 0) / arr.length);
}

const results: TypeStats[] = [];
for (const [type, rounds] of typeMap.entries()) {
  if (rounds.length < 2) continue;
  results.push({
    type,
    sessions: rounds.length,
    rounds,
    mean: rounds.reduce((s, v) => s + v, 0) / rounds.length,
    median: median(rounds),
    min: Math.min(...rounds),
    max: Math.max(...rounds),
    std: stddev(rounds),
  });
}
results.sort((a, b) => b.mean - a.mean);

function sparkline(arr: number[], width = 10): string {
  if (arr.length === 0) return '·'.repeat(width);
  const chars = ['▁', '▂', '▃', '▄', '▅', '▆', '▇', '█'];
  const out: string[] = [];
  const lo = Math.min(...arr);
  const hi = Math.max(...arr);
  const range = hi - lo || 1;
  for (let i = 0; i < width; i++) {
    const idx = Math.floor((i / (width - 1)) * (arr.length - 1));
    const v = arr[Math.max(0, Math.min(arr.length - 1, idx))];
    const ratio = (v - lo) / range;
    out.push(chars[Math.min(chars.length - 1, Math.floor(ratio * (chars.length - 1)))]);
  }
  return out.join('');
}

function bar(n: number, max: number, width = 16): string {
  if (!max) return '░'.repeat(width);
  const filled = Math.round((n / max) * width);
  return '█'.repeat(filled) + '░'.repeat(width - filled);
}

function esc(s: any): string {
  const str = String(s == null ? '' : s);
  return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}
---

<BaseLayout title="Goal Type Round Distribution · Agents">
  <Navbar />
  <main class="shell agents-shell">
    <nav class="agents-breadcrumb">
      <a href={`${base}/agents/`}>← 多智能体控制台</a>
      <span class="muted"> / goal-type-round-distribution</span>
    </nav>

    <header class="agents-header">
      <h1>🎯 Goal Type Round Distribution <span class="muted" style="font-size:0.6em">(iter #381)</span></h1>
      <p class="agents-sub">
        每个 goal type 的 session 总 round 数分布。
        mean 高的 type = 需要更多轮迭代;std 大 = 长度不可预测。
      </p>
    </header>

    <section class="agents-session-section">
      <h2>📊 Type × rounds</h2>
      <table class="agents-session-table">
        <thead>
          <tr><th>type</th><th>n</th><th>mean</th><th>median</th><th>min</th><th>max</th><th>std</th><th>distribution</th></tr>
        </thead>
        <tbody>
          {results.map((r) => (
            <tr>
              <td><code>{esc(r.type)}</code></td>
              <td>{r.sessions}</td>
              <td><strong>{r.mean.toFixed(1)}</strong></td>
              <td>{r.median}</td>
              <td>{r.min}</td>
              <td>{r.max}</td>
              <td>{r.std.toFixed(2)}</td>
              <td><code style="font-size:0.7em">{sparkline(r.rounds, 12)}</code></td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="agents-session-section">
      <h2>💡 解读</h2>
      <ul>
        <li>mean 高的 type = 该类任务需要更多轮迭代才能收敛</li>
        <li>std 大的 type = 同 type session 的长度差异大(难度变化大)</li>
        <li>对照 <a href={`${base}/agents/goal-type-round-count-heatmap/`}>Goal Type Round Count Heatmap</a></li>
        <li>对照 <a href={`${base}/agents/session-round-duration-histogram/`}>Session Round-Duration Histogram</a></li>
      </ul>
    </section>
  </main>
</BaseLayout>

