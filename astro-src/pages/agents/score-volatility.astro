---
// /agents/score-volatility.astro — iter #264:score volatility index
//
// 每个 session round score 的标准差 σ:
//   - 高 σ = 分数波动大(unstable)
//   - 低 σ = 分数稳定
// 找出最不稳定和最稳定的 sessions

import { readFile, readdir } from 'node:fs/promises';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import '../../styles/agents.css';

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');

interface Vol {
  sid: string;
  goal: string;
  scores: number[];
  rounds: number;
  mean: number;
  std: number;
  range: number;
  cv: number;  // 变异系数 std/mean
}

const root = join(process.cwd(), 'archive');
const vols: Vol[] = [];

function stdev(values: number[]): { mean: number; std: number } {
  if (values.length === 0) return { mean: 0, std: 0 };
  const mean = values.reduce((a, b) => a + b, 0) / values.length;
  const variance = values.reduce((s, v) => s + (v - mean) ** 2, 0) / values.length;
  return { mean, std: Math.sqrt(variance) };
}

if (existsSync(root)) {
  const sids = await readdir(root).catch(() => []);
  for (const sid of sids) {
    const rd = join(root, sid, 'rounds');
    if (!existsSync(rd)) continue;
    const rfs = await readdir(rd).catch(() => []);
    const rNum: number[] = [];
    for (const rf of rfs) {
      const m = rf.match(/^round_(\d+)\.json$/);
      if (m) rNum.push(parseInt(m[1], 10));
    }
    if (rNum.length < 4) continue;
    rNum.sort((a, b) => a - b);
    let goal = '';
    const mp = join(rd, '..', 'meta.json');
    if (existsSync(mp)) {
      try { goal = JSON.parse(await readFile(mp, 'utf8')).goal ?? ''; } catch (e) { /* */ }
    }
    const scores: number[] = [];
    for (const rn of rNum) {
      try {
        const r = JSON.parse(await readFile(join(rd, `round_${rn}.json`), 'utf8'));
        const arr: number[] = [];
        for (const persona of r.feedback?.personas ?? []) {
          for (const p of persona.proposals ?? []) {
            if (typeof p.total === 'number') arr.push(p.total);
          }
        }
        if (arr.length > 0) scores.push(arr.reduce((a, b) => a + b, 0) / arr.length);
      } catch (e) { /* */ }
    }
    if (scores.length < 4) continue;
    const { mean, std } = stdev(scores);
    const range = Math.max(...scores) - Math.min(...scores);
    const cv = mean > 0 ? std / mean : 0;
    vols.push({ sid, goal, scores, rounds: scores.length, mean, std, range, cv });
  }
}

const total = vols.length;
const stable = vols.filter((v) => v.std < 0.3);
const moderate = vols.filter((v) => v.std >= 0.3 && v.std < 0.7);
const volatile_ = vols.filter((v) => v.std >= 0.7);

// top by std (most volatile)
const topVolatile = [...vols].sort((a, b) => b.std - a.std).slice(0, 12);
// top by std asc (most stable)
const topStable = [...vols].sort((a, b) => a.std - b.std).slice(0, 12);

// 平均 σ
const avgStd = total > 0 ? vols.reduce((s, v) => s + v.std, 0) / total : 0;
const avgRange = total > 0 ? vols.reduce((s, v) => s + v.range, 0) / total : 0;

function esc(s: any): string {
  const str = String(s == null ? '' : s);
  return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}
function sparkline(values: number[]): string {
  const blocks = ['▁', '▂', '▃', '▄', '▅', '▆', '▇', '█'];
  if (values.length < 2) return '▅'.repeat(values.length);
  const min = Math.min(...values);
  const max = Math.max(...values);
  const range = max - min;
  if (range === 0) return '▅'.repeat(values.length);
  return values.map((v) => blocks[Math.min(blocks.length - 1, Math.floor(((v - min) / range) * (blocks.length - 1)))]).join('');
}
---

<BaseLayout title="Score Volatility · Agents">
  <Navbar />
  <main class="shell agents-shell">
    <nav class="agents-breadcrumb">
      <a href={`${base}/agents/`}>← 多智能体控制台</a>
      <span class="muted"> / score-volatility</span>
    </nav>

    <header class="agents-header">
      <h1>📊 Score Volatility Index <span class="muted" style="font-size:0.6em">(iter #264)</span></h1>
      <p class="agents-sub">
        每个 session round scores 的 σ,range,CV(变异系数)。
        高 σ = 分数反复横跳;低 σ = 平稳收敛。
      </p>
    </header>

    <section class="agents-session-section">
      <h2>📊 全局</h2>
      <div class="agents-sv-globals">
        <span>总 sessions: <strong>{total}</strong></span>
        <span>avg σ: <strong>{avgStd.toFixed(3)}</strong></span>
        <span>avg range: <strong>{avgRange.toFixed(2)}</strong></span>
        <span>稳定(σ &lt; 0.3): <strong style="color:#10b981">{stable.length}</strong></span>
        <span>中等(0.3-0.7): <strong style="color:#f59e0b">{moderate.length}</strong></span>
        <span>波动(σ &gt; 0.7): <strong style="color:#ef4444">{volatile_.length}</strong></span>
      </div>
    </section>

    <section class="agents-session-section">
      <h2>📈 top 12 最波动 sessions</h2>
      <table class="agents-session-table">
        <thead>
          <tr><th>σ</th><th>range</th><th>CV</th><th>rounds</th><th>sparkline</th><th>sid</th></tr>
        </thead>
        <tbody>
          {topVolatile.map((v) => (
            <tr>
              <td><strong style="color:#ef4444">{v.std.toFixed(3)}</strong></td>
              <td>{v.range.toFixed(2)}</td>
              <td>{v.cv.toFixed(2)}</td>
              <td>{v.rounds}</td>
              <td><code style="font-size:1.1em;color:#4f46e5">{sparkline(v.scores)}</code></td>
              <td><a href={`${base}/agents/${v.sid}/`}><code>{esc(v.sid.slice(0, 12))}</code></a></td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="agents-session-section">
      <h2>📏 top 12 最稳定 sessions</h2>
      <table class="agents-session-table">
        <thead>
          <tr><th>σ</th><th>range</th><th>CV</th><th>rounds</th><th>sparkline</th><th>sid</th></tr>
        </thead>
        <tbody>
          {topStable.map((v) => (
            <tr>
              <td><strong style="color:#10b981">{v.std.toFixed(3)}</strong></td>
              <td>{v.range.toFixed(2)}</td>
              <td>{v.cv.toFixed(2)}</td>
              <td>{v.rounds}</td>
              <td><code style="font-size:1.1em;color:#4f46e5">{sparkline(v.scores)}</code></td>
              <td><a href={`${base}/agents/${v.sid}/`}><code>{esc(v.sid.slice(0, 12))}</code></a></td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="agents-session-section">
      <h2>💡 解读</h2>
      <ul>
        <li>σ &lt; 0.3 = 分数稳定(可能已收敛)</li>
        <li>σ &gt; 0.7 = 分数波动大(可能在震荡 / 受随机性影响)</li>
        <li>CV = σ/mean 标准化,跨 session 可比</li>
        <li>对照 <a href={`${base}/agents/round-variance/`}>Round Variance</a> 看分布</li>
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .agents-sv-globals {
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
  }
  .agents-sv-globals strong {
    color: #4f46e5;
    font-family: ui-monospace, monospace;
    margin: 0 0.3rem;
  }
</style>