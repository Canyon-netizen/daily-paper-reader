---
// /agents/score-volatility.astro — iter #160:score volatility index
//
// 跨 session 看每轮 feedback score 的波动度(标准差):
//   - 高波动 session = LLM 反馈不稳定 / gate 阈值在反复跳动
//   - 低波动 session = LLM 反馈稳态,系统稳定
//   - 整体波动分布直方图
//   - top 10 高波动 sessions
//   - top 10 低波动 sessions(rounds ≥ 3)

import { readFile, readdir } from 'node:fs/promises';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import '../../styles/agents.css';

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');

interface VolRecord {
  sid: string;
  goal: string;
  rounds: number;
  meanScore: number;
  stdScore: number;
  scores: number[];
}

const records: VolRecord[] = [];
const root = join(process.cwd(), 'archive');
if (existsSync(root)) {
  const sids = await readdir(root).catch(() => []);
  for (const sid of sids) {
    const rd = join(root, sid, 'rounds');
    if (!existsSync(rd)) continue;
    let goal = '';
    const mp = join(root, sid, 'meta.json');
    if (existsSync(mp)) {
      try { goal = JSON.parse(await readFile(mp, 'utf8')).goal ?? ''; } catch (e) { /* */ }
    }
    const rfs = await readdir(rd).catch(() => []);
    const rNum: number[] = [];
    for (const rf of rfs) {
      const m = rf.match(/^round_(\d+)\.json$/);
      if (m) rNum.push(parseInt(m[1], 10));
    }
    rNum.sort((a, b) => a - b);
    if (rNum.length < 2) continue;
    const scores: number[] = [];
    for (const ri of rNum) {
      try {
        const r = JSON.parse(await readFile(join(rd, `round_${ri}.json`), 'utf8'));
        const perRound: number[] = [];
        for (const persona of r.feedback?.personas ?? []) {
          for (const p of persona.proposals ?? []) {
            if (typeof p.total === 'number') perRound.push(p.total);
          }
        }
        if (perRound.length > 0) {
          scores.push(perRound.reduce((a, b) => a + b, 0) / perRound.length);
        }
      } catch (e) { /* */ }
    }
    if (scores.length < 2) continue;
    const mean = scores.reduce((a, b) => a + b, 0) / scores.length;
    const variance = scores.reduce((s, x) => s + (x - mean) ** 2, 0) / scores.length;
    const std = Math.sqrt(variance);
    records.push({
      sid, goal,
      rounds: rNum.length,
      meanScore: mean,
      stdScore: std,
      scores,
    });
  }
}

// 分桶
const buckets = [
  { label: 'σ ≤ 0.2 (稳态)', min: 0, max: 0.2, count: 0 },
  { label: '0.2 < σ ≤ 0.5', min: 0.2, max: 0.5, count: 0 },
  { label: '0.5 < σ ≤ 1.0', min: 0.5, max: 1.0, count: 0 },
  { label: '1.0 < σ ≤ 1.5', min: 1.0, max: 1.5, count: 0 },
  { label: 'σ > 1.5 (剧烈)', min: 1.5, max: 99, count: 0 },
];
for (const r of records) {
  for (const b of buckets) {
    if (r.stdScore > b.min && r.stdScore <= b.max) {
      b.count += 1;
      break;
    }
  }
}
const maxBucket = Math.max(...buckets.map((b) => b.count), 1);

const stable = records.filter((r) => r.stdScore <= 0.2).length;
const extreme = records.filter((r) => r.stdScore > 1.5).length;
const avgStd = records.length > 0 ? records.reduce((s, r) => s + r.stdScore, 0) / records.length : 0;
const avgMean = records.length > 0 ? records.reduce((s, r) => s + r.meanScore, 0) / records.length : 0;

function bar(n: number, max: number, width = 24): string {
  if (!max) return '░'.repeat(width);
  const filled = Math.round((n / max) * width);
  return '█'.repeat(filled) + '░'.repeat(width - filled);
}
function esc(s: any): string {
  return String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({ '&': '&', '<': '<', '>': '>', '"': '"', "'": '&#39;' }[c] || c));
}
function fmtScores(scores: number[]): string {
  return scores.map((s) => s.toFixed(1)).join(' → ');
}

const high = [...records].sort((a, b) => b.stdScore - a.stdScore).slice(0, 10);
const low = [...records].filter((r) => r.rounds >= 3).sort((a, b) => a.stdScore - b.stdScore).slice(0, 10);
---

<BaseLayout title="Score Volatility · Agents">
  <Navbar />
  <main class="shell agents-shell">
    <nav class="agents-breadcrumb">
      <a href={`${base}/agents/`}>← 多智能体控制台</a>
      <span class="muted"> / score-volatility</span>
    </nav>

    <header class="agents-header">
      <h1>📈 Score Volatility <span class="muted" style="font-size:0.6em">(iter #160)</span></h1>
      <p class="agents-sub">
        跨 session 看每轮 feedback 平均分的标准差(σ)。
        低 σ = LLM 反馈稳态;高 σ = 反馈不稳定 / 系统仍在剧烈震荡。
      </p>
    </header>

    <section class="agents-session-section">
      <h2>📊 全局</h2>
      <div class="agents-sv-globals">
        <span>≥2 rounds sessions: <strong>{records.length}</strong></span>
        <span>avg σ: <strong>{avgStd.toFixed(3)}</strong></span>
        <span>avg mean: <strong>{avgMean.toFixed(2)}</strong></span>
        <span>σ ≤ 0.2 稳态: <strong>{stable}</strong> ({records.length > 0 ? ((stable/records.length)*100).toFixed(1) : '0'}%)</span>
        <span>σ > 1.5 剧烈: <strong>{extreme}</strong> ({records.length > 0 ? ((extreme/records.length)*100).toFixed(1) : '0'}%)</span>
      </div>
    </section>

    <section class="agents-session-section">
      <h2>📊 σ 分布</h2>
      <pre class="agents-sv-flow">{buckets.map((b) => {
        return `${b.label.padEnd(20)} ${bar(b.count, maxBucket, 24)}  ${String(b.count).padStart(4)}`;
      }).join('\n')}</pre>
    </section>

    <section class="agents-session-section">
      <h2>🔥 top 10 高波动 (剧烈震荡)</h2>
      <table class="agents-session-table">
        <thead>
          <tr><th>sid</th><th>rounds</th><th>σ</th><th>mean</th><th>score 轨迹</th></tr>
        </thead>
        <tbody>
          {high.map((r) => (
            <tr>
              <td><a href={`${base}/agents/${r.sid}/`}><code>{esc(r.sid.slice(0, 14))}</code></a></td>
              <td>{r.rounds}</td>
              <td><strong>{r.stdScore.toFixed(3)}</strong></td>
              <td>{r.meanScore.toFixed(2)}</td>
              <td><small class="muted">{esc(fmtScores(r.scores))}</small></td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="agents-session-section">
      <h2>🪨 top 10 低波动 (稳态 ≥ 3 rounds)</h2>
      <table class="agents-session-table">
        <thead>
          <tr><th>sid</th><th>rounds</th><th>σ</th><th>mean</th><th>score 轨迹</th></tr>
        </thead>
        <tbody>
          {low.map((r) => (
            <tr>
              <td><a href={`${base}/agents/${r.sid}/`}><code>{esc(r.sid.slice(0, 14))}</code></a></td>
              <td>{r.rounds}</td>
              <td><strong>{r.stdScore.toFixed(3)}</strong></td>
              <td>{r.meanScore.toFixed(2)}</td>
              <td><small class="muted">{esc(fmtScores(r.scores))}</small></td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="agents-session-section">
      <h2>💡 解读</h2>
      <ul>
        <li>σ > 1.5 的 session 通常意味着 LLM 反馈不稳定 — 看 goal 是否过宽</li>
        <li>σ < 0.2 的 session 表示 LLM 反馈稳态 — gate 决策有较强一致性</li>
        <li>与 <a href={`${base}/agents/anomalies/`}>Anomalies</a> 对照 — 异常 round 通常导致 σ 上升</li>
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .agents-sv-globals {
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
  }
  .agents-sv-globals strong {
    color: #4f46e5;
    font-family: ui-monospace, monospace;
    margin: 0 0.3rem;
  }
  .agents-sv-flow {
    background: rgba(0,0,0,0.4);
    color: #c9d1d9;
    padding: 0.8rem;
    border-radius: 4px;
    font-family: ui-monospace, "JetBrains Mono", monospace;
    font-size: 0.78rem;
    line-height: 1.4;
    overflow-x: auto;
    white-space: pre;
  }
</style>