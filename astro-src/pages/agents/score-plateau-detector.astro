---
// /agents/score-plateau-detector.astro — iter #285:plateau detector
//
// 检测 sessions 中"卡住"的部分:
//   - 连续 ≥3 轮 score 变化 < 0.5 = plateau
//   - 列出每次 plateau 的起止 / 长度 / 平均 score

import { readFile, readdir } from 'node:fs/promises';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import '../../styles/agents.css';

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');

interface Plateau {
  sid: string;
  goal: string;
  startRound: number;
  endRound: number;
  length: number;
  avgScore: number;
  range: number;
}

interface SessionInfo {
  sid: string;
  goal: string;
  totalRounds: number;
  plateauCount: number;
  longestPlateau: number;
  plateauRoundsPct: number;
  plateauAvg: number;
}

const PLATEAU_THRESHOLD = 0.5;
const MIN_LENGTH = 3;

const root = join(process.cwd(), 'archive');
const plateaus: Plateau[] = [];
const sessions: SessionInfo[] = [];

if (existsSync(root)) {
  const sids = await readdir(root).catch(() => []);
  for (const sid of sids) {
    const sp = join(root, sid);
    if (!existsSync(sp)) continue;
    let goal = '';
    const mp = join(sp, 'meta.json');
    if (existsSync(mp)) {
      try { goal = JSON.parse(await readFile(mp, 'utf8')).goal ?? ''; } catch (e) { /* */ }
    }
    const rd = join(sp, 'rounds');
    if (!existsSync(rd)) continue;
    const rfs = await readdir(rd).catch(() => []);
    const rNums: number[] = [];
    for (const rf of rfs) {
      const m = rf.match(/^round_(\d+)\.json$/);
      if (m) rNums.push(parseInt(m[1], 10));
    }
    if (rNums.length < MIN_LENGTH) continue;
    rNums.sort((a, b) => a - b);

    const scores: { round: number; score: number }[] = [];
    for (const rn of rNums) {
      try {
        const r = JSON.parse(await readFile(join(rd, `round_${rn}.json`), 'utf8'));
        const arr: number[] = [];
        for (const persona of r.feedback?.personas ?? []) {
          for (const p of persona.proposals ?? []) {
            if (typeof p.total === 'number') arr.push(p.total);
          }
        }
        if (arr.length > 0) {
          scores.push({ round: rn, score: arr.reduce((a, b) => a + b, 0) / arr.length });
        }
      } catch (e) { /* */ }
    }

    if (scores.length < MIN_LENGTH) continue;

    // 寻找 plateau
    let i = 0;
    const sessionPlateaus: Plateau[] = [];
    while (i < scores.length) {
      const start = i;
      const startScore = scores[i].score;
      let j = i + 1;
      while (j < scores.length) {
        const diff = Math.abs(scores[j].score - startScore);
        if (diff >= PLATEAU_THRESHOLD) break;
        j += 1;
      }
      const length = j - start;
      if (length >= MIN_LENGTH) {
        const slice = scores.slice(start, j);
        const avgScore = slice.reduce((a, x) => a + x.score, 0) / slice.length;
        const range = Math.max(...slice.map((s) => s.score)) - Math.min(...slice.map((s) => s.score));
        const p: Plateau = {
          sid, goal,
          startRound: scores[start].round,
          endRound: scores[j - 1].round,
          length, avgScore, range,
        };
        sessionPlateaus.push(p);
        plateaus.push(p);
      }
      i = j;
    }

    const plateauRounds = sessionPlateaus.reduce((s, p) => s + p.length, 0);
    const longest = sessionPlateaus.reduce((m, p) => Math.max(m, p.length), 0);
    const plateauAvg = sessionPlateaus.length > 0
      ? sessionPlateaus.reduce((s, p) => s + p.avgScore, 0) / sessionPlateaus.length
      : 0;
    sessions.push({
      sid, goal,
      totalRounds: scores.length,
      plateauCount: sessionPlateaus.length,
      longestPlateau: longest,
      plateauRoundsPct: scores.length > 0 ? (plateauRounds / scores.length) * 100 : 0,
      plateauAvg,
    });
  }
}

const totalSessions = sessions.length;
const sessionsWithPlateau = sessions.filter((s) => s.plateauCount > 0).length;
const totalPlateaus = plateaus.length;
const avgPlateauLength = plateaus.length > 0 ? plateaus.reduce((s, p) => s + p.length, 0) / plateaus.length : 0;
const longestPlateau = plateaus.reduce((m, p) => Math.max(m, p.length), 0);

const sortedSessions = [...sessions].sort((a, b) => b.plateauRoundsPct - a.plateauRoundsPct);

function esc(s: any): string {
  const str = String(s == null ? '' : s);
  return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}
function bar(n: number, max: number, width = 22): string {
  if (!max) return '░'.repeat(width);
  const filled = Math.round((n / max) * width);
  return '█'.repeat(filled) + '░'.repeat(width - filled);
}
---

<BaseLayout title="Score Plateau Detector · Agents">
  <Navbar />
  <main class="shell agents-shell">
    <nav class="agents-breadcrumb">
      <a href={`${base}/agents/`}>← 多智能体控制台</a>
      <span class="muted"> / score-plateau-detector</span>
    </nav>

    <header class="agents-header">
      <h1>🪨 Score Plateau Detector <span class="muted" style="font-size:0.6em">(iter #285)</span></h1>
      <p class="agents-sub">
        检测 sessions 中"卡住"的部分:连续 ≥3 轮 score 变化 &lt; {PLATEAU_THRESHOLD} 即视为 plateau。
      </p>
    </header>

    <section class="agents-session-section">
      <h2>📊 全局</h2>
      <div class="agents-spd-globals">
        <span>总 sessions: <strong>{totalSessions}</strong></span>
        <span>含 plateau: <strong style="color:#ef4444">{sessionsWithPlateau}</strong>({((sessionsWithPlateau / Math.max(1, totalSessions)) * 100).toFixed(1)}%)</span>
        <span>总 plateau 数: <strong>{totalPlateaus}</strong></span>
        <span>avg plateau 长度: <strong>{avgPlateauLength.toFixed(1)}</strong></span>
        <span>最长 plateau: <strong>{longestPlateau}</strong> 轮</span>
      </div>
    </section>

    <section class="agents-session-section">
      <h2>🔥 Top 10 卡得最久的 sessions</h2>
      <pre class="agents-spd-flow">{sortedSessions.slice(0, 10).map((s, i) => {
        return `${(i + 1).toString().padStart(2)}  ${bar(s.plateauRoundsPct, 100, 22)}  ${s.plateauRoundsPct.toFixed(0)}%  rounds=${s.totalRounds}  plateaus=${s.plateauCount}  long=${s.longestPlateau}`;
      }).join('\n')}</pre>
    </section>

    <section class="agents-session-section">
      <h2>📋 详情</h2>
      <table class="agents-session-table">
        <thead>
          <tr><th>#</th><th>sid</th><th>goal</th><th>rounds</th><th>plateaus</th><th>longest</th><th>% in plateau</th><th>avg plateau score</th></tr>
        </thead>
        <tbody>
          {sortedSessions.slice(0, 25).map((s, i) => (
            <tr>
              <td>{i + 1}</td>
              <td><a href={`${base}/agents/${s.sid}/`}><code>{esc(s.sid.slice(0, 10))}</code></a></td>
              <td><small class="muted">{esc(s.goal.slice(0, 30))}{(s.goal ?? '').length > 30 ? '…' : ''}</small></td>
              <td>{s.totalRounds}</td>
              <td>{s.plateauCount > 0 ? <strong style="color:#ef4444">{s.plateauCount}</strong> : <span class="muted">0</span>}</td>
              <td>{s.longestPlateau}</td>
              <td>{s.plateauRoundsPct.toFixed(0)}%</td>
              <td>{s.plateauAvg > 0 ? s.plateauAvg.toFixed(2) : '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="agents-session-section">
      <h2>💡 解读</h2>
      <ul>
        <li>plateau 长 = 系统在该 session 多次 round 内 score 无变化</li>
        <li>含 plateau sessions 多 = 当前 modifier 探索不足 / 已到天花板</li>
        <li>avg plateau score 高 = 高位卡住 / 低 = 低位挣扎</li>
        <li>对照 <a href={`${base}/agents/trajectory-classifier/`}>Trajectory Classifier</a> 看分类</li>
        <li>对照 <a href={`${base}/agents/stagnation-rounds/`}>Stagnation Rounds</a> 看连续轮次</li>
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .agents-spd-globals {
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
  }
  .agents-spd-globals strong {
    color: #4f46e5;
    font-family: ui-monospace, monospace;
    margin: 0 0.3rem;
  }
  .agents-spd-flow {
    background: rgba(0,0,0,0.4);
    color: #c9d1d9;
    padding: 0.8rem;
    border-radius: 4px;
    font-family: ui-monospace, "JetBrains Mono", monospace;
    font-size: 0.78rem;
    line-height: 1.4;
    overflow-x: auto;
    white-space: pre;
  }
</style>