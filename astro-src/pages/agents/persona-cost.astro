---
// /agents/persona-cost.astro — iter #236:per-persona token cost contribution
//
// 每个 persona 消耗的 tokens 占总 feedback tokens 的比例:
//   - 估算每 persona 的 feedback tokens
//   - 跨 session 累计
//   - top consumers

import { readFile, readdir } from 'node:fs/promises';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import '../../styles/agents.css';

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');

interface PersonaCost {
  name: string;
  tokens: number;
  uses: number;
  avgTokens: number;
  share: number;
}

const root = join(process.cwd(), 'archive');
const personaMap = new Map<string, { tokens: number; uses: number }>();
let totalTokensAll = 0;

if (existsSync(root)) {
  const sids = await readdir(root).catch(() => []);
  for (const sid of sids) {
    const rd = join(root, sid, 'rounds');
    if (!existsSync(rd)) continue;
    const rfs = await readdir(rd).catch(() => []);
    for (const rf of rfs) {
      if (!/^round_\d+\.json$/.test(rf)) continue;
      try {
        const r = JSON.parse(await readFile(join(rd, rf), 'utf8'));
        const total = r.feedback?.total_tokens ?? 0;
        totalTokensAll += total;
        const personas = r.feedback?.personas ?? [];
        if (personas.length === 0) continue;
        // 简化:把 total 平均分配给 personas(若 personas 有 proposal_count 则按比例)
        const counts = personas.map((p: any) => (p.proposals ?? []).length);
        const sum = counts.reduce((a: number, b: number) => a + b, 0) || 1;
        for (let i = 0; i < personas.length; i++) {
          const name = personas[i].persona ?? personas[i].name ?? personas[i].role ?? 'unknown';
          const share = total * (counts[i] / sum);
          const cur = personaMap.get(name) ?? { tokens: 0, uses: 0 };
          cur.tokens += share;
          cur.uses += 1;
          personaMap.set(name, cur);
        }
      } catch (e) { /* */ }
    }
  }
}

const stats: PersonaCost[] = [];
for (const [name, v] of personaMap.entries()) {
  stats.push({
    name,
    tokens: v.tokens,
    uses: v.uses,
    avgTokens: v.uses > 0 ? v.tokens / v.uses : 0,
    share: totalTokensAll > 0 ? (v.tokens / totalTokensAll) * 100 : 0,
  });
}
stats.sort((a, b) => b.tokens - a.tokens);

const topConsumers = stats.slice(0, 20);
const totalEstimateTokens = stats.reduce((s, p) => s + p.tokens, 0);

function bar(n: number, max: number, width = 18): string {
  if (!max) return '░'.repeat(width);
  const filled = Math.round((n / max) * width);
  return '█'.repeat(filled) + '░'.repeat(width - filled);
}
function esc(s: any): string {
  return String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({ '&': '&', '<': '<', '>': '>', '"': '"', "'": '&#39;' }[c] || c));
}
---

<BaseLayout title="Persona Cost · Agents">
  <Navbar />
  <main class="shell agents-shell">
    <nav class="agents-breadcrumb">
      <a href={`${base}/agents/`}>← 多智能体控制台</a>
      <span class="muted"> / persona-cost</span>
    </nav>

    <header class="agents-header">
      <h1>💸 Persona Cost <span class="muted" style="font-size:0.6em">(iter #236)</span></h1>
      <p class="agents-sub">
        每个 persona 的 feedback tokens 估算(按 proposal 数比例分配 total_tokens)。
        看成本集中在哪些 persona。
      </p>
    </header>

    <section class="agents-session-section">
      <h2>📊 全局</h2>
      <div class="agents-pc-globals">
        <span>personas: <strong>{stats.length}</strong></span>
        <span>总 tokens(分配): <strong>{totalEstimateTokens.toLocaleString()}</strong></span>
      </div>
    </section>

    <section class="agents-session-section">
      <h2>📊 top 20 cost 消耗 personas</h2>
      <pre class="agents-pc-flow">{topConsumers.map((p) => {
        const label = p.name.length > 18 ? p.name.slice(0, 18) + '…' : p.name.padEnd(18);
        return `${label} ${bar(p.tokens, Math.max(...topConsumers.map(x => x.tokens), 1), 18)}  ${Math.round(p.tokens).toLocaleString().padStart(8)}  ${p.share.toFixed(1)}%`;
      }).join('\n')}</pre>
    </section>

    <section class="agents-session-section">
      <h2>📋 详细表</h2>
      <table class="agents-session-table">
        <thead>
          <tr><th>persona</th><th>tokens</th><th>share %</th><th>uses</th><th>avg/use</th></tr>
        </thead>
        <tbody>
          {topConsumers.map((p) => (
            <tr>
              <td><code>{esc(p.name)}</code></td>
              <td>{Math.round(p.tokens).toLocaleString()}</td>
              <td>{p.share.toFixed(1)}%</td>
              <td>{p.uses}</td>
              <td>{Math.round(p.avgTokens).toLocaleString()}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="agents-session-section">
      <h2>💡 解读</h2>
      <ul>
        <li>share = 该 persona tokens / 总 tokens</li>
        <li>估算方式:total × (该 persona proposals / 该 round proposals 总数)</li>
        <li>对照 <a href={`${base}/agents/cost-by-phase/`}>Cost by Phase</a> 看阶段分布</li>
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .agents-pc-globals {
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
  }
  .agents-pc-globals strong {
    color: #4f46e5;
    font-family: ui-monospace, monospace;
    margin: 0 0.3rem;
  }
  .agents-pc-flow {
    background: rgba(0,0,0,0.4);
    color: #c9d1d9;
    padding: 0.8rem;
    border-radius: 4px;
    font-family: ui-monospace, "JetBrains Mono", monospace;
    font-size: 0.78rem;
    line-height: 1.4;
    overflow-x: auto;
    white-space: pre;
  }
</style>