---
// /agents/round-jump.astro — iter #162:round score improvement detector
//
// 跨 session 看相邻轮次分数差(Δ):
//   - 大正 Δ = 突破轮(score 显著上升)
//   - 大负 Δ = 退化轮(score 显著下降)
//   - per-session 最大 Δ 表
//   - 全局 Δ 直方图

import { readFile, readdir } from 'node:fs/promises';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import '../../styles/agents.css';

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');

interface Jump {
  sid: string;
  roundIdx: number; // 1-based, the "new" round
  prevScore: number;
  newScore: number;
  delta: number;
  goal: string;
}

interface SessionTrace {
  sid: string;
  goal: string;
  scores: number[]; // index 0 = round 1
}

const traces: SessionTrace[] = [];
const root = join(process.cwd(), 'archive');
if (existsSync(root)) {
  const sids = await readdir(root).catch(() => []);
  for (const sid of sids) {
    const rd = join(root, sid, 'rounds');
    if (!existsSync(rd)) continue;
    let goal = '';
    const mp = join(root, sid, 'meta.json');
    if (existsSync(mp)) {
      try { goal = JSON.parse(await readFile(mp, 'utf8')).goal ?? ''; } catch (e) { /* */ }
    }
    const rfs = await readdir(rd).catch(() => []);
    const rNum: number[] = [];
    for (const rf of rfs) {
      const m = rf.match(/^round_(\d+)\.json$/);
      if (m) rNum.push(parseInt(m[1], 10));
    }
    rNum.sort((a, b) => a - b);
    if (rNum.length < 2) continue;
    const scores: number[] = [];
    for (const ri of rNum) {
      try {
        const r = JSON.parse(await readFile(join(rd, `round_${ri}.json`), 'utf8'));
        const arr: number[] = [];
        for (const persona of r.feedback?.personas ?? []) {
          for (const p of persona.proposals ?? []) {
            if (typeof p.total === 'number') arr.push(p.total);
          }
        }
        if (arr.length > 0) scores.push(arr.reduce((a, b) => a + b, 0) / arr.length);
      } catch (e) { /* */ }
    }
    if (scores.length >= 2) traces.push({ sid, goal, scores });
  }
}

const jumps: Jump[] = [];
for (const t of traces) {
  for (let i = 1; i < t.scores.length; i++) {
    const prev = t.scores[i - 1];
    const next = t.scores[i];
    jumps.push({
      sid: t.sid,
      roundIdx: i + 1,
      prevScore: prev,
      newScore: next,
      delta: next - prev,
      goal: t.goal,
    });
  }
}

const positive = jumps.filter((j) => j.delta > 0);
const negative = jumps.filter((j) => j.delta < 0);
const avgDelta = jumps.length > 0 ? jumps.reduce((s, j) => s + j.delta, 0) / jumps.length : 0;

// 直方图
const buckets = [
  { label: 'Δ ≤ -1.5  ', min: -99, max: -1.5, count: 0 },
  { label: '-1.5 < Δ ≤ -0.5', min: -1.5, max: -0.5, count: 0 },
  { label: '-0.5 < Δ < 0.5  ', min: -0.5, max: 0.5, count: 0 },
  { label: '0.5 ≤ Δ < 1.5 ', min: 0.5, max: 1.5, count: 0 },
  { label: 'Δ ≥ 1.5 (突破)', min: 1.5, max: 99, count: 0 },
];
for (const j of jumps) {
  for (const b of buckets) {
    if (j.delta > b.min && j.delta <= b.max) {
      b.count += 1;
      break;
    }
  }
}
const maxBucket = Math.max(...buckets.map((b) => b.count), 1);

const topUp = [...jumps].sort((a, b) => b.delta - a.delta).slice(0, 15);
const topDown = [...jumps].filter((j) => j.delta < 0).sort((a, b) => a.delta - b.delta).slice(0, 15);

function bar(n: number, max: number, width = 24): string {
  if (!max) return '░'.repeat(width);
  const filled = Math.round((n / max) * width);
  return '█'.repeat(filled) + '░'.repeat(width - filled);
}
function esc(s: any): string {
  return String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({ '&': '&', '<': '<', '>': '>', '"': '"', "'": '&#39;' }[c] || c));
}
---

<BaseLayout title="Round Jumps · Agents">
  <Navbar />
  <main class="shell agents-shell">
    <nav class="agents-breadcrumb">
      <a href={`${base}/agents/`}>← 多智能体控制台</a>
      <span class="muted"> / round-jump</span>
    </nav>

    <header class="agents-header">
      <h1>⤴️ Round Jumps <span class="muted" style="font-size:0.6em">(iter #162)</span></h1>
      <p class="agents-sub">
        跨 session 看相邻轮的分数跳变 Δ = newScore − prevScore。
        大正 Δ = 突破;大负 Δ = 退化;接近 0 = 稳态。
      </p>
    </header>

    <section class="agents-session-section">
      <h2>📊 全局</h2>
      <div class="agents-rj-globals">
        <span>总 Δ 数: <strong>{jumps.length}</strong></span>
        <span>正 Δ: <strong>{positive.length}</strong> ({jumps.length > 0 ? ((positive.length/jumps.length)*100).toFixed(1) : '0'}%)</span>
        <span>负 Δ: <strong>{negative.length}</strong> ({jumps.length > 0 ? ((negative.length/jumps.length)*100).toFixed(1) : '0'}%)</span>
        <span>平均 Δ: <strong>{avgDelta >= 0 ? '+' : ''}{avgDelta.toFixed(3)}</strong></span>
      </div>
    </section>

    <section class="agents-session-section">
      <h2>📊 Δ 分布</h2>
      <pre class="agents-rj-flow">{buckets.map((b) => {
        return `${b.label} ${bar(b.count, maxBucket, 24)}  ${String(b.count).padStart(4)}`;
      }).join('\n')}</pre>
    </section>

    <section class="agents-session-section">
      <h2>🚀 top 15 大正 Δ(突破)</h2>
      <table class="agents-session-table">
        <thead>
          <tr><th>sid</th><th>轮</th><th>前</th><th>后</th><th>Δ</th><th>goal</th></tr>
        </thead>
        <tbody>
          {topUp.map((j) => (
            <tr>
              <td><a href={`${base}/agents/${j.sid}/`}><code>{esc(j.sid.slice(0, 14))}</code></a></td>
              <td>R{j.roundIdx}</td>
              <td>{j.prevScore.toFixed(2)}</td>
              <td>{j.newScore.toFixed(2)}</td>
              <td><strong style="color:#10b981">+{j.delta.toFixed(2)}</strong></td>
              <td><small class="muted">{esc(j.goal.slice(0, 50))}{(j.goal ?? '').length > 50 ? '…' : ''}</small></td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="agents-session-section">
      <h2>📉 top 15 大负 Δ(退化)</h2>
      <table class="agents-session-table">
        <thead>
          <tr><th>sid</th><th>轮</th><th>前</th><th>后</th><th>Δ</th><th>goal</th></tr>
        </thead>
        <tbody>
          {topDown.map((j) => (
            <tr>
              <td><a href={`${base}/agents/${j.sid}/`}><code>{esc(j.sid.slice(0, 14))}</code></a></td>
              <td>R{j.roundIdx}</td>
              <td>{j.prevScore.toFixed(2)}</td>
              <td>{j.newScore.toFixed(2)}</td>
              <td><strong style="color:#ef4444">{j.delta.toFixed(2)}</strong></td>
              <td><small class="muted">{esc(j.goal.slice(0, 50))}{(j.goal ?? '').length > 50 ? '…' : ''}</small></td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="agents-session-section">
      <h2>💡 解读</h2>
      <ul>
        <li>正 Δ > 1.5 通常意味着 modifier 应用了关键修改</li>
        <li>负 Δ < -1.5 可能是 gate 改严或 feedback prompt 改动</li>
        <li>对照 <a href={`${base}/agents/score-volatility/`}>Score Volatility</a> 看哪些 session 整体变化大</li>
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .agents-rj-globals {
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
  }
  .agents-rj-globals strong {
    color: #4f46e5;
    font-family: ui-monospace, monospace;
    margin: 0 0.3rem;
  }
  .agents-rj-flow {
    background: rgba(0,0,0,0.4);
    color: #c9d1d9;
    padding: 0.8rem;
    border-radius: 4px;
    font-family: ui-monospace, "JetBrains Mono", monospace;
    font-size: 0.78rem;
    line-height: 1.4;
    overflow-x: auto;
    white-space: pre;
  }
</style>