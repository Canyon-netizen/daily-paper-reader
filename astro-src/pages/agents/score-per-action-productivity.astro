---
// /agents/score-per-action-productivity.astro — iter #390:gain per action productivity per session

import { readFile, readdir } from 'node:fs/promises';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import '../../styles/agents.css';

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');

interface SessProd {
  sid: string;
  goal: string;
  actions: number;
  gain: number;
  productivity: number; // gain / actions
  costPerGain: number;
  rounds: number;
}

const root = join(process.cwd(), 'archive');
const sessions: SessProd[] = [];

if (existsSync(root)) {
  const sids = await readdir(root).catch(() => []);
  for (const sid of sids) {
    const rd = join(root, sid, 'rounds');
    if (!existsSync(rd)) continue;
    const rfs = await readdir(rd).catch(() => []);
    const rNums: number[] = [];
    for (const rf of rfs) {
      const m = rf.match(/^round_(\d+)\.json$/);
      if (m) rNums.push(parseInt(m[1], 10));
    }
    if (rNums.length < 2) continue;
    rNums.sort((a, b) => a - b);

    let totalActions = 0;
    let totalCost = 0;
    const scores: number[] = [];
    for (const rn of rNums) {
      try {
        const r = JSON.parse(await readFile(join(rd, `round_${rn}.json`), 'utf8'));
        const applied = r.modifier?.applied ?? [];
        totalActions += applied.length;
        for (const a of applied) {
          if (typeof a.cost === 'number') totalCost += a.cost;
        }
        const arr: number[] = [];
        for (const persona of r.feedback?.personas ?? []) {
          for (const p of persona.proposals ?? []) {
            if (typeof p.total === 'number') arr.push(p.total);
          }
        }
        scores.push(arr.length > 0 ? arr.reduce((a, b) => a + b, 0) / arr.length : 0);
      } catch (e) { scores.push(0); }
    }
    const gain = scores[scores.length - 1] - scores[0];
    if (totalActions === 0) continue;

    let goal = '';
    const mp = join(root, sid, 'meta.json');
    if (existsSync(mp)) {
      try { goal = JSON.parse(await readFile(mp, 'utf8')).goal ?? ''; } catch (e) { /* */ }
    }
    sessions.push({
      sid, goal,
      actions: totalActions,
      gain,
      productivity: gain / totalActions,
      costPerGain: gain > 0 ? totalCost / gain : Infinity,
      rounds: rNums.length,
    });
  }
}

const productive = sessions.filter((s) => s.gain > 0);
productive.sort((a, b) => b.productivity - a.productivity);

const total = sessions.length;
const productiveCount = productive.length;
const avgProductivity = productive.length > 0 ? productive.reduce((s, x) => s + x.productivity, 0) / productive.length : 0;

function bar(n: number, max: number, width = 16): string {
  if (!max) return '░'.repeat(width);
  const filled = Math.round((n / max) * width);
  return '█'.repeat(filled) + '░'.repeat(width - filled);
}

function esc(s: any): string {
  const str = String(s == null ? '' : s);
  return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}
---

<BaseLayout title="Score Per Action Productivity · Agents">
  <Navbar />
  <main class="shell agents-shell">
    <nav class="agents-breadcrumb">
      <a href={`${base}/agents/`}>← 多智能体控制台</a>
      <span class="muted"> / score-per-action-productivity</span>
    </nav>

    <header class="agents-header">
      <h1>⚙️ Score Per Action Productivity <span class="muted" style="font-size:0.6em">(iter #390)</span></h1>
      <p class="agents-sub">
        每 session:score gain / action 数。
        越高 = 单 action 贡献越大(每个 action 都用得有效)。
      </p>
    </header>

    <section class="agents-session-section">
      <h2>📊 全局</h2>
      <div class="agents-spap-globals">
        <span>total sessions: <strong>{total}</strong></span>
        <span>productive (gain&gt;0): <strong style="color:#10b981">{productiveCount}</strong></span>
        <span>avg productivity: <strong>{avgProductivity.toFixed(3)}</strong></span>
      </div>
    </section>

    <section class="agents-session-section">
      <h2>⚙️ Top 20 most productive sessions</h2>
      <table class="agents-session-table">
        <thead>
          <tr><th>#</th><th>sid</th><th>gain</th><th>actions</th><th>productivity</th><th>cost/gain</th><th>rounds</th><th>goal</th></tr>
        </thead>
        <tbody>
          {productive.slice(0, 20).map((s, i) => (
            <tr>
              <td>{i + 1}</td>
              <td><a href={`${base}/agents/${s.sid}/`}><code>{esc(s.sid.slice(0, 8))}</code></a></td>
              <td><strong style="color:#10b981">+{s.gain.toFixed(2)}</strong></td>
              <td>{s.actions}</td>
              <td><strong style="color:#fbbf24">{s.productivity.toFixed(3)}</strong></td>
              <td>{s.costPerGain === Infinity ? '∞' : `$${s.costPerGain.toFixed(2)}`}</td>
              <td>{s.rounds}</td>
              <td><small class="muted">{esc(s.goal.slice(0, 14))}{s.goal.length > 14 ? '…' : ''}</small></td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="agents-session-section">
      <h2>💡 解读</h2>
      <ul>
        <li>高 productivity = 每个 action 都有显著贡献(系统做事精准)</li>
        <li>低 productivity = 大量 action 但 gain 很小(可能做了无用功)</li>
        <li>cost/gain 配合看 = 单位 gain 花费</li>
        <li>对照 <a href={`${base}/agents/session-cost-efficiency-index/`}>Session Cost Efficiency Index</a></li>
        <li>对照 <a href={`${base}/agents/action-failure-correlation/`}>Action Failure Correlation</a></li>
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .agents-spap-globals {
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
  }
  .agents-spap-globals strong {
    color: #4f46e5;
    font-family: ui-monospace, monospace;
    margin: 0 0 0 0.3rem;
  }
</style>