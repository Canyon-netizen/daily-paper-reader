---
// /agents/designer-revision-rate.astro — iter #344:designer revision rate (round-to-round text similarity)

import { readFile, readdir } from 'node:fs/promises';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import '../../styles/agents.css';

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');

const CN_RE = /[一-鿿]/;

function tokenize(s: string): Set<string> {
  const out = new Set<string>();
  if (!s) return out;
  for (const seg of s.split(/\s+/)) {
    if (CN_RE.test(seg)) {
      const chars = Array.from(seg);
      for (let i = 0; i + 2 <= chars.length; i++) out.add(chars.slice(i, i + 2).join(''));
      for (const c of chars) out.add(c);
    } else {
      const t = seg.toLowerCase().replace(/[^\w]/g, '');
      if (t && t.length > 1) out.add(t);
    }
  }
  return out;
}

interface SessRev {
  sid: string;
  goal: string;
  totalRounds: number;
  similarities: number[];
  avgSimilarity: number;
  minSimilarity: number;
  maxSimilarity: number;
}

const root = join(process.cwd(), 'archive');
const sessions: SessRev[] = [];

if (existsSync(root)) {
  const sids = await readdir(root).catch(() => []);
  for (const sid of sids) {
    const rd = join(root, sid, 'rounds');
    if (!existsSync(rd)) continue;
    const rfs = await readdir(rd).catch(() => []);
    const rNums: number[] = [];
    for (const rf of rfs) {
      const m = rf.match(/^round_(\d+)\.json$/);
      if (m) rNums.push(parseInt(m[1], 10));
    }
    if (rNums.length < 2) continue;
    rNums.sort((a, b) => a - b);

    const designerTexts: string[] = [];
    for (const rn of rNums) {
      try {
        const r = JSON.parse(await readFile(join(rd, `round_${rn}.json`), 'utf8'));
        const text = r.designer?.output ?? r.designer?.draft ?? r.design?.output ?? '';
        designerTexts.push(text);
      } catch (e) { designerTexts.push(''); }
    }

    const sims: number[] = [];
    for (let i = 1; i < designerTexts.length; i++) {
      const a = tokenize(designerTexts[i - 1]);
      const b = tokenize(designerTexts[i]);
      if (a.size === 0 || b.size === 0) { sims.push(0); continue; }
      let inter = 0;
      for (const t of a) if (b.has(t)) inter += 1;
      const union = a.size + b.size - inter;
      sims.push(union > 0 ? inter / union : 0);
    }
    if (sims.length === 0) continue;

    let goal = '';
    const mp = join(root, sid, 'meta.json');
    if (existsSync(mp)) {
      try { goal = JSON.parse(await readFile(mp, 'utf8')).goal ?? ''; } catch (e) { /* */ }
    }

    sessions.push({
      sid, goal,
      totalRounds: designerTexts.length,
      similarities: sims,
      avgSimilarity: sims.reduce((s, v) => s + v, 0) / sims.length,
      minSimilarity: Math.min(...sims),
      maxSimilarity: Math.max(...sims),
    });
  }
}

sessions.sort((a, b) => a.avgSimilarity - b.avgSimilarity);

const total = sessions.length;
const avgSim = sessions.length > 0 ? sessions.reduce((s, x) => s + x.avgSimilarity, 0) / sessions.length : 0;

const buckets = [
  { label: 'heavy rewrite (<0.30)', min: 0, max: 0.30, count: 0 },
  { label: 'major revision (0.30-0.50)', min: 0.30, max: 0.50, count: 0 },
  { label: 'moderate (0.50-0.70)', min: 0.50, max: 0.70, count: 0 },
  { label: 'minor tweak (0.70-0.85)', min: 0.70, max: 0.85, count: 0 },
  { label: 'polish (0.85+)', min: 0.85, max: 1.01, count: 0 },
];
for (const s of sessions) {
  for (const b of buckets) {
    if (s.avgSimilarity >= b.min && s.avgSimilarity < b.max) { b.count += 1; break; }
  }
}

function bar(n: number, max: number, width = 22): string {
  if (!max) return '░'.repeat(width);
  const filled = Math.round((n / max) * width);
  return '█'.repeat(filled) + '░'.repeat(width - filled);
}

function esc(s: any): string {
  const str = String(s == null ? '' : s);
  return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}
---

<BaseLayout title="Designer Revision Rate · Agents">
  <Navbar />
  <main class="shell agents-shell">
    <nav class="agents-breadcrumb">
      <a href={`${base}/agents/`}>← 多智能体控制台</a>
      <span class="muted"> / designer-revision-rate</span>
    </nav>

    <header class="agents-header">
      <h1>📝 Designer Revision Rate <span class="muted" style="font-size:0.6em">(iter #344)</span></h1>
      <p class="agents-sub">
        designer 在相邻 round 之间的 output 文本相似度。
        低 = 重大重写;高 = 微调。
      </p>
    </header>

    <section class="agents-session-section">
      <h2>📊 全局</h2>
      <div class="agents-drr-globals">
        <span>sessions: <strong>{total}</strong></span>
        <span>avg similarity: <strong style={`color:${avgSim >= 0.7 ? '#10b981' : avgSim >= 0.5 ? '#f59e0b' : '#ef4444'}`}>{avgSim.toFixed(3)}</strong></span>
      </div>
    </section>

    <section class="agents-session-section">
      <h2>📊 Similarity 桶分布</h2>
      <pre class="agents-drr-flow">{buckets.map((b) => `${b.label.padEnd(28)} ${bar(b.count, Math.max(...buckets.map((x) => x.count), 1), 22)}  ${b.count}`).join('\n')}</pre>
    </section>

    <section class="agents-session-section">
      <h2>🔄 Top 12 most rewritten sessions</h2>
      <table class="agents-session-table">
        <thead>
          <tr><th>#</th><th>sid</th><th>rounds</th><th>avg</th><th>min</th><th>max</th><th>goal</th></tr>
        </thead>
        <tbody>
          {sessions.slice(0, 12).map((s, i) => (
            <tr>
              <td>{i + 1}</td>
              <td><a href={`${base}/agents/${s.sid}/`}><code>{esc(s.sid.slice(0, 10))}</code></a></td>
              <td>{s.totalRounds}</td>
              <td><strong style="color:#ef4444">{s.avgSimilarity.toFixed(3)}</strong></td>
              <td>{s.minSimilarity.toFixed(3)}</td>
              <td>{s.maxSimilarity.toFixed(3)}</td>
              <td><small class="muted">{esc(s.goal.slice(0, 22))}{s.goal.length > 22 ? '…' : ''}</small></td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="agents-session-section">
      <h2>💡 解读</h2>
      <ul>
        <li>avg &lt; 0.3 = designer 在大幅重写</li>
        <li>avg &gt; 0.85 = designer 只做小修补</li>
        <li>对比 <a href={`${base}/agents/designer-feedback-alignment/`}>Designer ↔ Feedback Alignment</a></li>
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .agents-drr-globals {
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
  }
  .agents-drr-globals strong {
    color: #4f46e5;
    font-family: ui-monospace, monospace;
    margin: 0 0.3rem;
  }
  .agents-drr-flow {
    background: rgba(0,0,0,0.4);
    color: #c9d1d9;
    padding: 0.8rem;
    border-radius: 4px;
    font-family: ui-monospace, "JetBrains Mono", monospace;
    font-size: 0.78rem;
    line-height: 1.4;
    overflow-x: auto;
    white-space: pre;
  }
</style>