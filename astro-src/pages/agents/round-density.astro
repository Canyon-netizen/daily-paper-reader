---
// /agents/round-density.astro — iter #156:round density profile
//
// 跨 session 看每轮的"密度":
//   - proposals per round(产生多少)
//   - promoted per round(采纳多少)
//   - 跨 session 的 r1/r2/r3 平均 proposal 数
//   - "流产" = 跑 ≤ 2 round 后不再更新的 sessions

import { readFile, readdir, stat } from 'node:fs/promises';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import '../../styles/agents.css';

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');

interface SessionDensity {
  sid: string;
  goal: string;
  rounds: number;
  proposalsPerRound: number[];
  promotedPerRound: number[];
  lastMtime: number;
  aborted: boolean;
  mtime: number;
}

const sessions: SessionDensity[] = [];
const root = join(process.cwd(), 'archive');
const now = Date.now();
if (existsSync(root)) {
  const sids = await readdir(root).catch(() => []);
  for (const sid of sids) {
    const rd = join(root, sid, 'rounds');
    if (!existsSync(rd)) continue;
    let goal = '';
    const mp = join(root, sid, 'meta.json');
    if (existsSync(mp)) {
      try { goal = JSON.parse(await readFile(mp, 'utf8')).goal ?? ''; } catch (e) { /* */ }
    }
    const rfs = await readdir(rd).catch(() => []);
    const rNum: number[] = [];
    for (const rf of rfs) {
      const m = rf.match(/^round_(\d+)\.json$/);
      if (m) rNum.push(parseInt(m[1], 10));
    }
    rNum.sort((a, b) => a - b);
    if (rNum.length === 0) continue;
    const maxR = Math.max(...rNum);
    const proposalsPerRound: number[] = [];
    const promotedPerRound: number[] = [];
    let lastMtime = 0;
    for (let i = 1; i <= maxR; i++) {
      const fp = join(rd, `round_${i}.json`);
      if (!existsSync(fp)) {
        proposalsPerRound.push(0);
        promotedPerRound.push(0);
        continue;
      }
      try {
        const st = await stat(fp);
        if (st.mtimeMs > lastMtime) lastMtime = st.mtimeMs;
        const r = JSON.parse(await readFile(fp, 'utf8'));
        const proposalCount = (r.designer?.proposals ?? []).length;
        let promoted = 0;
        for (const gp of r.gate?.proposals ?? []) {
          if (gp.category === 'promoted') promoted += 1;
        }
        proposalsPerRound.push(proposalCount);
        promotedPerRound.push(promoted);
      } catch (e) {
        proposalsPerRound.push(0);
        promotedPerRound.push(0);
      }
    }
    sessions.push({
      sid, goal,
      rounds: maxR,
      proposalsPerRound,
      promotedPerRound,
      lastMtime,
      aborted: false,
      mtime: now,
    });
  }
}

// 标 abort(7 天没更新且 rounds < 3)
const ABORT_MS = 7 * 24 * 60 * 60 * 1000;
for (const s of sessions) {
  s.aborted = s.rounds < 3 && (now - s.lastMtime) > ABORT_MS;
}

// per-round-index averages
const MAX_ROUNDS = Math.max(...sessions.map((s) => s.rounds), 1);
const avgProps: number[] = [];
const avgProm: number[] = [];
for (let i = 1; i <= MAX_ROUNDS; i++) {
  let pSum = 0, pN = 0, gSum = 0;
  for (const s of sessions) {
    if (s.proposalsPerRound[i - 1] != null) {
      pSum += s.proposalsPerRound[i - 1];
      pN += 1;
    }
    if (s.promotedPerRound[i - 1] != null) gSum += s.promotedPerRound[i - 1];
  }
  avgProps.push(pN > 0 ? pSum / pN : 0);
  avgProm.push(gSum / sessions.length);
}

const abortedCount = sessions.filter((s) => s.aborted).length;
const totalSessions = sessions.length;

function bar(n: number, max: number, width = 30): string {
  if (!max) return '░'.repeat(width);
  const filled = Math.round((n / max) * width);
  return '█'.repeat(filled) + '░'.repeat(width - filled);
}
function esc(s: any): string {
  return String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({ '&': '&', '<': '<', '>': '>', '"': '"', "'": '&#39;' }[c] || c));
}
function fmtDate(ts: number): string {
  if (!ts) return '—';
  return new Date(ts).toISOString().slice(0, 10);
}
---

<BaseLayout title="Round Density · Agents">
  <Navbar />
  <main class="shell agents-shell">
    <nav class="agents-breadcrumb">
      <a href={`${base}/agents/`}>← 多智能体控制台</a>
      <span class="muted"> / round-density</span>
    </nav>

    <header class="agents-header">
      <h1>🧬 Round Density <span class="muted" style="font-size:0.6em">(iter #156)</span></h1>
      <p class="agents-sub">
        跨 session 看每轮的"密度":每轮产生多少 proposals / promoted。
        平均分布 + 流产识别。
      </p>
    </header>

    <section class="agents-session-section">
      <h2>📊 全局</h2>
      <div class="agents-rd-globals">
        <span>总 sessions: <strong>{totalSessions}</strong></span>
        <span>最长 session rounds: <strong>{MAX_ROUNDS}</strong></span>
        <span>流产 sessions (rounds<3 + 7d 无更新): <strong>{abortedCount}</strong> ({totalSessions > 0 ? ((abortedCount/totalSessions)*100).toFixed(1) : '0'}%)</span>
      </div>
    </section>

    <section class="agents-session-section">
      <h2>📈 per-round 平均 proposal 数</h2>
      <pre class="agents-rd-flow">{avgProps.map((v, i) => {
        const r = `Round ${String(i + 1).padStart(2)}`;
        const max = Math.max(...avgProps, 1);
        return `${r} ${bar(v, max, 24)}  ${v.toFixed(2)} proposals`;
      }).join('\n')}</pre>
    </section>

    <section class="agents-session-section">
      <h2>📈 per-round 平均 promoted 数</h2>
      <pre class="agents-rd-flow">{avgProm.map((v, i) => {
        const r = `Round ${String(i + 1).padStart(2)}`;
        const max = Math.max(...avgProm, 1);
        return `${r} ${bar(v, max, 24)}  ${v.toFixed(2)} promoted`;
      }).join('\n')}</pre>
    </section>

    <section class="agents-session-section">
      <h2>🪦 流产的 sessions (按 lastMtime 排序)</h2>
      <table class="agents-session-table">
        <thead>
          <tr><th>sid</th><th>rounds</th><th>last update</th><th>goal</th></tr>
        </thead>
        <tbody>
          {sessions
            .filter((s) => s.aborted)
            .sort((a, b) => b.lastMtime - a.lastMtime)
            .slice(0, 30)
            .map((s) => (
              <tr>
                <td><a href={`${base}/agents/${s.sid}/`}><code>{esc(s.sid.slice(0, 14))}</code></a></td>
                <td>{s.rounds}</td>
                <td>{fmtDate(s.lastMtime)}</td>
                <td><small class="muted">{esc(s.goal.slice(0, 60))}{(s.goal ?? '').length > 60 ? '…' : ''}</small></td>
              </tr>
            ))}
        </tbody>
      </table>
    </section>

    <section class="agents-session-section">
      <h2>💡 解读</h2>
      <ul>
        <li>如果 Round 1 → 2 的 proposals 数大幅下降,可能是 designer 在自我重置</li>
        <li>如果 promoted 数持续 = 0,可能是 gate 阈值太高 — 看 <a href={`${base}/agents/gate-throughput/`}>Gate Throughput</a></li>
        <li>流产 sessions 可考虑在 <a href={`${base}/agents/resume/`}>Resume Suggestions</a> 中恢复</li>
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .agents-rd-globals {
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
  }
  .agents-rd-globals strong {
    color: #4f46e5;
    font-family: ui-monospace, monospace;
    margin: 0 0.3rem;
  }
  .agents-rd-flow {
    background: rgba(0,0,0,0.4);
    color: #c9d1d9;
    padding: 0.8rem;
    border-radius: 4px;
    font-family: ui-monospace, "JetBrains Mono", monospace;
    font-size: 0.78rem;
    line-height: 1.4;
    overflow-x: auto;
    white-space: pre;
  }
</style>