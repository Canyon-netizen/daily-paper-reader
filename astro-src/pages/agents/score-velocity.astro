---
// /agents/score-velocity.astro — iter #301:score velocity profile
//
// score velocity = (score_now - score_prev) per round.
//   - per session: avg velocity / max velocity / total displacement
//   - per round position: avg velocity (smooth curve of improvement rate)
//   - global: avg velocity across all sessions

import { readFile, readdir } from 'node:fs/promises';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import '../../styles/agents.css';

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');

interface SessInfo {
  sid: string;
  goal: string;
  velocities: number[];
  avgVelocity: number;
  maxVelocity: number;
  totalDisplacement: number;
}

interface PosStat {
  position: number;
  velocities: number[];
  avg: number;
  count: number;
}

const root = join(process.cwd(), 'archive');
const sessions: SessInfo[] = [];
const posMap = new Map<number, number[]>();

if (existsSync(root)) {
  const sids = await readdir(root).catch(() => []);
  for (const sid of sids) {
    const sp = join(root, sid);
    if (!existsSync(sp)) continue;
    let goal = '';
    const mp = join(sp, 'meta.json');
    if (existsSync(mp)) {
      try { goal = JSON.parse(await readFile(mp, 'utf8')).goal ?? ''; } catch (e) { /* */ }
    }
    const rd = join(sp, 'rounds');
    if (!existsSync(rd)) continue;
    const rfs = await readdir(rd).catch(() => []);
    const rNums: number[] = [];
    for (const rf of rfs) {
      const m = rf.match(/^round_(\d+)\.json$/);
      if (m) rNums.push(parseInt(m[1], 10));
    }
    if (rNums.length < 2) continue;
    rNums.sort((a, b) => a - b);

    const scores: number[] = [];
    for (const rn of rNums) {
      try {
        const r = JSON.parse(await readFile(join(rd, `round_${rn}.json`), 'utf8'));
        const arr: number[] = [];
        for (const persona of r.feedback?.personas ?? []) {
          for (const p of persona.proposals ?? []) {
            if (typeof p.total === 'number') arr.push(p.total);
          }
        }
        if (arr.length > 0) scores.push(arr.reduce((a, b) => a + b, 0) / arr.length);
      } catch (e) { /* */ }
    }
    if (scores.length < 2) continue;

    const velocities: number[] = [];
    for (let i = 1; i < scores.length; i++) {
      const v = scores[i] - scores[i - 1];
      velocities.push(v);
      const pos = i + 1;
      if (!posMap.has(pos)) posMap.set(pos, []);
      posMap.get(pos)!.push(v);
    }
    const avgV = velocities.reduce((a, b) => a + b, 0) / velocities.length;
    const maxV = Math.max(...velocities);
    const total = scores[scores.length - 1] - scores[0];
    sessions.push({ sid, goal, velocities, avgVelocity: avgV, maxVelocity: maxV, totalDisplacement: total });
  }
}

const positions: PosStat[] = [];
for (const [pos, vels] of [...posMap.entries()].sort((a, b) => a[0] - b[0])) {
  positions.push({
    position: pos,
    velocities: vels,
    avg: vels.reduce((a, b) => a + b, 0) / vels.length,
    count: vels.length,
  });
}

const SPARK_CHARS = ['▁', '▂', '▃', '▄', '▅', '▆', '▇', '█'];
const total = sessions.length;
const sortedByAvg = [...sessions].sort((a, b) => b.avgVelocity - a.avgVelocity);

function spark(values: number[]): string {
  if (values.length === 0) return '';
  const min = Math.min(...values);
  const max = Math.max(...values);
  if (max === min) return SPARK_CHARS[0].repeat(values.length);
  return values.map((v) => {
    const idx = Math.min(7, Math.floor(((v - min) / (max - min)) * 7));
    return SPARK_CHARS[idx];
  }).join('');
}
function bar(n: number, max: number, width = 22): string {
  if (!max) return '░'.repeat(width);
  const filled = Math.round((n / max) * width);
  return '█'.repeat(filled) + '░'.repeat(width - filled);
}

const globalAvgV = total > 0 ? sessions.reduce((s, x) => s + x.avgVelocity, 0) / total : 0;
const fast = sessions.filter((s) => s.avgVelocity > 0.5).length;
const slow = sessions.filter((s) => s.avgVelocity < 0).length;

function esc(s: any): string {
  const str = String(s == null ? '' : s);
  return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}
---

<BaseLayout title="Score Velocity · Agents">
  <Navbar />
  <main class="shell agents-shell">
    <nav class="agents-breadcrumb">
      <a href={`${base}/agents/`}>← 多智能体控制台</a>
      <span class="muted"> / score-velocity</span>
    </nav>

    <header class="agents-header">
      <h1>💨 Score Velocity <span class="muted" style="font-size:0.6em">(iter #301)</span></h1>
      <p class="agents-sub">
        score velocity = (score_now - score_prev)。看 modifier 在第几轮跑得最快。
      </p>
    </header>

    <section class="agents-session-section">
      <h2>📊 全局</h2>
      <div class="agents-sv-globals">
        <span>总 sessions: <strong>{total}</strong></span>
        <span>global avg velocity: <strong>{globalAvgV.toFixed(3)}</strong></span>
        <span>fast (>0.5): <strong style="color:#10b981">{fast}</strong></span>
        <span>slow (<0): <strong style="color:#ef4444">{slow}</strong></span>
      </div>
    </section>

    <section class="agents-session-section">
      <h2>📈 各 round position avg velocity</h2>
      <pre class="agents-sv-flow">{positions.map((p) => {
        const sym = p.avg >= 0 ? '+' : ' ';
        return `R${p.position.toString().padStart(2)}  ${sym}${p.avg.toFixed(3)}  n=${p.count}`;
      }).join('\n')}</pre>
    </section>

    <section class="agents-session-section">
      <h2>🏎️ Top 15 最快 sessions</h2>
      <table class="agents-session-table">
        <thead>
          <tr><th>#</th><th>sid</th><th>avg velocity</th><th>max</th><th>displacement</th><th>velocity spark</th><th>goal</th></tr>
        </thead>
        <tbody>
          {sortedByAvg.slice(0, 15).map((s, i) => (
            <tr>
              <td>{i + 1}</td>
              <td><a href={`${base}/agents/${s.sid}/`}><code>{esc(s.sid.slice(0, 10))}</code></a></td>
              <td><strong style="color:#10b981">+{s.avgVelocity.toFixed(3)}</strong></td>
              <td>{s.maxVelocity >= 0 ? '+' : ''}{s.maxVelocity.toFixed(2)}</td>
              <td>{s.totalDisplacement >= 0 ? '+' : ''}{s.totalDisplacement.toFixed(2)}</td>
              <td style="font-family:ui-monospace,monospace">{spark(s.velocities)}</td>
              <td><small class="muted">{esc((s.goal ?? '').slice(0, 25))}{(s.goal ?? '').length > 25 ? '…' : ''}</small></td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="agents-session-section">
      <h2>💡 解读</h2>
      <ul>
        <li>global avg velocity &gt; 0 = 系统整体有改进</li>
        <li>velocity 早高晚低 = 边际收益递减</li>
        <li>velocity 晚高 = 后期 deep refinement 效果显著</li>
        <li>对照 <a href={`${base}/agents/round-position-trajectory/`}>Round Position Trajectory</a></li>
        <li>对照 <a href={`${base}/agents/improvement-rate/`}>Improvement Rate</a></li>
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .agents-sv-globals {
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
  }
  .agents-sv-globals strong {
    color: #4f46e5;
    font-family: ui-monospace, monospace;
    margin: 0 0.3rem;
  }
  .agents-sv-flow {
    background: rgba(0,0,0,0.4);
    color: #c9d1d9;
    padding: 0.8rem;
    border-radius: 4px;
    font-family: ui-monospace, "JetBrains Mono", monospace;
    font-size: 0.78rem;
    line-height: 1.4;
    overflow-x: auto;
    white-space: pre;
  }
</style>