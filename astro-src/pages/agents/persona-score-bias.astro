---
// /agents/persona-score-bias.astro — iter #283:persona score bias analysis
//
// 哪个 persona 给分最高?哪个最严苛?
//   - 每个 persona 的 avg / min / max / σ
//   - 与全局均值的偏差 (bias)
//   - 哪个 persona 是 "nice" / "harsh"

import { readFile, readdir } from 'node:fs/promises';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import '../../styles/agents.css';

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');

interface PersonaStat {
  name: string;
  count: number;
  scores: number[];
  avg: number;
  min: number;
  max: number;
  std: number;
  bias: number;     // avg - globalAvg
}

const root = join(process.cwd(), 'archive');
const personaMap = new Map<string, number[]>();
const allScores: number[] = [];

if (existsSync(root)) {
  const sids = await readdir(root).catch(() => []);
  for (const sid of sids) {
    const rd = join(root, sid, 'rounds');
    if (!existsSync(rd)) continue;
    const rfs = await readdir(rd).catch(() => []);
    for (const rf of rfs) {
      if (!/^round_\d+\.json$/.test(rf)) continue;
      try {
        const r = JSON.parse(await readFile(join(rd, rf), 'utf8'));
        for (const persona of r.feedback?.personas ?? []) {
          const name = persona.persona ?? persona.name ?? persona.role ?? 'unknown';
          for (const p of persona.proposals ?? []) {
            if (typeof p.total === 'number') {
              allScores.push(p.total);
              if (!personaMap.has(name)) personaMap.set(name, []);
              personaMap.get(name)!.push(p.total);
            }
          }
        }
      } catch (e) { /* */ }
    }
  }
}

const globalAvg = allScores.length > 0 ? allScores.reduce((a, b) => a + b, 0) / allScores.length : 0;

const stats: PersonaStat[] = [];
for (const [name, scores] of personaMap.entries()) {
  if (scores.length < 3) continue;
  const avg = scores.reduce((a, b) => a + b, 0) / scores.length;
  const min = Math.min(...scores);
  const max = Math.max(...scores);
  const variance = scores.reduce((s, x) => s + (x - avg) ** 2, 0) / scores.length;
  const std = Math.sqrt(variance);
  stats.push({ name, count: scores.length, scores, avg, min, max, std, bias: avg - globalAvg });
}

stats.sort((a, b) => b.avg - a.avg);

const total = allScores.length;

function esc(s: any): string {
  const str = String(s == null ? '' : s);
  return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}
function fmtBias(b: number): string {
  if (b > 0) return `+${b.toFixed(2)}`;
  return b.toFixed(2);
}
function biasColor(b: number): string {
  if (b > 0.3) return '#10b981';
  if (b < -0.3) return '#ef4444';
  return '#94a3b8';
}
function badge(b: number): string {
  if (b > 0.5) return '🟢 generous';
  if (b > 0.1) return '🟡 mild';
  if (b > -0.1) return '⚪ neutral';
  if (b > -0.5) return '🟠 strict';
  return '🔴 harsh';
}
---

<BaseLayout title="Persona Score Bias · Agents">
  <Navbar />
  <main class="shell agents-shell">
    <nav class="agents-breadcrumb">
      <a href={`${base}/agents/`}>← 多智能体控制台</a>
      <span class="muted"> / persona-score-bias</span>
    </nav>

    <header class="agents-header">
      <h1>👥 Persona Score Bias <span class="muted" style="font-size:0.6em">(iter #283)</span></h1>
      <p class="agents-sub">
        哪个 persona 最慷慨 / 最严苛? 每个 persona 的 avg/min/max/σ,与全局均值的偏差(bias)。
      </p>
    </header>

    <section class="agents-session-section">
      <h2>📊 全局</h2>
      <div class="agents-psb-globals">
        <span>总 proposals: <strong>{total}</strong></span>
        <span>personas 覆盖: <strong>{stats.length}</strong></span>
        <span>global avg: <strong>{globalAvg.toFixed(2)}</strong></span>
      </div>
    </section>

    <section class="agents-session-section">
      <h2>📊 persona 分数排行</h2>
      <table class="agents-session-table">
        <thead>
          <tr>
            <th>#</th>
            <th>persona</th>
            <th>count</th>
            <th>avg</th>
            <th>min</th>
            <th>max</th>
            <th>σ</th>
            <th>bias</th>
            <th>印象</th>
          </tr>
        </thead>
        <tbody>
          {stats.map((p, i) => (
            <tr>
              <td>{i + 1}</td>
              <td><strong style="color:#4f46e5">{esc(p.name)}</strong></td>
              <td>{p.count}</td>
              <td><strong>{p.avg.toFixed(2)}</strong></td>
              <td>{p.min.toFixed(2)}</td>
              <td>{p.max.toFixed(2)}</td>
              <td>{p.std.toFixed(2)}</td>
              <td style={`color:${biasColor(p.bias)}`}><strong>{fmtBias(p.bias)}</strong></td>
              <td><small>{badge(p.bias)}</small></td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="agents-session-section">
      <h2>📊 bias 分布</h2>
      <pre class="agents-psb-flow">{stats.map((p) => {
        const sym = p.bias > 0 ? '+' : ' ';
        const width = 22;
        const filled = Math.min(width, Math.max(0, Math.round((p.bias + 1.5) * 4)));
        const bar = '█'.repeat(filled) + '░'.repeat(width - filled);
        return `${p.name.padEnd(20)} ${bar}  ${sym}${p.bias.toFixed(2)}`;
      }).join('\n')}</pre>
    </section>

    <section class="agents-session-section">
      <h2>💡 解读</h2>
      <ul>
        <li><strong>generous</strong>(bias &gt; +0.5)= 显著宽松, score 偏高</li>
        <li><strong>strict</strong>(bias &lt; -0.5)= 显著严苛, score 偏低</li>
        <li><strong>σ 小</strong>= 评分稳定 / <strong>σ 大</strong>= 评分波动</li>
        <li>对照 <a href={`${base}/agents/persona-consistency/`}>Persona Consistency</a> 看稳定性</li>
        <li>对照 <a href={`${base}/agents/persona-pair-corr/`}>Persona Pair Corr</a> 看关联</li>
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .agents-psb-globals {
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
  }
  .agents-psb-globals strong {
    color: #4f46e5;
    font-family: ui-monospace, monospace;
    margin: 0 0.3rem;
  }
  .agents-psb-flow {
    background: rgba(0,0,0,0.4);
    color: #c9d1d9;
    padding: 0.8rem;
    border-radius: 4px;
    font-family: ui-monospace, "JetBrains Mono", monospace;
    font-size: 0.78rem;
    line-height: 1.4;
    overflow-x: auto;
    white-space: pre;
  }
</style>