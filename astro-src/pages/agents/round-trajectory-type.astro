---
// /agents/round-trajectory-type.astro — iter #330:round score trajectory shape classification
//
// 把每个 session 的分数曲线按形状分类,看大多 session 是单调上升还是平台。

import { readFile, readdir } from 'node:fs/promises';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import '../../styles/agents.css';

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');

interface Trajectory {
  sid: string;
  goal: string;
  scores: number[];
  type: string;
  startScore: number;
  endScore: number;
  gain: number;
  totalRounds: number;
}

function classify(scores: number[]): string {
  const n = scores.length;
  if (n < 2) return 'too-short';

  // Compute deltas
  const deltas: number[] = [];
  for (let i = 1; i < n; i++) deltas.push(scores[i] - scores[i - 1]);

  const pos = deltas.filter((d) => d > 0.02).length;
  const neg = deltas.filter((d) => d < -0.02).length;
  const flat = deltas.filter((d) => Math.abs(d) <= 0.02).length;

  // Find midpoint and tally sign on each side
  const mid = Math.floor(n / 2);
  const firstHalf = deltas.slice(0, mid);
  const secondHalf = deltas.slice(mid);
  const firstPos = firstHalf.filter((d) => d > 0).length;
  const firstNeg = firstHalf.filter((d) => d < 0).length;
  const secondPos = secondHalf.filter((d) => d > 0).length;
  const secondNeg = secondHalf.filter((d) => d < 0).length;

  if (n <= 2) {
    if (pos > 0 && neg === 0) return 'short-rising';
    if (neg > 0 && pos === 0) return 'short-falling';
    return 'too-short';
  }

  // Monotonic
  if (neg === 0 && flat < n - 1) return 'monotonic-rising';
  if (pos === 0 && flat < n - 1) return 'monotonic-falling';

  // Plateau: many flats
  if (flat >= n * 0.5) return 'plateau';

  // Oscillation: lots of sign changes
  let signChanges = 0;
  for (let i = 1; i < deltas.length; i++) {
    if (Math.sign(deltas[i]) !== Math.sign(deltas[i - 1]) && deltas[i] !== 0 && deltas[i - 1] !== 0) {
      signChanges += 1;
    }
  }
  if (signChanges >= n * 0.6) return 'oscillating';

  // U-shape: decline then rise
  if (firstNeg > firstPos && secondPos > secondNeg) return 'u-shape';
  // Inverted U: rise then decline
  if (firstPos > firstNeg && secondNeg > secondPos) return 'inverted-u';

  // Mostly rising or mostly falling
  if (pos > neg * 1.5) return 'mostly-rising';
  if (neg > pos * 1.5) return 'mostly-falling';

  return 'mixed';
}

const root = join(process.cwd(), 'archive');
const trajectories: Trajectory[] = [];

if (existsSync(root)) {
  const sids = await readdir(root).catch(() => []);
  for (const sid of sids) {
    const rd = join(root, sid, 'rounds');
    if (!existsSync(rd)) continue;
    const rfs = await readdir(rd).catch(() => []);
    const rNums: number[] = [];
    for (const rf of rfs) {
      const m = rf.match(/^round_(\d+)\.json$/);
      if (m) rNums.push(parseInt(m[1], 10));
    }
    if (rNums.length < 2) continue;
    rNums.sort((a, b) => a - b);

    const scores: number[] = [];
    for (const rn of rNums) {
      try {
        const r = JSON.parse(await readFile(join(rd, `round_${rn}.json`), 'utf8'));
        const arr: number[] = [];
        for (const persona of r.feedback?.personas ?? []) {
          for (const p of persona.proposals ?? []) {
            if (typeof p.total === 'number') arr.push(p.total);
          }
        }
        if (arr.length > 0) scores.push(arr.reduce((a, b) => a + b, 0) / arr.length);
      } catch (e) { /* */ }
    }
    if (scores.length < 2) continue;

    let goal = '';
    const mp = join(root, sid, 'meta.json');
    if (existsSync(mp)) {
      try { goal = JSON.parse(await readFile(mp, 'utf8')).goal ?? ''; } catch (e) { /* */ }
    }

    trajectories.push({
      sid,
      goal,
      scores,
      type: classify(scores),
      startScore: scores[0],
      endScore: scores[scores.length - 1],
      gain: scores[scores.length - 1] - scores[0],
      totalRounds: scores.length,
    });
  }
}

const typeCount = new Map<string, number>();
for (const t of trajectories) typeCount.set(t.type, (typeCount.get(t.type) ?? 0) + 1);

const typeOrder = [
  'monotonic-rising', 'mostly-rising', 'monotonic-falling', 'mostly-falling',
  'plateau', 'oscillating', 'u-shape', 'inverted-u', 'mixed', 'short-rising', 'short-falling', 'too-short',
];

const total = trajectories.length;

function bar(n: number, max: number, width = 22): string {
  if (!max) return '░'.repeat(width);
  const filled = Math.round((n / max) * width);
  return '█'.repeat(filled) + '░'.repeat(width - filled);
}

// Per type: avg gain
const typeGain = new Map<string, { sum: number; count: number }>();
for (const t of trajectories) {
  if (!typeGain.has(t.type)) typeGain.set(t.type, { sum: 0, count: 0 });
  const tg = typeGain.get(t.type)!;
  tg.sum += t.gain;
  tg.count += 1;
}

function sparkline(arr: number[], width = 18): string {
  if (arr.length === 0) return '·'.repeat(width);
  const mn = Math.min(...arr);
  const mx = Math.max(...arr);
  const range = mx - mn || 1;
  const chars = ['▁', '▂', '▃', '▄', '▅', '▆', '▇', '█'];
  // Downsample to width
  const out: string[] = [];
  for (let i = 0; i < width; i++) {
    const idx = Math.floor((i / (width - 1)) * (arr.length - 1));
    const v = arr[Math.max(0, Math.min(arr.length - 1, idx))];
    const ratio = (v - mn) / range;
    out.push(chars[Math.min(chars.length - 1, Math.floor(ratio * (chars.length - 1)))]);
  }
  return out.join('');
}

function esc(s: any): string {
  const str = String(s == null ? '' : s);
  return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}
---

<BaseLayout title="Round Trajectory Type · Agents">
  <Navbar />
  <main class="shell agents-shell">
    <nav class="agents-breadcrumb">
      <a href={`${base}/agents/`}>← 多智能体控制台</a>
      <span class="muted"> / round-trajectory-type</span>
    </nav>

    <header class="agents-header">
      <h1>📈 Round Trajectory Type <span class="muted" style="font-size:0.6em">(iter #330)</span></h1>
      <p class="agents-sub">
        每个 session 的 score 曲线形状分类。
        monotonic-rising / mostly-rising / plateau / oscillating / u-shape / mixed ...
      </p>
    </header>

    <section class="agents-session-section">
      <h2>📊 类型分布</h2>
      <pre class="agents-rtt-flow">{typeOrder.filter((t) => typeCount.has(t)).map((t) => {
        const c = typeCount.get(t) ?? 0;
        const pct = total > 0 ? ((c / total) * 100).toFixed(1) : '0.0';
        const tg = typeGain.get(t);
        const avgG = tg && tg.count > 0 ? (tg.sum / tg.count) : 0;
        return `${t.padEnd(22)} ${bar(c, Math.max(...typeCount.values(), 1), 22)}  ${c.toString().padStart(4)} (${pct}%)  avg gain ${avgG >= 0 ? '+' : ''}${avgG.toFixed(2)}`;
      }).join('\n')}</pre>
    </section>

    <section class="agents-session-section">
      <h2>📝 10 个样本 session 轨迹</h2>
      <table class="agents-session-table">
        <thead>
          <tr><th>sid</th><th>type</th><th>sparkline</th><th>rounds</th><th>gain</th><th>goal</th></tr>
        </thead>
        <tbody>
          {trajectories.slice(0, 10).map((t) => (
            <tr>
              <td><a href={`${base}/agents/${t.sid}/`}><code>{esc(t.sid.slice(0, 8))}</code></a></td>
              <td><strong style="color:#4f46e5">{esc(t.type)}</strong></td>
              <td><code>{sparkline(t.scores, 18)}</code></td>
              <td>{t.totalRounds}</td>
              <td><strong style={`color:${t.gain >= 0 ? '#10b981' : '#ef4444'}`}>{t.gain >= 0 ? '+' : ''}{t.gain.toFixed(2)}</strong></td>
              <td><small class="muted">{esc(t.goal.slice(0, 22))}{t.goal.length > 22 ? '…' : ''}</small></td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="agents-session-section">
      <h2>💡 解读</h2>
      <ul>
        <li>monotonic-rising 占比 = 系统持续改进能力</li>
        <li>plateau 占比 = 系统在某些 session 卡住</li>
        <li>oscillating 占比 = 系统决策不稳定</li>
        <li>u-shape / inverted-u = 系统有"反转"</li>
        <li>对照 <a href={`${base}/agents/improvement-pattern-cluster/`}>Improvement Pattern Cluster</a></li>
        <li>对照 <a href={`${base}/agents/round-position-trajectory/`}>Round Position Trajectory</a></li>
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .agents-rtt-flow {
    background: rgba(0,0,0,0.4);
    color: #c9d1d9;
    padding: 0.8rem;
    border-radius: 4px;
    font-family: ui-monospace, "JetBrains Mono", monospace;
    font-size: 0.78rem;
    line-height: 1.4;
    overflow-x: auto;
    white-space: pre;
  }
</style>