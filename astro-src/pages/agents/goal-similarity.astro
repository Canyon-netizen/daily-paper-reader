---
// /agents/goal-similarity.astro — iter #198:cross-session goal similarity
//
// 跨 session 看 goal 的相似度:
//   - Jaccard over goal word tokens
//   - top N similar pairs(可能是重复 sessions)
//   - 各 session 与 avg 其他 session 的相似度分布

import { readFile, readdir } from 'node:fs/promises';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import '../../styles/agents.css';

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');

const STOPWORDS = new Set([
  'the', 'a', 'an', 'and', 'or', 'but', 'in', 'on', 'at', 'to', 'for', 'of',
  'with', 'by', 'from', 'as', 'is', 'are', 'was', 'were', 'be', 'been', 'being',
  'have', 'has', 'had', 'do', 'does', 'did', 'will', 'would', 'should', 'could',
  'may', 'might', 'must', 'can', 'this', 'that', 'these', 'those', 'i', 'you',
  'he', 'she', 'it', 'we', 'they', 'what', 'which', 'who', 'when', 'where', 'why',
  'how', 'all', 'each', 'every', 'both', 'few', 'more', 'most', 'other', 'some',
  'such', 'no', 'not', 'only', 'own', 'same', 'so', 'than', 'too', 'very', 's',
  't', 'just', 'don', 'now', '一个', '一些', '什么', '怎么', '怎样', '我们', '你们',
  '他们', '以及', '或者', '但是', '因为', '所以', '如果', '这个', '那个', '这些', '那些',
  '是否', '可以', '可能', '应该', '已经', '正在', '需要', '需要', '使用', '通过',
  '进行', '实现', '构建', '生成', '设计', '开发', '研究', '分析', '关于', '中',
  '上', '下', '里', '为', '于', '是', '的', '了', '在', '和', '有',
]);

function tokenize(goal: string): Set<string> {
  const text = (goal ?? '').toLowerCase();
  const words = text.match(/[a-z0-9一-鿿]+/g) ?? [];
  // 把中文 token 切分成 bigrams 以更细粒度
  const tokens: string[] = [];
  for (const w of words) {
    if (/^[一-鿿]+$/.test(w) && w.length > 1) {
      for (let i = 0; i < w.length - 1; i++) tokens.push(w.slice(i, i + 2));
    } else if (w.length >= 2 && !STOPWORDS.has(w)) {
      tokens.push(w);
    }
  }
  return new Set(tokens);
}

function jaccard(a: Set<string>, b: Set<string>): number {
  if (a.size === 0 && b.size === 0) return 0;
  let inter = 0;
  for (const t of a) if (b.has(t)) inter += 1;
  const uni = a.size + b.size - inter;
  return uni === 0 ? 0 : inter / uni;
}

interface SessionGoal {
  sid: string;
  goal: string;
  tokens: Set<string>;
}

const root = join(process.cwd(), 'archive');
const sessions: SessionGoal[] = [];

if (existsSync(root)) {
  const sids = await readdir(root).catch(() => []);
  for (const sid of sids) {
    const mp = join(root, sid, 'meta.json');
    if (!existsSync(mp)) continue;
    try {
      const goal = JSON.parse(await readFile(mp, 'utf8')).goal ?? '';
      if (!goal || goal.length < 5) continue;
      sessions.push({ sid, goal, tokens: tokenize(goal) });
    } catch (e) { /* */ }
  }
}

const total = sessions.length;

// 计算 pairwise Jaccard,top 20
const pairs: { a: string; b: string; goalA: string; goalB: string; sim: number }[] = [];
for (let i = 0; i < sessions.length; i++) {
  for (let j = i + 1; j < sessions.length; j++) {
    const sim = jaccard(sessions[i].tokens, sessions[j].tokens);
    if (sim > 0.1) {
      pairs.push({
        a: sessions[i].sid,
        b: sessions[j].sid,
        goalA: sessions[i].goal,
        goalB: sessions[j].goal,
        sim,
      });
    }
  }
}
pairs.sort((x, y) => y.sim - x.sim);
const topPairs = pairs.slice(0, 25);

// 每个 session 与其他 session 平均相似度
const simMap = new Map<string, { sum: number; count: number }>();
for (const p of pairs) {
  for (const sid of [p.a, p.b]) {
    const cur = simMap.get(sid) ?? { sum: 0, count: 0 };
    cur.sum += p.sim;
    cur.count += 1;
    simMap.set(sid, cur);
  }
}
const avgSim = [...simMap.entries()].map(([sid, v]) => ({
  sid,
  avg: v.count > 0 ? v.sum / v.count : 0,
  pairCount: v.count,
})).sort((x, y) => y.avg - x.avg);

// 孤立 sessions(无相似 pair)
const lonely = sessions.filter((s) => !simMap.has(s.sid)).slice(0, 20);

// 相似度分布
const buckets = [
  { label: 'sim > 0.5 (重复)', min: 0.5, max: 1.01, count: 0 },
  { label: '0.3 < sim ≤ 0.5', min: 0.3, max: 0.5, count: 0 },
  { label: '0.2 < sim ≤ 0.3', min: 0.2, max: 0.3, count: 0 },
  { label: '0.1 < sim ≤ 0.2', min: 0.1, max: 0.2, count: 0 },
  { label: 'sim ≤ 0.1 (无关)', min: 0, max: 0.1, count: 0 },
];
for (const p of pairs) {
  for (const b of buckets) {
    if (p.sim > b.min && p.sim <= b.max) {
      b.count += 1;
      break;
    }
  }
}
const maxBucket = Math.max(...buckets.map((b) => b.count), 1);

function bar(n: number, max: number, width = 22): string {
  if (!max) return '░'.repeat(width);
  const filled = Math.round((n / max) * width);
  return '█'.repeat(filled) + '░'.repeat(width - filled);
}
function esc(s: any): string {
  return String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({ '&': '&', '<': '<', '>': '>', '"': '"', "'": '&#39;' }[c] || c));
}
---

<BaseLayout title="Goal Similarity · Agents">
  <Navbar />
  <main class="shell agents-shell">
    <nav class="agents-breadcrumb">
      <a href={`${base}/agents/`}>← 多智能体控制台</a>
      <span class="muted"> / goal-similarity</span>
    </nav>

    <header class="agents-header">
      <h1>🧬 Goal Similarity <span class="muted" style="font-size:0.6em">(iter #198)</span></h1>
      <p class="agents-sub">
        跨 session 看 goal 相似度(Jaccard over tokens + 中文 bigram)。
        高相似度 = 可能重复 session。
      </p>
    </header>

    <section class="agents-session-section">
      <h2>📊 全局</h2>
      <div class="agents-gs-globals">
        <span>总 sessions: <strong>{total}</strong></span>
        <span>总 pairs (sim &gt; 0.1): <strong>{pairs.length}</strong></span>
        <span>avg sim (top pairs avg): <strong>{pairs.length > 0 ? (pairs.reduce((s, p) => s + p.sim, 0) / pairs.length).toFixed(3) : '0'}</strong></span>
      </div>
    </section>

    <section class="agents-session-section">
      <h2>📊 相似度分布</h2>
      <pre class="agents-gs-flow">{buckets.map((b) => {
        return `${b.label.padEnd(22)} ${bar(b.count, maxBucket, 22)}  ${String(b.count).padStart(4)}`;
      }).join('\n')}</pre>
    </section>

    <section class="agents-session-section">
      <h2>🔗 top 25 高相似度 pairs</h2>
      <table class="agents-session-table">
        <thead>
          <tr><th>sim</th><th>sid A</th><th>goal A</th><th>sid B</th><th>goal B</th></tr>
        </thead>
        <tbody>
          {topPairs.map((p) => (
            <tr>
              <td><strong>{p.sim.toFixed(2)}</strong></td>
              <td><a href={`${base}/agents/${p.a}/`}><code>{esc(p.a.slice(0, 12))}</code></a></td>
              <td><small class="muted">{esc(p.goalA.slice(0, 30))}…</small></td>
              <td><a href={`${base}/agents/${p.b}/`}><code>{esc(p.b.slice(0, 12))}</code></a></td>
              <td><small class="muted">{esc(p.goalB.slice(0, 30))}…</small></td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="agents-session-section">
      <h2>🌀 平均相似度 top 10 sessions(被多次重复)</h2>
      <table class="agents-session-table">
        <thead>
          <tr><th>sid</th><th>avg sim</th><th>pairs</th></tr>
        </thead>
        <tbody>
          {avgSim.slice(0, 10).map((s) => (
            <tr>
              <td><a href={`${base}/agents/${s.sid}/`}><code>{esc(s.sid.slice(0, 14))}</code></a></td>
              <td><strong>{s.avg.toFixed(3)}</strong></td>
              <td>{s.pairCount}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="agents-session-section">
      <h2>🏝️ 孤立 sessions(无相似 pair)</h2>
      <p class="muted">共 {sessions.length - avgSim.length} 个孤立。展示前 20:</p>
      <table class="agents-session-table">
        <thead>
          <tr><th>sid</th><th>goal</th></tr>
        </thead>
        <tbody>
          {lonely.map((s) => (
            <tr>
              <td><a href={`${base}/agents/${s.sid}/`}><code>{esc(s.sid.slice(0, 14))}</code></a></td>
              <td><small class="muted">{esc(s.goal.slice(0, 80))}…</small></td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="agents-session-section">
      <h2>💡 解读</h2>
      <ul>
        <li>sim &gt; 0.5 = 几乎是同一个目标,可能重复 session,可合并</li>
        <li>中文 token 拆 bigram,英文用整词</li>
        <li>对照 <a href={`${base}/agents/goal-journey/`}>Goal Journey</a> 看单 session 内变化</li>
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .agents-gs-globals {
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
  }
  .agents-gs-globals strong {
    color: #4f46e5;
    font-family: ui-monospace, monospace;
    margin: 0 0.3rem;
  }
  .agents-gs-flow {
    background: rgba(0,0,0,0.4);
    color: #c9d1d9;
    padding: 0.8rem;
    border-radius: 4px;
    font-family: ui-monospace, "JetBrains Mono", monospace;
    font-size: 0.78rem;
    line-height: 1.4;
    overflow-x: auto;
    white-space: pre;
  }
</style>