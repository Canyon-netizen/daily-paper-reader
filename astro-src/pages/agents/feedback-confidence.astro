---
// /agents/feedback-confidence.astro — iter #230:round feedback confidence
//
// 每 round 中 persona 评分的"共识度":
//   - low σ = 高共识(各 persona 看法一致)
//   - high σ = 低共识(分歧大)
//   - 按 round / session 聚合

import { readFile, readdir } from 'node:fs/promises';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import '../../styles/agents.css';

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');

interface RoundConfidence {
  sid: string;
  roundIdx: number;
  scores: number[];
  mean: number;
  stdDev: number;
  confidence: number;  // 1 - σ/5
  consensus: 'high' | 'medium' | 'low';
}

function consensusLevel(sigma: number): 'high' | 'medium' | 'low' {
  if (sigma < 0.5) return 'high';
  if (sigma < 1.5) return 'medium';
  return 'low';
}

const root = join(process.cwd(), 'archive');
const records: RoundConfidence[] = [];

if (existsSync(root)) {
  const sids = await readdir(root).catch(() => []);
  for (const sid of sids) {
    const rd = join(root, sid, 'rounds');
    if (!existsSync(rd)) continue;
    const rfs = await readdir(rd).catch(() => []);
    const rNum: number[] = [];
    for (const rf of rfs) {
      const m = rf.match(/^round_(\d+)\.json$/);
      if (m) rNum.push(parseInt(m[1], 10));
    }
    rNum.sort((a, b) => a - b);
    for (const ri of rNum) {
      try {
        const r = JSON.parse(await readFile(join(rd, `round_${ri}.json`), 'utf8'));
        const scores: number[] = [];
        for (const persona of r.feedback?.personas ?? []) {
          for (const p of persona.proposals ?? []) {
            if (typeof p.total === 'number') scores.push(p.total);
          }
        }
        if (scores.length < 2) continue;
        const mean = scores.reduce((a, b) => a + b, 0) / scores.length;
        const stdDev = Math.sqrt(scores.reduce((s, x) => s + (x - mean) ** 2, 0) / scores.length);
        records.push({
          sid, roundIdx: ri,
          scores, mean, stdDev,
          confidence: Math.max(0, 1 - stdDev / 5),
          consensus: consensusLevel(stdDev),
        });
      } catch (e) { /* */ }
    }
  }
}

const total = records.length;
const avgConfidence = total > 0 ? records.reduce((s, r) => s + r.confidence, 0) / total : 0;
const avgSigma = total > 0 ? records.reduce((s, r) => s + r.stdDev, 0) / total : 0;
const highCount = records.filter((r) => r.consensus === 'high').length;
const medCount = records.filter((r) => r.consensus === 'medium').length;
const lowCount = records.filter((r) => r.consensus === 'low').length;

const topConfident = [...records].sort((a, b) => a.stdDev - b.stdDev).slice(0, 15);
const topDivided = [...records].sort((a, b) => b.stdDev - a.stdDev).slice(0, 15);

function esc(s: any): string {
  return String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({ '&': '&', '<': '<', '>': '>', '"': '"', "'": '&#39;' }[c] || c));
}
function bar(n: number, max: number, width = 20): string {
  if (!max) return '░'.repeat(width);
  const filled = Math.round((n / max) * width);
  return '█'.repeat(filled) + '░'.repeat(width - filled);
}
---

<BaseLayout title="Feedback Confidence · Agents">
  <Navbar />
  <main class="shell agents-shell">
    <nav class="agents-breadcrumb">
      <a href={`${base}/agents/`}>← 多智能体控制台</a>
      <span class="muted"> / feedback-confidence</span>
    </nav>

    <header class="agents-header">
      <h1>🤝 Feedback Confidence <span class="muted" style="font-size:0.6em">(iter #230)</span></h1>
      <p class="agents-sub">
        每 round 的 persona 评分共识度。
        σ 低 = 高共识;σ 高 = 分歧大。
      </p>
    </header>

    <section class="agents-session-section">
      <h2>📊 全局</h2>
      <div class="agents-fc-globals">
        <span>总 rounds: <strong>{total}</strong></span>
        <span>avg σ: <strong>{avgSigma.toFixed(2)}</strong></span>
        <span>avg confidence: <strong>{avgConfidence.toFixed(2)}</strong></span>
      </div>
    </section>

    <section class="agents-session-section">
      <h2>📊 Consensus 分布</h2>
      <pre class="agents-fc-flow">{`high (σ < 0.5):   ${bar(highCount, total, 20)}  ${highCount} (${total > 0 ? ((highCount/total)*100).toFixed(1) : '0'}%)
medium (σ < 1.5): ${bar(medCount, total, 20)}  ${medCount} (${total > 0 ? ((medCount/total)*100).toFixed(1) : '0'}%)
low (σ ≥ 1.5):    ${bar(lowCount, total, 20)}  ${lowCount} (${total > 0 ? ((lowCount/total)*100).toFixed(1) : '0'}%)`}</pre>
    </section>

    <section class="agents-session-section">
      <h2>🤝 top 15 高共识 rounds(low σ)</h2>
      <table class="agents-session-table">
        <thead>
          <tr><th>σ</th><th>mean</th><th>conf</th><th>sid</th><th>round</th></tr>
        </thead>
        <tbody>
          {topConfident.map((r) => (
            <tr>
              <td><strong style="color:#10b981">{r.stdDev.toFixed(3)}</strong></td>
              <td>{r.mean.toFixed(2)}</td>
              <td>{r.confidence.toFixed(2)}</td>
              <td><a href={`${base}/agents/${r.sid}/`}><code>{esc(r.sid.slice(0, 12))}</code></a></td>
              <td>R{r.roundIdx}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="agents-session-section">
      <h2>⚔️ top 15 低共识 rounds(high σ)</h2>
      <table class="agents-session-table">
        <thead>
          <tr><th>σ</th><th>mean</th><th>conf</th><th>sid</th><th>round</th></tr>
        </thead>
        <tbody>
          {topDivided.map((r) => (
            <tr>
              <td><strong style="color:#ef4444">{r.stdDev.toFixed(2)}</strong></td>
              <td>{r.mean.toFixed(2)}</td>
              <td>{r.confidence.toFixed(2)}</td>
              <td><a href={`${base}/agents/${r.sid}/`}><code>{esc(r.sid.slice(0, 12))}</code></a></td>
              <td>R{r.roundIdx}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="agents-session-section">
      <h2>💡 解读</h2>
      <ul>
        <li>confidence = 1 - σ/5,越高越共识</li>
        <li>σ &lt; 0.5 = 各 persona 看法高度一致</li>
        <li>σ &gt; 1.5 = 评审团内部存在明显分歧</li>
        <li>对照 <a href={`${base}/agents/persona-agreement/`}>Persona Agreement</a> 看具体 pair 相关</li>
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .agents-fc-globals {
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
  }
  .agents-fc-globals strong {
    color: #4f46e5;
    font-family: ui-monospace, monospace;
    margin: 0 0.3rem;
  }
  .agents-fc-flow {
    background: rgba(0,0,0,0.4);
    color: #c9d1d9;
    padding: 0.8rem;
    border-radius: 4px;
    font-family: ui-monospace, "JetBrains Mono", monospace;
    font-size: 0.78rem;
    line-height: 1.4;
    overflow-x: auto;
    white-space: pre;
  }
</style>