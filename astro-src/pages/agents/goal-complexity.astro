---
// /agents/goal-complexity.astro — iter #173:goal complexity score
//
// 衡量每个 goal 的"复杂度":
//   - 字数 (chars)
//   - 词数 (words,中英文)
//   - 唯一词比 (lexical diversity)
//   - 数字 / 标点密度
//   - 总复杂度分 = 加权组合
//
// 高分 goal = 信息密度大 / 低分 = 简洁

import { readFile, readdir, stat } from 'node:fs/promises';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import '../../styles/agents.css';

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');

interface Complexity {
  sid: string;
  goal: string;
  chars: number;
  words: number;
  uniqueRatio: number;
  digits: number;
  punctuation: number;
  score: number;
  mtime: number;
}

const root = join(process.cwd(), 'archive');
const comps: Complexity[] = [];

if (existsSync(root)) {
  const sids = await readdir(root).catch(() => []);
  for (const sid of sids) {
    const mp = join(root, sid, 'meta.json');
    if (!existsSync(mp)) continue;
    let goal = '';
    let mtime = 0;
    try {
      const st = await stat(mp);
      mtime = st.mtimeMs;
      goal = JSON.parse(await readFile(mp, 'utf8')).goal ?? '';
    } catch (e) { /* */ }
    if (!goal) continue;

    const chars = goal.length;
    const tokens = goal.match(/[\w一-鿿]+/g) ?? [];
    const words = tokens.length;
    const uniqueSet = new Set(tokens.map((t) => t.toLowerCase()));
    const uniqueRatio = words > 0 ? uniqueSet.size / words : 0;
    const digits = (goal.match(/\d/g) ?? []).length;
    const punctuation = (goal.match(/[.,;:?!(){}[\]"'`]/g) ?? []).length;

    // 加权: 字符 + 词数 + 唯一词比 + 数字 + 标点
    // 满分约 100
    const score = Math.min(100,
      Math.min(chars / 5, 20) + // 长(<=20)
      Math.min(words / 3, 20) +  // 多词(<=20)
      uniqueRatio * 25 +          // 多样性(<=25)
      Math.min(digits / 2, 15) +  // 数字(<=15)
      Math.min(punctuation, 20)   // 标点(<=20)
    );

    comps.push({ sid, goal, chars, words, uniqueRatio, digits, punctuation, score, mtime });
  }
}

const total = comps.length;
const avgScore = comps.length > 0 ? comps.reduce((s, c) => s + c.score, 0) / comps.length : 0;
const avgChars = comps.length > 0 ? comps.reduce((s, c) => s + c.chars, 0) / comps.length : 0;
const avgWords = comps.length > 0 ? comps.reduce((s, c) => s + c.words, 0) / comps.length : 0;

// 直方图
const buckets = [
  { label: '0-20 (极简)', min: 0, max: 20, count: 0 },
  { label: '20-40 (简洁)', min: 20, max: 40, count: 0 },
  { label: '40-60 (中)', min: 40, max: 60, count: 0 },
  { label: '60-80 (详细)', min: 60, max: 80, count: 0 },
  { label: '80-100 (复杂)', min: 80, max: 100.001, count: 0 },
];
for (const c of comps) {
  for (const b of buckets) {
    if (c.score >= b.min && c.score < b.max) {
      b.count += 1;
      break;
    }
  }
}
const maxBucket = Math.max(...buckets.map((b) => b.count), 1);

const topComplex = [...comps].sort((a, b) => b.score - a.score).slice(0, 10);
const topSimple = [...comps].sort((a, b) => a.score - b.score).slice(0, 10);

function bar(n: number, max: number, width = 24): string {
  if (!max) return '░'.repeat(width);
  const filled = Math.round((n / max) * width);
  return '█'.repeat(filled) + '░'.repeat(width - filled);
}
function esc(s: any): string {
  return String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({ '&': '&', '<': '<', '>': '>', '"': '"', "'": '&#39;' }[c] || c));
}
---

<BaseLayout title="Goal Complexity · Agents">
  <Navbar />
  <main class="shell agents-shell">
    <nav class="agents-breadcrumb">
      <a href={`${base}/agents/`}>← 多智能体控制台</a>
      <span class="muted"> / goal-complexity</span>
    </nav>

    <header class="agents-header">
      <h1>🧮 Goal Complexity <span class="muted" style="font-size:0.6em">(iter #173)</span></h1>
      <p class="agents-sub">
        衡量每个 goal 文本的复杂度。
        综合字符数 / 词数 / 唯一词比 / 数字 / 标点密度。
      </p>
    </header>

    <section class="agents-session-section">
      <h2>📊 全局</h2>
      <div class="agents-gc-globals">
        <span>总 sessions: <strong>{total}</strong></span>
        <span>avg chars: <strong>{avgChars.toFixed(0)}</strong></span>
        <span>avg words: <strong>{avgWords.toFixed(0)}</strong></span>
        <span>avg score: <strong>{avgScore.toFixed(1)}</strong></span>
      </div>
    </section>

    <section class="agents-session-section">
      <h2>📊 复杂度分桶</h2>
      <pre class="agents-gc-flow">{buckets.map((b) => {
        return `${b.label.padEnd(18)} ${bar(b.count, maxBucket, 24)}  ${String(b.count).padStart(4)}`;
      }).join('\n')}</pre>
    </section>

    <section class="agents-session-section">
      <h2>🔥 top 10 最复杂</h2>
      <table class="agents-session-table">
        <thead>
          <tr><th>sid</th><th>score</th><th>chars</th><th>words</th><th>unique%</th><th>goal</th></tr>
        </thead>
        <tbody>
          {topComplex.map((c) => (
            <tr>
              <td><a href={`${base}/agents/${c.sid}/`}><code>{esc(c.sid.slice(0, 14))}</code></a></td>
              <td><strong>{c.score.toFixed(1)}</strong></td>
              <td>{c.chars}</td>
              <td>{c.words}</td>
              <td>{(c.uniqueRatio * 100).toFixed(0)}%</td>
              <td><small class="muted">{esc(c.goal.slice(0, 40))}{(c.goal ?? '').length > 40 ? '…' : ''}</small></td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="agents-session-section">
      <h2>📄 top 10 最简洁</h2>
      <table class="agents-session-table">
        <thead>
          <tr><th>sid</th><th>score</th><th>chars</th><th>words</th><th>goal</th></tr>
        </thead>
        <tbody>
          {topSimple.map((c) => (
            <tr>
              <td><a href={`${base}/agents/${c.sid}/`}><code>{esc(c.sid.slice(0, 14))}</code></a></td>
              <td>{c.score.toFixed(1)}</td>
              <td>{c.chars}</td>
              <td>{c.words}</td>
              <td><small class="muted">{esc(c.goal.slice(0, 50))}{(c.goal ?? '').length > 50 ? '…' : ''}</small></td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="agents-session-section">
      <h2>💡 解读</h2>
      <ul>
        <li>复杂度太高 (&gt; 80) → LLM 难以聚焦,可考虑拆分 goal</li>
        <li>复杂度太低 (&lt; 20) → 信息密度不够,LLM 难以生成有深度 proposal</li>
        <li>对照 <a href={`${base}/agents/goal-quality/`}>Goal Quality</a> 看质量</li>
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .agents-gc-globals {
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
  }
  .agents-gc-globals strong {
    color: #4f46e5;
    font-family: ui-monospace, monospace;
    margin: 0 0.3rem;
  }
  .agents-gc-flow {
    background: rgba(0,0,0,0.4);
    color: #c9d1d9;
    padding: 0.8rem;
    border-radius: 4px;
    font-family: ui-monospace, "JetBrains Mono", monospace;
    font-size: 0.78rem;
    line-height: 1.4;
    overflow-x: auto;
    white-space: pre;
  }
</style>