---
// /agents/round-cost-vs-gain-quadrant.astro — iter #398:per-round quadrant classification (cost × gain)

import { readFile, readdir } from 'node:fs/promises';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import '../../styles/agents.css';

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');

interface RoundEntry { sid: string; round: number; cost: number; gain: number; }

const root = join(process.cwd(), 'archive');
const rounds: RoundEntry[] = [];

if (existsSync(root)) {
  const sids = await readdir(root).catch(() => []);
  for (const sid of sids) {
    const rd = join(root, sid, 'rounds');
    if (!existsSync(rd)) continue;
    const rfs = await readdir(rd).catch(() => []);
    const rNums: number[] = [];
    for (const rf of rfs) {
      const m = rf.match(/^round_(\d+)\.json$/);
      if (m) rNums.push(parseInt(m[1], 10));
    }
    if (rNums.length < 3) continue;
    rNums.sort((a, b) => a - b);

    const scores: number[] = [];
    const costs: number[] = [];
    for (const rn of rNums) {
      try {
        const r = JSON.parse(await readFile(join(rd, `round_${rn}.json`), 'utf8'));
        let cost = 0;
        for (const a of (r.modifier?.applied ?? [])) {
          if (typeof a.cost === 'number') cost += a.cost;
        }
        costs.push(cost);
        const arr: number[] = [];
        for (const persona of r.feedback?.personas ?? []) {
          for (const p of persona.proposals ?? []) {
            if (typeof p.total === 'number') arr.push(p.total);
          }
        }
        scores.push(arr.length > 0 ? arr.reduce((a, b) => a + b, 0) / arr.length : 0);
      } catch (e) { costs.push(0); scores.push(0); }
    }
    for (let i = 1; i < scores.length; i++) {
      rounds.push({
        sid,
        round: i + 1,
        cost: costs[i],
        gain: scores[i] - scores[i - 1],
      });
    }
  }
}

const medianCost = (() => {
  if (rounds.length === 0) return 0;
  const s = rounds.map((r) => r.cost).sort((a, b) => a - b);
  return s[Math.floor(s.length / 2)];
})();
const medianGain = (() => {
  if (rounds.length === 0) return 0;
  const s = rounds.map((r) => r.gain).sort((a, b) => a - b);
  return s[Math.floor(s.length / 2)];
})();

interface Quadrant { name: string; emoji: string; count: number; pct: number; avgGain: number; }
const quads: Quadrant[] = [
  { name: 'low-cost high-gain (BEST)', emoji: '🌟', count: 0, pct: 0, avgGain: 0 },
  { name: 'high-cost high-gain (worth it)', emoji: '✨', count: 0, pct: 0, avgGain: 0 },
  { name: 'low-cost low-gain (cheap stagnation)', emoji: '😐', count: 0, pct: 0, avgGain: 0 },
  { name: 'high-cost low-gain (WASTE)', emoji: '💸', count: 0, pct: 0, avgGain: 0 },
];
let totalGainSum = 0;
for (const r of rounds) {
  const highCost = r.cost > medianCost;
  const highGain = r.gain > medianGain;
  let qi: number;
  if (!highCost && highGain) qi = 0;
  else if (highCost && highGain) qi = 1;
  else if (!highCost && !highGain) qi = 2;
  else qi = 3;
  quads[qi].count += 1;
  quads[qi].avgGain += r.gain;
  totalGainSum += r.gain;
}
for (const q of quads) {
  q.pct = rounds.length > 0 ? (q.count / rounds.length) * 100 : 0;
  q.avgGain = q.count > 0 ? q.avgGain / q.count : 0;
}

function bar(n: number, max: number, width = 22): string {
  if (!max) return '░'.repeat(width);
  const filled = Math.round((n / max) * width);
  return '█'.repeat(filled) + '░'.repeat(width - filled);
}

function esc(s: any): string {
  const str = String(s == null ? '' : s);
  return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}
---

<BaseLayout title="Round Cost vs Gain Quadrant · Agents">
  <Navbar />
  <main class="shell agents-shell">
    <nav class="agents-breadcrumb">
      <a href={`${base}/agents/`}>← 多智能体控制台</a>
      <span class="muted"> / round-cost-vs-gain-quadrant</span>
    </nav>

    <header class="agents-header">
      <h1>🎯 Round Cost vs Gain Quadrant <span class="muted" style="font-size:0.6em">(iter #398)</span></h1>
      <p class="agents-sub">
        每个 round-to-round 按 (cost, gain) 落入 4 个象限:
        🌟 low-cost + high-gain(最佳)
        ✨ high-cost + high-gain(值得)
        😐 low-cost + low-gain(停滞)
        💸 high-cost + low-gain(浪费)
      </p>
    </header>

    <section class="agents-session-section">
      <h2>📊 全局</h2>
      <div class="agents-rcvg-globals">
        <span>total rounds: <strong>{rounds.length}</strong></span>
        <span>median cost: <strong>${medianCost.toFixed(2)}</strong></span>
        <span>median gain: <strong>{medianGain.toFixed(3)}</strong></span>
      </div>
    </section>

    <section class="agents-session-section">
      <h2>🎯 Quadrant distribution</h2>
      <table class="agents-session-table">
        <thead>
          <tr><th>quadrant</th><th>count</th><th>%</th><th>avg gain</th><th>bar</th></tr>
        </thead>
        <tbody>
          {quads.map((q) => (
            <tr>
              <td>{q.emoji} <code>{q.name}</code></td>
              <td>{q.count}</td>
              <td>{q.pct.toFixed(1)}%</td>
              <td style={`color:${q.avgGain >= 0 ? '#10b981' : '#ef4444'}`}><strong>{q.avgGain >= 0 ? '+' : ''}{q.avgGain.toFixed(3)}</strong></td>
              <td><code>{bar(q.count, Math.max(...quads.map((x) => x.count)), 28)}</code></td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="agents-session-section">
      <h2>💡 解读</h2>
      <ul>
        <li>🌟 主导 = 系统高性价比(小额投入获得收益)</li>
        <li>💸 高比例 = 系统常浪费 token</li>
        <li>😐 高 = 大量停滞 round(系统不做事只评分)</li>
        <li>对照 <a href={`${base}/agents/round-cost-gain-correlation/`}>Round Cost-Gain Correlation</a></li>
        <li>对照 <a href={`${base}/agents/round-action-total-cost-distribution/`}>Round Action Total Cost</a></li>
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .agents-rcvg-globals {
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
  }
  .agents-rcvg-globals strong {
    color: #4f46e5;
    font-family: ui-monospace, monospace;
    margin: 0 0 0 0.3rem;
  }
</style>