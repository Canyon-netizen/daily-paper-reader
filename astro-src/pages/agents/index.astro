---
// astro-src/pages/agents/index.astro
//
// Multi-agent research loop console.
// Lists recent sessions + their latest round state. Drives Designer →
// Feedback → Modifier from the browser via the same orchestrator the CLI uses.

import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import '../../styles/agents.css';

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
---

<BaseLayout title="多智能体控制台">
  <Navbar />
  <main class="shell agents-shell">
    <header class="agents-header">
      <h1>🤖 多智能体控制台</h1>
      <p class="agents-sub">
        Designer 提出候选 → Feedback 多 persona 评分 → Gate 过滤 → Modifier 调用上游 ideas/experiments/writings。
        无 LLM Key 时跑 dry-run(stub);有 Key 时接 OpenAI 兼容端点。
      </p>
    </header>

    <section class="agents-stats" id="agents-stats">
      <div class="agents-stats-row">
        <span class="agents-stat"><strong id="agents-stat-sessions">0</strong> sessions</span>
        <span class="agents-stat"><strong id="agents-stat-rounds">0</strong> rounds</span>
        <span class="agents-stat"><strong id="agents-stat-proposals">0</strong> proposals</span>
        <span class="agents-stat"><strong id="agents-stat-promoted">0</strong> promoted</span>
        <span class="agents-stat"><strong id="agents-stat-applied">0</strong> applied</span>
        <span class="agents-stat agents-stat-aside" id="agents-stat-last"></span>
      </div>
    </section>

    <section class="agents-controls">
      <div class="agents-controls-row">
        <label>
          <span>Session</span>
          <select id="agents-session-picker">
            <option value="">— 新建 / 输入 —</option>
          </select>
        </label>
        <label>
          <span>Session ID</span>
          <input id="agents-session-id" type="text" placeholder="my-research-project" />
        </label>
        <label>
          <span>项目(可选)</span>
          <select id="agents-project-picker" title="从 UserLibrary 选一个,自动加载其论文作为 candidates">
            <option value="">— 不选 —</option>
          </select>
        </label>
        <button class="button small" id="agents-load-papers-btn" title="从选中项目读 paperIds → 论文库 → 写入 candidates">📚 载入论文</button>
        <label>
          <span>Gate 阈值</span>
          <select id="agents-preset">
            <option value="balanced" selected>balanced</option>
            <option value="conservative">conservative</option>
            <option value="aggressive">aggressive</option>
          </select>
        </label>
        <label>
          <span>最大轮数</span>
          <input id="agents-max-rounds" type="number" min="1" max="20" value="3" />
        </label>
        <label class="agents-checkbox">
          <input id="agents-dry-run" type="checkbox" checked />
          <span>Dry-run (无 LLM 调用)</span>
        </label>
        <label class="agents-checkbox">
          <input id="agents-auto-iterate" type="checkbox" />
          <span title="自动迭代直到 avg score 收敛(连续 N 轮 stdDev &lt; 0.3)或达到上限">🔁 自动迭代到收敛</span>
        </label>
        <button class="button primary" id="agents-run-btn">▶️ 跑一轮</button>
        <button class="button" id="agents-abort-btn" hidden title="中断当前 round 循环(已完成本轮后立即退出)">🛑 停止</button>
        <button class="button" id="agents-duplicate-btn" title="把当前 session 的所有 rounds 复制到新 sid,方便换个 preset/maxRounds 重跑同一基线">📋 复制</button>
        <button class="button" id="agents-delete-btn" title="把当前 session 移到回收站(30 天后自动永久删除,可提前恢复)">🗑️ 删除</button>
        <button class="button" id="agents-export-btn" title="把当前 session + meta 导出为单个 JSON 文件">📦 导出</button>
        <button class="button" id="agents-report-btn" title="生成单份 markdown 实验报告">📑 报告</button>
        <label class="button" for="agents-import-file" title="从 JSON 文件恢复 session 到 localStorage">
          📥 导入
          <input id="agents-import-file" type="file" accept="application/json,.json" hidden />
        </label>
        <label class="agents-checkbox" title="勾上后会覆盖已有 rounds">
          <input id="agents-import-overwrite" type="checkbox" />
          <span>overwrite</span>
        </label>
        <a class="button" href="/agents/compare/" title="多会话并排对比">📊 对比</a>
      </div>
    </section>

    <section class="agents-tokens" id="agents-tokens" hidden>
      <div class="agents-tokens-row">
        <span class="agents-token-cell">
          <span class="agents-token-label">本次 run 总 token</span>
          <strong id="agents-token-total">0</strong>
        </span>
        <span class="agents-token-cell">
          <span class="agents-token-label">估算费用</span>
          <strong id="agents-token-cost">$0.0000</strong>
          <span class="agents-token-aside">
            (<input id="agents-token-rate" type="number" min="0" step="0.05" value="0.50"
                   title="每 1M tokens 的美元单价,留空=不显示费用" /> $/M tok)
          </span>
        </span>
        <span class="agents-token-cell">
          <span class="agents-token-label">本轮已用</span>
          <strong id="agents-token-last">0</strong>
        </span>
        <span class="agents-token-cell agents-token-chart-cell">
          <span class="agents-token-label">每轮分布</span>
          <span class="agents-token-chart" id="agents-token-chart" aria-hidden="true"></span>
        </span>
      </div>
    </section>

    <section class="agents-search" id="agents-search-section">
      <div class="agents-search-row">
        <span class="agents-search-input-cell">
          <span class="agents-meta-label">🔍 全局搜索</span>
          <input id="agents-search" type="text" placeholder="搜 sid / title / notes / tag,空格 AND,Esc 清除" />
          <button class="button small" id="agents-search-clear" type="button">清除</button>
        </span>
        <span class="muted agents-search-count" id="agents-search-count"></span>
      </div>
      <p class="muted agents-search-hint">例:<code>acl methodology</code> 找 sid/title/notes/tag 同时含这两个词的 session</p>
    </section>

    <section class="agents-activity" id="agents-activity" hidden>
      <div class="agents-activity-header">
        <span class="agents-meta-label">📅 最近 30 天活动</span>
        <span class="muted">共 <strong id="agents-activity-total">0</strong> round(s)</span>
        <span class="agents-activity-legend">
          <span class="muted">少</span>
          <span class="agents-heat-cell level-0"></span>
          <span class="agents-heat-cell level-1"></span>
          <span class="agents-heat-cell level-2"></span>
          <span class="agents-heat-cell level-3"></span>
          <span class="agents-heat-cell level-4"></span>
          <span class="muted">多</span>
        </span>
      </div>
      <div class="agents-activity-grid" id="agents-activity-grid"></div>
    </section>

    <section class="agents-filter" id="agents-filter" hidden>
      <div class="agents-filter-header">
        <span class="agents-meta-label">🏷️ 按 tag 过滤 session</span>
        <button class="button small" id="agents-filter-clear" type="button">清除过滤</button>
      </div>
      <div class="agents-filter-chips" id="agents-filter-chips"></div>
    </section>

    <section class="agents-trash" id="agents-trash" hidden>
      <div class="agents-trash-header">
        <h3>🗑️ 回收站 <span class="muted">(30 天后自动永久删除)</span></h3>
        <button class="button small" id="agents-trash-purge-all" title="删除所有已过期的 trash 记录">清空过期</button>
      </div>
      <ul id="agents-trash-list"></ul>
    </section>

    <section class="agents-meta" id="agents-meta" hidden>
      <div class="agents-meta-row">
        <span class="agents-meta-title-cell">
          <span class="agents-meta-label">标题(可选)</span>
          <input id="agents-meta-title" type="text" placeholder="给这个 session 起个名字,例如:ACL 论文 review" maxlength="80" />
        </span>
        <span class="agents-meta-when">
          <span class="muted" id="agents-meta-when"></span>
        </span>
      </div>
      <div class="agents-meta-row">
        <span class="agents-meta-notes-cell">
          <span class="agents-meta-label">Notes(自由记录)</span>
          <textarea id="agents-meta-notes" rows="3" placeholder="想记住的事:目标 / 上下文 / 已尝试的方法 / 下一步计划…"></textarea>
        </span>
      </div>
      <div class="agents-meta-row">
        <span class="agents-meta-tags-cell">
          <span class="agents-meta-label">🏷️ Tags(逗号分隔,Enter 保存)</span>
          <input id="agents-meta-tags" type="text" placeholder="methodology, write-up, acl2026" />
          <span class="agents-meta-tags-chips" id="agents-meta-tags-chips"></span>
        </span>
      </div>
      <p class="muted agents-meta-hint">数据存在浏览器 localStorage 里,跨刷新保留,不会上传。</p>
    </section>

    <section class="agents-status" id="agents-status" hidden>
      <p class="agents-status-text" id="agents-status-text">就绪</p>
      <p class="agents-status-candidates muted" id="agents-status-candidates" hidden></p>
      <p class="muted" style="margin-top:0.25rem; font-size:0.85rem">
        提示:<kbd>⌘/Ctrl + Enter</kbd> 跑一轮 · <kbd>⌘/Ctrl + .</kbd> 停止 · <kbd>?</kbd> 看帮助
      </p>
    </section>

    <section class="agents-rounds" id="agents-rounds">
      <h2>本会话 round 历史</h2>
      <div id="agents-round-list"></div>
    </section>

    <section class="agents-empty" id="agents-empty">
      <p>暂无 round。在上方填 Session ID + 点"跑一轮"开始。</p>
    </section>

    <section class="agents-trends" id="agents-trends" hidden>
      <h2>📈 趋势(本会话所有 round)</h2>
      <div class="agents-trends-grid">
        <div class="agents-trend-cell">
          <h3>平均分(score)</h3>
          <div class="agents-trend-chart" id="agents-trend-score"></div>
          <p class="muted" id="agents-trend-score-meta"></p>
        </div>
        <div class="agents-trend-cell">
          <h3>平均 Elo</h3>
          <div class="agents-trend-chart" id="agents-trend-elo"></div>
          <p class="muted" id="agents-trend-elo-meta"></p>
        </div>
        <div class="agents-trend-cell">
          <h3>每轮 applied 动作数</h3>
          <div class="agents-trend-chart" id="agents-trend-applied"></div>
          <p class="muted" id="agents-trend-applied-meta"></p>
        </div>
      </div>
      <p class="muted" id="agents-trend-convergence"></p>
    </section>
  </main>

  <script>
    import { runRounds, memoryRoundSink } from '../../lib/agents/orchestrator';
    import { makeBrowserAdapter } from '../../lib/agents/modifier';
    import type { RoundRecord } from '../../lib/agents/types';
    import { STORAGE_KEYS } from '../../scripts/settings/storage';
    import { listUserLibraries } from '../../lib/user-libraries';
    import { buildCandidatesFromLibrary } from '../../lib/agents/candidates';

    // localStorage 里 LLM 配置的 shape(dpr_analyzer_v1 JSON)
    interface BrowserLLMConfig {
      apiKey?: string;
      baseUrl?: string;
      model?: string;
      provider?: string;
    }

    function readLLMConfig(): BrowserLLMConfig {
      try {
        const raw = localStorage.getItem(STORAGE_KEYS.llm);
        if (!raw) return {};
        return JSON.parse(raw) as BrowserLLMConfig;
      } catch {
        return {};
      }
    }

    const STORAGE_KEY = 'dpr_agents_session_v1';
    const ROUNDS_KEY = (sid: string) => `dpr_agents_rounds_${sid}`;

    // 当前 round 循环的 AbortController;点击 🛑 停止 时 .abort(),
    // orchestrator 在每轮开头检查 signal.aborted → stoppedReason = 'cancelled'
    let activeAbort: AbortController | null = null;

    const $ = <T extends HTMLElement = HTMLElement>(id: string): T => {
      const el = document.getElementById(id);
      if (!el) throw new Error(`#${id} not found`);
      return el as T;
    };

    let currentSessionId = '';
    let isRunning = false;
    let loadedCandidates: { arxivId: string; title: string; tldr?: string }[] = [];
    let loadedProjectId = '';

    function loadSessionId(): string {
      return localStorage.getItem(STORAGE_KEY) ?? '';
    }
    function saveSessionId(sid: string) {
      localStorage.setItem(STORAGE_KEY, sid);
    }

    function loadRounds(sid: string): RoundRecord[] {
      const raw = localStorage.getItem(ROUNDS_KEY(sid));
      if (!raw) return [];
      try { return JSON.parse(raw) as RoundRecord[]; } catch { return []; }
    }
    function saveRounds(sid: string, records: RoundRecord[]) {
      localStorage.setItem(ROUNDS_KEY(sid), JSON.stringify(records));
    }

    function makeLLMCallerFromConfig(cfg: BrowserLLMConfig) {
      const baseUrl = (cfg.baseUrl ?? '').replace(/\/$/, '');
      const model = cfg.model ?? 'gpt-4o-mini';
      const apiKey = cfg.apiKey ?? '';
      return {
        async callLLM(opts: { system: string; user: string; model?: string; temperature?: number; max_tokens?: number }) {
          if (!baseUrl || !apiKey) throw new Error('LLM 未配置:在 /settings/ 或 paper-analyzer 填 baseUrl + apiKey');
          const url = `${baseUrl}/chat/completions`;
          const r = await fetch(url, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              Authorization: `Bearer ${apiKey}`,
            },
            body: JSON.stringify({
              model: opts.model ?? model,
              messages: [
                { role: 'system', content: opts.system },
                { role: 'user', content: opts.user },
              ],
              temperature: opts.temperature ?? 0.7,
              max_tokens: opts.max_tokens ?? 1024,
            }),
          });
          if (!r.ok) throw new Error(`LLM ${r.status}: ${await r.text()}`);
          const data = await r.json();
          return data.choices?.[0]?.message?.content ?? '';
        },
      };
    }

    function makeStubCaller() {
      return {
        async callLLM(opts: { system: string; user: string }) {
          if (opts.system.includes('资深科研合作者')) {
            return JSON.stringify([{
              type: 'literature_review',
              title: '【stub】 整理已有候选论文',
              rationale: '(LLM 未配置;stub)',
              evidence: { paperIds: [], quotes: [] },
              target: { draftTitle: 'stub review' },
              estimated_effort: 'low',
              risk: 'dry-run',
            }]);
          }
          return JSON.stringify({ score: 5, critique: '(stub feedback)' });
        },
      };
    }

    function renderRound(rec: RoundRecord): HTMLDivElement {
      const div = document.createElement('div');
      div.className = 'agents-round-card';
      div.dataset.roundIndex = String(rec.round);
      div.innerHTML = `
        <header class="agents-round-header">
          <h3><a class="agents-link" href="/agents/${encodeURIComponent(currentSessionId)}/${String(rec.round).padStart(3, '0')}/" target="_blank">Round ${rec.round} ↗</a></h3>
          <span class="agents-round-meta">
            ${new Date(rec.started_at).toLocaleString()} · ${rec.feedback.total_tokens} tok
            <button class="button small agents-export-btn" data-fmt="json" title="导出此 round 的完整 JSON">📥 JSON</button>
            <button class="button small agents-export-btn" data-fmt="md" title="导出此 round 的人可读 digest">📥 digest.md</button>
          </span>
        </header>
        <div class="agents-round-section">
          <h4>📝 Designer (${rec.designer.proposals.length} proposals)</h4>
          <ul>
            ${rec.designer.proposals.map((p) => `
              <li>
                <strong>[${p.type}] ${escapeHtml(p.title)}</strong>
                <p class="muted">${escapeHtml(p.rationale)}</p>
                <p class="meta">effort=${p.estimated_effort} risk="${escapeHtml(p.risk)}"</p>
              </li>
            `).join('')}
          </ul>
        </div>
        <div class="agents-round-section">
          <h4>🎯 Feedback (${rec.feedback.critiques.length} critiques)</h4>
          <ul>
            ${rec.feedback.critiques.map((c) => {
              const p = rec.designer.proposals.find((x) => x.id === c.proposal_id);
              return `
                <li>
                  <strong>${escapeHtml(p?.title ?? c.proposal_id)}</strong>
                  <span class="badge badge-${c.total >= 8 ? 'high' : c.total >= 6 ? 'mid' : 'low'}">score=${c.total.toFixed(1)}</span>
                  <span class="muted">m${c.scores.methodologist} e${c.scores.engineer} s${c.scores.skeptic}</span>
                  <p class="muted">${escapeHtml(c.critique)}</p>
                </li>
              `;
            }).join('')}
          </ul>
        </div>
        <div class="agents-round-section">
          <h4>🚦 Gate</h4>
          <div class="agents-gate-bars">
            <span class="badge badge-high">promoted: ${rec.gate.promoted.length}</span>
            <span class="badge badge-mid">candidate: ${rec.gate.candidate.length}</span>
            <span class="badge badge-low">sketch: ${rec.gate.sketch.length}</span>
            <span class="badge badge-none">rejected: ${rec.gate.rejected.length}</span>
          </div>
        </div>
        <div class="agents-round-section">
          <h4>✏️ Modifier (applied=${rec.modifier.applied.length}, skipped=${rec.modifier.skipped.length})</h4>
          ${rec.modifier.applied.length ? `<ul>${rec.modifier.applied.map((a) => {
            const targetLink = actionTargetLink(a);
            return `<li><span class="badge badge-mid">${a.kind}</span> ${escapeHtml(a.payload.title ?? a.payload.would_call ?? '')} ${targetLink}</li>`;
          }).join('')}</ul>` : '<p class="muted">无写入动作</p>'}
        </div>
      `;
      return div;
    }

    function escapeHtml(s: string): string {
      return String(s ?? '').replace(/[&<>"']/g, (c) => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
      }[c] ?? c));
    }

    function actionTargetLink(a: { kind: string; payload: Record<string, unknown> }): string {
      const p = a.payload as Record<string, string>;
      if (a.kind === 'create_draft_outline' && p.writing_id) {
        const safe = escapeHtml(p.writing_id);
        return `<a class="agents-link" href="/writing/${safe}/" target="_blank">→ 打开 writing</a>`;
      }
      if (a.kind === 'archive_round_summary' && p.experiment_id) {
        const safe = escapeHtml(p.experiment_id);
        return `<a class="agents-link" href="/experiments/${safe}/" target="_blank">→ 打开 experiment</a>`;
      }
      if (a.kind === 'add_paper_to_stage' && p.arxivId) {
        const safe = escapeHtml(p.arxivId);
        return `<a class="agents-link" href="/papers/${safe}/" target="_blank">→ 打开 paper</a>`;
      }
      return '';
    }

    function refresh() {
      const sid = currentSessionId;
      const list = $('agents-round-list');
      const empty = $('agents-empty');
      list.innerHTML = '';
      refreshStats();
      refreshTokenPanel();
      refreshMetaPanel();
      refreshTagPanel();
      refreshTrashPanel();
      refreshFilterPanel();
      if (!sid) {
        empty.hidden = false;
        $('agents-rounds').hidden = true;
        return;
      }
      const records = loadRounds(sid);
      if (records.length === 0) {
        empty.hidden = false;
        $('agents-rounds').hidden = true;
      } else {
        empty.hidden = true;
        $('agents-rounds').hidden = false;
        for (const rec of records) list.appendChild(renderRound(rec));
        wireExportButtons(records);
      }
      refreshTokenPanel(records);
    }

    function refreshStats() {
      const allSessions = listKnownSessions();
      let totalRounds = 0;
      let totalProposals = 0;
      let totalPromoted = 0;
      let totalApplied = 0;
      let latestTs = 0;
      let latestSess = '';
      for (const sid of allSessions) {
        const recs = loadRounds(sid);
        totalRounds += recs.length;
        for (const r of recs) {
          totalProposals += r.designer.proposals.length;
          totalPromoted += r.gate.promoted.length;
          totalApplied += r.modifier.applied.length;
          if (r.started_at > latestTs) {
            latestTs = r.started_at;
            latestSess = sid;
          }
        }
      }
      $('agents-stat-sessions').textContent = String(allSessions.length);
      $('agents-stat-rounds').textContent = String(totalRounds);
      $('agents-stat-proposals').textContent = String(totalProposals);
      $('agents-stat-promoted').textContent = String(totalPromoted);
      $('agents-stat-applied').textContent = String(totalApplied);
      const lastEl = $('agents-stat-last');
      if (latestTs > 0) {
        const ago = formatAgo(Date.now() - latestTs);
        lastEl.textContent = `最近: ${latestSess} (${ago})`;
      } else {
        lastEl.textContent = '尚无 round';
      }
    }

    function formatAgo(ms: number): string {
      const s = Math.floor(ms / 1000);
      if (s < 60) return `${s}s 前`;
      const m = Math.floor(s / 60);
      if (m < 60) return `${m}m 前`;
      const h = Math.floor(m / 60);
      if (h < 24) return `${h}h 前`;
      const d = Math.floor(h / 24);
      return `${d}d 前`;
    }

    // iter #13 — token 用量面板
    //
    // 把 rec 列表聚合成 {total, perRound},然后按 $/M rate 算费用。
    // 纯函数,测试在 tests/test_agents_tokens.mjs。
    const TOKEN_RATE_KEY = 'dpr_agents_token_rate_v1';

    function aggregateTokens(records: RoundRecord[]) {
      const perRound = records.map((r, i) => ({
        round: r.round ?? i + 1,
        tokens: Number(r.feedback?.total_tokens) || 0,
      }));
      const total = perRound.reduce((a, b) => a + b.tokens, 0);
      return { total, perRound };
    }

    function estimateCost(totalTokens: number, ratePerMTok: number) {
      if (!isFinite(ratePerMTok) || ratePerMTok < 0) return 0;
      return (totalTokens / 1_000_000) * ratePerMTok;
    }

    function formatTokens2(n: number): string {
      if (n < 1000) return String(n);
      if (n < 1_000_000) return `${(n / 1000).toFixed(1)}k`;
      return `${(n / 1_000_000).toFixed(2)}M`;
    }

    function getTokenRate(): number {
      const raw = localStorage.getItem(TOKEN_RATE_KEY);
      const n = raw === null ? 0.5 : Number(raw);
      return isFinite(n) && n >= 0 ? n : 0;
    }

    function setTokenRate(n: number) {
      if (!isFinite(n) || n < 0) return;
      localStorage.setItem(TOKEN_RATE_KEY, String(n));
    }

    function refreshTokenPanel(records?: RoundRecord[]) {
      const panel = $('agents-tokens');
      if (!records) records = currentSessionId ? loadRounds(currentSessionId) : [];
      if (records.length === 0) {
        panel.hidden = true;
        return;
      }
      panel.hidden = false;

      const { total, perRound } = aggregateTokens(records);
      const rate = getTokenRate();
      const cost = estimateCost(total, rate);

      $('agents-token-total').textContent = formatTokens2(total);
      $('agents-token-cost').textContent = `$${cost.toFixed(4)}`;
      $('agents-token-last').textContent = formatTokens2(perRound[perRound.length - 1]?.tokens ?? 0);

      // 把 rate 输入框同步到当前值(初始化时被 wireTokenRate 设置一次,这里保持)
      const rateInput = $<HTMLInputElement>('agents-token-rate');
      if (document.activeElement !== rateInput) {
        rateInput.value = String(rate);
      }

      // 每轮条形图:每根柱子高度 ∝ tokens;最近 8 轮
      const tail = perRound.slice(-8);
      const max = Math.max(1, ...tail.map((p) => p.tokens));
      const chart = $('agents-token-chart');
      chart.innerHTML = tail
        .map((p) => {
          const h = Math.max(2, Math.round((p.tokens / max) * 28));
          const label = p.tokens === 0 ? '0' : formatTokens2(p.tokens);
          return `<span class="agents-token-bar" style="height:${h}px" title="R${p.round}: ${p.tokens} tok">${label}</span>`;
        })
        .join('');
    }

    function wireTokenRate() {
      const input = $<HTMLInputElement>('agents-token-rate');
      input.value = String(getTokenRate());
      input.addEventListener('input', () => {
        const v = Number(input.value);
        if (isFinite(v) && v >= 0) {
          setTokenRate(v);
          refreshTokenPanel();
        }
      });
    }

    // iter #14 — session 元数据(title + notes)
    //
    // localStorage[dpr_agents_meta_<sid>] = { title, notes, createdAt, updatedAt }
    // 让用户给 session 起个友好名字 + 自由记录目标/进度/下一步
    // 纯函数逻辑在 tests/test_agents_session_meta.mjs 测过
    const META_KEY = (sid: string) => `dpr_agents_meta_${sid}`;

    function emptyMeta(sid: string, now = Date.now()) {
      return { sid, title: '', notes: '', createdAt: now, updatedAt: now };
    }

    function loadMeta(sid: string, now = Date.now()) {
      const raw = localStorage.getItem(META_KEY(sid));
      if (!raw) return emptyMeta(sid, now);
      try {
        const obj = JSON.parse(raw);
        return {
          sid,
          title: typeof obj.title === 'string' ? obj.title : '',
          notes: typeof obj.notes === 'string' ? obj.notes : '',
          createdAt: typeof obj.createdAt === 'number' ? obj.createdAt : now,
          updatedAt: typeof obj.updatedAt === 'number' ? obj.updatedAt : now,
          tags: normalizeTags(obj.tags),
        };
      } catch {
        return emptyMeta(sid, now);
      }
    }

    function saveMeta(sid: string, patch: { title?: string; notes?: string }, now = Date.now()) {
      const prev = loadMeta(sid, now);
      const next = {
        ...prev,
        ...(patch.title !== undefined ? { title: String(patch.title) } : {}),
        ...(patch.notes !== undefined ? { notes: String(patch.notes) } : {}),
        updatedAt: now,
      };
      localStorage.setItem(META_KEY(sid), JSON.stringify(next));
      return next;
    }

    function formatSessionLabel(sid: string, meta: { title: string }, roundCount: number, appliedCount: number) {
      const title = (meta.title ?? '').trim();
      const tag = title ? `📝 ${title}` : sid;
      if (roundCount === 0) return tag;
      const r = `${roundCount} round${roundCount === 1 ? '' : 's'}`;
      return `${tag} · ${r} · ${appliedCount} applied`;
    }

    function refreshMetaPanel() {
      const panel = $('agents-meta');
      const sid = currentSessionId;
      const titleInput = $<HTMLInputElement>('agents-meta-title');
      const notesInput = $<HTMLTextAreaElement>('agents-meta-notes');
      const whenEl = $('agents-meta-when');
      if (!sid) {
        panel.hidden = true;
        return;
      }
      panel.hidden = false;
      const m = loadMeta(sid);
      // 用 focused 判断避免抢用户正在输入的内容
      if (document.activeElement !== titleInput) titleInput.value = m.title;
      if (document.activeElement !== notesInput) notesInput.value = m.notes;
      if (m.title || m.notes) {
        const created = new Date(m.createdAt).toLocaleDateString();
        whenEl.textContent = m.createdAt === m.updatedAt
          ? `创建于 ${created}`
          : `创建于 ${created} · 最近编辑 ${new Date(m.updatedAt).toLocaleString()}`;
      } else {
        whenEl.textContent = '';
      }
    }

    // iter #15 — session 复制(分支实验)
    //
    // 复制整个 session 到新 sid,retag meta.session_id,加 branch note。
    // 用户可以换个 gate preset / max_rounds / candidates 重跑同一基线。
    function pickNewSidLocal(base: string): string {
      let candidate = base;
      let n = 2;
      while (loadRounds(candidate).length > 0 || localStorage.getItem(META_KEY(candidate))) {
        candidate = `${base}-${n}`;
        n++;
      }
      return candidate;
    }

    function duplicateSession(oldSid: string): { newSid: string; roundCount: number } {
      if (!oldSid) throw new Error('oldSid required');
      const base = `${oldSid}-copy`;
      const newSid = pickNewSidLocal(base);
      const oldRecords = loadRounds(oldSid);
      const newRecords = oldRecords.map((r) => ({
        ...r,
        meta: { ...(r.meta ?? {}), session_id: newSid },
      }));
      if (newRecords.length > 0) saveRounds(newSid, newRecords);

      const oldMeta = loadMeta(oldSid);
      const title = oldMeta.title ? `${oldMeta.title} (copy)` : `Copy of ${oldSid}`;
      const branchNote = `Branched from ${oldSid} at ${new Date().toISOString()}`;
      const notes = oldMeta.notes ? `${branchNote}\n\n${oldMeta.notes}` : branchNote;
      saveMeta(newSid, { title, notes });

      return { newSid, roundCount: newRecords.length };
    }

    // iter #17 — session 导出/导入 JSON
    //
    // 浏览器 session 在 localStorage 里,不能跨设备。
    // 导出:把 rounds + meta 打包成单个 JSON 文件下载
    // 导入:从 <input type="file"> 读 JSON → 写到 localStorage(可选 overwrite / rename)
    function exportSessionBundle(sid: string): unknown {
      const rounds = loadRounds(sid);
      const meta = loadMeta(sid);
      return {
        kind: 'dpr-agents-session',
        version: 1,
        exportedAt: Date.now(),
        session: { sid, meta, rounds },
      };
    }

    // iter #18 — 实验报告 markdown
    //
    // 把整个 session 拼成单份 markdown,方便分享/存档。
    // 跟 JSON 导出互为补充:JSON 给机器读,.md 给人读。
    function avgScores(r: RoundRecord): number | null {
      const cs = r.feedback?.critiques ?? [];
      if (cs.length === 0) return null;
      return cs.reduce((a, c) => a + c.total, 0) / cs.length;
    }
    function avgElo(r: RoundRecord): number | null {
      const cs = r.feedback?.critiques ?? [];
      if (cs.length === 0) return null;
      return cs.reduce((a, c) => a + c.elo, 0) / cs.length;
    }

    function buildReport(sid: string, meta: { title: string; notes: string; createdAt: number; updatedAt: number }, rounds: RoundRecord[]): string {
      const title = (meta.title ?? '').trim() || sid;
      const lines: string[] = [];
      lines.push(`# ${title}`);
      lines.push('');
      if (meta.notes?.trim()) {
        lines.push(meta.notes.trim());
        lines.push('');
      }
      const createdAt = meta.createdAt ? new Date(meta.createdAt).toISOString() : '—';
      const updatedAt = meta.updatedAt ? new Date(meta.updatedAt).toISOString() : '—';
      const totalApplied = rounds.reduce((a, r) => a + (r.modifier?.applied?.length ?? 0), 0);
      const totalTokens = rounds.reduce((a, r) => a + (r.feedback?.total_tokens ?? 0), 0);
      lines.push('## 📋 元数据');
      lines.push('');
      lines.push(`- **sid**: \`${sid}\``);
      lines.push(`- **创建**: ${createdAt}`);
      lines.push(`- **最近编辑**: ${updatedAt}`);
      lines.push(`- **rounds**: ${rounds.length}`);
      lines.push(`- **applied 总数**: ${totalApplied}`);
      lines.push(`- **tokens 估算**: ${totalTokens}`);
      lines.push('');
      lines.push('## 📊 per-round 概览');
      lines.push('');
      lines.push('| Round | Proposals | Promoted | Applied | Avg Score | Avg Elo | Tokens |');
      lines.push('|------:|----------:|---------:|--------:|----------:|--------:|-------:|');
      for (const r of rounds) {
        const sc = avgScores(r);
        const elo = avgElo(r);
        lines.push(`| R${r.round} | ${r.designer?.proposals?.length ?? 0} | ${r.gate?.promoted?.length ?? 0} | ${r.modifier?.applied?.length ?? 0} | ${sc === null ? '—' : sc.toFixed(2)} | ${elo === null ? '—' : elo.toFixed(0)} | ${r.feedback?.total_tokens ?? 0} |`);
      }
      lines.push('');
      lines.push('## 📈 score delta (vs 上轮)');
      lines.push('');
      const nonNullDeltas: { round: number; delta: number }[] = [];
      for (let i = 0; i < rounds.length; i++) {
        const curr = rounds[i];
        const prev = i > 0 ? rounds[i - 1] : null;
        const cs = avgScores(curr);
        const ps = prev ? avgScores(prev) : null;
        if (cs !== null && ps !== null) nonNullDeltas.push({ round: curr.round, delta: cs - ps });
      }
      if (nonNullDeltas.length > 0) {
        lines.push('| Round | Δ score |');
        lines.push('|------:|--------:|');
        for (const d of nonNullDeltas) {
          const sign = d.delta > 0 ? '+' : '';
          lines.push(`| R${d.round} | ${sign}${d.delta.toFixed(2)} |`);
        }
        lines.push('');
      } else {
        lines.push('_只有一轮,无对比_');
        lines.push('');
      }
      lines.push('## ⭐ 实际写入 (按出现频次)');
      lines.push('');
      const appliedCounts = new Map<string, number>();
      for (const r of rounds) {
        for (const a of (r.modifier?.applied ?? [])) {
          const t = a.payload?.title
            ?? r.designer?.proposals?.find((p) => p.id === a.proposal_id)?.title
            ?? a.proposal_id;
          appliedCounts.set(t as string, (appliedCounts.get(t as string) ?? 0) + 1);
        }
      }
      if (appliedCounts.size > 0) {
        const sorted = [...appliedCounts.entries()].sort((a, b) => b[1] - a[1]).slice(0, 10);
        for (const [t, n] of sorted) lines.push(`- (${n}×) ${t}`);
        lines.push('');
      } else {
        lines.push('_本 session 无任何写入_');
        lines.push('');
      }
      lines.push('## 📝 详细 rounds');
      lines.push('');
      for (const r of rounds) {
        lines.push(`### Round ${r.round}`);
        lines.push('');
        lines.push(`- 时间: ${new Date(r.started_at).toISOString()} → ${new Date(r.finished_at).toISOString()}`);
        lines.push(`- proposals: ${r.designer?.proposals?.length ?? 0}, applied: ${r.modifier?.applied?.length ?? 0}, skipped: ${r.modifier?.skipped?.length ?? 0}`);
        const sc = avgScores(r);
        if (sc !== null) lines.push(`- avg score: ${sc.toFixed(2)}`);
        if (r.gate) {
          const buckets = [
            ['promoted', r.gate.promoted?.length ?? 0],
            ['candidate', r.gate.candidate?.length ?? 0],
            ['sketch', r.gate.sketch?.length ?? 0],
            ['rejected', r.gate.rejected?.length ?? 0],
          ];
          lines.push(`- gate: ${buckets.map(([k, n]) => `${k}=${n}`).join(', ')}`);
        }
        lines.push('');
        if (r.modifier?.applied?.length) {
          lines.push('**Applied**:');
          for (const a of r.modifier.applied) {
            const t = a.payload?.title
              ?? r.designer?.proposals?.find((p) => p.id === a.proposal_id)?.title
              ?? a.proposal_id;
            const kind = a.kind ? ` [${a.kind}]` : '';
            lines.push(`- ${t}${kind}`);
          }
          lines.push('');
        }
      }
      return lines.join('\n');
    }

    function downloadExperimentReport() {
      if (!currentSessionId) {
        alert('先选一个 session');
        return;
      }
      const sid = currentSessionId;
      const rounds = loadRounds(sid);
      const meta = loadMeta(sid);
      const md = buildReport(sid, meta, rounds);
      const blob = new Blob([md], { type: 'text/markdown;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      const ts = new Date().toISOString().slice(0, 19).replace(/[:T]/g, '-');
      a.href = url;
      a.download = `agents-report-${sid}-${ts}.md`;
      document.body.appendChild(a);
      a.click();
      setTimeout(() => {
        URL.revokeObjectURL(url);
        a.remove();
      }, 100);
      $('agents-status-text').textContent =
        `📑 已生成报告 "${sid}" (${rounds.length} rounds, ${md.length} bytes)`;
    }

    function downloadCurrentSession() {
      if (!currentSessionId) {
        alert('先选一个 session');
        return;
      }
      const sid = currentSessionId;
      const bundle = exportSessionBundle(sid);
      const json = JSON.stringify(bundle, null, 2);
      const blob = new Blob([json], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      const ts = new Date().toISOString().slice(0, 19).replace(/[:T]/g, '-');
      a.href = url;
      a.download = `agents-session-${sid}-${ts}.json`;
      document.body.appendChild(a);
      a.click();
      setTimeout(() => {
        URL.revokeObjectURL(url);
        a.remove();
      }, 100);
      $('agents-status-text').textContent =
        `📦 已导出 "${sid}" → agents-session-${sid}-${ts}.json (${loadRounds(sid).length} rounds)`;
    }

    async function importSessionFromFile(file: File, targetSid?: string, overwrite = false) {
      const text = await file.text();
      let obj: any;
      try {
        obj = JSON.parse(text);
      } catch {
        throw new Error('JSON 解析失败');
      }
      if (obj?.kind !== 'dpr-agents-session') {
        throw new Error(`不是 dpr-agents-session export(kind=${obj?.kind})`);
      }
      if (obj.version !== 1) {
        throw new Error(`不支持的 version=${obj.version}`);
      }
      if (!obj.session?.sid) throw new Error('export 缺 session.sid');
      const finalSid = targetSid || obj.session.sid;
      // 覆盖检查
      if (!overwrite && loadRounds(finalSid).length > 0) {
        throw new Error(`"${finalSid}" 已存在 rounds;勾选 overwrite 或换 targetSid`);
      }
      // 写 rounds
      const rounds = Array.isArray(obj.session.rounds) ? obj.session.rounds : [];
      saveRounds(finalSid, rounds);
      // 写 meta(更新 sid + updatedAt)
      const prevMeta = obj.session.meta ?? {};
      localStorage.setItem(META_KEY(finalSid), JSON.stringify({
        ...prevMeta,
        sid: finalSid,
        updatedAt: Date.now(),
      }));
      return { sid: finalSid, roundsImported: rounds.length };
    }

    async function handleImportFileInput(e: Event) {
      const input = e.target as HTMLInputElement;
      const file = input.files?.[0];
      if (!file) return;
      const overwrite = ($<HTMLInputElement>('agents-import-overwrite')).checked;
      try {
        const r = await importSessionFromFile(file, undefined, overwrite);
        currentSessionId = r.sid;
        saveSessionId(r.sid);
        sessionInput.value = r.sid;
        refreshSessionPicker();
        refresh();
        $('agents-status-text').textContent =
          `📥 已导入 "${file.name}" → "${r.sid}" (${r.roundsImported} rounds)`;
      } catch (err) {
        alert(`导入失败: ${err instanceof Error ? err.message : String(err)}`);
      } finally {
        input.value = '';  // reset 让同一文件能再次选
      }
    }

    // iter #19 — session 删除 / 回收站(30 天软删)
    //
    // localStorage key:
    //   dpr_agents_trash_<sid>_<deletedAt> = JSON { sid, deletedAt, roundsRaw, metaRaw }
    //   dpr_agents_trash_index = JSON [{ sid, deletedAt, key }]
    const TRASH_INDEX_KEY = 'dpr_agents_trash_index';
    const TRASH_RECORD_KEY = (sid: string, deletedAt: number) => `dpr_agents_trash_${sid}_${deletedAt}`;
    const TRASH_TTL_MS = 30 * 24 * 60 * 60 * 1000;

    function listTrash(): { sid: string; deletedAt: number; key: string }[] {
      const raw = localStorage.getItem(TRASH_INDEX_KEY);
      if (!raw) return [];
      try { return JSON.parse(raw); } catch { return []; }
    }
    function writeTrash(items: { sid: string; deletedAt: number; key: string }[]) {
      localStorage.setItem(TRASH_INDEX_KEY, JSON.stringify(items));
    }

    function softDelete(sid: string, now = Date.now()): { sid: string; deletedAt: number } {
      if (!sid) throw new Error('sid required');
      const roundsRaw = localStorage.getItem(ROUNDS_KEY(sid));
      const metaRaw = localStorage.getItem(META_KEY(sid));
      if (roundsRaw === null && metaRaw === null) {
        throw new Error(`session "${sid}" not found`);
      }
      const key = TRASH_RECORD_KEY(sid, now);
      localStorage.setItem(key, JSON.stringify({ sid, deletedAt: now, roundsRaw, metaRaw }));
      localStorage.removeItem(ROUNDS_KEY(sid));
      localStorage.removeItem(META_KEY(sid));
      const index = listTrash();
      index.push({ sid, deletedAt: now, key });
      writeTrash(index);
      return { sid, deletedAt: now };
    }

    function restoreFromTrash(sid: string, deletedAt: number): { sid: string } {
      const index = listTrash();
      const entry = index.find((e) => e.sid === sid && e.deletedAt === deletedAt);
      if (!entry) throw new Error(`trash entry for "${sid}" @ ${deletedAt} not found`);
      if (localStorage.getItem(ROUNDS_KEY(sid)) !== null || localStorage.getItem(META_KEY(sid)) !== null) {
        throw new Error(`active session "${sid}" already exists; cannot restore`);
      }
      const raw = localStorage.getItem(entry.key);
      if (!raw) throw new Error('trash record payload missing');
      const rec = JSON.parse(raw);
      if (rec.roundsRaw !== null) localStorage.setItem(ROUNDS_KEY(sid), rec.roundsRaw);
      if (rec.metaRaw !== null) localStorage.setItem(META_KEY(sid), rec.metaRaw);
      localStorage.removeItem(entry.key);
      writeTrash(index.filter((e) => !(e.sid === sid && e.deletedAt === deletedAt)));
      return { sid };
    }

    function permanentlyDelete(sid: string, deletedAt: number): { sid: string } {
      const index = listTrash();
      const entry = index.find((e) => e.sid === sid && e.deletedAt === deletedAt);
      if (!entry) throw new Error(`trash entry for "${sid}" @ ${deletedAt} not found`);
      localStorage.removeItem(entry.key);
      writeTrash(index.filter((e) => !(e.sid === sid && e.deletedAt === deletedAt)));
      return { sid };
    }

    function purgeExpired(now = Date.now()): { purged: number; remaining: number } {
      const index = listTrash();
      const expired = index.filter((e) => now - e.deletedAt > TRASH_TTL_MS);
      for (const e of expired) localStorage.removeItem(e.key);
      const remaining = index.filter((e) => now - e.deletedAt <= TRASH_TTL_MS);
      writeTrash(remaining);
      return { purged: expired.length, remaining: remaining.length };
    }

    function daysUntilExpiry(deletedAt: number, now = Date.now()): number {
      const remaining = TRASH_TTL_MS - (now - deletedAt);
      return Math.max(0, Math.ceil(remaining / (24 * 60 * 60 * 1000)));
    }

    function confirmAndSoftDelete() {
      if (!currentSessionId) {
        alert('先选一个 session');
        return;
      }
      const sid = currentSessionId;
      if (!confirm(`把 "${sid}" 移到回收站?30 天后自动永久删除(可手动提前恢复)。`)) return;
      try {
        const r = softDelete(sid);
        currentSessionId = '';
        sessionInput.value = '';
        saveSessionId('');
        refreshSessionPicker();
        refresh();
        refreshTrashPanel();
        $('agents-status-text').textContent = `🗑️ 已移到回收站 "${r.sid}" (${daysUntilExpiry(r.deletedAt)} 天后过期)`;
      } catch (err) {
        alert(`删除失败: ${err instanceof Error ? err.message : String(err)}`);
      }
    }

    function refreshTrashPanel() {
      const panel = $('agents-trash');
      const list = $('agents-trash-list');
      const trash = listTrash();
      if (trash.length === 0) {
        panel.hidden = true;
        return;
      }
      panel.hidden = false;
      list.innerHTML = trash
        .slice()
        .sort((a, b) => b.deletedAt - a.deletedAt)
        .map((e) => {
          const days = daysUntilExpiry(e.deletedAt);
          const expired = days === 0;
          const cls = expired ? 'badge-none' : 'badge-mid';
          const meta = loadMeta(e.sid) ?? {};
          void meta;
          // 还原标题(从 trash record 的 metaRaw 读,因为 active storage 已被删)
          const raw = localStorage.getItem(e.key);
          let title = '';
          if (raw) {
            try {
              const rec = JSON.parse(raw);
              if (rec.metaRaw) {
                const m = JSON.parse(rec.metaRaw);
                title = (m.title ?? '').trim();
              }
            } catch { /* ignore */ }
          }
          const tag = title ? `📝 ${escapeHtml(title)}` : `<code>${escapeHtml(e.sid)}</code>`;
          const dt = new Date(e.deletedAt).toLocaleDateString();
          return `
            <li class="agents-trash-item">
              <span class="agents-trash-sid">${tag}</span>
              <span class="agents-trash-meta">
                删除于 ${dt} ·
                <span class="badge ${cls}">${expired ? '已过期' : `${days} 天后清空`}</span>
              </span>
              <span class="agents-trash-actions">
                <button class="button small agents-trash-restore" data-sid="${escapeHtml(e.sid)}" data-deleted-at="${e.deletedAt}">♻️ 恢复</button>
                <button class="button small agents-trash-purge" data-sid="${escapeHtml(e.sid)}" data-deleted-at="${e.deletedAt}">永久删除</button>
              </span>
            </li>
          `;
        })
        .join('');
      // wire 按钮
      list.querySelectorAll<HTMLButtonElement>('.agents-trash-restore').forEach((btn) => {
        btn.addEventListener('click', () => {
          const sid = btn.dataset.sid!;
          const at = Number(btn.dataset.deletedAt);
          try {
            restoreFromTrash(sid, at);
            currentSessionId = sid;
            sessionInput.value = sid;
            saveSessionId(sid);
            refreshSessionPicker();
            refresh();
            refreshTrashPanel();
            $('agents-status-text').textContent = `♻️ 已恢复 "${sid}"`;
          } catch (err) {
            alert(`恢复失败: ${err instanceof Error ? err.message : String(err)}`);
          }
        });
      });
      list.querySelectorAll<HTMLButtonElement>('.agents-trash-purge').forEach((btn) => {
        btn.addEventListener('click', () => {
          const sid = btn.dataset.sid!;
          const at = Number(btn.dataset.deletedAt);
          if (!confirm(`永久删除 "${sid}"?此操作不可撤销。`)) return;
          permanentlyDelete(sid, at);
          refreshTrashPanel();
        });
      });
    }

    function wireTrash() {
      $('agents-delete-btn').addEventListener('click', confirmAndSoftDelete);
      $('agents-trash-purge-all').addEventListener('click', () => {
        const r = purgeExpired();
        refreshTrashPanel();
        alert(`清空过期:删除 ${r.purged} 个,剩余 ${r.remaining} 个未过期`);
      });
    }

    function wireExportImport() {
      $('agents-export-btn').addEventListener('click', downloadCurrentSession);
