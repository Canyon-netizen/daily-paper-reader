---
// astro-src/pages/agents/index.astro
//
// Multi-agent research loop console.
// Lists recent sessions + their latest round state. Drives Designer →
// Feedback → Modifier from the browser via the same orchestrator the CLI uses.

import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import '../../styles/agents.css';

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
---

<BaseLayout title="多智能体控制台">
  <Navbar />
  <main class="shell agents-shell">
    <header class="agents-header">
      <h1>🤖 多智能体控制台</h1>
      <p class="agents-sub">
        Designer 提出候选 → Feedback 多 persona 评分 → Gate 过滤 → Modifier 调用上游 ideas/experiments/writings。
        无 LLM Key 时跑 dry-run(stub);有 Key 时接 OpenAI 兼容端点。
      </p>
    </header>

    <section class="agents-stats" id="agents-stats">
      <div class="agents-stats-row">
        <span class="agents-stat"><strong id="agents-stat-sessions">0</strong> sessions</span>
        <span class="agents-stat"><strong id="agents-stat-rounds">0</strong> rounds</span>
        <span class="agents-stat"><strong id="agents-stat-proposals">0</strong> proposals</span>
        <span class="agents-stat"><strong id="agents-stat-promoted">0</strong> promoted</span>
        <span class="agents-stat"><strong id="agents-stat-applied">0</strong> applied</span>
        <span class="agents-stat agents-stat-aside" id="agents-stat-last"></span>
      </div>
    </section>

    <section class="agents-controls">
      <div class="agents-controls-row">
        <label>
          <span>Session</span>
          <select id="agents-session-picker">
            <option value="">— 新建 / 输入 —</option>
          </select>
        </label>
        <label>
          <span>Session ID</span>
          <input id="agents-session-id" type="text" placeholder="my-research-project" />
        </label>
        <label>
          <span>项目(可选)</span>
          <select id="agents-project-picker" title="从 UserLibrary 选一个,自动加载其论文作为 candidates">
            <option value="">— 不选 —</option>
          </select>
        </label>
        <button class="button small" id="agents-load-papers-btn" title="从选中项目读 paperIds → 论文库 → 写入 candidates">📚 载入论文</button>
        <label>
          <span>Gate 阈值</span>
          <select id="agents-preset">
            <option value="balanced" selected>balanced</option>
            <option value="conservative">conservative</option>
            <option value="aggressive">aggressive</option>
          </select>
        </label>
        <label>
          <span>最大轮数</span>
          <input id="agents-max-rounds" type="number" min="1" max="20" value="3" />
        </label>
        <label class="agents-checkbox">
          <input id="agents-dry-run" type="checkbox" checked />
          <span>Dry-run (无 LLM 调用)</span>
        </label>
        <button class="button primary" id="agents-run-btn">▶️ 跑一轮</button>
      </div>
    </section>

    <section class="agents-status" id="agents-status" hidden>
      <p class="agents-status-text" id="agents-status-text">就绪</p>
      <p class="agents-status-candidates muted" id="agents-status-candidates" hidden></p>
    </section>

    <section class="agents-rounds" id="agents-rounds">
      <h2>本会话 round 历史</h2>
      <div id="agents-round-list"></div>
    </section>

    <section class="agents-empty" id="agents-empty">
      <p>暂无 round。在上方填 Session ID + 点"跑一轮"开始。</p>
    </section>

    <section class="agents-trends" id="agents-trends" hidden>
      <h2>📈 趋势(本会话所有 round)</h2>
      <div class="agents-trends-grid">
        <div class="agents-trend-cell">
          <h3>平均分(score)</h3>
          <div class="agents-trend-chart" id="agents-trend-score"></div>
          <p class="muted" id="agents-trend-score-meta"></p>
        </div>
        <div class="agents-trend-cell">
          <h3>平均 Elo</h3>
          <div class="agents-trend-chart" id="agents-trend-elo"></div>
          <p class="muted" id="agents-trend-elo-meta"></p>
        </div>
        <div class="agents-trend-cell">
          <h3>每轮 applied 动作数</h3>
          <div class="agents-trend-chart" id="agents-trend-applied"></div>
          <p class="muted" id="agents-trend-applied-meta"></p>
        </div>
      </div>
      <p class="muted" id="agents-trend-convergence"></p>
    </section>
  </main>

  <script>
    import { runRounds, memoryRoundSink } from '../../lib/agents/orchestrator';
    import { makeBrowserAdapter } from '../../lib/agents/modifier';
    import type { RoundRecord } from '../../lib/agents/types';
    import { STORAGE_KEYS } from '../../scripts/settings/storage';
    import { listUserLibraries } from '../../lib/user-libraries';
    import { buildCandidatesFromLibrary } from '../../lib/agents/candidates';

    // localStorage 里 LLM 配置的 shape(dpr_analyzer_v1 JSON)
    interface BrowserLLMConfig {
      apiKey?: string;
      baseUrl?: string;
      model?: string;
      provider?: string;
    }

    function readLLMConfig(): BrowserLLMConfig {
      try {
        const raw = localStorage.getItem(STORAGE_KEYS.llm);
        if (!raw) return {};
        return JSON.parse(raw) as BrowserLLMConfig;
      } catch {
        return {};
      }
    }

    const STORAGE_KEY = 'dpr_agents_session_v1';
    const ROUNDS_KEY = (sid: string) => `dpr_agents_rounds_${sid}`;

    const $ = <T extends HTMLElement = HTMLElement>(id: string): T => {
      const el = document.getElementById(id);
      if (!el) throw new Error(`#${id} not found`);
      return el as T;
    };

    let currentSessionId = '';
    let isRunning = false;
    let loadedCandidates: { arxivId: string; title: string; tldr?: string }[] = [];
    let loadedProjectId = '';

    function loadSessionId(): string {
      return localStorage.getItem(STORAGE_KEY) ?? '';
    }
    function saveSessionId(sid: string) {
      localStorage.setItem(STORAGE_KEY, sid);
    }

    function loadRounds(sid: string): RoundRecord[] {
      const raw = localStorage.getItem(ROUNDS_KEY(sid));
      if (!raw) return [];
      try { return JSON.parse(raw) as RoundRecord[]; } catch { return []; }
    }
    function saveRounds(sid: string, records: RoundRecord[]) {
      localStorage.setItem(ROUNDS_KEY(sid), JSON.stringify(records));
    }

    function makeLLMCallerFromConfig(cfg: BrowserLLMConfig) {
      const baseUrl = (cfg.baseUrl ?? '').replace(/\/$/, '');
      const model = cfg.model ?? 'gpt-4o-mini';
      const apiKey = cfg.apiKey ?? '';
      return {
        async callLLM(opts: { system: string; user: string; model?: string; temperature?: number; max_tokens?: number }) {
          if (!baseUrl || !apiKey) throw new Error('LLM 未配置:在 /settings/ 或 paper-analyzer 填 baseUrl + apiKey');
          const url = `${baseUrl}/chat/completions`;
          const r = await fetch(url, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              Authorization: `Bearer ${apiKey}`,
            },
            body: JSON.stringify({
              model: opts.model ?? model,
              messages: [
                { role: 'system', content: opts.system },
                { role: 'user', content: opts.user },
              ],
              temperature: opts.temperature ?? 0.7,
              max_tokens: opts.max_tokens ?? 1024,
            }),
          });
          if (!r.ok) throw new Error(`LLM ${r.status}: ${await r.text()}`);
          const data = await r.json();
          return data.choices?.[0]?.message?.content ?? '';
        },
      };
    }

    function makeStubCaller() {
      return {
        async callLLM(opts: { system: string; user: string }) {
          if (opts.system.includes('资深科研合作者')) {
            return JSON.stringify([{
              type: 'literature_review',
              title: '【stub】 整理已有候选论文',
              rationale: '(LLM 未配置;stub)',
              evidence: { paperIds: [], quotes: [] },
              target: { draftTitle: 'stub review' },
              estimated_effort: 'low',
              risk: 'dry-run',
            }]);
          }
          return JSON.stringify({ score: 5, critique: '(stub feedback)' });
        },
      };
    }

    function renderRound(rec: RoundRecord): HTMLDivElement {
      const div = document.createElement('div');
      div.className = 'agents-round-card';
      div.dataset.roundIndex = String(rec.round);
      div.innerHTML = `
        <header class="agents-round-header">
          <h3><a class="agents-link" href="/agents/${encodeURIComponent(currentSessionId)}/${String(rec.round).padStart(3, '0')}/" target="_blank">Round ${rec.round} ↗</a></h3>
          <span class="agents-round-meta">
            ${new Date(rec.started_at).toLocaleString()} · ${rec.feedback.total_tokens} tok
            <button class="button small agents-export-btn" data-fmt="json" title="导出此 round 的完整 JSON">📥 JSON</button>
            <button class="button small agents-export-btn" data-fmt="md" title="导出此 round 的人可读 digest">📥 digest.md</button>
          </span>
        </header>
        <div class="agents-round-section">
          <h4>📝 Designer (${rec.designer.proposals.length} proposals)</h4>
          <ul>
            ${rec.designer.proposals.map((p) => `
              <li>
                <strong>[${p.type}] ${escapeHtml(p.title)}</strong>
                <p class="muted">${escapeHtml(p.rationale)}</p>
                <p class="meta">effort=${p.estimated_effort} risk="${escapeHtml(p.risk)}"</p>
              </li>
            `).join('')}
          </ul>
        </div>
        <div class="agents-round-section">
          <h4>🎯 Feedback (${rec.feedback.critiques.length} critiques)</h4>
          <ul>
            ${rec.feedback.critiques.map((c) => {
              const p = rec.designer.proposals.find((x) => x.id === c.proposal_id);
              return `
                <li>
                  <strong>${escapeHtml(p?.title ?? c.proposal_id)}</strong>
                  <span class="badge badge-${c.total >= 8 ? 'high' : c.total >= 6 ? 'mid' : 'low'}">score=${c.total.toFixed(1)}</span>
                  <span class="muted">m${c.scores.methodologist} e${c.scores.engineer} s${c.scores.skeptic}</span>
                  <p class="muted">${escapeHtml(c.critique)}</p>
                </li>
              `;
            }).join('')}
          </ul>
        </div>
        <div class="agents-round-section">
          <h4>🚦 Gate</h4>
          <div class="agents-gate-bars">
            <span class="badge badge-high">promoted: ${rec.gate.promoted.length}</span>
            <span class="badge badge-mid">candidate: ${rec.gate.candidate.length}</span>
            <span class="badge badge-low">sketch: ${rec.gate.sketch.length}</span>
            <span class="badge badge-none">rejected: ${rec.gate.rejected.length}</span>
          </div>
        </div>
        <div class="agents-round-section">
          <h4>✏️ Modifier (applied=${rec.modifier.applied.length}, skipped=${rec.modifier.skipped.length})</h4>
          ${rec.modifier.applied.length ? `<ul>${rec.modifier.applied.map((a) => {
            const targetLink = actionTargetLink(a);
            return `<li><span class="badge badge-mid">${a.kind}</span> ${escapeHtml(a.payload.title ?? a.payload.would_call ?? '')} ${targetLink}</li>`;
          }).join('')}</ul>` : '<p class="muted">无写入动作</p>'}
        </div>
      `;
      return div;
    }

    function escapeHtml(s: string): string {
      return String(s ?? '').replace(/[&<>"']/g, (c) => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
      }[c] ?? c));
    }

    function actionTargetLink(a: { kind: string; payload: Record<string, unknown> }): string {
      const p = a.payload as Record<string, string>;
      if (a.kind === 'create_draft_outline' && p.writing_id) {
        const safe = escapeHtml(p.writing_id);
        return `<a class="agents-link" href="/writing/${safe}/" target="_blank">→ 打开 writing</a>`;
      }
      if (a.kind === 'archive_round_summary' && p.experiment_id) {
        const safe = escapeHtml(p.experiment_id);
        return `<a class="agents-link" href="/experiments/${safe}/" target="_blank">→ 打开 experiment</a>`;
      }
      if (a.kind === 'add_paper_to_stage' && p.arxivId) {
        const safe = escapeHtml(p.arxivId);
        return `<a class="agents-link" href="/papers/${safe}/" target="_blank">→ 打开 paper</a>`;
      }
      return '';
    }

    function refresh() {
      const sid = currentSessionId;
      const list = $('agents-round-list');
      const empty = $('agents-empty');
      list.innerHTML = '';
      refreshStats();
      if (!sid) {
        empty.hidden = false;
        $('agents-rounds').hidden = true;
        return;
      }
      const records = loadRounds(sid);
      if (records.length === 0) {
        empty.hidden = false;
        $('agents-rounds').hidden = true;
      } else {
        empty.hidden = true;
        $('agents-rounds').hidden = false;
        for (const rec of records) list.appendChild(renderRound(rec));
        wireExportButtons(records);
      }
    }

    function refreshStats() {
      const allSessions = listKnownSessions();
      let totalRounds = 0;
      let totalProposals = 0;
      let totalPromoted = 0;
      let totalApplied = 0;
      let latestTs = 0;
      let latestSess = '';
      for (const sid of allSessions) {
        const recs = loadRounds(sid);
        totalRounds += recs.length;
        for (const r of recs) {
          totalProposals += r.designer.proposals.length;
          totalPromoted += r.gate.promoted.length;
          totalApplied += r.modifier.applied.length;
          if (r.started_at > latestTs) {
            latestTs = r.started_at;
            latestSess = sid;
          }
        }
      }
      $('agents-stat-sessions').textContent = String(allSessions.length);
      $('agents-stat-rounds').textContent = String(totalRounds);
      $('agents-stat-proposals').textContent = String(totalProposals);
      $('agents-stat-promoted').textContent = String(totalPromoted);
      $('agents-stat-applied').textContent = String(totalApplied);
      const lastEl = $('agents-stat-last');
      if (latestTs > 0) {
        const ago = formatAgo(Date.now() - latestTs);
        lastEl.textContent = `最近: ${latestSess} (${ago})`;
      } else {
        lastEl.textContent = '尚无 round';
      }
    }

    function formatAgo(ms: number): string {
      const s = Math.floor(ms / 1000);
      if (s < 60) return `${s}s 前`;
      const m = Math.floor(s / 60);
      if (m < 60) return `${m}m 前`;
      const h = Math.floor(m / 60);
      if (h < 24) return `${h}h 前`;
      const d = Math.floor(h / 24);
      return `${d}d 前`;
    }

    function wireExportButtons(records: RoundRecord[]) {
      const list = $('agents-round-list');
      list.querySelectorAll<HTMLButtonElement>('.agents-export-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const idx = Number(btn.closest<HTMLElement>('.agents-round-card')?.dataset.roundIndex);
          const rec = records.find((r) => r.round === idx);
          if (!rec) return;
          const fmt = btn.dataset.fmt;
          if (fmt === 'json') exportRoundJson(rec);
          else if (fmt === 'md') exportRoundDigest(rec);
        });
      });
    }

    function exportRoundJson(rec: RoundRecord) {
      const filename = `agents-round-${rec.project_id || 'session'}-${String(rec.round).padStart(3, '0')}.json`;
      downloadAsFile(JSON.stringify(rec, null, 2), filename, 'application/json');
    }

    function exportRoundDigest(rec: RoundRecord) {
      const lines: string[] = [];
      lines.push(`# Round ${rec.round} digest — ${rec.project_id || 'session'}`);
      lines.push('');
      lines.push(`- started_at: ${new Date(rec.started_at).toISOString()}`);
      lines.push(`- gate preset: ${rec.gate.preset}`);
      lines.push(`- designer proposals: ${rec.designer.proposals.length}`);
      lines.push(`- feedback critiques: ${rec.feedback.critiques.length}`);
      lines.push(`- applied: ${rec.modifier.applied.length}, skipped: ${rec.modifier.skipped.length}`);
      lines.push('');
      lines.push('## Designer proposals');
      for (const p of rec.designer.proposals) {
        lines.push(`### [${p.type}] ${p.title}`);
        lines.push(`**Rationale:** ${p.rationale}`);
        lines.push(`**Risk:** ${p.risk} · **Effort:** ${p.estimated_effort}`);
        lines.push('');
      }
      lines.push('## Feedback scores');
      for (const c of rec.feedback.critiques) {
        const p = rec.designer.proposals.find((x) => x.id === c.proposal_id);
        lines.push(`- ${p?.title ?? c.proposal_id}: total=${c.total.toFixed(1)} (m=${c.scores.methodologist} e=${c.scores.engineer} s=${c.scores.skeptic})`);
        lines.push(`  - ${c.critique}`);
      }
      lines.push('');
      lines.push('## Gate decision');
      for (const v of rec.gate.verdicts) {
        const p = rec.designer.proposals.find((x) => x.id === v.proposal_id);
        lines.push(`- ${p?.title ?? v.proposal_id} → **${v.decision}** (score=${v.score.toFixed(1)}, elo=${v.elo})`);
      }
      lines.push('');
      lines.push('## Modifier actions');
      for (const a of rec.modifier.applied) {
        const title = a.payload.title ?? a.payload.writing_id ?? a.payload.experiment_id ?? '';
        lines.push(`- [${a.kind}] ${title}`);
      }
      if (rec.modifier.skipped.length > 0) {
        lines.push('');
        lines.push('## Skipped');
        for (const s of rec.modifier.skipped) {
          lines.push(`- ${s.proposal_id}: ${s.reason}`);
        }
      }
      const filename = `agents-round-${rec.project_id || 'session'}-${String(rec.round).padStart(3, '0')}.md`;
      downloadAsFile(lines.join('\n'), filename, 'text/markdown');
    }

    function downloadAsFile(content: string, filename: string, mime: string) {
      const blob = new Blob([content], { type: mime });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      setTimeout(() => URL.revokeObjectURL(url), 1000);
    }

    async function runOnce() {
      if (isRunning) return;
      const sid = ($<HTMLInputElement>('agents-session-id')).value.trim();
      if (!sid) {
        alert('请填 Session ID');
        return;
      }
      currentSessionId = sid;
      saveSessionId(sid);

      const preset = ($<HTMLSelectElement>('agents-preset')).value as 'conservative' | 'balanced' | 'aggressive';
      const maxRounds = Number(($<HTMLInputElement>('agents-max-rounds')).value) || 3;
      const dryRun = ($<HTMLInputElement>('agents-dry-run')).checked;

      const status = $('agents-status');
      const statusText = $('agents-status-text');
      status.hidden = false;
      isRunning = true;
      statusText.textContent = `跑 round (dry=${dryRun}, preset=${preset})...`;

      try {
        const cfg = dryRun ? null : readLLMConfig();
        const caller = dryRun || !cfg?.apiKey ? makeStubCaller() : makeLLMCallerFromConfig(cfg);
        const adapter = await makeBrowserAdapter({ dry_run: dryRun });
        const sink = memoryRoundSink();

        const existing = loadRounds(sid);
        const startRound = existing.length + 1;

        const { records, stoppedReason } = await runRounds(
          { caller, adapter, gatePreset: preset, maxRounds },
          {
            sessionId: sid,
            input: {
              project: { id: sid, name: sid, statement: '(browser auto-run)' },
              candidates: loadedCandidates,
              user_goal: '(browser auto-run)',
              project_state: {
                paper_count: loadedCandidates.length,
                draft_count: 0,
              },
              round: startRound,
            },
            startRound,
            onRoundComplete: async (rec) => {
              await sink.write(rec);
              saveRounds(sid, [...existing, ...sink.records]);
            },
          },
        );

        saveRounds(sid, [...existing, ...records]);
        statusText.textContent = `完成 ${records.length} round(s), stopped: ${stoppedReason}`;
        refreshSessionPicker();
        refresh();
      } catch (err) {
        statusText.textContent = `错误: ${err instanceof Error ? err.message : String(err)}`;
      } finally {
        isRunning = false;
      }
    }

    // 初始化
    const sessionInput = $<HTMLInputElement>('agents-session-id');
    const sessionPicker = $<HTMLSelectElement>('agents-session-picker');

    function listKnownSessions(): string[] {
      const out = new Set<string>();
      for (let i = 0; i < localStorage.length; i++) {
        const k = localStorage.key(i);
        if (!k) continue;
        const m = k.match(/^dpr_agents_rounds_(.+)$/);
        if (m) out.add(m[1]);
      }
      const cur = loadSessionId();
      if (cur) out.add(cur);
      return [...out].sort();
    }

    function refreshSessionPicker() {
      const sessions = listKnownSessions();
      const cur = loadSessionId();
      sessionPicker.innerHTML = '<option value="">— 新建 / 输入 —</option>' +
        sessions.map((s) => {
          const recs = loadRounds(s);
          const roundCount = recs.length;
          const appliedCount = recs.reduce((acc, r) => acc + r.modifier.applied.length, 0);
          const label = roundCount > 0
            ? `${s} · ${roundCount} round${roundCount === 1 ? '' : 's'} · ${appliedCount} applied`
            : s;
          const sel = s === cur ? ' selected' : '';
          return `<option value="${escapeHtml(s)}"${sel}>${escapeHtml(label)}</option>`;
        }).join('');
    }

    sessionInput.value = loadSessionId();
    currentSessionId = sessionInput.value;
    refreshSessionPicker();

    sessionPicker.addEventListener('change', () => {
      const v = sessionPicker.value;
      if (v) {
        sessionInput.value = v;
        currentSessionId = v;
        saveSessionId(v);
        refresh();
      }
    });
    sessionInput.addEventListener('change', () => {
      currentSessionId = sessionInput.value;
      saveSessionId(sessionInput.value);
      refreshSessionPicker();
      refresh();
    });
    $('agents-run-btn').addEventListener('click', runOnce);
    refresh();

    // ---------------------------------------------------------------------
    // 项目选择 + 载入论文(UserLibrary → candidates)
    // ---------------------------------------------------------------------

    const projectPicker = $<HTMLSelectElement>('agents-project-picker');

    function refreshProjectPicker() {
      const libs = listUserLibraries();
      projectPicker.innerHTML = '<option value="">— 不选 —</option>' +
        libs.map((l) => {
          const sel = l.id === loadedProjectId ? ' selected' : '';
          return `<option value="${escapeHtml(l.id)}"${sel}>${escapeHtml(l.name)} · ${l.paperIds.length} 篇</option>`;
        }).join('');
    }

    async function loadPapersFromProject() {
      const libId = projectPicker.value;
      const statusCand = $('agents-status-candidates');
      if (!libId) {
        loadedCandidates = [];
        loadedProjectId = '';
        statusCand.hidden = true;
        return;
      }
      const libs = listUserLibraries();
      const lib = libs.find((l) => l.id === libId);
      if (!lib) {
        alert(`项目 ${libId} 不存在(可能 localStorage 被清理)`);
        return;
      }

      // 动态 import paper.ts 拿到 readPaper(避免主 bundle 变重)
      const paperMod = await import('../../lib/paper');
      const lookup = async (arxivId: string) => {
        const p = await paperMod.readPaper(arxivId);
        if (!p) return null;
        // Paper 类型的字段映射到 PaperMetaLike
        return {
          title: p.title,
          title_zh: (p as any).title_zh,
          tldr: p.tldr,
          tldr_zh: (p as any).tldr_zh,
        };
      };

      const isRunning2 = isRunning;
      if (isRunning2) return;
      isRunning = true;
      try {
        loadedCandidates = await buildCandidatesFromLibrary(lib, lookup, { maxPapers: 30 });
        loadedProjectId = libId;
        const missing = loadedCandidates.filter((c) => c.title.startsWith('(missing)')).length;
        statusCand.hidden = false;
        statusCand.textContent = `📚 ${lib.name}: 载入 ${loadedCandidates.length} 篇` +
          (missing > 0 ? `(${missing} 篇无元数据,占位)` : '');
      } catch (err) {
        statusCand.hidden = false;
        statusCand.textContent = `📚 载入失败: ${err instanceof Error ? err.message : String(err)}`;
      } finally {
        isRunning = isRunning2;
      }
    }

    projectPicker.addEventListener('change', loadPapersFromProject);
    $('agents-load-papers-btn').addEventListener('click', loadPapersFromProject);
    refreshProjectPicker();

    // ---------------------------------------------------------------------
    // Round trends:per-session 趋势(score / Elo / applied)
    // ---------------------------------------------------------------------

    interface TrendPoint { round: number; value: number; }

    function average(xs: number[]): number {
      if (xs.length === 0) return 0;
      return xs.reduce((a, b) => a + b, 0) / xs.length;
    }

    function buildTrend(records: RoundRecord[], metric: 'score' | 'elo' | 'applied'): TrendPoint[] {
      return records.map((r) => {
        if (metric === 'applied') {
          return { round: r.round, value: r.modifier.applied.length };
        }
        if (r.feedback.critiques.length === 0) {
          return { round: r.round, value: 0 };
        }
        const xs = r.feedback.critiques.map((c) =>
          metric === 'score' ? c.total : c.elo,
        );
        return { round: r.round, value: average(xs) };
      });
    }

    function sparklineSvg(points: TrendPoint[], opts: { width: number; height: number; color: string }): string {
      if (points.length === 0) return '<svg></svg>';
      const { width, height, color } = opts;
      const padX = 4, padY = 4;
      const w = width - padX * 2;
      const h = height - padY * 2;
      const xs = points.map((p) => p.value);
      const min = Math.min(...xs, 0);
      const max = Math.max(...xs, 1);
      const span = max - min || 1;
      const stepX = points.length === 1 ? 0 : w / (points.length - 1);
      const path = points
        .map((p, i) => {
          const x = padX + stepX * i;
          const y = padY + h - ((p.value - min) / span) * h;
          return `${i === 0 ? 'M' : 'L'}${x.toFixed(1)},${y.toFixed(1)}`;
        })
        .join(' ');
      const dots = points
        .map((p, i) => {
          const x = padX + stepX * i;
          const y = padY + h - ((p.value - min) / span) * h;
          return `<circle cx="${x.toFixed(1)}" cy="${y.toFixed(1)}" r="2.5" fill="${color}"/>`;
        })
        .join('');
      return `<svg width="${width}" height="${height}" viewBox="0 0 ${width} ${height}" class="agents-spark"><path d="${path}" fill="none" stroke="${color}" stroke-width="1.5"/>${dots}</svg>`;
    }

    function deltaArrow(delta: number): string {
      if (delta > 0.05) return '↑';
      if (delta < -0.05) return '↓';
      return '→';
    }

    function renderTrends(sid: string) {
      const records = loadRounds(sid).sort((a, b) => a.round - b.round);
      const section = $('agents-trends');
      if (records.length < 2) {
        section.hidden = true;
        return;
      }
      section.hidden = false;

      const score = buildTrend(records, 'score');
      const elo = buildTrend(records, 'elo');
      const applied = buildTrend(records, 'applied');

      $('agents-trend-score').innerHTML = sparklineSvg(score, { width: 240, height: 60, color: '#3b82f6' });
      $('agents-trend-elo').innerHTML = sparklineSvg(elo, { width: 240, height: 60, color: '#8b5cf6' });
      $('agents-trend-applied').innerHTML = sparklineSvg(applied, { width: 240, height: 60, color: '#10b981' });

      const lastScore = score[score.length - 1].value;
      const firstScore = score[0].value;
      const lastElo = elo[elo.length - 1].value;
      const firstElo = elo[0].value;
      const totalApplied = records.reduce((a, r) => a + r.modifier.applied.length, 0);

      $('agents-trend-score-meta').textContent =
        `首轮 ${firstScore.toFixed(1)} → 末轮 ${lastScore.toFixed(1)} (${deltaArrow(lastScore - firstScore)} ${(lastScore - firstScore).toFixed(2)})`;
      $('agents-trend-elo-meta').textContent =
        `首轮 ${firstElo.toFixed(0)} → 末轮 ${lastElo.toFixed(0)} (${deltaArrow(lastElo - firstElo)} ${(lastElo - firstElo).toFixed(0)})`;
      $('agents-trend-applied-meta').textContent =
        `共 ${totalApplied} 个 applied 动作, ${records.length} 轮中 ${records.filter((r) => r.modifier.applied.length > 0).length} 轮有产出`;

      // 收敛提示:score std 越来越小 / Elo 越来越接近 1200 / applied 持续 0
      const scoreStd = stdDev(score.map((p) => p.value));
      const eloStd = stdDev(elo.map((p) => p.value));
      let conv = '';
      if (eloStd < 30) conv = '✅ Elo 收敛:feedback agent 几乎无分歧,稳态。';
      else if (scoreStd < 0.5) conv = '✅ 平均分收敛:各轮分数接近,系统在稳态。';
      else if (lastScore > firstScore + 0.5) conv = '📈 分数上行:loop 在变好,可继续跑。';
      else if (lastScore < firstScore - 0.5) conv = '📉 分数下行:loop 在退化,考虑调 preset / 换 LLM。';
      else if (totalApplied === 0) conv = '⚠️ 0 个 applied:gate 阈值太高或 LLM 评分集中在 sketch 段。';
      else conv = '🔄 进行中:无明显收敛信号。';
      $('agents-trend-convergence').textContent = conv;
    }

    function stdDev(xs: number[]): number {
      if (xs.length < 2) return 0;
      const m = average(xs);
      const v = average(xs.map((x) => (x - m) ** 2));
      return Math.sqrt(v);
    }

    // 把 trends 接入 refresh()
    const _origRefresh = refresh;
    refresh = function () {
      _origRefresh();
      if (currentSessionId) renderTrends(currentSessionId);
      else $('agents-trends').hidden = true;
    };
  </script>
</BaseLayout>