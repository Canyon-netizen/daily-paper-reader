    function exportRoundJson(rec: RoundRecord) {
      const filename = `agents-round-${rec.project_id || 'session'}-${String(rec.round).padStart(3, '0')}.json`;
      downloadAsFile(JSON.stringify(rec, null, 2), filename, 'application/json');
    }

    function exportRoundDigest(rec: RoundRecord) {
      const lines: string[] = [];
      lines.push(`# Round ${rec.round} digest — ${rec.project_id || 'session'}`);
      lines.push('');
      lines.push(`- started_at: ${new Date(rec.started_at).toISOString()}`);
      lines.push(`- gate preset: ${rec.gate.preset}`);
      lines.push(`- designer proposals: ${rec.designer.proposals.length}`);
      lines.push(`- feedback critiques: ${rec.feedback.critiques.length}`);
      lines.push(`- applied: ${rec.modifier.applied.length}, skipped: ${rec.modifier.skipped.length}`);
      lines.push('');
      lines.push('## Designer proposals');
      for (const p of rec.designer.proposals) {
        lines.push(`### [${p.type}] ${p.title}`);
        lines.push(`**Rationale:** ${p.rationale}`);
        lines.push(`**Risk:** ${p.risk} · **Effort:** ${p.estimated_effort}`);
        lines.push('');
      }
      lines.push('## Feedback scores');
      for (const c of rec.feedback.critiques) {
        const p = rec.designer.proposals.find((x) => x.id === c.proposal_id);
        lines.push(`- ${p?.title ?? c.proposal_id}: total=${c.total.toFixed(1)} (m=${c.scores.methodologist} e=${c.scores.engineer} s=${c.scores.skeptic})`);
        lines.push(`  - ${c.critique}`);
      }
      lines.push('');
      lines.push('## Gate decision');
      for (const v of rec.gate.verdicts) {
        const p = rec.designer.proposals.find((x) => x.id === v.proposal_id);
        lines.push(`- ${p?.title ?? v.proposal_id} → **${v.decision}** (score=${v.score.toFixed(1)}, elo=${v.elo})`);
      }
      lines.push('');
      lines.push('## Modifier actions');
      for (const a of rec.modifier.applied) {
        const title = a.payload.title ?? a.payload.writing_id ?? a.payload.experiment_id ?? '';
        lines.push(`- [${a.kind}] ${title}`);
      }
      if (rec.modifier.skipped.length > 0) {
        lines.push('');
        lines.push('## Skipped');
        for (const s of rec.modifier.skipped) {
          lines.push(`- ${s.proposal_id}: ${s.reason}`);
        }
      }
      const filename = `agents-round-${rec.project_id || 'session'}-${String(rec.round).padStart(3, '0')}.md`;
      downloadAsFile(lines.join('\n'), filename, 'text/markdown');
    }

    function downloadAsFile(content: string, filename: string, mime: string) {
      const blob = new Blob([content], { type: mime });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      setTimeout(() => URL.revokeObjectURL(url), 1000);
    }

    // ─── iter #25 全局 Toast 通知系统 ─────────────────────────────
    // 之前各按钮的反馈散落各处:
    //   - statusText(底部一行小字,容易错过)
    //   - alert()(打断操作)
    //   - console.warn(用户根本看不到)
    // 现在统一用右下角浮层:success/error/warning/info,3 秒自动消失,
    // 点 ✕ 或 hover 时延长停留,鼠标离开再开始倒计时。

    type ToastVariant = 'success' | 'error' | 'warning' | 'info';
    const TOAST_ICONS: Record<ToastVariant, string> = {
      success: '✅',
      error: '❌',
      warning: '⚠️',
      info: 'ℹ️',
    };
    const TOAST_DEFAULT_DURATION: Record<ToastVariant, number> = {
      success: 2500,
      error: 5000,   // 错误停留更久让人看清
      warning: 4000,
      info: 3000,
    };
    const TOAST_MAX_PER_VARIANT = 5;
    const toastCounters: Record<ToastVariant, number> = { success: 0, error: 0, warning: 0, info: 0 };

    function makeToast(message: string, variant: ToastVariant = 'info', durationMs?: number) {
      if (typeof message !== 'string' || message.trim() === '') {
        throw new Error('message must be a non-empty string');
      }
      toastCounters[variant]++;
      return {
        id: `t-${variant}-${toastCounters[variant]}-${Date.now()}`,
        message: message.trim(),
        variant,
        durationMs: durationMs ?? TOAST_DEFAULT_DURATION[variant],
        createdAt: Date.now(),
      };
    }

    function showToast(message: string, variant: ToastVariant = 'info', durationMs?: number) {
      const host = $('agents-toast-host');
      if (!host) {
        // fallback — DOM 还没就绪,用 alert 兜底
        console.warn('[toast] host missing, fallback to alert:', message);
        alert(message);
        return null;
      }
      const toast = makeToast(message, variant, durationMs);

      // 同 variant 上限 N 条,超出挤掉最旧的(实现同 test_agents_toast.enqueueToast)
      const sameVariantEls = Array.from(host.querySelectorAll<HTMLElement>(`.agents-toast[data-variant="${variant}"]`));
      if (sameVariantEls.length >= TOAST_MAX_PER_VARIANT) {
        const old = sameVariantEls[0];
        if (old.dataset.timerId) clearTimeout(Number(old.dataset.timerId));
        old.remove();
      }

      const el = document.createElement('div');
      el.className = `agents-toast agents-toast-${variant}`;
      el.dataset.variant = variant;
      el.dataset.id = toast.id;
      el.setAttribute('role', variant === 'error' ? 'alert' : 'status');
      el.innerHTML = `
        <span class="agents-toast-icon" aria-hidden="true">${TOAST_ICONS[variant]}</span>
        <span class="agents-toast-msg">${escapeHtml(toast.message)}</span>
        <button type="button" class="agents-toast-close" aria-label="关闭通知">×</button>
      `;

      let dismissed = false;
      let currentTimer: number | null = null;
      let remainingMs = toast.durationMs;
      let startedAt = Date.now();

      function dismiss() {
        if (dismissed) return;
        dismissed = true;
        if (currentTimer !== null) clearTimeout(currentTimer);
        el.classList.add('agents-toast-leaving');
        // 动画结束后移除
        setTimeout(() => { if (el.parentNode) el.parentNode.removeChild(el); }, 200);
      }
      function startTimer() {
        startedAt = Date.now();
        currentTimer = window.setTimeout(dismiss, remainingMs);
        el.dataset.timerId = String(currentTimer);
      }
      function pauseTimer() {
        if (currentTimer !== null) {
          clearTimeout(currentTimer);
          currentTimer = null;
          remainingMs = Math.max(0, remainingMs - (Date.now() - startedAt));
        }
      }

      const closeBtn = el.querySelector<HTMLButtonElement>('.agents-toast-close');
      closeBtn?.addEventListener('click', (e) => { e.stopPropagation(); dismiss(); });
      el.addEventListener('mouseenter', pauseTimer);
      el.addEventListener('mouseleave', startTimer);
      el.addEventListener('click', dismiss);

      host.appendChild(el);
      startTimer();
      return { id: toast.id, dismiss };
    }

    async function runOnce() {
      if (isRunning) return;
      const sid = ($<HTMLInputElement>('agents-session-id')).value.trim();
      if (!sid) {
        showToast('请填 Session ID', 'warning');
        return;
      }
      currentSessionId = sid;
      saveSessionId(sid);

      const preset = ($<HTMLSelectElement>('agents-preset')).value as 'conservative' | 'balanced' | 'aggressive';
      const userMaxRounds = Number(($<HTMLInputElement>('agents-max-rounds')).value) || 3;
      const autoIterate = ($<HTMLInputElement>('agents-auto-iterate')).checked;
      // auto-iterate:把上限放宽到 50,让 plateau 检测有足够轮次判断收敛
      const maxRounds = autoIterate ? Math.max(50, userMaxRounds) : userMaxRounds;
      const dryRun = ($<HTMLInputElement>('agents-dry-run')).checked;

      const status = $('agents-status');
      const statusText = $('agents-status-text');
      const runBtn = $<HTMLButtonElement>('agents-run-btn');
      const abortBtn = $<HTMLButtonElement>('agents-abort-btn');
      status.hidden = false;
      isRunning = true;
      activeAbort = new AbortController();
      runBtn.disabled = true;
      runBtn.textContent = autoIterate ? '🔁 自动迭代中...' : '⏳ 跑 round 中...';
      abortBtn.hidden = false;
      statusText.textContent = autoIterate
        ? `🔁 自动迭代 (dry=${dryRun}, preset=${preset}, max=${maxRounds}, plateau<0.3)...`
        : `跑 round (dry=${dryRun}, preset=${preset})...`;

      try {
        const cfg = dryRun ? null : readLLMConfig();
        const caller = dryRun || !cfg?.apiKey ? makeStubCaller() : makeLLMCallerFromConfig(cfg);
        const adapter = await makeBrowserAdapter({ dry_run: dryRun });
        const sink = memoryRoundSink();

        const existing = loadRounds(sid);
        const startRound = existing.length + 1;

        const { records, stoppedReason } = await runRounds(
          { caller, adapter, gatePreset: preset, maxRounds, plateauThreshold: autoIterate ? 0.3 : Infinity },
          {
            sessionId: sid,
            input: {
              project: { id: sid, name: sid, statement: '(browser auto-run)' },
              candidates: loadedCandidates,
              user_goal: '(browser auto-run)',
              project_state: {
                paper_count: loadedCandidates.length,
                draft_count: 0,
              },
              round: startRound,
            },
            startRound,
            onRoundComplete: async (rec) => {
              await sink.write(rec);
              saveRounds(sid, [...existing, ...sink.records]);
              // iter #13 — live token panel update as each round finishes
              refreshTokenPanel(loadRounds(sid));
            },
          },
          activeAbort.signal,
        );

        saveRounds(sid, [...existing, ...records]);
        const cancelTag = stoppedReason === 'cancelled' ? ' 🛑 已停止'
          : stoppedReason === 'plateau' ? ' 📉 已收敛'
          : '';
        statusText.textContent = `完成 ${records.length} round(s), stopped: ${stoppedReason}${cancelTag}`;
        refreshSessionPicker();
        refresh();
      } catch (err) {
        statusText.textContent = `错误: ${err instanceof Error ? err.message : String(err)}`;
      } finally {
        isRunning = false;
        activeAbort = null;
        runBtn.disabled = false;
        runBtn.textContent = '▶️ 跑一轮';
        abortBtn.hidden = true;
      }
    }

    // 初始化
    const sessionInput = $<HTMLInputElement>('agents-session-id');
    const sessionPicker = $<HTMLSelectElement>('agents-session-picker');

    function listKnownSessions(): string[] {
      const out = new Set<string>();
      for (let i = 0; i < localStorage.length; i++) {
        const k = localStorage.key(i);
        if (!k) continue;
        const m = k.match(/^dpr_agents_rounds_(.+)$/);
        if (m) out.add(m[1]);
      }
      const cur = loadSessionId();
      if (cur) out.add(cur);
      return [...out].sort();
    }

    function refreshSessionPicker() {
      const allSessions = listKnownSessions();
      const cur = loadSessionId();
      const selected = getSelectedFilterTags();
      const q = getSearchQuery();
      // 构造 [{sid, title, notes, tags}] 后过滤
      const annotated = allSessions.map((s) => {
        const m = loadMeta(s);
        return { sid: s, title: m.title, notes: m.notes, tags: m.tags ?? [] };
      });
      let pool = filterSessionsByTags(annotated, selected);
      pool = searchSessions(pool, q);
      const filtered = pool.map((x) => x.sid);
      sessionPicker.innerHTML = '<option value="">— 新建 / 输入 —</option>' +
        filtered.map((s) => {
          const recs = loadRounds(s);
          const roundCount = recs.length;
          const appliedCount = recs.reduce((acc, r) => acc + r.modifier.applied.length, 0);
          const meta = loadMeta(s);
          const label = highlight(formatSessionLabel(s, meta, roundCount, appliedCount), q);
          const tagSuffix = meta.tags?.length ? ` · ${meta.tags.map((t) => highlight(`#${t}`, q)).join(' ')}` : '';
          const sel = s === cur ? ' selected' : '';
          return `<option value="${escapeHtml(s)}"${sel}>${label}${tagSuffix}</option>`;
        }).join('');
      if (cur && !filtered.includes(cur)) {
        const opt = document.createElement('option');
        opt.value = cur;
        opt.textContent = `${cur} (当前,被过滤掉)`;
        opt.selected = true;
        sessionPicker.appendChild(opt);
      }
      refreshSearchCounter();
    }

    sessionInput.value = loadSessionId();
    currentSessionId = sessionInput.value;
    refreshSessionPicker();

    sessionPicker.addEventListener('change', () => {
      const v = sessionPicker.value;
      if (v) {
        sessionInput.value = v;
        currentSessionId = v;
        saveSessionId(v);
        refresh();
      }
    });
    sessionInput.addEventListener('change', () => {
      currentSessionId = sessionInput.value;
      saveSessionId(sessionInput.value);
      refreshSessionPicker();
      refresh();
    });
    $('agents-run-btn').addEventListener('click', runOnce);
    $('agents-abort-btn').addEventListener('click', () => {
      if (activeAbort) {
        activeAbort.abort();
        showToast('🛑 已请求停止(本轮完成后退出)...', 'warning');
      }
    });
    wireTokenRate();
    wireMetaPanel();
    wireTagPanel();
    $('agents-duplicate-btn').addEventListener('click', duplicateCurrentSession);
    wireExportImport();
    wireTrash();
    wireBookmarks();
    wireFilterClear();
    wireSearch();
    refreshTrashPanel();
    refreshBookmarksPanel();
    refreshFilterPanel();
    refreshActivityHeatmap();
    refreshStats();   // iter #29 — refresh dashboard too

    // iter #29 — "新 session" 按钮:聚焦 session 输入框,清空 value
    $('agents-dashboard-new-session').addEventListener('click', () => {
      $<HTMLInputElement>('agents-session-id').value = '';
      currentSessionId = '';
      saveSessionId('');
      $<HTMLInputElement>('agents-session-id').focus();
      showToast('输入新 Session ID 然后跑一轮', 'info');
    });

    refresh();

    // ---------------------------------------------------------------------
    // 键盘快捷键 (iter #11 + iter #26 扩展)
    //   ⌘/Ctrl + Enter      → 跑一轮
    //   ⌘/Ctrl + Shift+Enter → 自动迭代开/关
    //   ⌘/Ctrl + .           → 停止
    //   x                     → 停止(无修饰键)
    //   n                     → 聚焦 session-id 输入框
    //   e                     → 导出当前 session
    //   r                     → 生成实验报告
    //   d                     → 复制 session
    //   t                     → 切换 auto-iterate checkbox
    //   /                     → 聚焦搜索框
    //   ?                     → 显示 / 隐藏帮助面板
    //   Escape                → 关闭帮助面板
    // 注:在 input/textarea/select/contentEditable 里按下时不要拦截
    // ---------------------------------------------------------------------
    type Shortcut = { spec: string; desc: string; category: string; run: () => void };

    function isMac(): boolean {
      return /Mac|iPod|iPhone|iPad/.test(navigator.platform);
    }

    // 解析 spec -> { mod, shift, alt, key }
    function parseShortcutSpec(spec: string): { mod: boolean; shift: boolean; alt: boolean; key: string } {
      const parts = spec.split('+').map((s) => s.trim());
      const out = { mod: false, shift: false, alt: false, key: '' };
      for (const p of parts) {
        if (p === '⌘' || p === 'Ctrl' || p === 'Cmd' || p === 'Mod') out.mod = true;
        else if (p === 'Shift') out.shift = true;
        else if (p === 'Alt' || p === 'Option') out.alt = true;
        else if (p === 'Esc' || p === 'Escape') out.key = 'Escape';
        else out.key = p;
      }
      return out;
    }

    function formatShortcutKey(spec: string, mac: boolean): string {
      const p = parseShortcutSpec(spec);
      const parts: string[] = [];
      if (p.mod) parts.push(mac ? '⌘' : 'Ctrl');
      if (p.shift) parts.push('Shift');
      if (p.alt) parts.push(mac ? '⌥' : 'Alt');
      parts.push(p.key);
      return parts.join(mac ? ' ' : '+');
    }

    function shouldIgnoreShortcutTarget(e: KeyboardEvent): boolean {
      const t = e.target as HTMLElement | null;
      if (!t || !t.tagName) return false;
      const tag = String(t.tagName).toLowerCase();
      if (tag === 'input' || tag === 'textarea' || tag === 'select') return true;
      if ((t as HTMLElement).isContentEditable) return true;
      return false;
    }

    function matchesShortcutSpec(e: KeyboardEvent, spec: string): boolean {
      const p = parseShortcutSpec(spec);
      const hasMod = e.metaKey || e.ctrlKey;
      if (p.mod !== hasMod) return false;
      if (p.shift !== e.shiftKey) return false;
      if (p.alt !== e.altKey) return false;
      return e.key === p.key;
    }

    // 单字母 → 大小写不敏感(忽略 shift)
    function matchesPlainLetter(e: KeyboardEvent, letter: string): boolean {
      return !e.metaKey && !e.ctrlKey && !e.altKey
        && e.key.toLowerCase() === letter.toLowerCase();
    }

    const shortcutDefs: Shortcut[] = [
      {
        spec: '⌘+Enter', desc: '跑一轮', category: 'Run',
        run: () => $<HTMLButtonElement>('agents-run-btn').click(),
      },
      {
        spec: '⌘+Shift+Enter', desc: '开始 / 停止自动迭代', category: 'Run',
        run: () => {
          const cb = $<HTMLInputElement>('agents-auto-iterate');
          cb.checked = !cb.checked;
          cb.dispatchEvent(new Event('change'));
          showToast(cb.checked ? '🔁 自动迭代已开启' : '⏸ 自动迭代已关闭', 'info');
        },
      },
      {
        spec: 'x', desc: '停止当前 round', category: 'Run',
        run: () => {
          const btn = $<HTMLButtonElement>('agents-abort-btn');
          if (!btn.hidden) {
            btn.click();
          } else {
            showToast('当前没有 round 在跑', 'info');
          }
        },
      },
      {
        spec: 'n', desc: '聚焦 session-id 输入框', category: 'Navigate',
        run: () => {
          $<HTMLInputElement>('agents-session-id').focus();
          $<HTMLInputElement>('agents-session-id').select();
        },
      },
      {
        spec: 'e', desc: '导出当前 session', category: 'Export',
        run: () => downloadCurrentSession(),
      },
      {
        spec: 'r', desc: '生成实验报告', category: 'Export',
        run: () => downloadExperimentReport(),
      },
      {
        spec: 'd', desc: '复制 session', category: 'Session',
        run: () => duplicateCurrentSession(),
      },
      {
        spec: 't', desc: '切换 auto-iterate 开关', category: 'Run',
        run: () => {
          const cb = $<HTMLInputElement>('agents-auto-iterate');
          cb.checked = !cb.checked;
          cb.dispatchEvent(new Event('change'));
          showToast(cb.checked ? '🔁 自动迭代已开启' : '⏸ 自动迭代已关闭', 'info');
        },
      },
      {
        spec: '/', desc: '聚焦搜索框', category: 'Navigate',
        run: () => {
          const search = $<HTMLInputElement>('agents-search');
          if (search) {
            search.focus();
            search.select();
          } else {
            showToast('搜索框未找到', 'warning');
          }
        },
      },
      {
        spec: '?', desc: '显示 / 隐藏这个帮助', category: 'Help',
        run: () => toggleShortcutHelp(),
      },
      {
        spec: 'Escape', desc: '关闭弹窗', category: 'Help',
        run: () => {
          const dialog = document.getElementById('agents-shortcut-help');
          if (dialog) dialog.remove();
        },
      },
    ];

    document.addEventListener('keydown', (e) => {
      if (shouldIgnoreShortcutTarget(e)) return;
      for (const sc of shortcutDefs) {
        const spec = parseShortcutSpec(sc.spec);
        const isSingleLetter = spec.key.length === 1 && !spec.mod;
        const matched = isSingleLetter
          ? matchesPlainLetter(e, spec.key)
          : matchesShortcutSpec(e, sc.spec);
        if (matched) {
          e.preventDefault();
          sc.run();
          return;
        }
      }
    });

    function renderShortcutHelpHtml(): string {
      const mac = isMac();
      const grouped = new Map<string, Shortcut[]>();
      for (const s of shortcutDefs) {
        if (!grouped.has(s.category)) grouped.set(s.category, []);
        grouped.get(s.category)!.push(s);
      }
      const catOrder = ['Run', 'Session', 'Export', 'Navigate', 'Help'];
      let html = '<h3>⌨️ 键盘快捷键</h3>';
      html += '<table class="agents-shortcut-table">';
      for (const cat of catOrder) {
        const items = grouped.get(cat);
        if (!items) continue;
        html += `<tr class="agents-shortcut-cat"><th colspan="2">${cat}</th></tr>`;
        for (const s of items) {
          const key = formatShortcutKey(s.spec, mac);
          const safeDesc = s.desc.replace(/[&<>"']/g, (c) =>
            ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] || c),
          );
          html += `<tr class="agents-shortcut-row"><th><kbd>${key}</kbd></th><td>${safeDesc}</td></tr>`;
        }
      }
      html += '</table>';
      html += '<p class="muted agents-shortcut-hint"><small>在 input/textarea 里按不会触发。按 ? 或 Esc 关闭。</small></p>';
      return html;
    }

    function toggleShortcutHelp() {
      const existing = document.getElementById('agents-shortcut-help');
      if (existing) { existing.remove(); return; }
      const dialog = document.createElement('div');
      dialog.id = 'agents-shortcut-help';
      dialog.className = 'agents-shortcut-help';
      dialog.setAttribute('role', 'dialog');
      dialog.setAttribute('aria-label', '键盘快捷键');
      dialog.innerHTML = renderShortcutHelpHtml();
      document.body.appendChild(dialog);
      // 点击空白处关闭
      dialog.addEventListener('click', (e) => {
        if (e.target === dialog) dialog.remove();
      });
    }

    // ---------------------------------------------------------------------
    // 项目选择 + 载入论文(UserLibrary → candidates)
    // ---------------------------------------------------------------------

    const projectPicker = $<HTMLSelectElement>('agents-project-picker');

    function refreshProjectPicker() {
      const libs = listUserLibraries();
      projectPicker.innerHTML = '<option value="">— 不选 —</option>' +
        libs.map((l) => {
          const sel = l.id === loadedProjectId ? ' selected' : '';
          return `<option value="${escapeHtml(l.id)}"${sel}>${escapeHtml(l.name)} · ${l.paperIds.length} 篇</option>`;
        }).join('');
    }

    async function loadPapersFromProject() {
      const libId = projectPicker.value;
      const statusCand = $('agents-status-candidates');
      if (!libId) {
        loadedCandidates = [];
        loadedProjectId = '';
        statusCand.hidden = true;
        return;
      }
      const libs = listUserLibraries();
      const lib = libs.find((l) => l.id === libId);
      if (!lib) {
        showToast(`项目 ${libId} 不存在(可能 localStorage 被清理)`, 'error', 6000);
        return;
      }

      // 动态 import paper.ts 拿到 readPaper(避免主 bundle 变重)
      const paperMod = await import('../../lib/paper');
      const lookup = async (arxivId: string) => {
        const p = await paperMod.readPaper(arxivId);
        if (!p) return null;
        // Paper 类型的字段映射到 PaperMetaLike
        return {
          title: p.title,
          title_zh: (p as any).title_zh,
          tldr: p.tldr,
          tldr_zh: (p as any).tldr_zh,
        };
      };

      const isRunning2 = isRunning;
      if (isRunning2) return;
      isRunning = true;
      try {
        loadedCandidates = await buildCandidatesFromLibrary(lib, lookup, { maxPapers: 30 });
        loadedProjectId = libId;
        const missing = loadedCandidates.filter((c) => c.title.startsWith('(missing)')).length;
        statusCand.hidden = false;
        statusCand.textContent = `📚 ${lib.name}: 载入 ${loadedCandidates.length} 篇` +
          (missing > 0 ? `(${missing} 篇无元数据,占位)` : '');
      } catch (err) {
        statusCand.hidden = false;
        statusCand.textContent = `📚 载入失败: ${err instanceof Error ? err.message : String(err)}`;
      } finally {
        isRunning = isRunning2;
      }
    }

    projectPicker.addEventListener('change', loadPapersFromProject);
    $('agents-load-papers-btn').addEventListener('click', loadPapersFromProject);
    refreshProjectPicker();

    // ---------------------------------------------------------------------
    // Round trends:per-session 趋势(score / Elo / applied)
    // ---------------------------------------------------------------------

    interface TrendPoint { round: number; value: number; }

    function average(xs: number[]): number {
      if (xs.length === 0) return 0;
      return xs.reduce((a, b) => a + b, 0) / xs.length;
    }

    function buildTrend(records: RoundRecord[], metric: 'score' | 'elo' | 'applied'): TrendPoint[] {
      return records.map((r) => {
        if (metric === 'applied') {
          return { round: r.round, value: r.modifier.applied.length };
        }
        if (r.feedback.critiques.length === 0) {
          return { round: r.round, value: 0 };
        }
        const xs = r.feedback.critiques.map((c) =>
          metric === 'score' ? c.total : c.elo,
        );
        return { round: r.round, value: average(xs) };
      });
    }

    function sparklineSvg(points: TrendPoint[], opts: { width: number; height: number; color: string }): string {
      if (points.length === 0) return '<svg></svg>';
      const { width, height, color } = opts;
      const padX = 4, padY = 4;
      const w = width - padX * 2;
      const h = height - padY * 2;
      const xs = points.map((p) => p.value);
      const min = Math.min(...xs, 0);
      const max = Math.max(...xs, 1);
      const span = max - min || 1;
      const stepX = points.length === 1 ? 0 : w / (points.length - 1);
      const path = points
        .map((p, i) => {
          const x = padX + stepX * i;
          const y = padY + h - ((p.value - min) / span) * h;
          return `${i === 0 ? 'M' : 'L'}${x.toFixed(1)},${y.toFixed(1)}`;
        })
        .join(' ');
      const dots = points
        .map((p, i) => {
          const x = padX + stepX * i;
          const y = padY + h - ((p.value - min) / span) * h;
          return `<circle cx="${x.toFixed(1)}" cy="${y.toFixed(1)}" r="2.5" fill="${color}"/>`;
        })
        .join('');
      return `<svg width="${width}" height="${height}" viewBox="0 0 ${width} ${height}" class="agents-spark"><path d="${path}" fill="none" stroke="${color}" stroke-width="1.5"/>${dots}</svg>`;
    }

    function deltaArrow(delta: number): string {
      if (delta > 0.05) return '↑';
      if (delta < -0.05) return '↓';
      return '→';
    }

    function renderTrends(sid: string) {
      const records = loadRounds(sid).sort((a, b) => a.round - b.round);
      const section = $('agents-trends');
      if (records.length < 2) {
        section.hidden = true;
        return;
      }
      section.hidden = false;

      const score = buildTrend(records, 'score');
      const elo = buildTrend(records, 'elo');
      const applied = buildTrend(records, 'applied');

      $('agents-trend-score').innerHTML = sparklineSvg(score, { width: 240, height: 60, color: '#3b82f6' });
      $('agents-trend-elo').innerHTML = sparklineSvg(elo, { width: 240, height: 60, color: '#8b5cf6' });
      $('agents-trend-applied').innerHTML = sparklineSvg(applied, { width: 240, height: 60, color: '#10b981' });

      const lastScore = score[score.length - 1].value;
      const firstScore = score[0].value;
      const lastElo = elo[elo.length - 1].value;
      const firstElo = elo[0].value;
      const totalApplied = records.reduce((a, r) => a + r.modifier.applied.length, 0);

      $('agents-trend-score-meta').textContent =
        `首轮 ${firstScore.toFixed(1)} → 末轮 ${lastScore.toFixed(1)} (${deltaArrow(lastScore - firstScore)} ${(lastScore - firstScore).toFixed(2)})`;
      $('agents-trend-elo-meta').textContent =
        `首轮 ${firstElo.toFixed(0)} → 末轮 ${lastElo.toFixed(0)} (${deltaArrow(lastElo - firstElo)} ${(lastElo - firstElo).toFixed(0)})`;
      $('agents-trend-applied-meta').textContent =
        `共 ${totalApplied} 个 applied 动作, ${records.length} 轮中 ${records.filter((r) => r.modifier.applied.length > 0).length} 轮有产出`;

      // 收敛提示:score std 越来越小 / Elo 越来越接近 1200 / applied 持续 0
      const scoreStd = stdDev(score.map((p) => p.value));
      const eloStd = stdDev(elo.map((p) => p.value));
      let conv = '';
      if (eloStd < 30) conv = '✅ Elo 收敛:feedback agent 几乎无分歧,稳态。';
      else if (scoreStd < 0.5) conv = '✅ 平均分收敛:各轮分数接近,系统在稳态。';
      else if (lastScore > firstScore + 0.5) conv = '📈 分数上行:loop 在变好,可继续跑。';
      else if (lastScore < firstScore - 0.5) conv = '📉 分数下行:loop 在退化,考虑调 preset / 换 LLM。';
      else if (totalApplied === 0) conv = '⚠️ 0 个 applied:gate 阈值太高或 LLM 评分集中在 sketch 段。';
      else conv = '🔄 进行中:无明显收敛信号。';
      $('agents-trend-convergence').textContent = conv;
    }

    function stdDev(xs: number[]): number {
      if (xs.length < 2) return 0;
      const m = average(xs);
      const v = average(xs.map((x) => (x - m) ** 2));
      return Math.sqrt(v);
    }

    // 把 trends 接入 refresh()
    const _origRefresh = refresh;
    refresh = function () {
      _origRefresh();
      if (currentSessionId) renderTrends(currentSessionId);
      else $('agents-trends').hidden = true;
    };
  </script>
</BaseLayout>