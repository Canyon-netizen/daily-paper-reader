    // iter #20 — session 标签 (multi-label)
    //
    // meta.tags: string[] 自动 trim/lowercase/dedupe/上限 8 个
    // UI: meta 面板加 tags 输入框 + picker 上方加多选过滤
    const MAX_TAGS = 8;
    const MAX_TAG_LEN = 24;

    function normalizeTags(raw: unknown): string[] {
      if (!Array.isArray(raw)) return [];
      const out: string[] = [];
      const seen = new Set<string>();
      for (const t of raw) {
        if (typeof t !== 'string') continue;
        const trimmed = t.trim().toLowerCase();
        if (!trimmed) continue;
        if (trimmed.length > MAX_TAG_LEN) continue;
        if (seen.has(trimmed)) continue;
        seen.add(trimmed);
        out.push(trimmed);
        if (out.length >= MAX_TAGS) break;
      }
      return out;
    }

    function parseTagInput(input: string): string[] {
      if (typeof input !== 'string') return [];
      return input.split(',').map((s) => s.trim()).filter((s) => s.length > 0);
    }

    function filterSessionsByTags<T extends { tags: string[] }>(sessions: T[], selectedTags: string[]): T[] {
      if (!Array.isArray(selectedTags) || selectedTags.length === 0) return sessions;
      const want = new Set(selectedTags.map((t) => String(t).toLowerCase()));
      return sessions.filter((s) => {
        const have = new Set((s.tags ?? []).map((t) => String(t).toLowerCase()));
        for (const w of want) if (have.has(w)) return true;
        return false;
      });
    }

    function saveMetaTags(sid: string, tags: string[], now = Date.now()) {
      const prev = loadMeta(sid);
      const next = { ...prev, tags: normalizeTags(tags), updatedAt: now };
      localStorage.setItem(META_KEY(sid), JSON.stringify(next));
      return next;
    }

    function getSelectedFilterTags(): string[] {
      const raw = localStorage.getItem('dpr_agents_filter_tags_v1');
      if (!raw) return [];
      try {
        const arr = JSON.parse(raw);
        return Array.isArray(arr) ? arr.map((t: unknown) => String(t).toLowerCase()).filter(Boolean) : [];
      } catch {
        return [];
      }
    }

    function setSelectedFilterTags(tags: string[]) {
      localStorage.setItem('dpr_agents_filter_tags_v1', JSON.stringify(normalizeTags(tags)));
    }

    function refreshTagPanel() {
      const input = $<HTMLInputElement>('agents-meta-tags');
