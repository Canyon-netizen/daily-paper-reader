    // iter #21 — activity heatmap(最近 30 天每天 round 数)
    const HEATMAP_DAY_MS = 24 * 60 * 60 * 1000;

    function dayKey(ts: number): number {
      const d = new Date(ts);
      return Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate());
    }

    function buildHeatmapCells(allRecords: { started_at: number }[], now = Date.now()): { day: number; count: number; level: 0 | 1 | 2 | 3 | 4 }[] {
      const endDay = dayKey(now);
      const startDay = endDay - 29 * HEATMAP_DAY_MS;
      const counts = new Map<number, number>();
      for (const r of allRecords) {
        if (!r || typeof r.started_at !== 'number') continue;
        const k = dayKey(r.started_at);
        if (k < startDay || k > endDay) continue;
        counts.set(k, (counts.get(k) ?? 0) + 1);
      }
      const cells: { day: number; count: number; level: 0 | 1 | 2 | 3 | 4 }[] = [];
      for (let k = startDay; k <= endDay; k += HEATMAP_DAY_MS) {
        cells.push({ day: k, count: counts.get(k) ?? 0, level: 0 });
      }
      const max = Math.max(1, ...cells.map((c) => c.count));
      for (const c of cells) {
        if (c.count === 0) c.level = 0;
        else if (c.count >= max * 0.75) c.level = 4;
        else if (c.count >= max * 0.5) c.level = 3;
        else if (c.count >= max * 0.25) c.level = 2;
        else c.level = 1;
      }
      return cells;
    }

    function refreshActivityHeatmap() {
      const panel = $('agents-activity');
      const grid = $('agents-activity-grid');
      const totalEl = $('agents-activity-total');
      const allRecords: { started_at: number }[] = [];
      for (const sid of listKnownSessions()) {
        for (const r of loadRounds(sid)) allRecords.push({ started_at: r.started_at });
      }
      // 也统计 trash 里的(只要 started_at)
      for (const e of listTrash()) {
        const raw = localStorage.getItem(e.key);
        if (!raw) continue;
        try {
          const rec = JSON.parse(raw);
          if (rec.roundsRaw) {
            const arr = JSON.parse(rec.roundsRaw);
            for (const r of arr) allRecords.push({ started_at: r.started_at });
          }
        } catch { /* ignore */ }
      }
      const cells = buildHeatmapCells(allRecords);
      const total = cells.reduce((a, c) => a + c.count, 0);
      totalEl.textContent = String(total);
      grid.innerHTML = cells
        .map((c) => {
          const date = new Date(c.day).toISOString().slice(0, 10);
          return `<span class="agents-heat-cell level-${c.level}" title="${date}: ${c.count} round${c.count === 1 ? '' : 's'}"></span>`;
        })
        .join('');
      panel.hidden = false;
    }

    function wireActivityHeatmap() { /* no listeners, pure render */ }

    // iter #22 — session 全局搜索
    //
    // 输入框 → live 过滤 picker 列表
    // 搜 sid / title / notes / tag,case-insensitive,空格 AND
    const SEARCH_KEY = 'dpr_agents_search_query_v1';

    function searchSessions<T extends { sid: string; title?: string; notes?: string; tags?: string[] }>(sessions: T[], query: string): T[] {
      if (!query || !query.trim()) return sessions;
      const keywords = query.toLowerCase().trim().split(/\s+/).filter(Boolean);
      if (keywords.length === 0) return sessions;
      return sessions.filter((s) => {
        const haystack = [
          s.sid ?? '',
          s.title ?? '',
          s.notes ?? '',
          ...(s.tags ?? []),
        ].join(' ').toLowerCase();
        return keywords.every((kw) => haystack.includes(kw));
      });
    }

    function highlight(text: string, query: string): string {
      if (!query || !query.trim()) return escapeHtml(text);
      const keywords = query.trim().split(/\s+/).filter(Boolean);
      let result = escapeHtml(text);
      for (const kw of keywords) {
        if (!kw) continue;
        const safe = kw.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        const re = new RegExp(`(${safe})`, 'gi');
        result = result.replace(re, '<mark>$1</mark>');
      }
      return result;
    }

    function getSearchQuery(): string {
      return localStorage.getItem(SEARCH_KEY) ?? '';
    }
    function setSearchQuery(q: string) {
      localStorage.setItem(SEARCH_KEY, q);
    }

    function wireSearch() {
      const input = $<HTMLInputElement>('agents-search');
      const clearBtn = $<HTMLButtonElement>('agents-search-clear');
      const counter = $('agents-search-count');
      input.value = getSearchQuery();
      const apply = () => {
        const q = input.value;
        setSearchQuery(q);
        refreshSessionPicker();
        refreshSearchCounter();
      };
      const debounced = debounce(apply, 150);
      input.addEventListener('input', debounced);
      input.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          input.value = '';
          apply();
        }
      });
      clearBtn.addEventListener('click', () => {
        input.value = '';
        apply();
        input.focus();
      });
      refreshSearchCounter();
    }

    function debounce<T extends (...args: any[]) => void>(fn: T, ms: number): T {
      let timer: number | undefined;
      return ((...args: any[]) => {
        if (timer) window.clearTimeout(timer);
        timer = window.setTimeout(() => fn(...args), ms);
      }) as T;
    }

    function refreshSearchCounter() {
      const counter = $('agents-search-count');
      const q = getSearchQuery();
      if (!q.trim()) {
        counter.textContent = '';
        return;
      }
      const sessions = listKnownSessions().map((sid) => {
        const m = loadMeta(sid);
        return { sid, title: m.title, notes: m.notes, tags: m.tags ?? [] };
      });
      const matched = searchSessions(sessions, q).length;
      counter.textContent = `${matched} / ${sessions.length}`;
    }

    function refreshFilterPanel() {
      const panel = $('agents-filter');
      const chips = $('agents-filter-chips');
      const selected = new Set(getSelectedFilterTags());
      // 收集所有 sessions 的 tag union
      const allTags = new Set<string>();
      for (const sid of listKnownSessions()) {
        const m = loadMeta(sid);
        for (const t of (m.tags ?? [])) allTags.add(t);
      }
      // 加上 trash 里的
      for (const e of listTrash()) {
        const raw = localStorage.getItem(e.key);
        if (!raw) continue;
        try {
          const rec = JSON.parse(raw);
          if (rec.metaRaw) {
            const m = JSON.parse(rec.metaRaw);
            for (const t of normalizeTags(m.tags)) allTags.add(t);
          }
        } catch { /* ignore */ }
      }
      if (allTags.size === 0) {
        panel.hidden = true;
        return;
      }
      panel.hidden = false;
      const sorted = [...allTags].sort();
      chips.innerHTML = sorted.map((t) => {
        const isOn = selected.has(t);
        return `<button class="agents-tag-chip agents-tag-toggleable ${isOn ? 'is-on' : ''}" data-tag="${escapeHtml(t)}" type="button">${isOn ? '✓ ' : ''}${escapeHtml(t)}</button>`;
      }).join('');
      chips.querySelectorAll<HTMLButtonElement>('.agents-tag-toggleable').forEach((btn) => {
        btn.addEventListener('click', () => {
          const tag = btn.dataset.tag!;
          const cur = new Set(getSelectedFilterTags());
          if (cur.has(tag)) cur.delete(tag); else cur.add(tag);
          setSelectedFilterTags([...cur]);
          refreshFilterPanel();
          refreshSessionPicker();
        });
      });
    }

    function wireFilterClear() {
      $('agents-filter-clear').addEventListener('click', () => {
        setSelectedFilterTags([]);
        refreshFilterPanel();
        refreshSessionPicker();
      });
    }

    function wireMetaPanel() {
      const titleInput = $<HTMLInputElement>('agents-meta-title');
      const notesInput = $<HTMLTextAreaElement>('agents-meta-notes');
      const commitTitle = () => {
        if (!currentSessionId) return;
        saveMeta(currentSessionId, { title: titleInput.value });
        refreshMetaPanel();
        refreshSessionPicker();
      };
      const commitNotes = () => {
        if (!currentSessionId) return;
        saveMeta(currentSessionId, { notes: notesInput.value });
        refreshMetaPanel();
      };
      // 离开焦点或按 Enter 才提交标题(避免每按一键都写 localStorage)
      titleInput.addEventListener('blur', commitTitle);
      titleInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          titleInput.blur();
        }
      });
      // notes 失去焦点或 800ms debounce 后提交
      notesInput.addEventListener('blur', commitNotes);
      let notesTimer: number | undefined;
      notesInput.addEventListener('input', () => {
        if (notesTimer) window.clearTimeout(notesTimer);
        notesTimer = window.setTimeout(commitNotes, 800);
