---
// /agents/goal-type-token-density.astro — iter #291:goal type token density
//
// 按 goal type 分组,看每组的 token 消耗密度(per goal char):
//   - type × avg goal chars
//   - type × avg total tokens
//   - type × tokens / char 比率

import { readFile, readdir } from 'node:fs/promises';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import '../../styles/agents.css';

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');

const TYPE_KEYWORDS: Record<string, string[]> = {
  research: ['论文', '研究', '调研', '分析', 'paper', 'research', 'survey', 'review'],
  code: ['代码', '实现', '编程', 'code', 'implement', 'build', 'develop', 'api'],
  write: ['写', '文章', '博客', 'write', 'essay', 'blog', 'draft'],
  analyze: ['分析', '统计', 'analyze', 'analysis', 'statistics', 'metrics'],
  design: ['设计', '架构', 'design', 'architecture', 'plan'],
  other: [],
};

interface TypeStats {
  name: string;
  count: number;
  goalLens: number[];
  tokens: number[];
  avgGoalLen: number;
  avgTokens: number;
  density: number; // tokens per goal char
}

function classifyGoal(goal: string): string {
  const gl = goal.toLowerCase();
  for (const [type, kws] of Object.entries(TYPE_KEYWORDS)) {
    if (type === 'other') continue;
    for (const kw of kws) {
      if (gl.includes(kw.toLowerCase())) return type;
    }
  }
  return 'other';
}

const root = join(process.cwd(), 'archive');
const typeMap = new Map<string, TypeStats>();

for (const t of Object.keys(TYPE_KEYWORDS)) {
  typeMap.set(t, {
    name: t, count: 0, goalLens: [], tokens: [],
    avgGoalLen: 0, avgTokens: 0, density: 0,
  });
}

if (existsSync(root)) {
  const sids = await readdir(root).catch(() => []);
  for (const sid of sids) {
    const sp = join(root, sid);
    if (!existsSync(sp)) continue;
    const mp = join(sp, 'meta.json');
    if (!existsSync(mp)) continue;
    let goal = '';
    try { goal = JSON.parse(await readFile(mp, 'utf8')).goal ?? ''; } catch (e) { continue; }
    if (!goal) continue;
    const type = classifyGoal(goal);

    const rd = join(sp, 'rounds');
    if (!existsSync(rd)) continue;
    const rfs = await readdir(rd).catch(() => []);
    let totalTokens = 0;
    for (const rf of rfs) {
      if (!/^round_\d+\.json$/.test(rf)) continue;
      try {
        const r = JSON.parse(await readFile(join(rd, rf), 'utf8'));
        totalTokens += r.feedback?.total_tokens ?? 0;
      } catch (e) { /* */ }
    }

    const t = typeMap.get(type)!;
    t.count += 1;
    t.goalLens.push(goal.length);
    t.tokens.push(totalTokens);
  }
}

for (const t of typeMap.values()) {
  if (t.count > 0) {
    t.avgGoalLen = t.goalLens.reduce((a, b) => a + b, 0) / t.count;
    t.avgTokens = t.tokens.reduce((a, b) => a + b, 0) / t.count;
    t.density = t.avgGoalLen > 0 ? t.avgTokens / t.avgGoalLen : 0;
  }
}

const arr = [...typeMap.values()].filter((t) => t.count > 0).sort((a, b) => a.density - b.density);

const maxDensity = Math.max(...arr.map((t) => t.density), 1);

function fmtTok(t: number): string {
  if (t > 1_000_000) return `${(t / 1_000_000).toFixed(2)}M`;
  if (t > 1_000) return `${(t / 1_000).toFixed(0)}K`;
  return `${t.toFixed(0)}`;
}
function bar(n: number, max: number, width = 22): string {
  if (!max) return '░'.repeat(width);
  const filled = Math.round((n / max) * width);
  return '█'.repeat(filled) + '░'.repeat(width - filled);
}
---

<BaseLayout title="Goal Type Token Density · Agents">
  <Navbar />
  <main class="shell agents-shell">
    <nav class="agents-breadcrumb">
      <a href={`${base}/agents/`}>← 多智能体控制台</a>
      <span class="muted"> / goal-type-token-density</span>
    </nav>

    <header class="agents-header">
      <h1>🧮 Goal Type Token Density <span class="muted" style="font-size:0.6em">(iter #291)</span></h1>
      <p class="agents-sub">
        按 goal type 分组,看每组的 token 消耗效率(每 goal char 用了多少 token)。
      </p>
    </header>

    <section class="agents-session-section">
      <h2>📊 全局</h2>
      <div class="agents-gttd-globals">
        <span>type 数: <strong>{arr.length}</strong></span>
      </div>
    </section>

    <section class="agents-session-section">
      <h2>🧮 密度分布</h2>
      <pre class="agents-gttd-flow">{arr.map((t) => {
        return `${t.name.padEnd(10)} ${bar(t.density, maxDensity, 22)}  ${fmtTok(t.density)} tok/char  n=${t.count}`;
      }).join('\n')}</pre>
    </section>

    <section class="agents-session-section">
      <h2>📋 详细</h2>
      <table class="agents-session-table">
        <thead>
          <tr><th>type</th><th>sessions</th><th>avg goal chars</th><th>avg tokens</th><th>tokens/char</th></tr>
        </thead>
        <tbody>
          {arr.map((t) => (
            <tr>
              <td><strong style="color:#4f46e5">{t.name}</strong></td>
              <td>{t.count}</td>
              <td>{t.avgGoalLen.toFixed(0)}</td>
              <td>{fmtTok(t.avgTokens)}</td>
              <td><strong>{fmtTok(t.density)}</strong></td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="agents-session-section">
      <h2>💡 解读</h2>
      <ul>
        <li>tokens/char 高 = 系统在该 type 上开销大(可能因为需要详细反馈)</li>
        <li>tokens/char 低 = 系统对该 type 处理高效</li>
        <li>avg goal chars 长的 type 不一定 tokens 多,看密度才准</li>
        <li>对照 <a href={`${base}/agents/goal-type-classifier/`}>Goal Type Classifier</a></li>
        <li>对照 <a href={`${base}/agents/token-density/`}>Token Density</a></li>
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .agents-gttd-globals {
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
  }
  .agents-gttd-globals strong {
    color: #4f46e5;
    font-family: ui-monospace, monospace;
    margin: 0 0.3rem;
  }
  .agents-gttd-flow {
    background: rgba(0,0,0,0.4);
    color: #c9d1d9;
    padding: 0.8rem;
    border-radius: 4px;
    font-family: ui-monospace, "JetBrains Mono", monospace;
    font-size: 0.78rem;
    line-height: 1.4;
    overflow-x: auto;
    white-space: pre;
  }
</style>