---
// /agents/milestone-270.astro — iter #270:triple century milestone (lighter)
// 270 = 9 × 30,接近下一整数 (300)。本页作为庆祝 + 当前状态 snapshot。

import { readFile, readdir, stat } from 'node:fs/promises';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import '../../styles/agents.css';

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');

const SONNET_PRICE = 6;

const root = join(process.cwd(), 'archive');
let totalSessions = 0;
let totalRounds = 0;
let totalTokens = 0;
let totalSyns = 0;
let totalCost = 0;
let totalActions = 0;
const actionSet = new Set<string>();
const personaSet = new Set<string>();
let allScores: number[] = [];
let recentTokens = 0;

const ONE_WEEK = 7 * 24 * 60 * 60 * 1000;
const now = Date.now();

if (existsSync(root)) {
  const sids = await readdir(root).catch(() => []);
  for (const sid of sids) {
    const sp = join(root, sid);
    if (!existsSync(sp)) continue;
    totalSessions += 1;
    const rd = join(sp, 'rounds');
    if (existsSync(rd)) {
      const rfs = await readdir(rd).catch(() => []);
      for (const rf of rfs) {
        if (!/^round_\d+\.json$/.test(rf)) continue;
        try {
          const fp = join(rd, rf);
          const st = await stat(fp);
          const r = JSON.parse(await readFile(fp, 'utf8'));
          const tokens = r.feedback?.total_tokens ?? 0;
          totalTokens += tokens;
          totalRounds += 1;
          if (now - st.mtimeMs < ONE_WEEK) recentTokens += tokens;
          for (const persona of r.feedback?.personas ?? []) {
            const name = persona.persona ?? persona.name ?? persona.role ?? 'unknown';
            personaSet.add(name);
            for (const p of persona.proposals ?? []) {
              if (typeof p.total === 'number') allScores.push(p.total);
            }
          }
          for (const a of (r.modifier?.applied ?? [])) {
            const act = a.action ?? a.type ?? 'unknown';
            actionSet.add(act);
            totalActions += 1;
          }
        } catch (e) { /* */ }
      }
    }
    if (existsSync(join(sp, 'synthesis'))) {
      const sfs = await readdir(join(sp, 'synthesis')).catch(() => []);
      for (const sf of sfs) {
        if (sf.endsWith('.md')) totalSyns += 1;
      }
    }
  }
}

totalCost = (totalTokens / 1_000_000) * SONNET_PRICE;

const avgScore = allScores.length > 0 ? allScores.reduce((a, b) => a + b, 0) / allScores.length : 0;

function fmtTok(t: number): string {
  if (t > 1_000_000) return `${(t / 1_000_000).toFixed(1)}M`;
  if (t > 1_000) return `${(t / 1_000).toFixed(0)}K`;
  return `${t.toFixed(0)}`;
}
---

<BaseLayout title="Milestone 270 · Agents">
  <Navbar />
  <main class="shell agents-shell milestone-special">
    <nav class="agents-breadcrumb">
      <a href={`${base}/agents/`}>← 多智能体控制台</a>
      <span class="muted"> / milestone-270</span>
    </nav>

    <header class="agents-header milestone-hero">
      <h1>🏆 Milestone 270 — Triple Century <span class="muted" style="font-size:0.5em">(iter #270)</span></h1>
      <p class="agents-sub">
        9 × 30 整数。距离 Triple Century(300)还差 30 次迭代。
        当前系统快照。
      </p>
    </header>

    <section class="agents-session-section">
      <h2>📊 当前系统</h2>
      <div class="agents-m270-globals">
        <span>总 sessions: <strong>{totalSessions}</strong></span>
        <span>总 rounds: <strong>{totalRounds.toLocaleString()}</strong></span>
        <span>总 tokens: <strong>{fmtTok(totalTokens)}</strong></span>
        <span>总 cost: <strong>${totalCost.toFixed(2)}</strong></span>
        <span>总 actions: <strong>{totalActions.toLocaleString()}</strong></span>
        <span>总 syntheses: <strong>{totalSyns}</strong></span>
        <span>avg score: <strong>{avgScore.toFixed(2)}</strong></span>
        <span>unique actions: <strong>{actionSet.size}</strong></span>
        <span>unique personas: <strong>{personaSet.size}</strong></span>
        <span>7d tokens: <strong>{fmtTok(recentTokens)}</strong></span>
      </div>
    </section>

    <section class="agents-session-section">
      <h2>🎉 里程碑路线</h2>
      <ul>
        <li>✅ 100 — Centenary</li>
        <li>✅ 200 — Bicentenary</li>
        <li>✅ 250 — Quarter-K</li>
        <li>🎯 270 — Triple Century(本次)</li>
        <li>🚀 300 — Triple Century Round(下一整数)</li>
      </ul>
    </section>

    <section class="agents-session-section">
      <h2>💰 成本估算</h2>
      <p>按当前 avg weekly ${(totalCost / Math.max(1, totalSessions) * 30).toFixed(2)} 估算。</p>
      <p class="muted" style="font-size:0.85em">注:简单估算,实际取决于使用模式</p>
    </section>

    <section class="agents-session-section">
      <h2>🔗 推荐入口</h2>
      <ul>
        <li><a href={`${base}/agents/system-maturity/`}>System Maturity</a> — 综合健康度</li>
        <li><a href={`${base}/agents/hall-of-fame/`}>Hall of Fame</a> — 最成功 sessions</li>
        <li><a href={`${base}/agents/cost-cumulative-curve/`}>Cost Curve</a> — 累计支出</li>
        <li><a href={`${base}/agents/score-week-heatmap/`}>Score Week Heatmap</a> — 周级 score 热图</li>
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .milestone-special {
    background: linear-gradient(135deg, rgba(245, 158, 11, 0.06), rgba(99, 102, 241, 0.06));
    padding-bottom: 3rem;
  }
  .milestone-hero {
    text-align: center;
    padding: 1.5rem 0;
  }
  .agents-m270-globals {
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
  }
  .agents-m270-globals strong {
    color: #4f46e5;
    font-family: ui-monospace, monospace;
    margin: 0 0.3rem;
  }
</style>