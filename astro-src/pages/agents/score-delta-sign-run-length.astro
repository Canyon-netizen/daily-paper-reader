---
// /agents/score-delta-sign-run-length.astro — iter #388:longest sign-run of score deltas per session

import { readFile, readdir } from 'node:fs/promises';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import '../../styles/agents.css';

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');

interface SessRun {
  sid: string;
  goal: string;
  longestPosRun: number;
  longestNegRun: number;
  totalPos: number;
  totalNeg: number;
  totalRounds: number;
}

const root = join(process.cwd(), 'archive');
const sessions: SessRun[] = [];

if (existsSync(root)) {
  const sids = await readdir(root).catch(() => []);
  for (const sid of sids) {
    const rd = join(root, sid, 'rounds');
    if (!existsSync(rd)) continue;
    const rfs = await readdir(rd).catch(() => []);
    const rNums: number[] = [];
    for (const rf of rfs) {
      const m = rf.match(/^round_(\d+)\.json$/);
      if (m) rNums.push(parseInt(m[1], 10));
    }
    if (rNums.length < 4) continue;
    rNums.sort((a, b) => a - b);

    const scores: number[] = [];
    for (const rn of rNums) {
      try {
        const r = JSON.parse(await readFile(join(rd, `round_${rn}.json`), 'utf8'));
        const arr: number[] = [];
        for (const persona of r.feedback?.personas ?? []) {
          for (const p of persona.proposals ?? []) {
            if (typeof p.total === 'number') arr.push(p.total);
          }
        }
        scores.push(arr.length > 0 ? arr.reduce((a, b) => a + b, 0) / arr.length : 0);
      } catch (e) { scores.push(0); }
    }
    if (scores.length < 4) continue;

    const deltas: number[] = [];
    for (let i = 1; i < scores.length; i++) deltas.push(scores[i] - scores[i - 1]);

    let longestPos = 0;
    let longestNeg = 0;
    let curPos = 0;
    let curNeg = 0;
    let totalPos = 0;
    let totalNeg = 0;
    for (const d of deltas) {
      if (d > 0) {
        curPos += 1;
        curNeg = 0;
        longestPos = Math.max(longestPos, curPos);
        totalPos += 1;
      } else if (d < 0) {
        curNeg += 1;
        curPos = 0;
        longestNeg = Math.max(longestNeg, curNeg);
        totalNeg += 1;
      } else {
        curPos = 0;
        curNeg = 0;
      }
    }

    let goal = '';
    const mp = join(root, sid, 'meta.json');
    if (existsSync(mp)) {
      try { goal = JSON.parse(await readFile(mp, 'utf8')).goal ?? ''; } catch (e) { /* */ }
    }
    sessions.push({
      sid, goal,
      longestPosRun: longestPos,
      longestNegRun: longestNeg,
      totalPos,
      totalNeg,
      totalRounds: rNums.length,
    });
  }
}

sessions.sort((a, b) => b.longestPosRun - a.longestPosRun);

const total = sessions.length;
const avgLongestPos = sessions.length > 0 ? sessions.reduce((s, x) => s + x.longestPosRun, 0) / sessions.length : 0;
const avgLongestNeg = sessions.length > 0 ? sessions.reduce((s, x) => s + x.longestNegRun, 0) / sessions.length : 0;
const maxLongestPos = sessions.length > 0 ? Math.max(...sessions.map((s) => s.longestPosRun)) : 0;
const maxLongestNeg = sessions.length > 0 ? Math.max(...sessions.map((s) => s.longestNegRun)) : 0;

function esc(s: any): string {
  const str = String(s == null ? '' : s);
  return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}
---

<BaseLayout title="Score Delta Sign Run Length · Agents">
  <Navbar />
  <main class="shell agents-shell">
    <nav class="agents-breadcrumb">
      <a href={`${base}/agents/`}>← 多智能体控制台</a>
      <span class="muted"> / score-delta-sign-run-length</span>
    </nav>

    <header class="agents-header">
      <h1>🔥 Score Delta Sign Run Length <span class="muted" style="font-size:0.6em">(iter #388)</span></h1>
      <p class="agents-sub">
        每 session 中 score delta 的最长连续正/负 run。
        正 run = 系统连续多轮都在变好;负 run = 连续多轮在变差。
      </p>
    </header>

    <section class="agents-session-section">
      <h2>📊 全局</h2>
      <div class="agents-sdsrl-globals">
        <span>sessions: <strong>{total}</strong></span>
        <span>avg longest pos run: <strong style="color:#10b981">{avgLongestPos.toFixed(1)}</strong></span>
        <span>avg longest neg run: <strong style="color:#ef4444">{avgLongestNeg.toFixed(1)}</strong></span>
        <span>max pos run: <strong style="color:#10b981">{maxLongestPos}</strong></span>
        <span>max neg run: <strong style="color:#ef4444">{maxLongestNeg}</strong></span>
      </div>
    </section>

    <section class="agents-session-section">
      <h2>🔥 Top 15 longest positive runs</h2>
      <table class="agents-session-table">
        <thead>
          <tr><th>sid</th><th>longest pos</th><th>longest neg</th><th>total pos</th><th>total neg</th><th>rounds</th><th>goal</th></tr>
        </thead>
        <tbody>
          {sessions.slice(0, 15).map((s) => (
            <tr>
              <td><a href={`${base}/agents/${s.sid}/`}><code>{esc(s.sid.slice(0, 8))}</code></a></td>
              <td><strong style="color:#10b981">{s.longestPosRun}</strong></td>
              <td style="color:#ef4444">{s.longestNegRun}</td>
              <td>{s.totalPos}</td>
              <td>{s.totalNeg}</td>
              <td>{s.totalRounds}</td>
              <td><small class="muted">{esc(s.goal.slice(0, 14))}{s.goal.length > 14 ? '…' : ''}</small></td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="agents-session-section">
      <h2>💀 Top 15 longest negative runs</h2>
      <table class="agents-session-table">
        <thead>
          <tr><th>sid</th><th>longest neg</th><th>longest pos</th><th>rounds</th><th>goal</th></tr>
        </thead>
        <tbody>
          {sessions.slice().sort((a, b) => b.longestNegRun - a.longestNegRun).slice(0, 15).map((s) => (
            <tr>
              <td><a href={`${base}/agents/${s.sid}/`}><code>{esc(s.sid.slice(0, 8))}</code></a></td>
              <td><strong style="color:#ef4444">{s.longestNegRun}</strong></td>
              <td style="color:#10b981">{s.longestPosRun}</td>
              <td>{s.totalRounds}</td>
              <td><small class="muted">{esc(s.goal.slice(0, 14))}{s.goal.length > 14 ? '…' : ''}</small></td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="agents-session-section">
      <h2>💡 解读</h2>
      <ul>
        <li>longest pos ≥ 3 = 该 session 出现连续 3 轮以上变好</li>
        <li>longest neg ≥ 3 = 该 session 出现连续 3 轮以上变差(系统可能陷入负反馈)</li>
        <li>对照 <a href={`${base}/agents/round-improvement-statistics/`}>Round Improvement Statistics</a></li>
        <li>对照 <a href={`${base}/agents/score-recovery-rate/`}>Score Recovery Rate</a></li>
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .agents-sdsrl-globals {
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
  }
  .agents-sdsrl-globals strong {
    color: #4f46e5;
    font-family: ui-monospace, monospace;
    margin: 0 0 0 0.3rem;
  }
</style>