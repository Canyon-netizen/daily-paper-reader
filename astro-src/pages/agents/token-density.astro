---
// /agents/token-density.astro — iter #277:token density per session
//
// 每个 session 的 token 密度 = total tokens / goal length(chars)
// 高密度 = 用了大量 token 但 goal 简短(可能过度投入)
// 低密度 = 高效

import { readFile, readdir } from 'node:fs/promises';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import '../../styles/agents.css';

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');

const SONNET_PRICE = 6;

interface Density {
  sid: string;
  goal: string;
  goalLen: number;
  tokens: number;
  density: number;
  rounds: number;
  finalScore: number;
  gain: number;
}

const root = join(process.cwd(), 'archive');
const densities: Density[] = [];

if (existsSync(root)) {
  const sids = await readdir(root).catch(() => []);
  for (const sid of sids) {
    const sp = join(root, sid);
    if (!existsSync(sp)) continue;
    let goal = '';
    const mp = join(sp, 'meta.json');
    if (existsSync(mp)) {
      try { goal = JSON.parse(await readFile(mp, 'utf8')).goal ?? ''; } catch (e) { /* */ }
    }
    const rd = join(sp, 'rounds');
    if (!existsSync(rd)) continue;
    const rfs = await readdir(rd).catch(() => []);
    const rNum: number[] = [];
    for (const rf of rfs) {
      const m = rf.match(/^round_(\d+)\.json$/);
      if (m) rNum.push(parseInt(m[1], 10));
    }
    if (rNum.length < 2) continue;
    rNum.sort((a, b) => a - b);
    let firstScore = 0;
    let finalScore = 0;
    let tokens = 0;
    for (let i = 0; i < rNum.length; i++) {
      try {
        const r = JSON.parse(await readFile(join(rd, `round_${rNum[i]}.json`), 'utf8'));
        const arr: number[] = [];
        for (const persona of r.feedback?.personas ?? []) {
          for (const p of persona.proposals ?? []) {
            if (typeof p.total === 'number') arr.push(p.total);
          }
        }
        tokens += r.feedback?.total_tokens ?? 0;
        if (arr.length > 0) {
          const avg = arr.reduce((a, b) => a + b, 0) / arr.length;
          if (i === 0) firstScore = avg;
          if (i === rNum.length - 1) finalScore = avg;
        }
      } catch (e) { /* */ }
    }
    if (goal.length >= 5 && tokens > 0) {
      densities.push({
        sid, goal, goalLen: goal.length, tokens,
        density: tokens / goal.length,
        rounds: rNum.length,
        finalScore,
        gain: finalScore - firstScore,
      });
    }
  }
}

const total = densities.length;
const avgDensity = total > 0 ? densities.reduce((s, d) => s + d.density, 0) / total : 0;
const sortedByDensity = [...densities].sort((a, b) => b.density - a.density);
const top10High = sortedByDensity.slice(0, 10);
const top10Low = sortedByDensity.slice(-10).reverse();

// 按 density 分桶
const buckets = [
  { label: '< 1K/char', min: 0, max: 1000, count: 0 },
  { label: '1K-5K/char', min: 1000, max: 5000, count: 0 },
  { label: '5K-20K/char', min: 5000, max: 20000, count: 0 },
  { label: '20K-100K/char', min: 20000, max: 100000, count: 0 },
  { label: '> 100K/char', min: 100000, max: 999999999, count: 0 },
];
for (const d of densities) {
  for (const b of buckets) {
    if (d.density >= b.min && d.density < b.max) {
      b.count += 1;
      break;
    }
  }
}

function esc(s: any): string {
  const str = String(s == null ? '' : s);
  return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}
function fmtTok(t: number): string {
  if (t > 1_000_000) return `${(t / 1_000_000).toFixed(1)}M`;
  if (t > 1_000) return `${(t / 1_000).toFixed(0)}K`;
  return `${t.toFixed(0)}`;
}
function bar(n: number, max: number, width = 18): string {
  if (!max) return '░'.repeat(width);
  const filled = Math.round((n / max) * width);
  return '█'.repeat(filled) + '░'.repeat(width - filled);
}
---

<BaseLayout title="Token Density · Agents">
  <Navbar />
  <main class="shell agents-shell">
    <nav class="agents-breadcrumb">
      <a href={`${base}/agents/`}>← 多智能体控制台</a>
      <span class="muted"> / token-density</span>
    </nav>

    <header class="agents-header">
      <h1>📐 Token Density <span class="muted" style="font-size:0.6em">(iter #277)</span></h1>
      <p class="agents-sub">
        每 session 的 token 密度 = total tokens / goal 字符数。
        越高 = 每字符 goal 投入越多 token。
      </p>
    </header>

    <section class="agents-session-section">
      <h2>📊 全局</h2>
      <div class="agents-td-globals">
        <span>总 sessions: <strong>{total}</strong></span>
        <span>avg density: <strong>{fmtTok(avgDensity)} / char</strong></span>
      </div>
    </section>

    <section class="agents-session-section">
      <h2>📊 density 分桶</h2>
      <pre class="agents-td-flow">{buckets.map((b) => {
        const max = Math.max(...buckets.map((x) => x.count), 1);
        return `${b.label.padEnd(15)} ${bar(b.count, max, 22)}  ${b.count}`;
      }).join('\n')}</pre>
    </section>

    <section class="agents-session-section">
      <h2>📈 top 10 最高密度 sessions</h2>
      <table class="agents-session-table">
        <thead>
          <tr><th>density</th><th>tokens</th><th>goal len</th><th>final</th><th>goal</th><th>sid</th></tr>
        </thead>
        <tbody>
          {top10High.map((d) => (
            <tr>
              <td><strong style="color:#f59e0b">{fmtTok(d.density)}/c</strong></td>
              <td>{fmtTok(d.tokens)}</td>
              <td>{d.goalLen}</td>
              <td>{d.finalScore.toFixed(2)}</td>
              <td><small class="muted">{esc(d.goal.slice(0, 25))}{(d.goal ?? '').length > 25 ? '…' : ''}</small></td>
              <td><a href={`${base}/agents/${d.sid}/`}><code>{esc(d.sid.slice(0, 10))}</code></a></td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="agents-session-section">
      <h2>📉 top 10 最低密度 sessions</h2>
      <table class="agents-session-table">
        <thead>
          <tr><th>density</th><th>tokens</th><th>goal len</th><th>final</th><th>goal</th><th>sid</th></tr>
        </thead>
        <tbody>
          {top10Low.map((d) => (
            <tr>
              <td><strong style="color:#10b981">{fmtTok(d.density)}/c</strong></td>
              <td>{fmtTok(d.tokens)}</td>
              <td>{d.goalLen}</td>
              <td>{d.finalScore.toFixed(2)}</td>
              <td><small class="muted">{esc(d.goal.slice(0, 25))}{(d.goal ?? '').length > 25 ? '…' : ''}</small></td>
              <td><a href={`${base}/agents/${d.sid}/`}><code>{esc(d.sid.slice(0, 10))}</code></a></td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="agents-session-section">
      <h2>💡 解读</h2>
      <ul>
        <li>高 density = 高投入低产出(可能 goal 太抽象需要更多探索)</li>
        <li>低 density = 高效(session 顺利完成)</li>
        <li>对照 <a href={`${base}/agents/token-score-scatter/`}>Token×Score</a> 看绝对量</li>
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .agents-td-globals {
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
  }
  .agents-td-globals strong {
    color: #4f46e5;
    font-family: ui-monospace, monospace;
    margin: 0 0.3rem;
  }
  .agents-td-flow {
    background: rgba(0,0,0,0.4);
    color: #c9d1d9;
    padding: 0.8rem;
    border-radius: 4px;
    font-family: ui-monospace, "JetBrains Mono", monospace;
    font-size: 0.78rem;
    line-height: 1.4;
    overflow-x: auto;
    white-space: pre;
  }
</style>