---
// /agents/action-diversity-sessions.astro — iter #338:action diversity across sessions
//
// 横向:每 action 被多少 session 使用 (action 普及度)
// 纵向:每 session 用多少 unique actions

import { readFile, readdir } from 'node:fs/promises';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import '../../styles/agents.css';

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');

interface SessActs { sid: string; goal: string; actions: Set<string>; totalActions: number; }

const root = join(process.cwd(), 'archive');
const sessions: SessActs[] = [];

if (existsSync(root)) {
  const sids = await readdir(root).catch(() => []);
  for (const sid of sids) {
    const rd = join(root, sid, 'rounds');
    if (!existsSync(rd)) continue;
    const rfs = await readdir(rd).catch(() => []);
    const rNums: number[] = [];
    for (const rf of rfs) {
      const m = rf.match(/^round_(\d+)\.json$/);
      if (m) rNums.push(parseInt(m[1], 10));
    }
    if (rNums.length < 1) continue;
    rNums.sort((a, b) => a - b);

    const actions = new Set<string>();
    let totalActions = 0;
    for (const rn of rNums) {
      try {
        const r = JSON.parse(await readFile(join(rd, `round_${rn}.json`), 'utf8'));
        for (const a of (r.modifier?.applied ?? [])) {
          const act = a.action ?? a.type ?? 'unknown';
          actions.add(act);
          totalActions += 1;
        }
      } catch (e) { /* */ }
    }
    if (actions.size === 0) continue;

    let goal = '';
    const mp = join(root, sid, 'meta.json');
    if (existsSync(mp)) {
      try { goal = JSON.parse(await readFile(mp, 'utf8')).goal ?? ''; } catch (e) { /* */ }
    }
    sessions.push({ sid, goal, actions, totalActions });
  }
}

// Action → session count
const actionSessions = new Map<string, number>();
for (const s of sessions) {
  for (const a of s.actions) {
    actionSessions.set(a, (actionSessions.get(a) ?? 0) + 1);
  }
}
const totalSessions = sessions.length;
const actionArr = [...actionSessions.entries()]
  .map(([action, count]) => ({ action, count, pct: count / totalSessions }))
  .sort((a, b) => b.count - a.count);

// Per session unique action count distribution
const uniqCounts = sessions.map((s) => s.actions.size).sort((a, b) => a - b);
const avgUnique = uniqCounts.reduce((s, v) => s + v, 0) / Math.max(1, uniqCounts.length);
const medianUnique = uniqCounts.length > 0 ? uniqCounts[Math.floor(uniqCounts.length / 2)] : 0;

const uniqBuckets = [
  { label: '1', min: 1, max: 2, count: 0 },
  { label: '2', min: 2, max: 3, count: 0 },
  { label: '3', min: 3, max: 4, count: 0 },
  { label: '4', min: 4, max: 5, count: 0 },
  { label: '5', min: 5, max: 6, count: 0 },
  { label: '6+', min: 6, max: Infinity, count: 0 },
];
for (const u of uniqCounts) {
  for (const b of uniqBuckets) {
    if (u >= b.min && u < b.max) { b.count += 1; break; }
  }
}

// Coverage buckets
const coverageBuckets = [
  { label: 'niche (<10%)', min: 0, max: 0.10, count: 0 },
  { label: 'moderate (10-30%)', min: 0.10, max: 0.30, count: 0 },
  { label: 'common (30-50%)', min: 0.30, max: 0.50, count: 0 },
  { label: 'popular (50-75%)', min: 0.50, max: 0.75, count: 0 },
  { label: 'ubiquitous (75%+)', min: 0.75, max: 1.01, count: 0 },
];
for (const a of actionArr) {
  for (const b of coverageBuckets) {
    if (a.pct >= b.min && a.pct < b.max) { b.count += 1; break; }
  }
}

function bar(n: number, max: number, width = 22): string {
  if (!max) return '░'.repeat(width);
  const filled = Math.round((n / max) * width);
  return '█'.repeat(filled) + '░'.repeat(width - filled);
}

function esc(s: any): string {
  const str = String(s == null ? '' : s);
  return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}
---

<BaseLayout title="Action Diversity Across Sessions · Agents">
  <Navbar />
  <main class="shell agents-shell">
    <nav class="agents-breadcrumb">
      <a href={`${base}/agents/`}>← 多智能体控制台</a>
      <span class="muted"> / action-diversity-sessions</span>
    </nav>

    <header class="agents-header">
      <h1>🌐 Action Diversity Across Sessions <span class="muted" style="font-size:0.6em">(iter #338)</span></h1>
      <p class="agents-sub">
        横向:每个 action 被多少 session 用过(普及度);
        纵向:每个 session 用多少 unique action(宽度)。
      </p>
    </header>

    <section class="agents-session-section">
      <h2>📊 全局</h2>
      <div class="agents-ads-globals">
        <span>sessions: <strong>{totalSessions}</strong></span>
        <span>distinct actions: <strong>{actionArr.length}</strong></span>
        <span>avg unique per session: <strong>{avgUnique.toFixed(2)}</strong></span>
        <span>median unique: <strong>{medianUnique}</strong></span>
      </div>
    </section>

    <section class="agents-session-section">
      <h2>📊 Action 普及度(横向)</h2>
      <pre class="agents-ads-flow">{actionArr.slice(0, 20).map((a) => {
        return `${a.action.padEnd(24)} ${bar(a.count, Math.max(...actionArr.map((x) => x.count), 1), 22)}  ${a.count}/${totalSessions}  (${(a.pct * 100).toFixed(1)}%)`;
      }).join('\n')}</pre>
    </section>

    <section class="agents-session-section">
      <h2>📊 Coverage 分布</h2>
      <pre class="agents-ads-flow">{coverageBuckets.map((b) => {
        return `${b.label.padEnd(28)} ${bar(b.count, Math.max(...coverageBuckets.map((x) => x.count), 1), 18)}  ${b.count}`;
      }).join('\n')}</pre>
    </section>

    <section class="agents-session-section">
      <h2>📊 Per-session unique count 分布</h2>
      <pre class="agents-ads-flow">{uniqBuckets.map((b) => {
        return `${b.label.padEnd(8)} ${bar(b.count, Math.max(...uniqBuckets.map((x) => x.count), 1), 22)}  ${b.count}`;
      }).join('\n')}</pre>
    </section>

    <section class="agents-session-section">
      <h2>💡 解读</h2>
      <ul>
        <li>ubiquitous actions = 系统高度依赖的核心 action</li>
        <li>niche actions = 偶尔才用的长尾 action</li>
        <li>per-session unique 高 = 每 session 灵活组合</li>
        <li>对照 <a href={`${base}/agents/action-distribution-entropy/`}>Action Distribution Entropy</a></li>
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .agents-ads-globals {
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
  }
  .agents-ads-globals strong {
    color: #4f46e5;
    font-family: ui-monospace, monospace;
    margin: 0 0.3rem;
  }
  .agents-ads-flow {
    background: rgba(0,0,0,0.4);
    color: #c9d1d9;
    padding: 0.8rem;
    border-radius: 4px;
    font-family: ui-monospace, "JetBrains Mono", monospace;
    font-size: 0.78rem;
    line-height: 1.4;
    overflow-x: auto;
    white-space: pre;
  }
</style>