---
// /agents/round-throughput.astro — iter #219:round throughput time series
//
// 按日期统计 rounds 数量,形成 throughput 时间序列:
//   - 每日 rounds 数
//   - 7 日滚动平均
//   - peak 日 / 平均日

import { readFile, readdir, stat } from 'node:fs/promises';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import '../../styles/agents.css';

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');

interface DayBucket {
  date: string;
  count: number;
}

const root = join(process.cwd(), 'archive');
const dayMap = new Map<string, number>();
let totalRounds = 0;
let firstDay = '';
let lastDay = '';

if (existsSync(root)) {
  const sids = await readdir(root).catch(() => []);
  for (const sid of sids) {
    const rd = join(root, sid, 'rounds');
    if (!existsSync(rd)) continue;
    const rfs = await readdir(rd).catch(() => []);
    for (const rf of rfs) {
      if (!/^round_\d+\.json$/.test(rf)) continue;
      try {
        const st = await stat(join(rd, rf));
        const dateStr = new Date(st.mtimeMs).toISOString().slice(0, 10);
        dayMap.set(dateStr, (dayMap.get(dateStr) ?? 0) + 1);
        totalRounds += 1;
        if (!firstDay || dateStr < firstDay) firstDay = dateStr;
        if (!lastDay || dateStr > lastDay) lastDay = dateStr;
      } catch (e) { /* */ }
    }
  }
}

// expand all days from first to last
const days: DayBucket[] = [];
if (firstDay && lastDay) {
  const start = new Date(firstDay + 'T00:00:00Z').getTime();
  const end = new Date(lastDay + 'T00:00:00Z').getTime();
  for (let t = start; t <= end; t += 24 * 60 * 60 * 1000) {
    const d = new Date(t).toISOString().slice(0, 10);
    days.push({ date: d, count: dayMap.get(d) ?? 0 });
  }
}

const activeDays = days.filter((d) => d.count > 0).length;
const avgPerActiveDay = activeDays > 0 ? totalRounds / activeDays : 0;
const avgPerAllDays = days.length > 0 ? totalRounds / days.length : 0;
const maxDay = days.reduce((m, d) => (d.count > m.count ? d : m), { date: '', count: 0 });

// 7-day rolling avg
const rolling: { date: string; avg: number }[] = [];
for (let i = 0; i < days.length; i++) {
  const window = days.slice(Math.max(0, i - 6), i + 1);
  const sum = window.reduce((s, d) => s + d.count, 0);
  rolling.push({ date: days[i].date, avg: sum / window.length });
}

// sparkline
function sparkline(values: number[], width = 50): string {
  if (values.length === 0) return '';
  const chars = [' ', '░', '▒', '▓', '█'];
  const max = Math.max(...values, 1);
  // downsample to width
  const step = Math.max(1, Math.floor(values.length / width));
  const sampled: number[] = [];
  for (let i = 0; i < values.length; i += step) sampled.push(values[i]);
  return sampled.map((v) => {
    const idx = Math.min(chars.length - 1, Math.floor((v / max) * chars.length));
    return chars[idx];
  }).join('');
}

function bar(n: number, max: number, width = 20): string {
  if (!max) return '░'.repeat(width);
  const filled = Math.round((n / max) * width);
  return '█'.repeat(filled) + '░'.repeat(width - filled);
}
---

<BaseLayout title="Round Throughput · Agents">
  <Navbar />
  <main class="shell agents-shell">
    <nav class="agents-breadcrumb">
      <a href={`${base}/agents/`}>← 多智能体控制台</a>
      <span class="muted"> / round-throughput</span>
    </nav>

    <header class="agents-header">
      <h1>📈 Round Throughput <span class="muted" style="font-size:0.6em">(iter #219)</span></h1>
      <p class="agents-sub">
        按日期统计 rounds 数 + 7 日滚动平均。
        看 throughput 时间序列与峰值。
      </p>
    </header>

    <section class="agents-session-section">
      <h2>📊 全局</h2>
      <div class="agents-rt-globals">
        <span>总 rounds: <strong>{totalRounds}</strong></span>
        <span>总天数: <strong>{days.length}</strong></span>
        <span>活跃日: <strong>{activeDays}</strong></span>
        <span>avg / active day: <strong>{avgPerActiveDay.toFixed(2)}</strong></span>
        <span>peak: <strong>{maxDay.date} ({maxDay.count})</strong></span>
      </div>
    </section>

    <section class="agents-session-section">
      <h2>📈 sparkline(rounds/day)</h2>
      <pre class="agents-rt-flow">{sparkline(days.map((d) => d.count))}</pre>
      <p class="muted"><small>{days[0]?.date} → {days[days.length - 1]?.date} ({days.length} days)</small></p>
    </section>

    <section class="agents-session-section">
      <h2>📊 最近 30 天</h2>
      <pre class="agents-rt-flow">{days.slice(-30).map((d) => {
        const max = Math.max(...days.map((x) => x.count), 1);
        return `${d.date} ${bar(d.count, max, 16)}  ${d.count}`;
      }).join('\n')}</pre>
    </section>

    <section class="agents-session-section">
      <h2>📈 7 日滚动平均</h2>
      <pre class="agents-rt-flow">{rolling.slice(-30).map((r) => {
        return `${r.date} ${bar(r.avg, Math.max(...rolling.map((x) => x.avg), 1), 16)}  ${r.avg.toFixed(2)}`;
      }).join('\n')}</pre>
    </section>

    <section class="agents-session-section">
      <h2>💡 解读</h2>
      <ul>
        <li>rolling avg 平稳 = throughput 稳定</li>
        <li>rolling avg 上升 = 加速期</li>
        <li>peak day = 历史上最忙一天</li>
        <li>对照 <a href={`${base}/agents/daily-burn/`}>Daily Burn</a> 看 token throughput</li>
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .agents-rt-globals {
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
  }
  .agents-rt-globals strong {
    color: #4f46e5;
    font-family: ui-monospace, monospace;
    margin: 0 0.3rem;
  }
  .agents-rt-flow {
    background: rgba(0,0,0,0.4);
    color: #c9d1d9;
    padding: 0.8rem;
    border-radius: 4px;
    font-family: ui-monospace, "JetBrains Mono", monospace;
    font-size: 0.78rem;
    line-height: 1.4;
    overflow-x: auto;
    white-space: pre;
  }
</style>