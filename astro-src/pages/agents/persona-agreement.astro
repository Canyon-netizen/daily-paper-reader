---
// /agents/persona-agreement.astro — iter #309:persona pair agreement
//
// 各 persona 对之间的"评分一致性"(在同 session/round 中):
//   - 收集所有 rounds 里所有 persona × persona 的 score diff
//   - 计算 avg abs diff
//   - 低 diff = 高一致

import { readFile, readdir } from 'node:fs/promises';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import '../../styles/agents.css';

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');

const AGREEMENT_THRESHOLD = 1.0;  // |a-b| < 1 算 agree

const root = join(process.cwd(), 'archive');
const allPersonas = new Set<string>();
const pairDiffs = new Map<string, number[]>();   // "a||b" → [diff, diff, ...]

if (existsSync(root)) {
  const sids = await readdir(root).catch(() => []);
  for (const sid of sids) {
    const rd = join(root, sid, 'rounds');
    if (!existsSync(rd)) continue;
    const rfs = await readdir(rd).catch(() => []);
    for (const rf of rfs) {
      if (!/^round_\d+\.json$/.test(rf)) continue;
      try {
        const r = JSON.parse(await readFile(join(rd, rf), 'utf8'));
        // 对每个 round,收集 (persona, avg_score)
        const scores: { name: string; score: number }[] = [];
        for (const persona of r.feedback?.personas ?? []) {
          const name = persona.persona ?? persona.name ?? persona.role ?? 'unknown';
          const arr: number[] = [];
          for (const p of persona.proposals ?? []) {
            if (typeof p.total === 'number') arr.push(p.total);
          }
          if (arr.length > 0) {
            scores.push({ name, score: arr.reduce((a, b) => a + b, 0) / arr.length });
          }
        }
        for (const s of scores) allPersonas.add(s.name);
        for (let i = 0; i < scores.length; i++) {
          for (let j = i + 1; j < scores.length; j++) {
            const a = scores[i], b = scores[j];
            const key = [a.name, b.name].sort().join('||');
            const diff = Math.abs(a.score - b.score);
            if (!pairDiffs.has(key)) pairDiffs.set(key, []);
            pairDiffs.get(key)!.push(diff);
          }
        }
      } catch (e) { /* */ }
    }
  }
}

const personas = [...allPersonas].sort();
const pairStats: { a: string; b: string; n: number; avgDiff: number; agreement: number }[] = [];
for (const [key, diffs] of pairDiffs.entries()) {
  const [a, b] = key.split('||');
  const avgDiff = diffs.reduce((s, x) => s + x, 0) / diffs.length;
  const agreement = diffs.filter((d) => d < AGREEMENT_THRESHOLD).length / diffs.length;
  pairStats.push({ a, b, n: diffs.length, avgDiff, agreement });
}
pairStats.sort((x, y) => x.avgDiff - y.avgDiff);

const totalPairs = pairStats.length;
const highlyAgree = pairStats.filter((p) => p.avgDiff < 0.5).length;

function esc(s: any): string {
  const str = String(s == null ? '' : s);
  return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}
---

<BaseLayout title="Persona Agreement · Agents">
  <Navbar />
  <main class="shell agents-shell">
    <nav class="agents-breadcrumb">
      <a href={`${base}/agents/`}>← 多智能体控制台</a>
      <span class="muted"> / persona-agreement</span>
    </nav>

    <header class="agents-header">
      <h1>🤝 Persona Agreement <span class="muted" style="font-size:0.6em">(iter #309)</span></h1>
      <p class="agents-sub">
        各 persona 对之间的评分一致性。|diff| &lt; {AGREEMENT_THRESHOLD} 视为同意。
      </p>
    </header>

    <section class="agents-session-section">
      <h2>📊 全局</h2>
      <div class="agents-pa-globals">
        <span>personas: <strong>{personas.length}</strong></span>
        <span>pairs: <strong>{totalPairs}</strong></span>
        <span>高度一致 (avg diff &lt; 0.5): <strong style="color:#10b981">{highlyAgree}</strong></span>
      </div>
    </section>

    <section class="agents-session-section">
      <h2>🤝 最一致 Top 10</h2>
      <table class="agents-session-table">
        <thead>
          <tr><th>#</th><th>persona A</th><th>persona B</th><th>n</th><th>avg diff</th><th>agreement %</th></tr>
        </thead>
        <tbody>
          {pairStats.slice(0, 10).map((p, i) => (
            <tr>
              <td>{i + 1}</td>
              <td><strong style="color:#4f46e5">{esc(p.a)}</strong></td>
              <td><strong style="color:#4f46e5">{esc(p.b)}</strong></td>
              <td>{p.n}</td>
              <td><strong style="color:#10b981">{p.avgDiff.toFixed(2)}</strong></td>
              <td>{(p.agreement * 100).toFixed(0)}%</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="agents-session-section">
      <h2>⚡ 最不一致 Top 10</h2>
      <table class="agents-session-table">
        <thead>
          <tr><th>#</th><th>persona A</th><th>persona B</th><th>n</th><th>avg diff</th><th>agreement %</th></tr>
        </thead>
        <tbody>
          {pairStats.slice().sort((a, b) => b.avgDiff - a.avgDiff).slice(0, 10).map((p, i) => (
            <tr>
              <td>{i + 1}</td>
              <td><strong style="color:#4f46e5">{esc(p.a)}</strong></td>
              <td><strong style="color:#4f46e5">{esc(p.b)}</strong></td>
              <td>{p.n}</td>
              <td><strong style="color:#ef4444">{p.avgDiff.toFixed(2)}</strong></td>
              <td>{(p.agreement * 100).toFixed(0)}%</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="agents-session-section">
      <h2>💡 解读</h2>
      <ul>
        <li>avg diff &lt; 0.5 = 强一致</li>
        <li>avg diff &gt; 2 = 经常分歧</li>
        <li>高 agreement 多的 sessions = 反馈稳定</li>
        <li>对照 <a href={`${base}/agents/persona-score-bias/`}>Persona Score Bias</a></li>
        <li>对照 <a href={`${base}/agents/persona-pair-corr/`}>Persona Pair Corr</a></li>
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .agents-pa-globals {
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
  }
  .agents-pa-globals strong {
    color: #4f46e5;
    font-family: ui-monospace, monospace;
    margin: 0 0.3rem;
  }
</style>