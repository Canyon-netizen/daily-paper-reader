---
// /agents/designer-output-confidence.astro — iter #365:designer self-reported confidence per round

import { readFile, readdir } from 'node:fs/promises';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import '../../styles/agents.css';

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');

interface SessConf {
  sid: string;
  goal: string;
  confidences: number[];
  gains: number[];
  scores: number[];
  avgConf: number;
  corrConfGain: number;
}

function getConfidence(r: any): number | null {
  if (typeof r.designer?.confidence === 'number') return r.designer.confidence;
  if (typeof r.design?.confidence === 'number') return r.design.confidence;
  if (typeof r.designer?.self_score === 'number') return r.designer.self_score;
  if (typeof r.designer?.confidence_score === 'number') return r.designer.confidence_score;
  return null;
}

const root = join(process.cwd(), 'archive');
const sessions: SessConf[] = [];

if (existsSync(root)) {
  const sids = await readdir(root).catch(() => []);
  for (const sid of sids) {
    const rd = join(root, sid, 'rounds');
    if (!existsSync(rd)) continue;
    const rfs = await readdir(rd).catch(() => []);
    const rNums: number[] = [];
    for (const rf of rfs) {
      const m = rf.match(/^round_(\d+)\.json$/);
      if (m) rNums.push(parseInt(m[1], 10));
    }
    if (rNums.length < 2) continue;
    rNums.sort((a, b) => a - b);

    const confidences: number[] = [];
    const scores: number[] = [];
    for (const rn of rNums) {
      try {
        const r = JSON.parse(await readFile(join(rd, `round_${rn}.json`), 'utf8'));
        const conf = getConfidence(r);
        if (conf !== null) confidences.push(conf);
        const arr: number[] = [];
        for (const persona of r.feedback?.personas ?? []) {
          for (const p of persona.proposals ?? []) {
            if (typeof p.total === 'number') arr.push(p.total);
          }
        }
        if (arr.length > 0) scores.push(arr.reduce((a, b) => a + b, 0) / arr.length);
      } catch (e) { /* */ }
    }
    if (confidences.length < 3) continue;
    // Trim to common length
    const n = Math.min(confidences.length, scores.length);
    const cTrim = confidences.slice(0, n);
    const sTrim = scores.slice(0, n);
    const gains: number[] = [];
    for (let i = 1; i < sTrim.length; i++) gains.push(sTrim[i] - sTrim[i - 1]);
    const cTrimForGain = cTrim.slice(1);

    // Pearson(conf, gain)
    let corr = 0;
    if (cTrimForGain.length >= 3) {
      const x = cTrimForGain;
      const y = gains;
      const nx = x.length;
      const mx = x.reduce((s, v) => s + v, 0) / nx;
      const my = y.reduce((s, v) => s + v, 0) / nx;
      let sx = 0, sy = 0, sxy = 0;
      for (let i = 0; i < nx; i++) {
        const dx = x[i] - mx;
        const dy = y[i] - my;
        sx += dx * dx; sy += dy * dy; sxy += dx * dy;
      }
      const denom = Math.sqrt(sx * sy);
      corr = denom !== 0 ? sxy / denom : 0;
    }

    let goal = '';
    const mp = join(root, sid, 'meta.json');
    if (existsSync(mp)) {
      try { goal = JSON.parse(await readFile(mp, 'utf8')).goal ?? ''; } catch (e) { /* */ }
    }

    sessions.push({
      sid, goal,
      confidences: cTrim,
      gains,
      scores: sTrim,
      avgConf: cTrim.reduce((s, v) => s + v, 0) / cTrim.length,
      corrConfGain: corr,
    });
  }
}

sessions.sort((a, b) => b.corrConfGain - a.corrConfGain);

const total = sessions.length;
const avgCorr = sessions.length > 0 ? sessions.reduce((s, x) => s + x.corrConfGain, 0) / sessions.length : 0;
const goodCalibration = sessions.filter((s) => s.corrConfGain > 0.3).length;
const overconfident = sessions.filter((s) => s.corrConfGain < -0.3).length;

function bar(n: number, max: number, width = 18): string {
  if (!max) return '░'.repeat(width);
  const filled = Math.round((n / max) * width);
  return '█'.repeat(filled) + '░'.repeat(width - filled);
}

function esc(s: any): string {
  const str = String(s == null ? '' : s);
  return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}
---

<BaseLayout title="Designer Output Confidence · Agents">
  <Navbar />
  <main class="shell agents-shell">
    <nav class="agents-breadcrumb">
      <a href={`${base}/agents/`}>← 多智能体控制台</a>
      <span class="muted"> / designer-output-confidence</span>
    </nav>

    <header class="agents-header">
      <h1>🎯 Designer Output Confidence <span class="muted" style="font-size:0.6em">(iter #365)</span></h1>
      <p class="agents-sub">
        designer 自报 confidence × round gain 的 Pearson 相关系数。
        + = 高 confidence → 高 gain(校准好);− = 高 confidence → 低 gain(过度自信)。
      </p>
    </header>

    <section class="agents-session-section">
      <h2>📊 全局</h2>
      <div class="agents-doc-globals">
        <span>sessions w/ confidence: <strong>{total}</strong></span>
        <span>avg corr(conf, gain): <strong style={`color:${avgCorr >= 0.2 ? '#10b981' : avgCorr <= -0.2 ? '#ef4444' : '#94a3b8'}`}>{avgCorr.toFixed(3)}</strong></span>
        <span>good calibration (&gt;0.3): <strong style="color:#10b981">{goodCalibration}</strong></span>
        <span>overconfident (&lt;-0.3): <strong style="color:#ef4444">{overconfident}</strong></span>
      </div>
    </section>

    <section class="agents-session-section">
      <h2>🏆 Top 10 best-calibrated sessions</h2>
      <table class="agents-session-table">
        <thead>
          <tr><th>#</th><th>sid</th><th>corr(conf,gain)</th><th>avg conf</th><th>rounds</th><th>goal</th></tr>
        </thead>
        <tbody>
          {sessions.slice(0, 10).map((s, i) => (
            <tr>
              <td>{i + 1}</td>
              <td><a href={`${base}/agents/${s.sid}/`}><code>{esc(s.sid.slice(0, 10))}</code></a></td>
              <td><strong style="color:#10b981">{s.corrConfGain.toFixed(3)}</strong></td>
              <td>{s.avgConf.toFixed(2)}</td>
              <td>{s.confidences.length}</td>
              <td><small class="muted">{esc(s.goal.slice(0, 18))}{s.goal.length > 18 ? '…' : ''}</small></td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="agents-session-section">
      <h2>😬 Top 10 most-overconfident sessions</h2>
      <table class="agents-session-table">
        <thead>
          <tr><th>#</th><th>sid</th><th>corr(conf,gain)</th><th>avg conf</th><th>goal</th></tr>
        </thead>
        <tbody>
          {sessions.slice().reverse().slice(0, 10).map((s, i) => (
            <tr>
              <td>{i + 1}</td>
              <td><a href={`${base}/agents/${s.sid}/`}><code>{esc(s.sid.slice(0, 10))}</code></a></td>
              <td><strong style="color:#ef4444">{s.corrConfGain.toFixed(3)}</strong></td>
              <td>{s.avgConf.toFixed(2)}</td>
              <td><small class="muted">{esc(s.goal.slice(0, 18))}{s.goal.length > 18 ? '…' : ''}</small></td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="agents-session-section">
      <h2>💡 解读</h2>
      <ul>
        <li>corr &gt; 0.3 = designer 自评能预测实际效果(校准好)</li>
        <li>corr &lt; -0.3 = designer 高 confidence 反而低 gain(过度自信)</li>
        <li>corr ≈ 0 = designer 自评与实际无关</li>
        <li>对照 <a href={`${base}/agents/designer-revision-rate/`}>Designer Revision Rate</a></li>
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .agents-doc-globals {
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
  }
  .agents-doc-globals strong {
    color: #4f46e5;
    font-family: ui-monospace, monospace;
    margin: 0 0.3rem;
  }
</style>