---
// /agents/goal-quality.astro — iter #151:goal quality scorer
//
// 给定一个 goal 文本,基于历史 session 数据评分:
//   - 长度分:40-150 字最理想
//   - 多样性分:不重复太多词
//   - 历史命中:与高 avg_score 的 session 相似度高 = 好
//   - 关键词命中:有 "如何 / 为什么 / 比较" 等动作词加分

import { readFile, readdir } from 'node:fs/promises';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import '../../styles/agents.css';

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');

interface HistoricalSession { sid: string; goal: string; avgScore: number; tokens: number; }

// 计算每个 session 的 avgScore 用于"好 goal"参考
const historical: HistoricalSession[] = [];
const root = join(process.cwd(), 'archive');
if (existsSync(root)) {
  const sids = await readdir(root).catch(() => []);
  for (const sid of sids) {
    const mp = join(root, sid, 'meta.json');
    const rd = join(root, sid, 'rounds');
    if (!existsSync(mp) || !existsSync(rd)) continue;
    try {
      const m = JSON.parse(await readFile(mp, 'utf8'));
      const goal = m.goal ?? '';
      if (!goal || goal.length < 5) continue;
      let totalTokens = 0;
      const allScores: number[] = [];
      const rfs = await readdir(rd).catch(() => []);
      for (const rf of rfs) {
        if (!/^round_\d+\.json$/.test(rf)) continue;
        const r = JSON.parse(await readFile(join(rd, rf), 'utf8'));
        totalTokens += r.feedback?.total_tokens ?? 0;
        for (const persona of r.feedback?.personas ?? []) {
          for (const p of persona.proposals ?? []) {
            if (typeof p.total === 'number') allScores.push(p.total);
          }
        }
      }
      const avgScore = allScores.length > 0 ? allScores.reduce((a, b) => a + b, 0) / allScores.length : 0;
      historical.push({ sid, goal, avgScore, tokens: totalTokens });
    } catch (e) { /* */ }
  }
}

// 选 avgScore 高的 session 作为好 goal 参考(top 30%)
const sortedByScore = [...historical].sort((a, b) => b.avgScore - a.avgScore);
const topGoals = sortedByScore.slice(0, Math.max(1, Math.floor(sortedByScore.length * 0.3)));

// 提取所有 goal 的高频关键词
const allGoalTokens = new Map<string, number>();
for (const s of historical) {
  const cleaned = s.goal.toLowerCase().replace(/[#*_~>|]/g, ' ').replace(/[.,;:!?'"()\[\]{}\/\\\-]/g, ' ').split(/\s+/).filter((t) => t.length >= 2);
  for (const t of cleaned) allGoalTokens.set(t, (allGoalTokens.get(t) ?? 0) + 1);
}

function scoreGoal(text: string): { lengthScore: number; diversityScore: number; actionScore: number; historyScore: number; total: number; feedback: string[] } {
  const feedback: string[] = [];

  // 长度
  const len = text.length;
  let lengthScore = 0;
  if (len < 10) { lengthScore = 0; feedback.push('⚠ goal 太短(至少 10 字符)'); }
  else if (len < 30) { lengthScore = 30; feedback.push('⚠ goal 偏短,考虑写更多上下文'); }
  else if (len <= 150) { lengthScore = 100; feedback.push('✓ 长度合适'); }
  else if (len <= 300) { lengthScore = 80; feedback.push('✓ 长度可以,稍微偏长'); }
  else { lengthScore = 60; feedback.push('⚠ goal 过长(> 300 字),可能会让 designer 抓不到重点'); }

  // 多样性(token 数 / 总字符)
  const tokens = text.toLowerCase().replace(/[#*_~>|]/g, ' ').replace(/[.,;:!?'"()\[\]{}\/\\\-]/g, ' ').split(/\s+/).filter((t) => t.length >= 2);
  const unique = new Set(tokens);
  const diversityScore = tokens.length > 0 ? Math.min(100, (unique.size / tokens.length) * 100 + 30) : 0;
  if (diversityScore < 50) feedback.push('⚠ 词汇重复多,试着用更多样的表达');

  // 动作词
  const ACTION_WORDS = ['为什么', '如何', '怎么', '比较', '分析', '研究', '探索', '调查', '设计', '实现', '评估', 'why', 'how', 'what', 'compare', 'analyze', 'design', 'implement', 'evaluate', 'explore', 'investigate'];
  const actionHits = ACTION_WORDS.filter((w) => text.toLowerCase().includes(w)).length;
  const actionScore = Math.min(100, actionHits * 25);
  if (actionScore === 0) feedback.push('💡 加动作词:"如何 / 为什么 / 比较 / 探索"');

  // 历史命中
  let historyScore = 0;
  let bestMatch: HistoricalSession | null = null;
  for (const s of topGoals) {
    const sTokens = s.goal.toLowerCase().replace(/[^\w一-鿿\s]/g, ' ').split(/\s+/).filter((t) => t.length >= 2);
    const sSet = new Set(sTokens);
    let inter = 0;
    for (const t of tokens) if (sSet.has(t)) inter += 1;
    const jaccard = tokens.length + sTokens.length > 0 ? inter / (tokens.length + sTokens.length - inter) : 0;
    const sim = jaccard * 100;
    if (sim > historyScore) {
      historyScore = sim;
      bestMatch = s;
    }
  }
  historyScore = Math.min(100, historyScore * 2); // 0-50 jaccard 映射到 0-100
  if (historyScore >= 60 && bestMatch) feedback.push(`✓ 接近历史高分 session(<code>${bestMatch.sid.slice(0, 12)}</code>,avg=${bestMatch.avgScore.toFixed(1)})`);
  else if (historyScore < 20) feedback.push('💡 这个 goal 在历史中没有相似的高分参考 — 可能是新方向');

  const total = lengthScore * 0.3 + diversityScore * 0.2 + actionScore * 0.2 + historyScore * 0.3;
  return { lengthScore, diversityScore, actionScore, historyScore, total, feedback };
}
---

<BaseLayout title="Goal Quality · Agents">
  <Navbar />
  <main class="shell agents-shell">
    <nav class="agents-breadcrumb">
      <a href={`${base}/agents/`}>← 多智能体控制台</a>
      <span class="muted"> / goal-quality</span>
    </nav>

    <header class="agents-header">
      <h1>🎯 Goal Quality Scorer <span class="muted" style="font-size:0.6em">(iter #151)</span></h1>
      <p class="agents-sub">
        给定一个 goal,基于 {historical.length} 个历史 session 数据评分:
        <strong>长度</strong> + <strong>多样性</strong> + <strong>动作词</strong> + <strong>历史相似度</strong>。
        评分 0-100,得 70+ 的 goal 通常能产生好结果。
      </p>
    </header>

    <section class="agents-session-section">
      <h2>📊 全局</h2>
      <div class="agents-gq-globals">
        <span>历史 sessions: <strong>{historical.length}</strong></span>
        <span>高分参考 goals (top 30%): <strong>{topGoals.length}</strong></span>
      </div>
    </section>

    <section class="agents-session-section">
      <h2>📝 输入 goal 评分</h2>
      <textarea id="gq-input" placeholder="输入你的研究 goal …" rows="3" style="width:100%;padding:0.6rem;border-radius:4px;border:1px solid rgba(99,102,241,0.3);background:rgba(99,102,241,0.05);color:inherit;font-family:inherit"></textarea>
      <div style="margin-top:0.6rem">
        <button class="button primary" id="gq-score" type="button">🎯 评分</button>
        <button class="button" id="gq-clear" type="button">🗑️ 清空</button>
      </div>
      <div id="gq-result" style="margin-top:1rem"></div>
    </section>

    <section class="agents-session-section">
      <h2>📈 历史高分 goals 参考(Top 10)</h2>
      <table class="agents-session-table">
        <thead>
          <tr><th>avg score</th><th>goal</th><th>session</th></tr>
        </thead>
        <tbody>
          {topGoals.slice(0, 10).map((s) => (
            <tr>
              <td><strong style="color:#10b981">{s.avgScore.toFixed(2)}</strong></td>
              <td><small>{s.goal.slice(0, 100)}{s.goal.length > 100 ? '…' : ''}</small></td>
              <td><a href={`${base}/agents/${s.sid}/`}><code>{s.sid.slice(0, 14)}</code></a></td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  </main>
</BaseLayout>

<script define:vars={{ topGoalSids: topGoals.slice(0, 10).map((s) => s.sid) }}>
const ACTION_WORDS = ['为什么', '如何', '怎么', '比较', '分析', '研究', '探索', '调查', '设计', '实现', '评估', 'why', 'how', 'what', 'compare', 'analyze', 'design', 'implement', 'evaluate', 'explore', 'investigate'];
const inputEl = document.getElementById('gq-input') as HTMLTextAreaElement | null;
const scoreBtn = document.getElementById('gq-score');
const clearBtn = document.getElementById('gq-clear');
const resultEl = document.getElementById('gq-result');

function score(text: string): { length: number; diversity: number; action: number; history: number; total: number; fb: string[] } {
  const fb: string[] = [];
  const len = text.length;
  let lengthScore = 0;
  if (len < 10) { lengthScore = 0; fb.push('⚠ goal 太短(至少 10 字符)'); }
  else if (len < 30) { lengthScore = 30; fb.push('⚠ goal 偏短,考虑写更多上下文'); }
  else if (len <= 150) { lengthScore = 100; fb.push('✓ 长度合适'); }
  else if (len <= 300) { lengthScore = 80; fb.push('✓ 长度可以,稍微偏长'); }
  else { lengthScore = 60; fb.push('⚠ goal 过长(> 300 字)'); }

  const tokens = text.toLowerCase().replace(/[#*_~>|]/g, ' ').replace(/[.,;:!?'"()\[\]{}\/\\\-]/g, ' ').split(/\s+/).filter((t) => t.length >= 2);
  const unique = new Set(tokens);
  const diversityScore = tokens.length > 0 ? Math.min(100, (unique.size / tokens.length) * 100 + 30) : 0;
  if (diversityScore < 50) fb.push('⚠ 词汇重复多');

  const actionHits = ACTION_WORDS.filter((w) => text.toLowerCase().includes(w)).length;
  const actionScore = Math.min(100, actionHits * 25);
  if (actionScore === 0) fb.push('💡 加动作词:"如何 / 为什么 / 比较"');

  // history 不在客户端实现(数据来自 SSR),给一个 placeholder
  const historyScore = 50;
  fb.push('💡 history score 需要 SSR 计算 — 提交到 SSR 版本才能看');

  const total = lengthScore * 0.3 + diversityScore * 0.2 + actionScore * 0.2 + historyScore * 0.3;
  return { length: lengthScore, diversity: diversityScore, action: actionScore, history: historyScore, total, fb };
}

function render(): void {
  if (!inputEl || !resultEl) return;
  const text = inputEl.value;
  if (text.length < 5) {
    resultEl.innerHTML = '<p class="muted">输入至少 5 个字符。</p>';
    return;
  }
  const r = score(text);
  const color = r.total >= 70 ? '#10b981' : r.total >= 50 ? '#f59e0b' : '#ef4444';
  resultEl.innerHTML = `
    <div style="background:rgba(99,102,241,0.05);border:1px solid rgba(99,102,241,0.2);border-radius:6px;padding:1rem">
      <h3 style="margin:0">总评分: <strong style="color:${color};font-size:1.6rem">${r.total.toFixed(0)}</strong> / 100</h3>
      <ul style="margin-top:0.6rem">
        <li>长度: <strong>${r.length}</strong></li>
        <li>多样性: <strong>${r.diversity.toFixed(0)}</strong></li>
        <li>动作词: <strong>${r.action}</strong></li>
        <li>历史相似: <strong>${r.history}</strong> <small>(需 SSR)</small></li>
      </ul>
      <h4 style="margin:0.6rem 0 0.3rem">建议:</h4>
      <ul style="margin:0">${r.fb.map((x) => `<li>${x}</li>`).join('')}</ul>
    </div>
  `;
}

scoreBtn?.addEventListener('click', render);
clearBtn?.addEventListener('click', () => {
  if (inputEl) inputEl.value = '';
  if (resultEl) resultEl.innerHTML = '';
});
</script>

<style>
  .agents-gq-globals {
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
  }
  .agents-gq-globals strong {
    color: #4f46e5;
    font-family: ui-monospace, monospace;
    margin: 0 0.3rem;
  }
</style>