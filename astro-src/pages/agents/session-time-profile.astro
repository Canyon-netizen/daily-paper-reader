---
// /agents/session-time-profile.astro — iter #306:session time profile
//
// 每个 session 的 round-to-round 时间间隔 + 总时长
//   - mtime diff between consecutive rounds
//   - 总时间 = first round mtime - last round mtime
//   - 看节奏

import { readFile, readdir, stat } from 'node:fs/promises';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import '../../styles/agents.css';

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');

interface SessInfo {
  sid: string;
  goal: string;
  timestamps: number[];
  intervals: number[];   // ms
  totalDuration: number;
  avgInterval: number;
}

const root = join(process.cwd(), 'archive');
const sessions: SessInfo[] = [];

if (existsSync(root)) {
  const sids = await readdir(root).catch(() => []);
  for (const sid of sids) {
    const rd = join(root, sid, 'rounds');
    if (!existsSync(rd)) continue;
    const rfs = await readdir(rd).catch(() => []);
    const rNums: number[] = [];
    for (const rf of rfs) {
      const m = rf.match(/^round_(\d+)\.json$/);
      if (m) rNums.push(parseInt(m[1], 10));
    }
    if (rNums.length < 2) continue;
    rNums.sort((a, b) => a - b);

    let goal = '';
    const sp = join(root, sid);
    const mp = join(sp, 'meta.json');
    if (existsSync(mp)) {
      try { goal = JSON.parse(await readFile(mp, 'utf8')).goal ?? ''; } catch (e) { /* */ }
    }

    const timestamps: number[] = [];
    for (const rn of rNums) {
      try {
        const fp = join(rd, `round_${rn}.json`);
        const st = await stat(fp);
        timestamps.push(st.mtimeMs);
      } catch (e) { /* */ }
    }
    if (timestamps.length < 2) continue;

    const intervals: number[] = [];
    for (let i = 1; i < timestamps.length; i++) {
      intervals.push(timestamps[i] - timestamps[i - 1]);
    }

    sessions.push({
      sid, goal,
      timestamps,
      intervals,
      totalDuration: timestamps[timestamps.length - 1] - timestamps[0],
      avgInterval: intervals.reduce((a, b) => a + b, 0) / intervals.length,
    });
  }
}

const totalSessions = sessions.length;

// 间隔分布
const buckets = [
  { label: '<1m',   min: 0,        max: 60_000,        count: 0 },
  { label: '1-5m',  min: 60_000,   max: 5 * 60_000,    count: 0 },
  { label: '5-15m', min: 5 * 60_000, max: 15 * 60_000, count: 0 },
  { label: '15-60m',min: 15 * 60_000, max: 60 * 60_000, count: 0 },
  { label: '1-6h',  min: 60 * 60_000, max: 6 * 60 * 60_000, count: 0 },
  { label: '6h+',   min: 6 * 60 * 60_000, max: Infinity, count: 0 },
];

const allIntervals: number[] = [];
for (const s of sessions) allIntervals.push(...s.intervals);
for (const iv of allIntervals) {
  for (const b of buckets) {
    if (iv >= b.min && iv < b.max) { b.count += 1; break; }
  }
}

// 总时长分布
const durationBuckets = [
  { label: '<5m',     min: 0, max: 5 * 60_000, count: 0 },
  { label: '5-30m',   min: 5 * 60_000, max: 30 * 60_000, count: 0 },
  { label: '30-60m',  min: 30 * 60_000, max: 60 * 60_000, count: 0 },
  { label: '1-6h',    min: 60 * 60_000, max: 6 * 60 * 60_000, count: 0 },
  { label: '6-24h',   min: 6 * 60 * 60_000, max: 24 * 60 * 60_000, count: 0 },
  { label: '24h+',    min: 24 * 60 * 60_000, max: Infinity, count: 0 },
];
for (const s of sessions) {
  for (const b of durationBuckets) {
    if (s.totalDuration >= b.min && s.totalDuration < b.max) { b.count += 1; break; }
  }
}

const totalIv = allIntervals.length;
const avgIv = totalIv > 0 ? allIntervals.reduce((a, b) => a + b, 0) / totalIv : 0;
const maxIv = totalIv > 0 ? Math.max(...allIntervals) : 0;

function fmtDur(ms: number): string {
  if (ms < 60_000) return `${(ms / 1000).toFixed(0)}s`;
  if (ms < 3_600_000) return `${(ms / 60_000).toFixed(0)}m`;
  if (ms < 86_400_000) return `${(ms / 3_600_000).toFixed(1)}h`;
  return `${(ms / 86_400_000).toFixed(1)}d`;
}

function bar(n: number, max: number, width = 22): string {
  if (!max) return '░'.repeat(width);
  const filled = Math.round((n / max) * width);
  return '█'.repeat(filled) + '░'.repeat(width - filled);
}

const maxBucketCount = Math.max(...buckets.map((b) => b.count), 1);
const maxDurationBucket = Math.max(...durationBuckets.map((b) => b.count), 1);
---

<BaseLayout title="Session Time Profile · Agents">
  <Navbar />
  <main class="shell agents-shell">
    <nav class="agents-breadcrumb">
      <a href={`${base}/agents/`}>← 多智能体控制台</a>
      <span class="muted"> / session-time-profile</span>
    </nav>

    <header class="agents-header">
      <h1>⏱️ Session Time Profile <span class="muted" style="font-size:0.6em">(iter #306)</span></h1>
      <p class="agents-sub">
        基于 mtime 看每个 session 的 round 间隔分布 + 总时长分布。
      </p>
    </header>

    <section class="agents-session-section">
      <h2>📊 全局</h2>
      <div class="agents-stp-globals">
        <span>总 sessions: <strong>{totalSessions}</strong></span>
        <span>总 intervals: <strong>{totalIv}</strong></span>
        <span>avg interval: <strong>{fmtDur(avgIv)}</strong></span>
        <span>max interval: <strong>{fmtDur(maxIv)}</strong></span>
      </div>
    </section>

    <section class="agents-session-section">
      <h2>📊 round 间隔分布</h2>
      <pre class="agents-stp-flow">{buckets.map((b) => {
        return `${b.label.padEnd(8)} ${bar(b.count, maxBucketCount, 22)}  ${b.count}  (${((b.count / Math.max(1, totalIv)) * 100).toFixed(1)}%)`;
      }).join('\n')}</pre>
    </section>

    <section class="agents-session-section">
      <h2>📊 session 总时长分布</h2>
      <pre class="agents-stp-flow">{durationBuckets.map((b) => {
        return `${b.label.padEnd(8)} ${bar(b.count, maxDurationBucket, 22)}  ${b.count}  (${((b.count / Math.max(1, totalSessions)) * 100).toFixed(1)}%)`;
      }).join('\n')}</pre>
    </section>

    <section class="agents-session-section">
      <h2>💡 解读</h2>
      <ul>
        <li>间隔 &lt; 1m = 系统自动快速迭代</li>
        <li>间隔 1-5m = 常见人工审视节奏</li>
        <li>间隔 6h+ = 隔天再继续</li>
        <li>总时长 = session 从第一次 round 到最后一次 round 的时长</li>
        <li>对照 <a href={`${base}/agents/session-lifetime/`}>Session Lifetime</a></li>
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .agents-stp-globals {
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
  }
  .agents-stp-globals strong {
    color: #4f46e5;
    font-family: ui-monospace, monospace;
    margin: 0 0.3rem;
  }
  .agents-stp-flow {
    background: rgba(0,0,0,0.4);
    color: #c9d1d9;
    padding: 0.8rem;
    border-radius: 4px;
    font-family: ui-monospace, "JetBrains Mono", monospace;
    font-size: 0.78rem;
    line-height: 1.4;
    overflow-x: auto;
    white-space: pre;
  }
</style>