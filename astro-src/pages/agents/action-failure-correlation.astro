---
// /agents/action-failure-correlation.astro — iter #337:round action count vs gain correlation
//
// Pearson correlation between total applied actions and total gain per session.

import { readFile, readdir } from 'node:fs/promises';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import '../../styles/agents.css';

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');

interface SessPoint {
  sid: string;
  goal: string;
  totalActions: number;
  gain: number;
  finalScore: number;
}

const root = join(process.cwd(), 'archive');
const points: SessPoint[] = [];

if (existsSync(root)) {
  const sids = await readdir(root).catch(() => []);
  for (const sid of sids) {
    const rd = join(root, sid, 'rounds');
    if (!existsSync(rd)) continue;
    const rfs = await readdir(rd).catch(() => []);
    const rNums: number[] = [];
    for (const rf of rfs) {
      const m = rf.match(/^round_(\d+)\.json$/);
      if (m) rNums.push(parseInt(m[1], 10));
    }
    if (rNums.length < 2) continue;
    rNums.sort((a, b) => a - b);

    let totalActions = 0;
    let firstScore = 0;
    let lastScore = 0;
    for (let i = 0; i < rNums.length; i++) {
      const rn = rNums[i];
      try {
        const r = JSON.parse(await readFile(join(rd, `round_${rn}.json`), 'utf8'));
        totalActions += (r.modifier?.applied ?? []).length;
        const arr: number[] = [];
        for (const persona of r.feedback?.personas ?? []) {
          for (const p of persona.proposals ?? []) {
            if (typeof p.total === 'number') arr.push(p.total);
          }
        }
        if (arr.length > 0) {
          const avg = arr.reduce((a, b) => a + b, 0) / arr.length;
          if (i === 0) firstScore = avg;
          lastScore = avg;
        }
      } catch (e) { /* */ }
    }
    if (firstScore === 0) continue;

    let goal = '';
    const mp = join(root, sid, 'meta.json');
    if (existsSync(mp)) {
      try { goal = JSON.parse(await readFile(mp, 'utf8')).goal ?? ''; } catch (e) { /* */ }
    }

    points.push({
      sid, goal,
      totalActions,
      gain: lastScore - firstScore,
      finalScore: lastScore,
    });
  }
}

// Pearson correlation totalActions vs gain
let n = 0, sx = 0, sy = 0, sxx = 0, syy = 0, sxy = 0;
for (const p of points) {
  n += 1;
  sx += p.totalActions;
  sy += p.gain;
  sxx += p.totalActions ** 2;
  syy += p.gain ** 2;
  sxy += p.totalActions * p.gain;
}
const denom = Math.sqrt((n * sxx - sx ** 2) * (n * syy - sy ** 2));
const pearson = denom !== 0 ? (n * sxy - sx * sy) / denom : 0;

// Identify "action-heavy & low-gain" sessions (worst ROI)
const avgActions = points.reduce((s, p) => s + p.totalActions, 0) / Math.max(1, points.length);
const avgGain = points.reduce((s, p) => s + p.gain, 0) / Math.max(1, points.length);

const inefficient = points.filter((p) => p.totalActions >= avgActions && p.gain <= avgGain);
inefficient.sort((a, b) => a.gain - b.gain);

const efficient = points.filter((p) => p.totalActions <= avgActions && p.gain >= avgGain);
efficient.sort((a, b) => b.gain - a.gain);

// Action count buckets
const buckets = [
  { label: '1-3', min: 1, max: 4, count: 0 },
  { label: '4-6', min: 4, max: 7, count: 0 },
  { label: '7-9', min: 7, max: 10, count: 0 },
  { label: '10-15', min: 10, max: 16, count: 0 },
  { label: '16+', min: 16, max: Infinity, count: 0 },
];
for (const p of points) {
  for (const b of buckets) {
    if (p.totalActions >= b.min && p.totalActions < b.max) { b.count += 1; break; }
  }
}

function bar(n: number, max: number, width = 22): string {
  if (!max) return '░'.repeat(width);
  const filled = Math.round((n / max) * width);
  return '█'.repeat(filled) + '░'.repeat(width - filled);
}

function esc(s: any): string {
  const str = String(s == null ? '' : s);
  return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}
---

<BaseLayout title="Round Action Failure Correlation · Agents">
  <Navbar />
  <main class="shell agents-shell">
    <nav class="agents-breadcrumb">
      <a href={`${base}/agents/`}>← 多智能体控制台</a>
      <span class="muted"> / action-failure-correlation</span>
    </nav>

    <header class="agents-header">
      <h1>⚠️ Round Action Failure Correlation <span class="muted" style="font-size:0.6em">(iter #337)</span></h1>
      <p class="agents-sub">
        判断 action 数量多是否对应 gain 高 / 低。
        pearson ≈ 0 = actions 与 gain 无关;负相关 = "忙而无功"。
      </p>
    </header>

    <section class="agents-session-section">
      <h2>📊 全局</h2>
      <div class="agents-afc-globals">
        <span>sessions: <strong>{points.length}</strong></span>
        <span>avg actions: <strong>{avgActions.toFixed(1)}</strong></span>
        <span>avg gain: <strong>{avgGain.toFixed(2)}</strong></span>
        <span>Pearson(actions, gain): <strong style={`color:${pearson >= 0.1 ? '#10b981' : pearson <= -0.1 ? '#ef4444' : '#94a3b8'}`}>{pearson.toFixed(3)}</strong></span>
        <span>inefficient sessions: <strong style="color:#ef4444">{inefficient.length}</strong></span>
      </div>
    </section>

    <section class="agents-session-section">
      <h2>📊 Action Count 分布</h2>
      <pre class="agents-afc-flow">{buckets.map((b) => {
        return `${b.label.padEnd(12)} ${bar(b.count, Math.max(...buckets.map((x) => x.count), 1), 22)}  ${b.count}`;
      }).join('\n')}</pre>
    </section>

    <section class="agents-session-section">
      <h2>⚠️ Top 12 inefficient (actions 高 + gain 低)</h2>
      <table class="agents-session-table">
        <thead>
          <tr><th>#</th><th>sid</th><th>actions</th><th>gain</th><th>final</th><th>goal</th></tr>
        </thead>
        <tbody>
          {inefficient.slice(0, 12).map((p, i) => (
            <tr>
              <td>{i + 1}</td>
              <td><a href={`${base}/agents/${p.sid}/`}><code>{esc(p.sid.slice(0, 10))}</code></a></td>
              <td>{p.totalActions}</td>
              <td><strong style={`color:${p.gain >= 0 ? '#10b981' : '#ef4444'}`}>{p.gain >= 0 ? '+' : ''}{p.gain.toFixed(2)}</strong></td>
              <td>{p.finalScore.toFixed(2)}</td>
              <td><small class="muted">{esc(p.goal.slice(0, 22))}{p.goal.length > 22 ? '…' : ''}</small></td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="agents-session-section">
      <h2>🏆 Top 8 efficient (actions 少 + gain 高)</h2>
      <table class="agents-session-table">
        <thead>
          <tr><th>#</th><th>sid</th><th>actions</th><th>gain</th><th>final</th><th>goal</th></tr>
        </thead>
        <tbody>
          {efficient.slice(0, 8).map((p, i) => (
            <tr>
              <td>{i + 1}</td>
              <td><a href={`${base}/agents/${p.sid}/`}><code>{esc(p.sid.slice(0, 10))}</code></a></td>
              <td>{p.totalActions}</td>
              <td><strong style="color:#10b981">+{p.gain.toFixed(2)}</strong></td>
              <td>{p.finalScore.toFixed(2)}</td>
              <td><small class="muted">{esc(p.goal.slice(0, 22))}{p.goal.length > 22 ? '…' : ''}</small></td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="agents-session-section">
      <h2>💡 解读</h2>
      <ul>
        <li>pearson &gt; 0.3 = 行动越多,成果越大(健康)</li>
        <li>pearson &lt; -0.3 = 行动越多,成果越差(机制问题)</li>
        <li>inefficient 列表 = 系统在该 session "白忙"</li>
        <li>对照 <a href={`${base}/agents/cost-per-score-point/`}>Cost Per Score Point</a></li>
        <li>对照 <a href={`${base}/agents/cost-by-action/`}>Cost By Action</a></li>
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .agents-afc-globals {
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
  }
  .agents-afc-globals strong {
    color: #4f46e5;
    font-family: ui-monospace, monospace;
    margin: 0 0.3rem;
  }
  .agents-afc-flow {
    background: rgba(0,0,0,0.4);
    color: #c9d1d9;
    padding: 0.8rem;
    border-radius: 4px;
    font-family: ui-monospace, "JetBrains Mono", monospace;
    font-size: 0.78rem;
    line-height: 1.4;
    overflow-x: auto;
    white-space: pre;
  }
</style>