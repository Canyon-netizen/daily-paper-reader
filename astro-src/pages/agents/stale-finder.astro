---
// /agents/stale-finder.astro — iter #205:stale session finder
//
// 找出"长期未更新"的 sessions,按不活跃天数排序:
//   - 1-3 天:温暖期
//   - 3-7 天:冷却期
//   - 7-30 天:stale
//   - > 30 天:abandoned

import { readFile, readdir, stat } from 'node:fs/promises';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import '../../styles/agents.css';

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');

interface StaleSession {
  sid: string;
  goal: string;
  metaMtime: number;
  lastRoundMtime: number;
  lastSynthesisMtime: number;
  maxMtime: number;
  daysSinceUpdate: number;
  rounds: number;
  syntheses: number;
}

const root = join(process.cwd(), 'archive');
const records: StaleSession[] = [];
const now = Date.now();
const ONE_DAY = 24 * 60 * 60 * 1000;

if (existsSync(root)) {
  const sids = await readdir(root).catch(() => []);
  for (const sid of sids) {
    let metaMtime = 0;
    let goal = '';
    const mp = join(root, sid, 'meta.json');
    if (existsSync(mp)) {
      try {
        const st = await stat(mp);
        metaMtime = st.mtimeMs;
        goal = JSON.parse(await readFile(mp, 'utf8')).goal ?? '';
      } catch (e) { /* */ }
    }
    let lastRoundMtime = 0;
    let rounds = 0;
    const rd = join(root, sid, 'rounds');
    if (existsSync(rd)) {
      const rfs = await readdir(rd).catch(() => []);
      for (const rf of rfs) {
        if (!/^round_\d+\.json$/.test(rf)) continue;
        try {
          const st = await stat(join(rd, rf));
          if (st.mtimeMs > lastRoundMtime) lastRoundMtime = st.mtimeMs;
          rounds += 1;
        } catch (e) { /* */ }
      }
    }
    let lastSynthesisMtime = 0;
    let syntheses = 0;
    const sd = join(root, sid, 'synthesis');
    if (existsSync(sd)) {
      const sfs = await readdir(sd).catch(() => []);
      for (const sf of sfs) {
        if (!sf.endsWith('.md')) continue;
        try {
          const st = await stat(join(sd, sf));
          if (st.mtimeMs > lastSynthesisMtime) lastSynthesisMtime = st.mtimeMs;
          syntheses += 1;
        } catch (e) { /* */ }
      }
    }
    const maxMtime = Math.max(metaMtime, lastRoundMtime, lastSynthesisMtime);
    if (maxMtime === 0) continue;
    records.push({
      sid, goal, metaMtime, lastRoundMtime, lastSynthesisMtime,
      maxMtime,
      daysSinceUpdate: (now - maxMtime) / ONE_DAY,
      rounds, syntheses,
    });
  }
}

// 分桶
const buckets = [
  { label: '1-3 天 (温暖)', min: 1, max: 3, count: 0 },
  { label: '3-7 天 (冷却)', min: 3, max: 7, count: 0 },
  { label: '7-30 天 (stale)', min: 7, max: 30, count: 0 },
  { label: '> 30 天 (abandoned)', min: 30, max: 99999, count: 0 },
];
for (const r of records) {
  for (const b of buckets) {
    if (r.daysSinceUpdate >= b.min && r.daysSinceUpdate < b.max) {
      b.count += 1;
      break;
    }
  }
}

const topStale = [...records].sort((a, b) => b.daysSinceUpdate - a.daysSinceUpdate).slice(0, 30);

function bar(n: number, max: number, width = 22): string {
  if (!max) return '░'.repeat(width);
  const filled = Math.round((n / max) * width);
  return '█'.repeat(filled) + '░'.repeat(width - filled);
}
function esc(s: any): string {
  return String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({ '&': '&', '<': '<', '>': '>', '"': '"', "'": '&#39;' }[c] || c));
}
---

<BaseLayout title="Stale Session Finder · Agents">
  <Navbar />
  <main class="shell agents-shell">
    <nav class="agents-breadcrumb">
      <a href={`${base}/agents/`}>← 多智能体控制台</a>
      <span class="muted"> / stale-finder</span>
    </nav>

    <header class="agents-header">
      <h1>⏰ Stale Session Finder <span class="muted" style="font-size:0.6em">(iter #205)</span></h1>
      <p class="agents-sub">
        按"距上次任何活动"的天数排序所有 sessions。
        stale = 长期未更新,可能需要重新激活或归档。
      </p>
    </header>

    <section class="agents-session-section">
      <h2>📊 不活跃分布</h2>
      <pre class="agents-sf-flow">{buckets.map((b) => {
        const max = Math.max(...buckets.map((x) => x.count), 1);
        return `${b.label.padEnd(22)} ${bar(b.count, max, 22)}  ${b.count}`;
      }).join('\n')}</pre>
    </section>

    <section class="agents-session-section">
      <h2>🕰️ top 30 最久未更新</h2>
      <table class="agents-session-table">
        <thead>
          <tr><th>days</th><th>sid</th><th>rounds</th><th>synth</th><th>goal</th></tr>
        </thead>
        <tbody>
          {topStale.map((r) => (
            <tr class={r.daysSinceUpdate > 30 ? 'sf-abandoned' : r.daysSinceUpdate > 7 ? 'sf-stale' : ''}>
              <td><strong>{r.daysSinceUpdate.toFixed(1)}d</strong></td>
              <td><a href={`${base}/agents/${r.sid}/`}><code>{esc(r.sid.slice(0, 14))}</code></a></td>
              <td>{r.rounds}</td>
              <td>{r.syntheses}</td>
              <td><small class="muted">{esc(r.goal.slice(0, 50))}{(r.goal ?? '').length > 50 ? '…' : ''}</small></td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="agents-session-section">
      <h2>💡 解读</h2>
      <ul>
        <li>&gt; 30 天 abandoned = 候选清理</li>
        <li>7-30 天 stale = 可"续命"(再跑 1 round)</li>
        <li>对照 <a href={`${base}/agents/session-lifecycle/`}>Session Lifecycle</a> 看完整生命周期</li>
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .agents-sf-flow {
    background: rgba(0,0,0,0.4);
    color: #c9d1d9;
    padding: 0.8rem;
    border-radius: 4px;
    font-family: ui-monospace, "JetBrains Mono", monospace;
    font-size: 0.78rem;
    line-height: 1.4;
    overflow-x: auto;
    white-space: pre;
  }
  tr.sf-abandoned td { background: rgba(239, 68, 68, 0.1); }
  tr.sf-stale td { background: rgba(245, 158, 11, 0.1); }
</style>