---
// /agents/top-sessions.astro — iter #189:top sessions by composite metric
//
// 综合多个 KPI 给出"最佳 sessions"排名:
//   - promoted 数
//   - avg score
//   - synthesis 数
//   - rounds 数(深度)
//   - token 效率(promoted/tokens)
// 综合得分 = 加权和

import { readFile, readdir } from 'node:fs/promises';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import '../../styles/agents.css';

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');

interface SessionInfo {
  sid: string;
  goal: string;
  rounds: number;
  promoted: number;
  synthCount: number;
  avgScore: number;
  tokens: number;
  composite: number;
}

const root = join(process.cwd(), 'archive');
const sessions: SessionInfo[] = [];

if (existsSync(root)) {
  const sids = await readdir(root).catch(() => []);
  for (const sid of sids) {
    let goal = '';
    const mp = join(root, sid, 'meta.json');
    if (existsSync(mp)) {
      try { goal = JSON.parse(await readFile(mp, 'utf8')).goal ?? ''; } catch (e) { /* */ }
    }
    const rd = join(root, sid, 'rounds');
    const sd = join(root, sid, 'synthesis');
    let rounds = 0;
    let promoted = 0;
    let tokens = 0;
    const allScores: number[] = [];
    let synthCount = 0;
    if (existsSync(rd)) {
      const rfs = await readdir(rd).catch(() => []);
      const rNum: number[] = [];
      for (const rf of rfs) {
        const m = rf.match(/^round_(\d+)\.json$/);
        if (m) rNum.push(parseInt(m[1], 10));
      }
      rNum.sort((a, b) => a - b);
      rounds = rNum.length;
      for (const ri of rNum) {
        try {
          const r = JSON.parse(await readFile(join(rd, `round_${ri}.json`), 'utf8'));
          tokens += r.feedback?.total_tokens ?? 0;
          for (const persona of r.feedback?.personas ?? []) {
            for (const p of persona.proposals ?? []) {
              if (typeof p.total === 'number') allScores.push(p.total);
            }
          }
          for (const gp of r.gate?.proposals ?? []) {
            if (gp.category === 'promoted') promoted += 1;
          }
        } catch (e) { /* */ }
      }
    }
    if (existsSync(sd)) {
      const sfs = await readdir(sd).catch(() => []);
      synthCount = sfs.filter((f) => /^synthesis_\d+\.md$/.test(f)).length;
    }
    const avgScore = allScores.length > 0 ? allScores.reduce((a, b) => a + b, 0) / allScores.length : 0;
    sessions.push({
      sid, goal, rounds, promoted, synthCount, avgScore, tokens, composite: 0,
    });
  }
}

// 计算综合分
// 标准化 + 加权:
//   - promoted (1/4) = min(promoted / 5, 1) * 100
//   - avg score (1/4) = (avgScore / 10) * 100
//   - synth (1/4) = min(synthCount / 3, 1) * 100
//   - efficiency (1/4) = min(promoted / max(tokens/100k, 1), 1) * 100
for (const s of sessions) {
  const promN = Math.min(s.promoted / 5, 1) * 100;
  const scoreN = (s.avgScore / 10) * 100;
  const synthN = Math.min(s.synthCount / 3, 1) * 100;
  const eff = s.tokens > 0 ? Math.min(s.promoted / (s.tokens / 100_000), 1) * 100 : 0;
  s.composite = (promN + scoreN + synthN + eff) / 4;
}

sessions.sort((a, b) => b.composite - a.composite);

function esc(s: any): string {
  return String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({ '&': '&', '<': '<', '>': '>', '"': '"', "'": '&#39;' }[c] || c));
}
function grade(n: number): string {
  if (n >= 80) return 'A';
  if (n >= 65) return 'B';
  if (n >= 50) return 'C';
  if (n >= 35) return 'D';
  return 'F';
}

const top = sessions.slice(0, 30);
---

<BaseLayout title="Top Sessions · Agents">
  <Navbar />
  <main class="shell agents-shell">
    <nav class="agents-breadcrumb">
      <a href={`${base}/agents/`}>← 多智能体控制台</a>
      <span class="muted"> / top-sessions</span>
    </nav>

    <header class="agents-header">
      <h1>🏆 Top Sessions <span class="muted" style="font-size:0.6em">(iter #189)</span></h1>
      <p class="agents-sub">
        综合多 KPI 排名的最佳 sessions。
        权重:promoted / score / synth / 效率 各 25%。
      </p>
    </header>

    <section class="agents-session-section">
      <h2>📊 全局</h2>
      <div class="agents-ts-globals">
        <span>总 sessions: <strong>{sessions.length}</strong></span>
        <span>avg composite: <strong>{(sessions.reduce((s, x) => s + x.composite, 0) / Math.max(sessions.length, 1)).toFixed(1)}</strong></span>
      </div>
    </section>

    <section class="agents-session-section">
      <h2>🏆 top 30 综合得分</h2>
      <table class="agents-session-table">
        <thead>
          <tr><th>#</th><th>sid</th><th>composite</th><th>grade</th><th>prom</th><th>score</th><th>synth</th><th>rounds</th><th>goal</th></tr>
        </thead>
        <tbody>
          {top.map((s, i) => (
            <tr>
              <td>{i + 1}</td>
              <td><a href={`${base}/agents/${s.sid}/`}><code>{esc(s.sid.slice(0, 14))}</code></a></td>
              <td><strong style={s.composite >= 60 ? 'color:#10b981' : s.composite >= 40 ? 'color:#f59e0b' : 'color:#ef4444'}>{s.composite.toFixed(1)}</strong></td>
              <td><strong>{grade(s.composite)}</strong></td>
              <td>{s.promoted}</td>
              <td>{s.avgScore.toFixed(2)}</td>
              <td>{s.synthCount}</td>
              <td>{s.rounds}</td>
              <td><small class="muted">{esc(s.goal.slice(0, 40))}{(s.goal ?? '').length > 40 ? '…' : ''}</small></td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="agents-session-section">
      <h2>💡 解读</h2>
      <ul>
        <li>composite ≥ 80 = 高产高效 session,可作为模板参考</li>
        <li>composite &lt; 30 = 多维度不佳,看 <a href={`${base}/agents/health-summary/`}>Health Summary</a> 分析原因</li>
        <li>对照 <a href={`${base}/agents/best-proposals/`}>Best Proposals</a> 看单 proposal 排名</li>
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .agents-ts-globals {
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
  }
  .agents-ts-globals strong {
    color: #4f46e5;
    font-family: ui-monospace, monospace;
    margin: 0 0.3rem;
  }
</style>