---
// /agents/action-diversity-trend.astro — iter #369:weekly action diversity trend

import { readFile, readdir, statSync } from 'node:fs';
import { existsSync } from 'node:fs';
import { readFile as readFileAsync, readdir as readdirAsync } from 'node:fs/promises';
import { join } from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import '../../styles/agents.css';

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');

function isoWeek(date: Date): string {
  const d = new Date(Date.UTC(date.getFullYear(), date.getMonth(), date.getDate()));
  const day = d.getUTCDay() || 7;
  d.setUTCDate(d.getUTCDate() + 4 - day);
  const yearStart = new Date(Date.UTC(d.getUTCFullYear(), 0, 1));
  const weekNum = Math.ceil((((d.getTime() - yearStart.getTime()) / 86400000) + 1) / 7);
  return `${d.getUTCFullYear()}-W${weekNum.toString().padStart(2, '0')}`;
}

const root = join(process.cwd(), 'archive');
interface WeekDiv { week: string; sessions: number; totalActs: number; uniqueActs: number; diversity: number; }
const weekMap = new Map<string, WeekDiv>();

if (existsSync(root)) {
  const sids = await readdirAsync(root).catch(() => []);
  for (const sid of sids) {
    const rd = join(root, sid, 'rounds');
    if (!existsSync(rd)) continue;
    const rfs = await readdirAsync(rd).catch(() => []);
    const rNums: number[] = [];
    for (const rf of rfs) {
      const m = rf.match(/^round_(\d+)\.json$/);
      if (m) rNums.push(parseInt(m[1], 10));
    }
    if (rNums.length < 1) continue;
    rNums.sort((a, b) => a - b);

    let created: Date | null = null;
    const r1 = join(rd, `round_${rNums[0]}.json`);
    if (existsSync(r1)) {
      try { created = statSync(r1).mtime; } catch (e) { /* */ }
    }
    if (!created) continue;
    const week = isoWeek(created);
    if (!weekMap.has(week)) weekMap.set(week, { week, sessions: 0, totalActs: 0, uniqueActs: 0, diversity: 0 });
    const wd = weekMap.get(week)!;
    wd.sessions += 1;

    const sessionActs = new Set<string>();
    for (const rn of rNums) {
      try {
        const r = JSON.parse(await readFileAsync(join(rd, `round_${rn}.json`), 'utf8'));
        for (const a of (r.modifier?.applied ?? [])) {
          const act = a.action ?? a.type ?? 'unknown';
          sessionActs.add(act);
          wd.totalActs += 1;
        }
      } catch (e) { /* */ }
    }
    wd.uniqueActs += sessionActs.size;
  }
}

const weeks = [...weekMap.values()].sort((a, b) => a.week.localeCompare(b.week));
for (const w of weeks) {
  w.diversity = w.totalActs > 0 ? w.uniqueActs / w.totalActs : 0;
}

function sparkline(arr: number[], width = 24): string {
  if (arr.length === 0) return '·'.repeat(width);
  const mn = Math.min(...arr);
  const mx = Math.max(...arr);
  const range = mx - mn || 1;
  const chars = ['▁', '▂', '▃', '▄', '▅', '▆', '▇', '█'];
  const out: string[] = [];
  for (let i = 0; i < width; i++) {
    const idx = Math.floor((i / (width - 1)) * (arr.length - 1));
    const v = arr[Math.max(0, Math.min(arr.length - 1, idx))];
    const ratio = (v - mn) / range;
    out.push(chars[Math.min(chars.length - 1, Math.floor(ratio * (chars.length - 1)))]);
  }
  return out.join('');
}

function esc(s: any): string {
  const str = String(s == null ? '' : s);
  return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}
---

<BaseLayout title="Action Diversity Trend · Agents">
  <Navbar />
  <main class="shell agents-shell">
    <nav class="agents-breadcrumb">
      <a href={`${base}/agents/`}>← 多智能体控制台</a>
      <span class="muted"> / action-diversity-trend</span>
    </nav>

    <header class="agents-header">
      <h1>📈 Action Diversity Trend <span class="muted" style="font-size:0.6em">(iter #369)</span></h1>
      <p class="agents-sub">
        每周 action diversity = unique_acts / total_acts。
        上升 = action 选择越来越多样;下降 = 越来越集中。
      </p>
    </header>

    <section class="agents-session-section">
      <h2>📊 全局</h2>
      <div class="agents-adt-globals">
        <span>weeks: <strong>{weeks.length}</strong></span>
        <span>avg diversity: <strong>{(weeks.reduce((s, w) => s + w.diversity, 0) / Math.max(1, weeks.length)).toFixed(3)}</strong></span>
      </div>
    </section>

    <section class="agents-session-section">
      <h2>📈 Diversity sparkline</h2>
      <pre class="agents-adt-flow">{sparkline(weeks.map((w) => w.diversity), 32)}</pre>
      <p class="muted">▁..█ = 周度 action diversity(高 = 多样)</p>
    </section>

    <section class="agents-session-section">
      <h2>📈 Total actions sparkline</h2>
      <pre class="agents-adt-flow">{sparkline(weeks.map((w) => w.totalActs), 32)}</pre>
    </section>

    <section class="agents-session-section">
      <h2>📅 周表(最新 18 周)</h2>
      <table class="agents-session-table">
        <thead>
          <tr><th>week</th><th>n</th><th>total acts</th><th>unique acts</th><th>diversity</th></tr>
        </thead>
        <tbody>
          {weeks.slice(-18).map((w) => (
            <tr>
              <td><code>{esc(w.week)}</code></td>
              <td>{w.sessions}</td>
              <td>{w.totalActs}</td>
              <td>{w.uniqueActs}</td>
              <td><strong style={`color:${w.diversity >= 0.7 ? '#10b981' : w.diversity >= 0.4 ? '#f59e0b' : '#ef4444'}`}>{w.diversity.toFixed(3)}</strong></td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="agents-session-section">
      <h2>💡 解读</h2>
      <ul>
        <li>diversity 上升 = action 选择越来越灵活</li>
        <li>diversity 下降 = 系统越来越依赖少数 action</li>
        <li>对照 <a href={`${base}/agents/action-diversity-sessions/`}>Action Diversity Across Sessions</a></li>
        <li>对照 <a href={`${base}/agents/action-recency-half-life/`}>Action Recency Half-life</a></li>
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .agents-adt-globals {
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
  }
  .agents-adt-globals strong {
    color: #4f46e5;
    font-family: ui-monospace, monospace;
    margin: 0 0.3rem;
  }
  .agents-adt-flow {
    background: rgba(0,0,0,0.4);
    color: #c9d1d9;
    padding: 0.8rem;
    border-radius: 4px;
    font-family: ui-monospace, "JetBrains Mono", monospace;
    font-size: 0.78rem;
    line-height: 1.4;
    overflow-x: auto;
    white-space: pre;
  }
</style>