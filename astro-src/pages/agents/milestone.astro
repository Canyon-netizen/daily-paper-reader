---
// /agents/milestone.astro — iter #180:milestone summary (180 iters)
//
// 庆祝多智能体系统完成 180 次迭代!
// 显示:
//   - 累计统计(总 sessions / rounds / tokens / syntheses)
//   - 系统历史曲线
//   - 与早期相比的增长率
//   - iter 进度条(150-180 / 200 目标)

import { readFile, readdir, stat } from 'node:fs/promises';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import '../../styles/agents.css';

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');

const root = join(process.cwd(), 'archive');
let totalSessions = 0;
let totalRounds = 0;
let totalSyntheses = 0;
let totalTokens = 0;
let totalPromoted = 0;
const allDates: number[] = [];
const oldestSid: { sid: string; date: number } | null = { sid: '', date: 0 };
const newestSid: { sid: string; date: number } | null = { sid: '', date: 0 };

if (existsSync(root)) {
  const sids = await readdir(root).catch(() => []);
  for (const sid of sids) {
    totalSessions += 1;
    const mp = join(root, sid, 'meta.json');
    let metaDate = 0;
    if (existsSync(mp)) {
      try {
        const st = await stat(mp);
        metaDate = st.mtimeMs;
        allDates.push(metaDate);
        if (!oldestSid || metaDate < oldestSid.date) { oldestSid!.sid = sid; oldestSid!.date = metaDate; }
        if (!newestSid || metaDate > newestSid.date) { newestSid!.sid = sid; newestSid!.date = metaDate; }
      } catch (e) { /* */ }
    }
    const rd = join(root, sid, 'rounds');
    const sd = join(root, sid, 'synthesis');
    if (existsSync(rd)) {
      const rfs = await readdir(rd).catch(() => []);
      for (const rf of rfs) {
        if (!/^round_\d+\.json$/.test(rf)) continue;
        totalRounds += 1;
        try {
          const r = JSON.parse(await readFile(join(rd, rf), 'utf8'));
          totalTokens += r.feedback?.total_tokens ?? 0;
          for (const gp of r.gate?.proposals ?? []) {
            if (gp.category === 'promoted') totalPromoted += 1;
          }
        } catch (e) { /* */ }
      }
    }
    if (existsSync(sd)) {
      const sfs = await readdir(sd).catch(() => []);
      totalSyntheses += sfs.filter((f) => /^synthesis_\d+\.md$/.test(f)).length;
    }
  }
}

// 按天累积曲线
allDates.sort((a, b) => a - b);
const dayCumMap = new Map<string, number>();
for (const ts of allDates) {
  const k = new Date(ts).toISOString().slice(0, 10);
  dayCumMap.set(k, (dayCumMap.get(k) ?? 0) + 1);
}
let runningTotal = 0;
const cumPoints: { date: string; cum: number }[] = [];
for (const [d, c] of [...dayCumMap.entries()].sort((a, b) => a[0].localeCompare(b[0]))) {
  runningTotal += c;
  cumPoints.push({ date: d, cum: runningTotal });
}

// 估算成本
const sonnetCost = (totalTokens / 1_000_000) * 6;
const avgSessionCost = totalSessions > 0 ? sonnetCost / totalSessions : 0;
const avgRoundCost = totalRounds > 0 ? sonnetCost / totalRounds : 0;

const oldestDate = allDates.length > 0 ? new Date(allDates[0]).toISOString().slice(0, 10) : '—';
const newestDate = allDates.length > 0 ? new Date(allDates[allDates.length - 1]).toISOString().slice(0, 10) : '—';
const ageDays = allDates.length > 0 ? Math.ceil((Date.now() - allDates[0]) / (24 * 60 * 60 * 1000)) : 0;

// iter 进度: 1-180 iters
const TOTAL_ITERS = 200;
const iterNumber = 180;
const progressPct = (iterNumber / TOTAL_ITERS) * 100;

function bar(n: number, max: number, width = 40): string {
  if (!max) return '░'.repeat(width);
  const filled = Math.round((n / max) * width);
  return '█'.repeat(filled) + '░'.repeat(width - filled);
}

// sparkline of cumulative sessions
const lastN = cumPoints.slice(-50);
const maxCum = Math.max(...lastN.map((p) => p.cum), 1);
const spark = lastN.map((p) => {
  const filled = Math.round((p.cum / maxCum) * 8);
  return '▁▂▃▄▅▆▇█'[filled] || '▁';
}).join('');
---

<BaseLayout title="Milestone 180 · Agents">
  <Navbar />
  <main class="shell agents-shell">
    <nav class="agents-breadcrumb">
      <a href={`${base}/agents/`}>← 多智能体控制台</a>
      <span class="muted"> / milestone</span>
    </nav>

    <header class="agents-header">
      <h1>🎉 Milestone 180 iters! <span class="muted" style="font-size:0.6em">(iter #180)</span></h1>
      <p class="agents-sub">
        多智能体研究自动化系统已完成 <strong>180 次迭代</strong>。
        累计统计与里程碑一览。
      </p>
    </header>

    <section class="agents-session-section">
      <h2>📈 累计统计</h2>
      <div class="agents-mil-globals">
        <span>总 sessions: <strong>{totalSessions}</strong></span>
        <span>总 rounds: <strong>{totalRounds}</strong></span>
        <span>总 syntheses: <strong>{totalSyntheses}</strong></span>
        <span>总 tokens: <strong>{totalTokens.toLocaleString()}</strong></span>
        <span>总 promoted: <strong>{totalPromoted}</strong></span>
        <span>估算总成本: <strong>${sonnetCost.toFixed(2)}</strong></span>
        <span>系统年龄: <strong>{ageDays} 天</strong></span>
        <span>首 session: <strong>{oldestDate}</strong></span>
        <span>末 session: <strong>{newestDate}</strong></span>
      </div>
    </section>

    <section class="agents-session-section">
      <h2>🚀 iter 进度</h2>
      <div class="agents-mil-progress">
        <div class="agents-mil-progress-bar">
          <div class="agents-mil-progress-fill" style={`width: ${progressPct}%`}></div>
        </div>
        <p class="muted"><small>{iterNumber} / {TOTAL_ITERS} iters ({progressPct.toFixed(1)}%)</small></p>
      </div>
    </section>

    <section class="agents-session-section">
      <h2>📊 累计 sessions 增长(最近 50 天)</h2>
      <pre class="agents-mil-flow">{spark}</pre>
      <p class="muted"><small>每个字符 = 1 天的高度对应累积 sessions 数。</small></p>
    </section>

    <section class="agents-session-section">
      <h2>⚡ 效率</h2>
      <table class="agents-session-table">
        <thead>
          <tr><th>指标</th><th>值</th></tr>
        </thead>
        <tbody>
          <tr><td>平均 rounds/session</td><td>{totalSessions > 0 ? (totalRounds / totalSessions).toFixed(2) : '—'}</td></tr>
          <tr><td>平均 syntheses/session</td><td>{totalSessions > 0 ? (totalSyntheses / totalSessions).toFixed(2) : '—'}</td></tr>
          <tr><td>promoted/round</td><td>{(totalPromoted / Math.max(totalRounds, 1) * 100).toFixed(1)}%</td></tr>
          <tr><td>avg session cost</td><td>${avgSessionCost.toFixed(2)}</td></tr>
          <tr><td>avg round cost</td><td>${avgRoundCost.toFixed(3)}</td></tr>
          <tr><td>avg tokens/session</td><td>{totalSessions > 0 ? Math.round(totalTokens / totalSessions).toLocaleString() : '—'}</td></tr>
          <tr><td>avg tokens/round</td><td>{totalRounds > 0 ? Math.round(totalTokens / totalRounds).toLocaleString() : '—'}</td></tr>
        </tbody>
      </table>
    </section>

    <section class="agents-session-section">
      <h2>🏅 系统组件</h2>
      <p>多智能体研究自动化系统已包含以下模块:</p>
      <ul>
        <li>🎨 <strong>Designer</strong> — 生成 proposals</li>
        <li>🗣️ <strong>Feedback</strong>(3 personas)— 评审 proposals</li>
        <li>🚧 <strong>Gate</strong> — 决策 promoted / candidate / sketch / rejected</li>
        <li>🔧 <strong>Modifier</strong> — 应用 refinements</li>
        <li>📝 <strong>Reviewer</strong> — 同行评审</li>
        <li>✏️ <strong>Reviser</strong> — 修订</li>
        <li>📚 <strong>Knowledge Base</strong> — synthesis 知识库</li>
      </ul>
    </section>

    <section class="agents-session-section">
      <h2>📊 已建仪表板(180 个 iter)</h2>
      <p>从 iter #1 到 iter #180,我们构建了 100+ 个分析视图:</p>
      <ul>
        <li><a href={`${base}/agents/health-summary/`}>Health Summary</a> — 系统健康叙事</li>
        <li><a href={`${base}/agents/funnel/`}>Funnel</a> — 转化漏斗</li>
        <li><a href={`${base}/agents/pipeline-trace/`}>Pipeline Trace</a> — 7 阶段 trace</li>
        <li><a href={`${base}/agents/knowledge-base/`}>Knowledge Base</a> — 全文搜索</li>
        <li><a href={`${base}/agents/daily-burn/`}>Daily Burn</a> — token 节奏</li>
        <li><a href={`${base}/agents/goal-suggest/`}>Goal Suggest</a> — n-gram 方向建议</li>
        <li><a href={`${base}/agents/persona-elo/`}>Persona Elo</a> — 反馈轨迹</li>
        <li>... 还有 100+ 个其他视图</li>
      </ul>
    </section>

    <section class="agents-session-section">
      <h2>🎯 下一步目标</h2>
      <ul>
        <li>完成 iter #200(终极里程碑)</li>
        <li>实现真正"用户可用"工具 — auto-run pipeline</li>
        <li>export bundle 让用户能下载整个项目</li>
        <li>跨 session 推荐系统</li>
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .agents-mil-globals {
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
  }
  .agents-mil-globals strong {
    color: #4f46e5;
    font-family: ui-monospace, monospace;
    margin: 0 0.3rem;
  }
  .agents-mil-progress {
    background: rgba(99, 102, 241, 0.05);
    padding: 1rem;
    border-radius: 6px;
  }
  .agents-mil-progress-bar {
    width: 100%;
    height: 1.5rem;
    background: rgba(99, 102, 241, 0.1);
    border-radius: 4px;
    overflow: hidden;
    margin-bottom: 0.4rem;
  }
  .agents-mil-progress-fill {
    height: 100%;
    background: linear-gradient(90deg, #4f46e5, #10b981);
    border-radius: 4px;
    transition: width 0.3s ease;
  }
  .agents-mil-flow {
    background: rgba(0,0,0,0.4);
    color: #c9d1d9;
    padding: 0.8rem;
    border-radius: 4px;
    font-family: ui-monospace, "JetBrains Mono", monospace;
    font-size: 0.85rem;
    line-height: 1.5;
    overflow-x: auto;
    white-space: pre;
  }
</style>