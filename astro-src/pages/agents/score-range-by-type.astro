---
// /agents/score-range-by-type.astro — iter #323:score range per goal type
//
// 每个 goal type 的 final score 范围 + max - min spread:
//   - avg / min / max / range
//   - 看哪个 type 的结果最稳定 vs 最分散

import { readFile, readdir } from 'node:fs/promises';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import '../../styles/agents.css';

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');

const TYPE_KEYWORDS: Record<string, string[]> = {
  research: ['论文', '研究', '调研', '分析', 'paper', 'research', 'survey', 'review'],
  code: ['代码', '实现', '编程', 'code', 'implement', 'build', 'develop', 'api'],
  write: ['写', '文章', '博客', 'write', 'essay', 'blog', 'draft'],
  analyze: ['分析', '统计', 'analyze', 'analysis', 'statistics', 'metrics'],
  design: ['设计', '架构', 'design', 'architecture', 'plan'],
  other: [],
};

function classifyGoal(goal: string): string {
  const gl = goal.toLowerCase();
  for (const [type, kws] of Object.entries(TYPE_KEYWORDS)) {
    if (type === 'other') continue;
    for (const kw of kws) {
      if (gl.includes(kw.toLowerCase())) return type;
    }
  }
  return 'other';
}

interface TypeStat {
  name: string;
  count: number;
  scores: number[];
  avg: number;
  min: number;
  max: number;
  range: number;
}

const root = join(process.cwd(), 'archive');
const typeMap = new Map<string, TypeStat>();

for (const t of Object.keys(TYPE_KEYWORDS)) {
  typeMap.set(t, { name: t, count: 0, scores: [], avg: 0, min: 0, max: 0, range: 0 });
}

if (existsSync(root)) {
  const sids = await readdir(root).catch(() => []);
  for (const sid of sids) {
    const sp = join(root, sid);
    if (!existsSync(sp)) continue;
    const mp = join(sp, 'meta.json');
    if (!existsSync(mp)) continue;
    let goal = '';
    try { goal = JSON.parse(await readFile(mp, 'utf8')).goal ?? ''; } catch (e) { continue; }
    if (!goal) continue;
    const type = classifyGoal(goal);
    const t = typeMap.get(type)!;
    t.count += 1;

    const rd = join(sp, 'rounds');
    if (!existsSync(rd)) continue;
    const rfs = await readdir(rd).catch(() => []);
    const rNums: number[] = [];
    for (const rf of rfs) {
      const m = rf.match(/^round_(\d+)\.json$/);
      if (m) rNums.push(parseInt(m[1], 10));
    }
    if (rNums.length < 2) continue;
    rNums.sort((a, b) => a - b);
    try {
      const r = JSON.parse(await readFile(join(rd, `round_${rNums[rNums.length - 1]}.json`), 'utf8'));
      const arr: number[] = [];
      for (const persona of r.feedback?.personas ?? []) {
        for (const p of persona.proposals ?? []) {
          if (typeof p.total === 'number') arr.push(p.total);
        }
      }
      if (arr.length > 0) t.scores.push(arr.reduce((a, b) => a + b, 0) / arr.length);
    } catch (e) { /* */ }
  }
}

for (const t of typeMap.values()) {
  if (t.scores.length > 0) {
    t.avg = t.scores.reduce((a, b) => a + b, 0) / t.scores.length;
    t.min = Math.min(...t.scores);
    t.max = Math.max(...t.scores);
    t.range = t.max - t.min;
  }
}

const arr = [...typeMap.values()].filter((t) => t.count > 0).sort((a, b) => a.range - b.range);
---

<BaseLayout title="Score Range by Type · Agents">
  <Navbar />
  <main class="shell agents-shell">
    <nav class="agents-breadcrumb">
      <a href={`${base}/agents/`}>← 多智能体控制台</a>
      <span class="muted"> / score-range-by-type</span>
    </nav>

    <header class="agents-header">
      <h1>📏 Score Range by Type <span class="muted" style="font-size:0.6em">(iter #323)</span></h1>
      <p class="agents-sub">
        每个 goal type 的 final score 范围(avg/min/max/range)。
      </p>
    </header>

    <section class="agents-session-section">
      <h2>📋 详情</h2>
      <table class="agents-session-table">
        <thead>
          <tr><th>type</th><th>count</th><th>avg</th><th>min</th><th>max</th><th>range</th></tr>
        </thead>
        <tbody>
          {arr.map((t) => (
            <tr>
              <td><strong style="color:#4f46e5">{t.name}</strong></td>
              <td>{t.count}</td>
              <td><strong>{t.avg.toFixed(2)}</strong></td>
              <td>{t.min.toFixed(2)}</td>
              <td>{t.max.toFixed(2)}</td>
              <td>{t.range.toFixed(2)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="agents-session-section">
      <h2>💡 解读</h2>
      <ul>
        <li>range 小 = 该 type 系统表现稳定</li>
        <li>range 大 = 用户差异大,系统表现波动</li>
        <li>avg 高 + range 小 = 系统擅长且稳定</li>
        <li>avg 低 + range 大 = 系统在该 type 上不稳定</li>
        <li>对照 <a href={`${base}/agents/goal-type-score-matrix/`}>Goal Type × Score Matrix</a></li>
      </ul>
    </section>
  </main>
</BaseLayout>

