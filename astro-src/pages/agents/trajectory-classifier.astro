---
// /agents/trajectory-classifier.astro — iter #243:round trajectory classifier
//
// 对每个有 ≥3 round 的 session,分析其 score 轨迹并分类:
//   - improving (last > first by > 0.5)
//   - declining (last < first by > 0.5)
//   - plateau (|Δ| ≤ 0.5)
//   - peak-then-decline (max 在前半)
//   - U-shape (min 在前 1/3)
//   - inverted-U (max 在中段)

import { readFile, readdir } from 'node:fs/promises';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import '../../styles/agents.css';

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');

interface Trajectory {
  sid: string;
  scores: number[];
  type: string;
  first: number;
  last: number;
  maxIdx: number;
  minIdx: number;
}

const root = join(process.cwd(), 'archive');
const trajectories: Trajectory[] = [];

function classify(scores: number[]): { type: string; maxIdx: number; minIdx: number } {
  const n = scores.length;
  let maxIdx = 0;
  let minIdx = 0;
  for (let i = 1; i < n; i++) {
    if (scores[i] > scores[maxIdx]) maxIdx = i;
    if (scores[i] < scores[minIdx]) minIdx = i;
  }
  const first = scores[0];
  const last = scores[n - 1];
  const delta = last - first;
  if (Math.abs(delta) <= 0.5) {
    // plateau
    if (maxIdx === 0 || maxIdx === n - 1) return { type: 'plateau-flat', maxIdx, minIdx };
    return { type: 'plateau', maxIdx, minIdx };
  }
  if (delta > 0.5) {
    // improving
    if (minIdx < n / 3) return { type: 'U-shape (improve)', maxIdx, minIdx };
    if (maxIdx === n - 1) return { type: 'improving', maxIdx, minIdx };
    return { type: 'improving-then-stall', maxIdx, minIdx };
  }
  // declining
  if (maxIdx < n / 2) return { type: 'peak-then-decline', maxIdx, minIdx };
  if (maxIdx > (2 * n) / 3) return { type: 'inverted-U (decline)', maxIdx, minIdx };
  return { type: 'declining', maxIdx, minIdx };
}

if (existsSync(root)) {
  const sids = await readdir(root).catch(() => []);
  for (const sid of sids) {
    const rd = join(root, sid, 'rounds');
    if (!existsSync(rd)) continue;
    const rfs = await readdir(rd).catch(() => []);
    const rNum: number[] = [];
    for (const rf of rfs) {
      const m = rf.match(/^round_(\d+)\.json$/);
      if (m) rNum.push(parseInt(m[1], 10));
    }
    if (rNum.length < 3) continue;
    rNum.sort((a, b) => a - b);
    const scores: number[] = [];
    for (const rn of rNum) {
      try {
        const r = JSON.parse(await readFile(join(rd, `round_${rn}.json`), 'utf8'));
        const arr: number[] = [];
        for (const persona of r.feedback?.personas ?? []) {
          for (const p of persona.proposals ?? []) {
            if (typeof p.total === 'number') arr.push(p.total);
          }
        }
        scores.push(arr.length > 0 ? arr.reduce((a, b) => a + b, 0) / arr.length : 0);
      } catch (e) { /* */ }
    }
    if (scores.filter((s) => s > 0).length < 3) continue;
    const c = classify(scores);
    trajectories.push({
      sid, scores, type: c.type,
      first: scores[0], last: scores[scores.length - 1],
      maxIdx: c.maxIdx, minIdx: c.minIdx,
    });
  }
}

const total = trajectories.length;
const typeDist: Record<string, number> = {};
for (const t of trajectories) typeDist[t.type] = (typeDist[t.type] ?? 0) + 1;

const sortedTypes = Object.entries(typeDist).sort((a, b) => b[1] - a[1]);

function sparkline(values: number[]): string {
  const blocks = ['▁', '▂', '▃', '▄', '▅', '▆', '▇', '█'];
  const min = Math.min(...values);
  const max = Math.max(...values);
  const range = max - min;
  if (range === 0) return '▅'.repeat(values.length);
  return values.map((v) => blocks[Math.min(blocks.length - 1, Math.floor(((v - min) / range) * (blocks.length - 1)))]).join('');
}

function esc(s: any): string {
  return String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({ '&': '&', '<': '<', '>': '>', '"': '"', "'": '&#39;' }[c] || c));
}
function bar(n: number, max: number, width = 22): string {
  if (!max) return '░'.repeat(width);
  const filled = Math.round((n / max) * width);
  return '█'.repeat(filled) + '░'.repeat(width - filled);
}
---

<BaseLayout title="Trajectory Classifier · Agents">
  <Navbar />
  <main class="shell agents-shell">
    <nav class="agents-breadcrumb">
      <a href={`${base}/agents/`}>← 多智能体控制台</a>
      <span class="muted"> / trajectory-classifier</span>
    </nav>

    <header class="agents-header">
      <h1>📈 Trajectory Classifier <span class="muted" style="font-size:0.6em">(iter #243)</span></h1>
      <p class="agents-sub">
        对每个 ≥3 rounds 的 session,根据分数变化轨迹分类。
        类型:improving / declining / plateau / U-shape / peak-then-decline / inverted-U。
      </p>
    </header>

    <section class="agents-session-section">
      <h2>📊 全局</h2>
      <div class="agents-tc-globals">
        <span>可分类 sessions: <strong>{total}</strong></span>
      </div>
    </section>

    <section class="agents-session-section">
      <h2>📊 类型分布</h2>
      <pre class="agents-tc-flow">{sortedTypes.map(([type, count]) => {
        const max = sortedTypes[0][1];
        return `${type.padEnd(28)} ${bar(count, max, 22)}  ${count}  (${((count / total) * 100).toFixed(1)}%)`;
      }).join('\n')}</pre>
    </section>

    <section class="agents-session-section">
      <h2>📋 样本 sparkline(每个类型一条)</h2>
      <table class="agents-session-table">
        <thead>
          <tr><th>type</th><th>sparkline</th><th>rounds</th><th>Δ</th><th>sid</th></tr>
        </thead>
        <tbody>
          {sortedTypes.map(([type]) => {
            const sample = trajectories.find((t) => t.type === type);
            if (!sample) return null;
            return (
              <tr>
                <td>{type}</td>
                <td><code style="font-size:1.4em;color:#4f46e5">{sparkline(sample.scores)}</code></td>
                <td>{sample.scores.length}</td>
                <td><strong style={`color:${sample.last >= sample.first ? '#10b981' : '#ef4444'}`}>{sample.last >= sample.first ? '+' : ''}{(sample.last - sample.first).toFixed(2)}</strong></td>
                <td><a href={`${base}/agents/${sample.sid}/`}><code>{esc(sample.sid.slice(0, 12))}</code></a></td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </section>

    <section class="agents-session-section">
      <h2>💡 解读</h2>
      <ul>
        <li>improving:last &gt; first by &gt; 0.5</li>
        <li>declining:last &lt; first by &gt; 0.5</li>
        <li>plateau:|Δ| ≤ 0.5(可能是已收敛)</li>
        <li>U-shape:先降后升(可能撞墙后反弹)</li>
        <li>peak-then-decline:max 在前半(可能过拟合)</li>
        <li>对照 <a href={`${base}/agents/round-score-trajectory/`}>Round Score Trajectory</a> 看单 session 曲线</li>
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .agents-tc-globals {
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
  }
  .agents-tc-globals strong {
    color: #4f46e5;
    font-family: ui-monospace, monospace;
    margin: 0 0.3rem;
  }
  .agents-tc-flow {
    background: rgba(0,0,0,0.4);
    color: #c9d1d9;
    padding: 0.8rem;
    border-radius: 4px;
    font-family: ui-monospace, "JetBrains Mono", monospace;
    font-size: 0.78rem;
    line-height: 1.4;
    overflow-x: auto;
    white-space: pre;
  }
</style>