---
// /agents/session-creation-time.astro — iter #322:session creation time distribution
//
// 看 sessions 是什么时候创建的(基于 round_1.json 的 mtime):
//   - 按月 / 按周 / 按天的分布
//   - 看出系统使用的高峰期

import { readFile, readdir, stat } from 'node:fs/promises';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import '../../styles/agents.css';

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');

const root = join(process.cwd(), 'archive');
const timestamps: number[] = [];

if (existsSync(root)) {
  const sids = await readdir(root).catch(() => []);
  for (const sid of sids) {
    const rd = join(root, sid, 'rounds');
    if (!existsSync(rd)) continue;
    const rfs = await readdir(rd).catch(() => []);
    const rNums: number[] = [];
    for (const rf of rfs) {
      const m = rf.match(/^round_(\d+)\.json$/);
      if (m) rNums.push(parseInt(m[1], 10));
    }
    if (rNums.length === 0) continue;
    rNums.sort((a, b) => a - b);
    try {
      const fp = join(rd, `round_${rNums[0]}.json`);
      const st = await stat(fp);
      timestamps.push(st.mtimeMs);
    } catch (e) { /* */ }
  }
}

const total = timestamps.length;
timestamps.sort((a, b) => a - b);
const minDate = total > 0 ? new Date(timestamps[0]) : new Date();
const maxDate = total > 0 ? new Date(timestamps[timestamps.length - 1]) : new Date();
const spanDays = total > 0 ? Math.ceil((timestamps[timestamps.length - 1] - timestamps[0]) / (24 * 60 * 60 * 1000)) : 1;

// 按周分桶(ISO week)
const weekMap = new Map<string, number>();
for (const t of timestamps) {
  const d = new Date(t);
  const year = d.getUTCFullYear();
  const start = new Date(Date.UTC(year, 0, 1));
  const days = Math.floor((d.getTime() - start.getTime()) / (24 * 60 * 60 * 1000));
  const week = Math.floor((days + start.getUTCDay()) / 7);
  const key = `${year}-W${week.toString().padStart(2, '0')}`;
  weekMap.set(key, (weekMap.get(key) ?? 0) + 1);
}

const weeks = [...weekMap.entries()].sort((a, b) => a[0].localeCompare(b[0]));

const maxWeek = Math.max(...weeks.map((w) => w[1]), 1);

function bar(n: number, max: number, width = 30): string {
  if (!max) return '░'.repeat(width);
  const filled = Math.round((n / max) * width);
  return '█'.repeat(filled) + '░'.repeat(width - filled);
}
---

<BaseLayout title="Session Creation Time · Agents">
  <Navbar />
  <main class="shell agents-shell">
    <nav class="agents-breadcrumb">
      <a href={`${base}/agents/`}>← 多智能体控制台</a>
      <span class="muted"> / session-creation-time</span>
    </nav>

    <header class="agents-header">
      <h1>📅 Session Creation Time <span class="muted" style="font-size:0.6em">(iter #322)</span></h1>
      <p class="agents-sub">
        sessions 首次 round 的 mtime 分布(按 ISO 周聚合)。
      </p>
    </header>

    <section class="agents-session-section">
      <h2>📊 全局</h2>
      <div class="agents-sct-globals">
        <span>总 sessions: <strong>{total}</strong></span>
        <span>首 session: <strong>{minDate.toISOString().slice(0, 10)}</strong></span>
        <span>末 session: <strong>{maxDate.toISOString().slice(0, 10)}</strong></span>
        <span>跨度: <strong>{spanDays}</strong> 天</span>
      </div>
    </section>

    <section class="agents-session-section">
      <h2>📅 按 ISO 周分布</h2>
      <pre class="agents-sct-flow">{weeks.map(([key, count]) => {
        return `${key}  ${bar(count, maxWeek, 22)}  ${count}`;
      }).join('\n')}</pre>
    </section>

    <section class="agents-session-section">
      <h2>💡 解读</h2>
      <ul>
        <li>分布看出系统使用模式 — 是连续高强度还是间断使用</li>
        <li>跨度大 = 长期使用 / 跨度小 = 短期内完成</li>
        <li>对照 <a href={`${base}/agents/daily-pulse/`}>Daily Pulse</a> 看日级</li>
        <li>对照 <a href={`${base}/agents/cost-cumulative-curve/`}>Cost Cumulative Curve</a></li>
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .agents-sct-globals {
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
  }
  .agents-sct-globals strong {
    color: #4f46e5;
    font-family: ui-monospace, monospace;
    margin: 0 0.3rem;
  }
  .agents-sct-flow {
    background: rgba(0,0,0,0.4);
    color: #c9d1d9;
    padding: 0.8rem;
    border-radius: 4px;
    font-family: ui-monospace, "JetBrains Mono", monospace;
    font-size: 0.78rem;
    line-height: 1.4;
    overflow-x: auto;
    white-space: pre;
  }
</style>