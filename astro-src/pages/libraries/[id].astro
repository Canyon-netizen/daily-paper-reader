---
// /libraries/<id>/ — 单库工作台(3 tab 版,对照 Polaris /libraries/:id WikiWorkbench)
//
// 三个 tab,沿用 URL hash 切换 #papers / #concepts / #notes,无 JS 也能切。
//
//   - 论文库 tab(PapersTab 同构):左列表 + 右详情,view filter + 行内 chip
//     (星标 / 阅读状态 / 笔记数 / 概念数)+ 详情面板提供打开论文页 +
//     写笔记入口 + 概念 chips 链到 /wiki/concepts/<slug>/
//   - 概念库 tab(ConceptsTab 同构):左 chip 按 category 过滤,右 grid 显示
//     高频概念(去重 slug)+ 命中论文数
//   - 笔记 tab(NotesTab 同构):列出库内论文,每行链到详情页"📝 写笔记"位置
//
// 不复刻 Polaris 的图谱 / 每日简报 / 文献对话 / 治理 / 摘要 / ingest / chat
// —— 8 个 tab 完整版需要 LLM 能力 + 后端 storage。我们走"无后端 + frontmatter
// 派生"模式,只保留有数据来源的 3 tab。

import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { defaultPaperRepository } from '../../lib/paper-repository';
import { getLibrary, LIBRARIES, selectLibraryPapers } from '../../lib/libraries';
import '../../styles/library-workbench.css';

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');

export async function getStaticPaths() {
  return LIBRARIES.map((lib) => ({ params: { id: lib.id } }));
}

const { id } = Astro.params;
const lib = getLibrary(id!);

if (!lib) {
  return Astro.redirect(base + '/libraries/');
}

const items = await defaultPaperRepository.list({ sortBy: 'date' });
const papers = selectLibraryPapers(items, lib)
  .sort((a, b) => (b.date || '').localeCompare(a.date || ''));

interface ConceptHit { slug: string; display_name: string; category: string; n: number }
const conceptMap = new Map<string, ConceptHit>();
for (const p of papers) {
  const cats = p.concepts;
  if (!Array.isArray(cats)) continue;
  for (const c of cats) {
    if (!c?.slug) continue;
    const cur = conceptMap.get(c.slug);
    if (cur) cur.n++;
    else conceptMap.set(c.slug, { slug: c.slug, display_name: c.display_name, category: c.category, n: 1 });
  }
}
const topConcepts = Array.from(conceptMap.values()).sort((a, b) => b.n - a.n);

const notesPapers = papers.map((p) => ({
  id: p.id,
  canonicalArxivId: p.canonicalArxivId,
  titleZh: p.title_zh || p.title_plain || p.title || p.id,
  titleEn: p.title,
  date: p.date,
  arxivId: p.arxivId,
}));

const todayStr = new Date().toISOString().slice(0, 10);
const newTodayCount = papers.filter((p) => p.date === todayStr).length;

const libraryPrefix = `${lib.id}-library`;
const memberCxList = papers.map((p) => p.canonicalArxivId).filter(Boolean);

const conceptCategories = [
  { v: 'all', label: '全部' },
  { v: 'method', label: 'method · 方法' },
  { v: 'architecture', label: 'architecture · 架构' },
  { v: 'methodology', label: 'methodology · 方法论' },
  { v: 'problem', label: 'problem · 问题' },
  { v: 'metric', label: 'metric · 指标' },
  { v: 'dataset', label: 'dataset · 数据集' },
  { v: 'other', label: 'other · 其他' },
];

const selectedPaper = papers[0];
---

<BaseLayout
  title={`${lib.title} 文献库 · Daily Paper Reader`}
  description={`${lib.descriptionZh} · 共 ${papers.length} 篇论文。`}
>
  <Navbar />

  <main class={`library-workbench hue-${lib.hue}`}>
    <header class="library-wb-hero">
      <div>
        <h1>{lib.title}</h1>
        <p class="lib-wb-zh">{lib.titleZh}</p>
        <p class="lib-wb-desc">{lib.description} — {lib.descriptionZh}</p>
        <div class="library-wb-meta">
          <span><span class="meta-num">{papers.length}</span> 篇论文</span>
          <span><span class="meta-num">{topConcepts.length}</span> 个高频概念</span>
          <span>维护 · {lib.curator}</span>
        </div>
      </div>
      <div class="library-wb-export">
        <a class="export-btn" href="#" data-library-export-target="bibtex">📄 导出 references.bib</a>
        <a class="export-btn" href="#" data-library-export-target="csl">📋 导出 library.csl.json</a>
        <a class="export-btn primary" href="#" data-library-export-target="obsidian">📦 导出 my-library.zip</a>
        <span id="lib-export-hint" class="export-hint"></span>
      </div>
    </header>

    <nav class="library-wb-tabs" aria-label="tab 切换">
      <a class="lib-wb-tab active" href="#papers" data-tab="papers">📄 论文库 <span class="tab-count">{papers.length}</span></a>
      <a class="lib-wb-tab" href="#concepts" data-tab="concepts">🕸 概念库 <span class="tab-count">{topConcepts.length}</span></a>
      <a class="lib-wb-tab" href="#notes" data-tab="notes">📝 笔记 <span class="tab-count">—</span></a>
      <a class="back" href={base + '/libraries/'}>← 所有文献库</a>
    </nav>

    {/* ===== 论文库 tab:左列表 + 右详情 =====
        设计:SSR 渲染所有论文的详情面板,只用 CSS :target 切换可见性。
        优点:零 JS,任意点行都立刻响应;用户在另一个 tab 切回论文库 tab,选中态
        仍然是上一次点的(URL hash 持久)。 */}
    <section id="papers-panel" class="library-wb-panel active" data-panel="papers">
      <div class="wb-papers">
        <div class="wb-papers-list">
          <div class="wb-papers-filter">
            <a class="filter-pill active" data-view="all" href="#papers">全部 {papers.length}</a>
            <a class="filter-pill" data-view="today" href="#papers">今日 {newTodayCount}</a>
          </div>
          <div class="wb-papers-sort">
            <span class="sort-label">排序</span>
            <a class="filter-pill active" data-sort="date" href="#papers">📅 按时间</a>
            <a class="filter-pill" data-sort="score" href="#papers">⭐ 按相关度</a>
          </div>
          {papers.map((p, i) => {
            const conceptsHere = p.concepts?.length || 0;
            return (
              <a class={`wb-paper-row${i === 0 ? ' is-selected' : ''}`}
                 href={`#paper-${p.canonicalArxivId}`}
                 data-paper-id={p.canonicalArxivId}>
                <div class="row-head">
                  <span class="arx">{p.arxivId || '—'}</span>
                  {p.date ? <span>{p.date.slice(5)}</span> : null}
                  <span class="year">{p.date?.slice(0, 4) || '—'}</span>
                  {typeof p.score === 'number' && p.score > 0 && (
                    <span class="row-score" data-score={p.score}>{p.score.toFixed(2)}</span>
                  )}
                </div>
                <p class="row-title">{p.title_zh || p.title_plain || p.title || p.id}</p>
                {p.title && p.title_zh && <p class="row-en">{p.title}</p>}
                <div class="row-chips">
                  {conceptsHere > 0 && <span class="row-chip">🕸 {conceptsHere} 概念</span>}
                  <span class="row-chip">📅 {p.date || '—'}</span>
                </div>
              </a>
            );
          })}
        </div>

        {/* 详情面板:每个 paper 渲染一个隐藏 div,用 :target 显示。
            第一个 (.wb-detail-default) 默认显示;之后用 #paper-<cx> 锚点切换。 */}
        <div class="wb-paper-detail" id="wb-detail-pane">
          {papers.length === 0 ? (
            <p class="empty">没有可显示的论文</p>
          ) : (
            papers.map((p, i) => (
              <div id={`paper-${p.canonicalArxivId}`}
                   class={`wb-detail-body${i === 0 ? ' wb-detail-default' : ''}`}>
                {/* ===== 1. 元数据头:pills + 标题 + 作者 + 评分环 ===== */}
                <div class="detail-head">
                  <div class="detail-head-text">
                    <div class="detail-pills">
                      <span class="pill pill-status">已纳入</span>
                      {p.tldr && <span class="pill pill-wiki">✨ wiki</span>}
                      {p.pdf && <span class="pill pill-pdf">📄 PDF</span>}
                      {p.venue && <span class="pill pill-venue">{p.venue}</span>}
                    </div>
                    <h2>{p.title_zh || p.title_plain || p.title || p.id}</h2>
                    {p.title && p.title_zh && <p class="detail-en">{p.title}</p>}
                    {p.authors && <p class="detail-authors">{p.authors}</p>}
                    <div class="detail-meta">
                      {p.arxivId && (
                        <a href={`https://arxiv.org/abs/${p.arxivId.replace(/v\d+$/, '')}`}
                           target="_blank" rel="noopener">arXiv:{p.arxivId}</a>
                      )}
                      <span>{p.date || '—'}</span>
                      {p.venue && <span class="pill pill-venue-sm">{p.venue}</span>}
                      {p.source && p.source !== 'arxiv' && <span class="pill pill-source-sm">{p.source}</span>}
                    </div>
                  </div>
                  {typeof p.score === 'number' && p.score > 0 && (
                    <div class="score-ring" aria-label={`相关度 ${p.score.toFixed(2)}`}>
                      <svg viewBox="0 0 64 64" width="64" height="64">
                        <circle cx="32" cy="32" r="28" fill="none" stroke="var(--bg-muted)" stroke-width="4" />
                        <circle cx="32" cy="32" r="28" fill="none" stroke="var(--accent)" stroke-width="4"
                                stroke-dasharray={`${(p.score * 175.93).toFixed(1)} 175.93`}
                                stroke-linecap="round" transform="rotate(-90 32 32)" />
                      </svg>
                      <span class="score-ring-label">{p.score.toFixed(2)}</span>
                      <span class="score-ring-sub">相关度</span>
                    </div>
                  )}
                </div>

                {/* ===== 2. 操作按钮 ===== */}
                <div class="detail-row detail-actions">
                  <a class="export-btn primary" href={base + '/papers/' + p.id + '/'}>📖 阅读原文</a>
                  <a class="export-btn" href={base + '/papers/' + p.id + '/#paper-notes-section'}>📝 写笔记</a>
                  {p.pdf && (
                    <a class="export-btn" href={p.pdf} target="_blank" rel="noopener">🔗 arXiv PDF</a>
                  )}
                  <a class="export-btn" href={base + '/libraries/'}>📂 所有文献库</a>
                </div>


                {/* ===== 2.5 分类块:venue / task / method / type chips ===== */}
                {p.categories && (() => {
                  const cats = p.categories as { venue?: string[]; task?: string[]; method?: string[]; type?: string[] };
                  const all = [
                    ...(cats.venue || []).map((x) => ({ dim: 'venue', label: x })),
                    ...(cats.task || []).map((x) => ({ dim: 'task', label: x })),
                    ...(cats.method || []).map((x) => ({ dim: 'method', label: x })),
                    ...(cats.type || []).map((x) => ({ dim: 'type', label: x })),
                  ];
                  if (all.length === 0) return null;
                  return (
                    <div class="detail-categories">
                      {all.map((c) => (
                        <span class={`detail-cat detail-cat-${c.dim}`}>{c.label}</span>
                      ))}
                    </div>
                  );
                })()}
                {p.accepted && <p class="detail-accepted">✓ 已收录</p>}
                {/* ===== 3. TL;DR 卡片 ===== */}
                {p.tldr && (
                  <div class="tldr-card">
                    <span class="tldr-label">TL;DR</span>
                    <p>{p.tldr}</p>
                  </div>
                )}

                {/* ===== 4. 概念 chips(过多时折叠) ===== */}
                {p.concepts && p.concepts.length > 0 && (() => {
                  const limit = 12;
                  const overflow = p.concepts.length > limit;
                  return (
                    <details class="detail-section" open={p.concepts.length <= limit}>
                      <summary>概念 · {p.concepts.length} 个</summary>
                      <div class="concepts-chips">
                        {(overflow ? p.concepts.slice(0, limit) : p.concepts).map((c) => (
                          <a class="cc" href={base + '/wiki/concepts/' + c.slug + '/'}>{c.display_name}</a>
                        ))}
                        {overflow && <span class="cc cc-overflow">+{p.concepts.length - limit} 个</span>}
                      </div>
                    </details>
                  );
                })()}

                {/* ===== 5. 摘要 + meta 折叠区 ===== */}
                <details class="detail-section">
                  <summary>摘要</summary>
                  {p.evidence ? (
                    <p class="detail-abstract">{p.evidence}</p>
                  ) : (
                    <p class="empty muted">这篇还没有摘要。</p>
                  )}
                </details>

                {/* ===== 6. 我的笔记(SSR 不可见,只占位) ===== */}
                <details class="detail-section">
                  <summary>我的笔记</summary>
                  <p class="empty muted">
                    笔记存在浏览器 localStorage,SSR 无法读取。<br />
                    <a href={base + '/papers/' + p.id + '/#paper-notes-section'}>→ 去论文页底部写笔记 / 读笔记</a>
                  </p>
                </details>

                {/* ===== 7. 元信息折叠区 ===== */}
                <details class="detail-section">
                  <summary>元信息</summary>
                  <dl class="detail-meta-table">
                    {p.arxivId && <><dt>arXiv</dt><dd class="mono">{p.arxivId}</dd></>}
                    {p.date && <><dt>发布日期</dt><dd class="mono">{p.date}</dd></>}
                    {p.pdf && <><dt>PDF</dt><dd><a href={p.pdf} target="_blank" rel="noopener" class="mono">{p.pdf}</a></dd></>}
                    {typeof p.score === 'number' && <><dt>相关度</dt><dd class="mono">{p.score.toFixed(3)}</dd></>}
                  </dl>
                </details>
              </div>
            ))
          )}
        </div>
      </div>
    </section>

    {/* ===== 概念库 tab ===== */}
    <section id="concepts-panel" class="library-wb-panel" data-panel="concepts">
      <div class="wb-concepts">
        <div class="wb-concepts-filter">
          {conceptCategories.map((c) => {
            const n = c.v === 'all' ? topConcepts.length : topConcepts.filter((x) => x.category === c.v).length;
            return (
              <a class="filter-pill" href="#concepts" data-cat={c.v}>
                <span>{c.label}</span>
                <span>{n}</span>
              </a>
            );
          })}
        </div>
        <div class="wb-concepts-grid">
          {topConcepts.map((c) => (
            <a class="wb-concepts-card" href={base + '/wiki/concepts/' + c.slug + '/'} data-cat={c.category}>
              <p class="cc-name">{c.display_name}</p>
              <div class="cc-meta">
                <span>×{c.n} 篇</span>
              </div>
              <p class="cc-cat">{c.category}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    {/* ===== 笔记 tab ===== */}
    <section id="notes-panel" class="library-wb-panel" data-panel="notes">
      <div class="wb-notes">
        <p class="empty">
          笔记在每篇论文的 <a href={base + '/papers/'}>详情页</a> 底部写。
          选中下面的论文直接进入"📝 写笔记"位置。
        </p>
        {notesPapers.slice(0, 50).map((p) => (
          <a class="wb-note-row" href={base + '/papers/' + p.id + '/#paper-notes-section'}>
            <div class="note-head">
              <span>{p.arxivId || '—'}</span>
              <span>{p.date?.slice(5) || '—'}</span>
            </div>
            <p class="note-title">{p.titleZh}</p>
            {p.titleEn && p.titleEn !== p.titleZh && <p class="note-body">{p.titleEn}</p>}
          </a>
        ))}
      </div>
    </section>

    {/* 导出数据载体 — export-bridge 读这个 */}
    <section
      id="library-wb-data"
      aria-hidden="true"
      data-cx={JSON.stringify(memberCxList)}
      data-prefix={libraryPrefix}
      data-hint-id="lib-export-hint"
    ></section>
  </main>

  <Footer />

  <script>
    import '../../scripts/export-bridge.ts';
    import { initLibraryExportButtons } from '../../scripts/export-bridge';
    initLibraryExportButtons();

    type Tab = 'papers' | 'concepts' | 'notes';
    const VALID: Tab[] = ['papers', 'concepts', 'notes'];

    function setActiveTab(tab: Tab) {
      document.querySelectorAll<HTMLAnchorElement>('.lib-wb-tab').forEach((t) => {
        t.classList.toggle('active', (t.dataset.tab || '') === tab);
      });
      document.querySelectorAll<HTMLElement>('.library-wb-panel').forEach((p) => {
        p.classList.toggle('active', p.dataset.panel === tab);
      });
    }

    function syncFromHash() {
      const m = window.location.hash.match(/^#(papers|concepts|notes)$/);
      if (m) setActiveTab(m[1] as Tab);
    }

    window.addEventListener('hashchange', syncFromHash);
    document.querySelectorAll<HTMLAnchorElement>('.lib-wb-tab').forEach((t) => {
      t.addEventListener('click', () => {
        const tab = (t.dataset.tab || '') as Tab;
        if (VALID.includes(tab)) setActiveTab(tab);
      });
    });

    // 论文库 tab:论文行点击 → 选中态切换。
    // 详情面板用 CSS :target(纯 SSR):用户的锚点 #paper-<cx> 命中对应 panel 显示。
    // 这里 JS 只负责高亮行(.is-selected)+ 滚动到详情(若需要)。
    document.querySelectorAll<HTMLAnchorElement>('.wb-paper-row').forEach((row) => {
      row.addEventListener('click', () => {
        document.querySelectorAll('.wb-paper-row').forEach((r) => r.classList.remove('is-selected'));
        row.classList.add('is-selected');
      });
    });

    // 论文库 tab:view filter 切 row
    document.querySelectorAll<HTMLAnchorElement>('.wb-papers-filter .filter-pill').forEach((p) => {
      p.addEventListener('click', (e) => {
        e.preventDefault();
        document.querySelectorAll('.wb-papers-filter .filter-pill').forEach((b) => b.classList.toggle('active', b === p));
        const view = p.dataset.view;
        document.querySelectorAll<HTMLElement>('.wb-paper-row').forEach((row) => {
          const date = row.querySelector('.row-head > span:nth-child(2)')?.textContent || '';
          const show = view === 'all' || (view === 'today' && /\d{2}-\d{2}/.test(date));
          row.style.display = show ? '' : 'none';
        });
      });
    });

    // 排序按钮(按时间 / 按相关度)—— 真的重排 DOM。
    // 用 data-score 字段读分数,没有视为 0;按分数降序;同分按 date 降序。
    document.querySelectorAll<HTMLAnchorElement>('.wb-papers-sort .filter-pill').forEach((p) => {
      p.addEventListener('click', (e) => {
        e.preventDefault();
        document.querySelectorAll('.wb-papers-sort .filter-pill').forEach((b) => b.classList.toggle('active', b === p));
        const sort = p.dataset.sort;
        const list = document.querySelector('.wb-papers-list');
        if (!list) return;
        const rows = Array.from(list.querySelectorAll<HTMLElement>('.wb-paper-row'));
        rows.sort((a, b) => {
          if (sort === 'score') {
            const sa = parseFloat(a.querySelector<HTMLElement>('.row-score')?.dataset.score || '0');
            const sb = parseFloat(b.querySelector<HTMLElement>('.row-score')?.dataset.score || '0');
            if (sb !== sa) return sb - sa;
          }
          // 同分(或按时间):fallback 到 date 字段(第 2 个 span)
          const da = a.querySelector('.row-head > span:nth-child(2)')?.textContent || '';
          const db = b.querySelector('.row-head > span:nth-child(2)')?.textContent || '';
          return db.localeCompare(da);
        });
        const frag = document.createDocumentFragment();
        rows.forEach((r) => frag.appendChild(r));
        list.appendChild(frag);
      });
    });

    // 概念库 tab:category 过滤
    document.querySelectorAll<HTMLAnchorElement>('.wb-concepts-filter .filter-pill').forEach((p) => {
      p.addEventListener('click', (e) => {
        e.preventDefault();
        document.querySelectorAll('.wb-concepts-filter .filter-pill').forEach((b) => b.classList.toggle('active', b === p));
        const cat = p.dataset.cat;
        document.querySelectorAll<HTMLElement>('.wb-concepts-card').forEach((card) => {
          const show = cat === 'all' || card.dataset.cat === cat;
          card.style.display = show ? '' : 'none';
        });
      });
    });

    syncFromHash();
  </script>
</BaseLayout>