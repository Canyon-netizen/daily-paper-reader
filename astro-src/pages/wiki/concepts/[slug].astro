---
// pages/wiki/concepts/[slug].astro
// 概念详情页 — 真值来自 docs/papers/ frontmatter 的 concepts 段。
//
// 关键设计(plan §阶段 9):
//   - 真数据源是 git-tracked 的 docs/papers/*.md frontmatter,不依赖 gitignored 的 wiki/concepts/
//   - SSR-only:getStaticPaths 直接走 buildConceptIndex(),不走 _index.json / _graph.json
//   - 一个 slug 一页,含 display_name / category / paper_count / 引用论文列表 / 共现相关概念
//   - 渲染走纯 HTML,无客户端脚本

import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import {
  getAllConceptSlugs,
  getConceptDetail,
} from '../../../lib/concept-detail';
import { sparklinePoints } from '../../../lib/concepts/version';
import ConceptEditModal from '../../../components/ConceptEditModal.astro';
import '../../../styles/page.css';

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');

export async function getStaticPaths() {
  const slugs = await getAllConceptSlugs();
  return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const slugStr = String(slug || '').trim();
const detail = slugStr ? await getConceptDetail(slugStr) : null;
const meta = detail?.entry || null;
const related = detail?.related || [];
const citingPapers = detail?.citingPapers || [];
const recentHistory = detail?.recentHistory || [];

// G.2.1: 按 category 分组 related,每组按 co_count 降序(已经在 lib 里排过)。
const relatedGroups: { category: string; items: typeof related }[] = [];
{
  const groups = new Map<string, typeof related>();
  for (const r of related) {
    if (!groups.has(r.category)) groups.set(r.category, []);
    groups.get(r.category)!.push(r);
  }
  const sortedCats = Array.from(groups.keys()).sort();
  for (const cat of sortedCats) {
    relatedGroups.push({ category: cat, items: groups.get(cat)! });
  }
}

// G.2.2: 算 sparkline points
const sparklinePts = recentHistory.length >= 2
  ? sparklinePoints(recentHistory, 300, 60)
  : '';
const sparklineMax = recentHistory.length > 0
  ? Math.max(...recentHistory.map((s) => s.paper_count), 1)
  : 0;

// G.3.3: 准备 local subgraph data(本 concept + top 相关 → cytoscape 渲染)
// 把 related 转成 cytoscape elements 格式
const graphData = {
  centerSlug: slugStr,
  nodes: [
    { id: slugStr, label: meta?.display_name || slugStr, weight: meta?.paper_count || 1, category: meta?.category || 'other' },
    ...related.slice(0, 30).map((r) => ({
      id: r.slug,
      label: r.display_name,
      weight: r.paper_count,
      category: r.category,
    })),
  ],
  edges: related.slice(0, 30).map((r) => ({
    source: slugStr,
    target: r.slug,
    weight: r.co_count,
  })),
};
---

<BaseLayout
  title={`${meta?.display_name || slugStr} · 概念图谱`}
  description={meta ? `Daily Paper Reader 概念图谱:${meta.display_name} (${meta.category},${meta.paper_count} 篇论文)。` : '概念详情'}
>
  <Navbar />

  <main class="concepts-page">
    <a class="concepts-back" href={base + '/concepts/'}>← 返回概念图谱</a>

    {meta ? (
      <>
        <header class="concept-detail-head">
          <h1>{meta.display_name}</h1>
          <div class="concept-detail-meta">
            <span class="concept-cat">{meta.category}</span>
            <span class="concept-count">{meta.paper_count} 篇论文</span>
            {meta.novelty > 0 && (
              <span class="concept-stat">novelty {meta.novelty.toFixed(2)}</span>
            )}
            {meta.centrality > 0 && (
              <span class="concept-stat">centrality {meta.centrality.toFixed(2)}</span>
            )}
          </div>
          <p class="concept-detail-slug">
            slug: <code>{meta.slug}</code>
          </p>
          {/* G.3.2: 编辑 modal 入口 */}
          <ConceptEditModal
            slug={meta.slug}
            display_name={meta.display_name}
            category={meta.category}
            novelty={meta.novelty}
            centrality={meta.centrality}
          />
        </header>

        <section class="concept-detail-body">
          {/* G.2.2: 概念热度趋势(近 90 天 sparkline) */}
          {recentHistory.length >= 2 && (
            <section class="concept-evolution">
              <h2>概念热度趋势(近 90 天)</h2>
              <p class="concept-detail-empty">
                引用此概念的论文数随时间变化。共 {recentHistory.length} 个数据点,峰值 {sparklineMax} 篇/天。
              </p>
              <svg class="concept-sparkline" viewBox="0 0 300 60" preserveAspectRatio="none">
                <polyline
                  points={sparklinePts}
                  fill="none"
                  stroke="var(--accent)"
                  stroke-width="1.5"
                  stroke-linejoin="round"
                />
              </svg>
            </section>
          )}

          {citingPapers.length > 0 && (
            <article class="concept-detail-section">
              <h2>引用本概念的论文({citingPapers.length})</h2>
              <ul class="concept-paper-list">
                {citingPapers.map((p) => (
                  <li class="concept-paper-item">
                    <a class="concept-paper-link" href={base + '/papers/' + p.id.split('/').pop()}>
                      {p.title_zh || p.title || p.id}
                    </a>
                    {p.title_zh && p.title && (
                      <span class="concept-paper-en">{p.title}</span>
                    )}
                    {p.canonicalArxivId && (
                      <span class="concept-paper-arxiv">arXiv {p.canonicalArxivId}</span>
                    )}
                  </li>
                ))}
              </ul>
            </article>
          )}

          {related.length > 0 && (
            <article class="concept-detail-section">
              <h2>概念关系可视化</h2>
              <p class="concept-detail-empty">
                本概念与共现相关概念的局部图(中心节点 = 本概念,周围节点 = 高频共现概念,
                边粗细 = 共现论文数)。点击节点跳转到对应概念。
              </p>
              <div class="concept-cy" id="concept-cy" data-graph={JSON.stringify(graphData)}></div>
              <noscript>
                <p class="concept-detail-empty">需要启用 JavaScript 才能看到关系图。</p>
              </noscript>
            </article>
          )}

          {related.length > 0 && (
            <article class="concept-detail-section concept-related">
              <h2>共现相关概念</h2>
              <p class="concept-detail-empty">
                在引用本概念的论文中,与下列概念同时出现的次数(降序)。
              </p>
              {relatedGroups.map((g) => (
                <section class="concept-related-group">
                  <h3 class="concept-related-cat">
                    {g.category}
                    <span class="concept-related-cat-count">{g.items.length}</span>
                  </h3>
                  <ul class="concept-graph">
                    {g.items.slice(0, 10).map((r) => (
                      <li class="concept-graph-item">
                        <a href={base + '/wiki/concepts/' + r.slug}>
                          <span class="concept-graph-name">{r.display_name}</span>
                          <span class="co-count">{r.co_count} 次共现</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </section>
              ))}
            </article>
          )}

          {citingPapers.length === 0 && related.length === 0 && (
            <p class="concept-detail-empty">
              该概念暂无引用论文或共现概念。检查 frontmatter <code>concepts</code> 段是否正确填入。
            </p>
          )}
        </section>
      </>
    ) : (
      <section class="concept-detail-empty">
        <h1>概念「{slugStr}」暂未收录</h1>
        <p>该 slug 不在 <code>docs/papers/</code> frontmatter 的 <code>concepts</code> 段中。
          新增论文或修正 slug 后,重跑 <code>bun run build</code> 即可。</p>
      </section>
    )}
  </main>

  <Footer />
</BaseLayout>

<script>
  // G.3.3: 概念关系图(cytoscape + fcose 持续受力模拟)
  // 与 /concepts 页不同的是:这里只画本概念 + top 30 相关,中心节点固定,
  // 点击节点跳到对应概念详情页。
  const cyEl = document.getElementById('concept-cy') as HTMLDivElement | null;
  if (cyEl) {
    const raw = cyEl.getAttribute('data-graph') || '{}';
    let graphData: { centerSlug?: string; nodes: { id: string; label: string; weight: number; category: string }[]; edges: { source: string; target: string; weight: number }[] };
    try {
      graphData = JSON.parse(raw);
    } catch {
      return;
    }
    if (!graphData.nodes || graphData.nodes.length === 0) return;

    (async () => {
      let cytoscape: any;
      let fcose: any;
      try {
        cytoscape = (await import('cytoscape')).default;
        fcose = (await import('cytoscape-fcose')).default;
      } catch (e) {
        console.warn('[concept-cy] cytoscape/fcose not available:', e);
        return;
      }
      cytoscape.use(fcose);

      const categoryColor: Record<string, string> = {
        method: '#7c5cff',
        problem: '#ef4444',
        dataset: '#0891b2',
        metric: '#059669',
        methodology: '#d97706',
        task: '#0284c7',
        other: '#9ca3af',
      };

      const cy = cytoscape({
        container: cyEl,
        elements: [
          ...graphData.nodes.map((n) => ({
            data: { id: n.id, label: n.label, weight: n.weight, category: n.category, color: categoryColor[n.category] || categoryColor.other },
          })),
          ...graphData.edges.map((e) => ({
            data: { source: e.source, target: e.target, weight: e.weight },
          })),
        ],
        style: [
          {
            selector: 'node',
            style: {
              'background-color': 'data(color)',
              'label': 'data(label)',
              'font-size': '11px',
              'color': '#1f2937',
              'text-valign': 'bottom',
              'text-halign': 'center',
              'text-margin-y': 4,
              'width': 'mapData(weight, 1, 50, 18, 56)',
              'height': 'mapData(weight, 1, 50, 18, 56)',
              'text-background-color': '#fff',
              'text-background-opacity': 0.9,
              'text-background-padding': 2,
              'text-background-shape': 'roundrectangle',
              'text-wrap': 'wrap',
              'text-max-width': '100px',
            },
          },
          {
            selector: `node[id = "${graphData.centerSlug}"]`,
            style: { 'border-color': '#1f2937', 'border-width': 3 },
          },
          {
            selector: 'edge',
            style: {
              'line-color': '#94a3b8',
              'width': 'mapData(weight, 1, 20, 1, 5)',
              'curve-style': 'bezier',
              'opacity': 0.6,
            },
          },
        ],
        layout: { name: 'fcose', quality: 'default', animate: false },
      });

      cy.on('tap', 'node', (evt: any) => {
        const node = evt.target;
        const id = node.id();
        if (id && id !== graphData.centerSlug) {
          const base = (document.querySelector('meta[name="base-url"]') as HTMLMetaElement)?.content || '';
          window.location.href = `${base}/wiki/concepts/${id}/`;
        }
      });
    })();
  }
</script>

<style>
  .concept-detail-head h1 {
    font-size: 2rem;
    margin: 0.5rem 0 0.25rem;
  }
  .concept-detail-meta {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }
  .concept-cat,
  .concept-count,
  .concept-stat {
    font-size: 0.85rem;
    padding: 0.2em 0.6em;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    color: var(--fg-muted);
  }
  .concept-stat {
    font-family: var(--font-mono);
    color: var(--accent);
  }
  .concept-detail-slug {
    margin-top: 0.5rem;
    color: var(--fg-subtle);
    font-size: 0.85rem;
  }
  .concept-detail-slug code {
    font-family: var(--font-mono);
    background: var(--code-bg);
    padding: 0.1em 0.4em;
    border-radius: 4px;
  }
  .concept-detail-section {
    margin: 2rem 0;
  }
  .concept-detail-section h2 {
    font-size: 1.25rem;
    margin: 0 0 0.75rem;
    color: var(--fg);
  }
  .concept-paper-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .concept-paper-item {
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .concept-paper-link {
    color: var(--accent);
    font-weight: 500;
    text-decoration: none;
  }
  .concept-paper-link:hover { text-decoration: underline; }
  .concept-paper-en {
    color: var(--fg-muted);
    font-size: 0.85rem;
    font-style: italic;
  }
  .concept-paper-arxiv {
    color: var(--fg-subtle);
    font-size: 0.75rem;
    font-family: var(--font-mono);
  }
  .concept-related-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .concept-related-chip {
    display: inline-flex;
    flex-direction: column;
    padding: 0.45rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-elevated);
    text-decoration: none;
    color: var(--fg);
    transition: border-color 150ms, background 150ms;
  }
  .concept-related-chip:hover {
    border-color: var(--accent);
    background: var(--accent-soft);
  }
  .concept-related-name { font-weight: 500; }
  .concept-related-meta {
    font-size: 0.7rem;
    color: var(--fg-subtle);
    font-family: var(--font-mono);
  }
  /* G.2.1 grouped related-graph */
  .concept-related-group {
    margin-top: 1rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-elevated);
  }
  .concept-related-cat {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0 0 0.5rem;
    font-size: 0.95rem;
    color: var(--fg-muted);
    font-family: var(--font-mono);
  }
  .concept-related-cat-count {
    font-size: 0.75rem;
    padding: 0.1em 0.5em;
    border-radius: 999px;
    background: var(--bg);
    color: var(--fg-subtle);
    border: 1px solid var(--border);
  }
  .concept-graph {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .concept-graph-item a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.3rem 0.5rem;
    border-radius: 4px;
    text-decoration: none;
    color: var(--fg);
    transition: background 150ms;
  }
  .concept-graph-item a:hover {
    background: var(--accent-soft);
  }
  .concept-graph-name {
    font-weight: 500;
  }
  .concept-graph-item a:hover .concept-graph-name {
    color: var(--accent);
  }
  .co-count {
    font-size: 0.75rem;
    color: var(--fg-subtle);
    font-family: var(--font-mono);
    white-space: nowrap;
  }
  /* G.2.2 sparkline */
  .concept-evolution {
    margin: 1.5rem 0;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-elevated);
  }
  .concept-evolution h2 {
    font-size: 1rem;
    margin: 0 0 0.4rem;
    color: var(--fg-muted);
    font-family: var(--font-mono);
  }
  .concept-sparkline {
    width: 100%;
    height: 60px;
    display: block;
    margin-top: 0.5rem;
  }
  /* G.3.3 cytoscape container */
  .concept-cy {
    width: 100%;
    height: 380px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-elevated);
  }
</style>