---
// /conferences/ — 会议论文拉取 UI(F1)
//
// 这个页面提供"按会议拉取论文到 Supabase"的触发按钮,通过 GitHub REST
// workflow_dispatch 触发 .github/workflows/conference-init.yml(跑 init_<conf>.py:
// fetch + embedding + upsert 到 Supabase)。流程:
//   1. 用户选会议 + 年份 → 点"立即拉取"
//   2. 前端 POST api.github.com/.../workflows/conference-init.yml/dispatches
//      inputs: {conferences, year_end, year_count, skip_fetch}
//   3. 轮询 /actions/workflows/conference-init.yml/runs 看 status / conclusion
//   4. 完成后给出 GitHub Actions run 链接
//
// 前提:需在 /settings/ 页面填 GitHub PAT(勾 repo + workflow scope);
// owner/repo 也从 settings 的 GitHubRepo 配置读(默认 Canyon-netizen/daily-paper-reader)。

import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/page.css';
import '../../styles/settings.css';

const CONFERENCES = [
  { id: 'aaai', label: 'AAAI', desc: 'AAAI 官方 proceedings (OJS 抓取)' },
  { id: 'acl', label: 'ACL', desc: 'ACL Anthology (EMNLP/ACL 共享 fetcher)' },
  { id: 'emnlp', label: 'EMNLP', desc: 'EMNLP Anthology (同上)' },
  { id: 'iclr', label: 'ICLR', desc: 'ICLR OpenReview 投稿' },
  { id: 'icml', label: 'ICML', desc: 'ICML OpenReview 投稿' },
  { id: 'neurips', label: 'NeurIPS', desc: 'NeurIPS OpenReview 投稿' },
] as const;
---

<BaseLayout
  title="会议论文拉取 · Daily Paper Reader"
  description="按会议触发 init_<conf>.py,拉取最新论文并同步到 Supabase。"
>
  <Navbar />

  <main class="settings-page">
    <header class="settings-page-header">
      <strong>会议论文拉取</strong> · 选会议 + 年份,点"立即拉取"通过 GitHub Actions 跑
      <code>init_&lt;conf&gt;.py</code> (fetch + embedding + upsert 到 Supabase)。
      需先在 <a href={`${import.meta.env.BASE_URL}settings/`}>设置页</a> 填 GitHub PAT(勾 <code>repo</code> + <code>workflow</code> 权限)。
      <br />
      <strong>NeurIPS / ICLR / ICML</strong> 还需要 OpenReview 凭证(在配 Gist 时一并填 <code>OPENREVIEW_USERNAME / OPENREVIEW_PASSWORD</code>);
      没有可先勾选"跳过 fetch"只跑 sync,或去 <a href="https://openreview.net" target="_blank" rel="noopener">openreview.net</a> 注册。
    </header>

    <section class="settings-card">
      <h2 class="settings-card-title">拉取参数</h2>
      <p class="settings-card-sub">
        <code>--year-end</code> 决定抓哪一年;<code>--year-count</code> 决定往前抓几年。
        默认 2025 / 3 = 抓 2023-2025。NeurIPS 会自动用 <code>format_years_token</code> 拼接年份范围。
      </p>

      <div class="settings-field">
        <label for="conf-year-end">Year End</label>
        <input type="number" id="conf-year-end" min="2010" max="2099" value="2025" />
        <span class="settings-field-hint">默认 2025 (当前年)</span>
      </div>

      <div class="settings-field">
        <label for="conf-year-count">Year Count</label>
        <input type="number" id="conf-year-count" min="1" max="20" value="3" />
        <span class="settings-field-hint">默认 3 年</span>
      </div>

      <div class="settings-field">
        <label>
          <input type="checkbox" id="conf-skip-fetch" />
          跳过 fetch,只重跑 sync (复用已有 raw archive 文件)
        </label>
      </div>
    </section>

    <section class="settings-card">
      <h2 class="settings-card-title">选择会议</h2>
      <div class="conf-grid">
        {CONFERENCES.map((c) => (
          <div class="conf-card" data-conf-id={c.id} data-conf-label={c.label}>
            <div class="conf-card-head">
              <span class="conf-card-label">{c.label}</span>
              <button
                type="button"
                class="settings-action-btn primary conf-trigger-btn"
                data-conf={c.id}
              >立即拉取</button>
            </div>
            <p class="conf-card-desc">{c.desc}</p>
            <div class="conf-card-status" data-conf-status={c.id}>
              <span class="conf-status-label">未运行</span>
            </div>
          </div>
        ))}
      </div>

      <p class="settings-card-sub" style="margin-top: 1rem;">
        也可以选多个会议批量跑(下方按钮)。GitHub Actions 里串行执行每个
        <code>init_&lt;conf&gt;.py</code>,任意一个失败整体 exit 1。
      </p>
      <button type="button" class="settings-action-btn primary" id="conf-batch-btn">
        拉取全部 6 个会议
      </button>
    </section>

    <a class="settings-page-back" href={import.meta.env.BASE_URL}>← 返回首页</a>
  </main>

  <Footer />
</BaseLayout>

<style>
  .conf-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
  }
  .conf-card {
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 0.85rem 1rem;
    background: var(--bg-elevated);
  }
  .conf-card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.4rem;
  }
  .conf-card-label {
    font-weight: 700;
    font-size: 1rem;
  }
  .conf-card-desc {
    margin: 0 0 0.5rem;
    font-size: 0.85rem;
    color: var(--fg-muted);
  }
  .conf-card-status {
    font-size: 0.8rem;
    color: var(--fg-subtle);
  }
  .conf-card-status.is-running { color: var(--accent); }
  .conf-card-status.is-success { color: var(--success); }
  .conf-card-status.is-failure { color: var(--danger); }
  .conf-card-status a { color: inherit; text-decoration: underline; }
</style>

<script>
  import { loadGitHubToken, loadGitHubRepo } from '../../scripts/settings';
  import { dispatchWorkflow, pollRun } from '../../scripts/conferences';

  // 卡片状态 setter — 与 ./conferences.ts 内部默认值同语义,只暴露给本文件。
  function setCardStatus(conf: string, state: 'idle' | 'running' | 'success' | 'failure', html: string) {
    const el = document.querySelector(`[data-conf-status="${conf}"]`);
    if (!el) return;
    el.className = `conf-card-status is-${state}`;
    el.innerHTML = `<span class="conf-status-label">${html}</span>`;
  }

  // -------- 事件入口 --------
  async function triggerConf(confList: string[]) {
    const yearEndEl = document.getElementById('conf-year-end') as HTMLInputElement | null;
    const yearCountEl = document.getElementById('conf-year-count') as HTMLInputElement | null;
    const skipFetchEl = document.getElementById('conf-skip-fetch') as HTMLInputElement | null;
    if (!yearEndEl || !yearCountEl || !skipFetchEl) return;

    const token = loadGitHubToken();
    if (!token) {
      for (const c of confList)
        setCardStatus(c, 'failure', '✗ 未配置 GitHub PAT,请到设置页填(需 repo + workflow 权限)');
      return;
    }
    const { owner, repo } = loadGitHubRepo();
    const yearEnd = parseInt(yearEndEl.value, 10) || new Date().getUTCFullYear();
    const yearCount = parseInt(yearCountEl.value, 10) || 3;
    const skipFetch = skipFetchEl.checked;
    const inputs: Record<string, string> = {
      conferences: confList.join(','),
      year_end: String(yearEnd),
      year_count: String(yearCount),
      skip_fetch: skipFetch ? 'true' : 'false',
    };

    for (const c of confList) setCardStatus(c, 'running', '调度中…');
    const since = Date.now();
    try {
      await dispatchWorkflow(owner, repo, token, inputs);
    } catch (e) {
      for (const c of confList) setCardStatus(c, 'failure', `✗ 调度失败: ${(e as Error).message}`);
      return;
    }
    for (const c of confList) setCardStatus(c, 'running', '已触发,等待排队…');
    void pollRun(owner, repo, token, since, confList);
  }

  document.addEventListener('DOMContentLoaded', () => {
    // 单会议按钮(data-conf 是小写 id,与 init 脚本 key、卡片 data-conf-status 一致)
    document.querySelectorAll<HTMLButtonElement>('.conf-trigger-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const conf = btn.dataset.conf;
        if (conf) void triggerConf([conf]);
      });
    });
    // 全部 6 会议(用小写 id,保证卡片状态能匹配上)
    const batchBtn = document.getElementById('conf-batch-btn');
    if (batchBtn) {
      batchBtn.addEventListener('click', () => {
        void triggerConf(['aaai', 'acl', 'emnlp', 'iclr', 'icml', 'neurips']);
      });
    }
  });
</script>
