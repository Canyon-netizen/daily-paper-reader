---
// astro-src/pages/papers/[arxiv].astro
// 单篇论文页:用 lib/paper.ts 读 MD 文件(兼容坏文件)
// 路径格式:docs/papers/{arxiv_id}-{slug}.md -> /papers/{arxiv_id}-{slug}/
import type { GetStaticPaths } from 'astro';
import { readFile } from 'node:fs/promises';
import { join } from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import { readPaper, listPapers, listAllPaperIds, flattenCategories } from '../../lib/paper';
import { renderMarkdownBody, renderTitleHtml } from '../../lib/markdown';
import { paperPlainTitle } from '../../lib/title';
import { buildConceptIndex, buildWikilinkResolver } from '../../lib/concepts-index';
import '../../styles/paper-chat.css';
import '../../styles/hidden-toast.css';
import '../../styles/paper-selection.css';
import '../../styles/papers.css';
import '../../styles/method-debate.css';
import '../../styles/paper-deep-extract.css';
import '../../styles/follow-up-questions.css';

// 全文 inline 上限。超过这个大小(原始 utf-8 字节计)就不内联,让客户端走 fetch /papers/{id}.txt。
// 200KB 原文 base64 后 ~270KB 进 HTML,论文单页就这样大了;能覆盖绝大多数 arXiv 短文(< 30 页),
// 超长论文(> 30 页)不内联,让客户端 fetch。
// 1 KB 以下的视为 404 HTML/空,也不内联。
const FULLTEXT_INLINE_MAX_BYTES = 200 * 1024;

/** per-build 缓存 (Phase J2):同 build 进程内同 id 只 fs.readFile 一次。 */
const _fulltextCache = new Map<string, string>();

/**
 * SSR 阶段直接 fs 读 docs/papers/{arxiv}-slug.txt,base64 编码后塞进页面。
 * 客户端 paper-chat.ts::loadFulltextSkeleton 优先用 inline 内容,不走 HTTP。
 *
 * 为什么这么做:
 *   - 用户体感「为什么 chat 读全文要经网站」— fs.readFile 是直接的 IO,
 *     HTTP fetch 看起来多绕一圈;虽然 fetch 本地静态资源没真成本,但"路径感"
 *     不直观。
 *   - 内联到 HTML 的代价是单篇页面大 ~60KB,但 chat 默认不展开全文,
 *     大多数用户不会切 — 切了才付 token,但读 60KB HTML 是单次发生,缓存友好。
 *   - 没 .txt 的论文(早期 pipeline 漏抓)SSR 拿不到,data-fulltext 空,
 *     客户端走 fetch 兜底,保留 f40bc41 的 fetch 链不破。
 */
async function readFulltextInline(id: string): Promise<string> {
  // per-build 缓存命中 (Phase J2)
  if (_fulltextCache.has(id)) {
    return _fulltextCache.get(id) ?? '';
  }
  try {
    // docs/papers/ 现在按 arxiv id 的 YYMM 分桶到 <YYYY>/<MM>/ 子目录,
    // id 形如 `papers/2026/06/2606.26155v1-detecting-and...`,直接 join 即可。
    const txtPath = join(process.cwd(), 'docs', `${id}.txt`);
    const buf = await readFile(txtPath);
    if (buf.byteLength > FULLTEXT_INLINE_MAX_BYTES || buf.byteLength < 1000) {
      // 太大 → 不内联,客户端 fetch;太小 → 视为异常(404 HTML/空),不内联
      _fulltextCache.set(id, '');
      return '';
    }
    const encoded = buf.toString('base64');
    _fulltextCache.set(id, encoded);
    return encoded;
  } catch {
    _fulltextCache.set(id, '');
    return '';
  }
}

export const getStaticPaths: GetStaticPaths = async () => {
  const ids = await listAllPaperIds();
  // 仅处理 papers/ 段(子目录分桶后 id 含 /YYYY/MM/,但 URL 路由仍是 basename)。
  // 把 basename 当 params.arxiv 喂给 page,内部用全 id 走 readPaper/readFulltextInline。
  return ids
    .filter((id) => id.startsWith('papers/'))
    .map((id) => ({
      params: {
        // basename = 文件名段(无目录前缀)。例如
        //   papers/2026/06/2606.26155v1-foo  →  arxiv = "2606.26155v1-foo"
        arxiv: id.split('/').pop() || '',
      },
      props: {
        // 顺手把完整 id 通过 props 喂进去,避免 page 端用 basename 反推时拼错目录。
        // Astro getStaticPaths 的 props 会作为 Astro.props.fullId 暴露。
        fullId: id,
      },
    }));
};

const { arxiv } = Astro.params;
const { fullId } = Astro.props;
const id = fullId || `papers/${arxiv}`;
const paper = await readPaper(id);
const base = import.meta.env.BASE_URL;
const fulltextInline = paper && !paper.isBroken ? await readFulltextInline(id) : '';
// 浏览器 <title> / 富标题:纯文本用于 tab 标题,富 HTML 用于页面 <h1>/<h2> 渲染数学。
const plainZh = paper ? paperPlainTitle(paper.title_zh, paper.title_zh_plain) : '';
const plainEn = paper ? paperPlainTitle(paper.title, paper.title_plain) : '';
const tabTitle = plainZh || plainEn || id;
---

<BaseLayout title={tabTitle}>
  <Navbar />
  <main class="paper-page">
    {paper ? (
      paper.isBroken ? (
        <div class="container">
          <article class="paper-broken">
            <h1>⚠️ 论文摘要解析失败</h1>
            <p>这篇论文({id})的 frontmatter YAML 损坏,无法读取标题和摘要。</p>
            <p>原因:{paper.brokenReason}</p>
            <p>这是 daily pipeline 写入 figures_json 字段时的已知 bug,源文件保留供后续修复。</p>
            <p>如果你需要这篇论文内容,请用其他渠道获取 arxiv ID <code>{paper.arxivId}</code>。</p>
            <p><a href={`${base}`}>← 返回首页</a></p>
          </article>
        </div>
      ) : (
        <article class="paper-article">
          <header class="paper-header">
            <div class="container">
              <div class="paper-header-row">
                <div class="paper-meta-line">
                  arXiv {paper.arxivId}
                  {paper.date && <span> · 发布 {paper.date}</span>}
                </div>
                {!paper.isBroken && (
                  <div class="paper-header-actions">
                    <button
                      type="button"
                      id="paper-star-btn"
                      class="paper-star-btn"
                      hidden
                      aria-label="星标这篇论文"
                      data-arxiv-id={paper.canonicalArxivId || ' '}
                    >☆</button>
                    <button
                      type="button"
                      id="paper-status-btn"
                      class="paper-status-btn"
                      hidden
                      aria-label="切换阅读状态"
                      data-arxiv-id={paper.canonicalArxivId || ' '}
                    >○</button>
                    <button
                      type="button"
                      id="paper-select-btn"
                      class="paper-select-btn"
                      hidden
                      aria-label="把这篇论文加入主题探索"
                    >📌 选入探索</button>
                    <button
                      type="button"
                      id="paper-compare-btn"
                      class="paper-compare-btn"
                      hidden
                      aria-label="把这篇论文加入对比"
                      data-arxiv-id={paper.canonicalArxivId || ' '}
                    >➕ 加入对比</button>
                    {/* + 加进文献库(2026-08-02):对照 Polaris LibraryPicker,弹层多选
                        用户库。客户端由 scripts/user-libraries-ui.ts 接管交互。 */}
                    <button
                      type="button"
                      class="add-to-library-btn"
                      data-add-to-library={paper.canonicalArxivId || ' '}
                      aria-label="加进文献库"
                    ><span data-add-to-library-label>+ 加进文献库</span><span data-in-libs-count class="in-libraries-count" style="display:none;"></span></button>
                    <button
                      type="button"
                      id="paper-hide-btn"
                      class="paper-hide-btn"
                      hidden
                      aria-label="隐藏或恢复这篇论文"
                    >🗑 隐藏</button>
                  </div>
                )}
              </div>
              <h1 class="paper-title-zh" set:html={renderTitleHtml(paper.title_zh || paper.title || '')}></h1>
              {paper.title_zh && paper.title && paper.title !== paper.title_zh && (
                <h2 class="paper-title-en" set:html={renderTitleHtml(paper.title)}></h2>
              )}

              {/* 跨库视图:这篇论文所在的全部用户库。客户端 paper-cross-libraries.ts
                  读 localStorage dpr_user_libraries_v1 后渲染。
                  SSR 期间 localStorage 不可用 → mount hidden + 空内容;客户端 hydrate 时挂。*/}
              <div
                class="paper-cross-libraries"
                data-paper-cross-libs
                data-paper-canonical-id={paper.canonicalArxivId || ''}
                hidden
              ></div>

              <div class="paper-meta">
                {paper.authors && (
                  <div class="meta-row">
                    <span class="meta-label">AUTHORS</span>
                    <span class="meta-value">{paper.authors}</span>
                  </div>
                )}
                {paper.evidence && (
                  <div class="meta-row">
                    <span class="meta-label">EVIDENCE</span>
                    <span class="meta-value">{paper.evidence}</span>
                  </div>
                )}
                {typeof paper.score === 'number' && Number.isFinite(paper.score) && (
                  <div class="meta-row">
                    <span class="meta-label">SCORE</span>
                    <span class="meta-value score-pill">{paper.score.toFixed(1)}</span>
                  </div>
                )}
                {paper.categories && (paper.categories.venue.length + paper.categories.task.length + paper.categories.method.length + paper.categories.type.length) > 0 && (
                  <div class="meta-row meta-row--categories">
                    <span class="meta-label">CATEGORIES</span>
                    <span class="meta-value meta-categories">
                      {(['venue', 'task', 'method', 'type'] as const).map((dim) => {
                        const labels = paper.categories && paper.categories[dim];
                        if (!labels || labels.length === 0) return null;
                        return (
                          <span class="category-dim">
                            <span class="category-dim-label">{dim.toUpperCase()}</span>
                            {labels.map((label: string) => (
                              <span class={`tag tag-${dim}${paper.accepted && dim === 'venue' ? ' tag-venue--accepted' : ''}`}>{label}</span>
                            ))}
                          </span>
                        );
                      })}
                    </span>
                  </div>
                )}
                {paper.pdf && (
                  <div class="meta-row">
                    <span class="meta-label">PDF</span>
                    <a class="meta-value pdf-link" href={paper.pdf} target="_blank" rel="noopener">↗ {paper.arxivId}.pdf</a>
                  </div>
                )}
                {paper.generated_at && (
                  <div class="meta-row">
                    <span class="meta-label">GENERATED</span>
                    <span class="meta-value">{paper.generated_at}</span>
                  </div>
                )}
              </div>
            </div>
          </header>

          {paper.tldr && (
            <section class="paper-glance">
              <div class="container">
                <h3>📝 TLDR</h3>
                <p>{paper.tldr}</p>
              </div>
            </section>
          )}

          {(paper.motivation || paper.method || paper.result || paper.conclusion) && (
            <section class="paper-summary">
              <div class="container">
                <h3>🧭 速览</h3>
                {paper.motivation && (
                  <div class="glance-card">
                    <div class="glance-label">动机</div>
                    <p>{paper.motivation}</p>
                  </div>
                )}
                {paper.method && (
                  <div class="glance-card">
                    <div class="glance-label">方法</div>
                    <p>{paper.method}</p>
                  </div>
                )}
                {paper.result && (
                  <div class="glance-card">
                    <div class="glance-label">结果</div>
                    <p>{paper.result}</p>
                  </div>
                )}
                {paper.conclusion && (
                  <div class="glance-card">
                    <div class="glance-label">结论</div>
                    <p>{paper.conclusion}</p>
                  </div>
                )}
              </div>
            </section>
          )}

          {/* 深入追问:3-5 个引导性问题,帮助读者深入探索这篇论文。 */}
          {paper.follow_up_questions && paper.follow_up_questions.length > 0 && (
            <details class="follow-up-questions-section">
              <summary>🤔 深入追问</summary>
              <ul class="follow-up-questions-list">
                {paper.follow_up_questions.map((q, i) => (
                  <li>
                    <button
                      type="button"
                      class="follow-up-question-btn"
                      data-question={q}
                    >{q}</button>
                  </li>
                ))}
              </ul>
            </details>
          )}

          {/* 方法对比:每篇论文的 methods pros/cons debate。
              优先用 frontmatter 字段,若无则从 localStorage 兜底,若都无则展示空状态+生成按钮。 */}
          <details id="method-debate-section" class="method-debate-section">
            <summary>🆚 方法对比</summary>
            <div class="method-debate-content">
              {(() => {
                const hasProsCons = paper.method_pros_cons && Object.keys(paper.method_pros_cons).length > 0;
                if (!hasProsCons) {
                  return (
                    <div class="method-debate-empty">
                      <p>暂未生成 — 点击下方按钮</p>
                      <button
                        type="button"
                        class="method-debate-generate-btn"
                        data-action="generate-method-debate"
                        data-arxiv={paper.canonicalArxivId || paper.arxivId || ''}
                      >🔄 生成方法对比</button>
                    </div>
                  );
                }
                return (
                  <>
                    <div class="method-debate-cards">
                      {Object.entries(paper.method_pros_cons!).map(([method, { pros, cons }]) => (
                        <section class="method-debate-card" aria-labelledby={`method-${method.replace(/\s+/g, '-').toLowerCase()}`}>
                          <h4 id={`method-${method.replace(/\s+/g, '-').toLowerCase()}`} class="method-debate-card-header">{method}</h4>
                          <div class="method-debate-card-body">
                            {pros && pros.length > 0 && (
                              <div class="method-debate-pros">
                                <div class="method-debate-pros-label">✓ 优点</div>
                                <ul class="method-debate-pros-list">
                                  {pros.map((pro, i) => <li key={`pro-${i}`}>{pro}</li>)}
                                </ul>
                              </div>
                            )}
                            {cons && cons.length > 0 && (
                              <div class="method-debate-cons">
                                <div class="method-debate-cons-label">✗ 缺点</div>
                                <ul class="method-debate-cons-list">
                                  {cons.map((con, i) => <li key={`con-${i}`}>{con}</li>)}
                                </ul>
                              </div>
                            )}
                          </div>
                        </section>
                      ))}
                    </div>
                    {paper.method_comparison && (
                      <p class="method-debate-comparison"><em>{paper.method_comparison}</em></p>
                    )}
                    <button
                      type="button"
                      class="method-debate-regen-btn"
                      data-action="regen-method-debate"
                      data-arxiv={paper.canonicalArxivId || paper.arxivId || ''}
                    >🔄 重新生成</button>
                  </>
                );
              })()}
            </div>
          </details>

          {/* 深度抽取:指标/数据集/算力需求/局限性/可复现性评分。
              优先用 frontmatter 字段,若无则从 localStorage 兜底,若都无则展示空状态+生成按钮。 */}
          <details id="deep-extract-section" class="deep-extract-section-wrapper">
            <summary>🔬 深度抽取</summary>
            <div class="deep-extract-content">
              {(() => {
                const hasDeepExtract = paper.deep_extract && (
                  (paper.deep_extract.reported_metrics && paper.deep_extract.reported_metrics.length > 0) ||
                  (paper.deep_extract.datasets && paper.deep_extract.datasets.length > 0) ||
                  (paper.deep_extract.compute_requirements && Object.keys(paper.deep_extract.compute_requirements).length > 0) ||
                  (paper.deep_extract.limitations && paper.deep_extract.limitations.length > 0) ||
                  paper.deep_extract.replicability_score
                );
                if (!hasDeepExtract) {
                  return (
                    <div class="deep-extract-empty">
                      <p>深度抽取提供:指标/数据集/算力需求/局限性/可复现性评分</p>
                      <button
                        type="button"
                        class="deep-extract-generate-btn"
                        data-action="generate-deep-extract"
                        data-arxiv={paper.canonicalArxivId || paper.arxivId || ''}
                        data-title={paper.title || ''}
                        data-abstract={paper.abstract || ''}
                      >🔬 深度抽取 (5 项)</button>
                    </div>
                  );
                }
                const de = paper.deep_extract!;
                return (
                  <>
                    {de.reported_metrics && de.reported_metrics.length > 0 && (
                      <div class="deep-extract-section">
                        <h4 class="deep-extract-section-title">📊 报告指标</h4>
                        <div class="deep-extract-metrics-grid">
                          {de.reported_metrics.map((m, i) => (
                            <div class="deep-extract-metric" key={`metric-${i}`}>
                              <div class="deep-extract-metric-name">{m.name}</div>
                              <div class="deep-extract-metric-value">{m.value}</div>
                              {m.context && <div class="deep-extract-metric-context">{m.context}</div>}
                            </div>
                          ))}
                        </div>
                      </div>
                    )}
                    {de.datasets && de.datasets.length > 0 && (
                      <div class="deep-extract-section">
                        <h4 class="deep-extract-section-title">📁 数据集</h4>
                        <div class="deep-extract-datasets-list">
                          {de.datasets.map((d, i) => (
                            <div class="deep-extract-dataset" key={`dataset-${i}`}>
                              <span class="deep-extract-dataset-name">{d.name}</span>
                              <span class="deep-extract-dataset-role">{d.role}</span>
                              {d.size && <span class="deep-extract-dataset-size">{d.size}</span>}
                            </div>
                          ))}
                        </div>
                      </div>
                    )}
                    {de.compute_requirements && Object.keys(de.compute_requirements).length > 0 && (
                      <div class="deep-extract-section">
                        <h4 class="deep-extract-section-title">🖥️ 算力需求</h4>
                        <div class="deep-extract-compute-grid">
                          {de.compute_requirements.params && (
                            <div class="deep-extract-compute-item">
                              <span class="deep-extract-compute-label">参数量</span>
                              <span class="deep-extract-compute-value">{de.compute_requirements.params}</span>
                            </div>
                          )}
                          {de.compute_requirements.gpu_hours && (
                            <div class="deep-extract-compute-item">
                              <span class="deep-extract-compute-label">GPU小时</span>
                              <span class="deep-extract-compute-value">{de.compute_requirements.gpu_hours}</span>
                            </div>
                          )}
                          {de.compute_requirements.model_size && (
                            <div class="deep-extract-compute-item">
                              <span class="deep-extract-compute-label">模型大小</span>
                              <span class="deep-extract-compute-value">{de.compute_requirements.model_size}</span>
                            </div>
                          )}
                          {de.compute_requirements.flops && (
                            <div class="deep-extract-compute-item">
                              <span class="deep-extract-compute-label">FLOPs</span>
                              <span class="deep-extract-compute-value">{de.compute_requirements.flops}</span>
                            </div>
                          )}
                        </div>
                      </div>
                    )}
                    {de.limitations && de.limitations.length > 0 && (
                      <div class="deep-extract-section">
                        <h4 class="deep-extract-section-title">⚠️ 局限性</h4>
                        <ul class="deep-extract-limitations-list">
                          {de.limitations.map((l, i) => (
                            <li class="deep-extract-limitation" key={`limitation-${i}`}>{l}</li>
                          ))}
                        </ul>
                      </div>
                    )}
                    {de.replicability_score && (
                      <div class="deep-extract-section">
                        <h4 class="deep-extract-section-title">🔄 可复现性评分</h4>
                        <div class="deep-extract-replicability">
                          <div class="deep-extract-replicability-score">
                            {'★'.repeat(de.replicability_score)}{'☆'.repeat(5 - de.replicability_score)}
                            <span class="deep-extract-replicability-value">{de.replicability_score}/5</span>
                          </div>
                          {de.replicability_reason && <div class="deep-extract-replicability-reason">{de.replicability_reason}</div>}
                        </div>
                      </div>
                    )}
                    <button
                      type="button"
                      class="deep-extract-regen-btn"
                      data-action="regen-deep-extract"
                      data-arxiv={paper.canonicalArxivId || paper.arxivId || ''}
                      data-title={paper.title || ''}
                      data-abstract={paper.abstract || ''}
                    >🔄 重新生成</button>
                  </>
                );
              })()}
            </div>
          </details>

          {paper.body && (
            <section class="paper-body">
              <div class="container">
                <article class="markdown" set:html={renderMarkdownBody(paper.body, { figures: paper.figures, base })} />
              </div>
            </section>
          )}

          {/* 「编译论文」流式 LLM 翻译(Stage 11+ 主动要求)——
              浏览器侧调 LLM 流式翻译成中文 markdown,! ！[[fig:N]]/[[table:N]]
              自动嵌位,结果存 localStorage(下次访问免调 LLM)。
              broken 论文 / 404 不挂。 */}
          {paper && !paper.isBroken && (
            <section class="paper-compile" id="paper-compile-section" aria-label="编译论文">
              <div class="container">
                <div class="paper-compile-header">
                  <h3>✨ 编译论文</h3>
                  <div class="paper-compile-toolbar">
                    <button type="button" class="paper-compile-btn paper-compile-btn-primary" data-compile-start>✨ 编译</button>
                    <button type="button" class="paper-compile-btn" data-compile-stop hidden>■ 停止</button>
                    <button type="button" class="paper-compile-btn" data-compile-recompile hidden>🔄 重新编译</button>
                    <button type="button" class="paper-compile-btn" data-compile-clear hidden>🗑 清除缓存</button>
                  </div>
                </div>
                <p class="paper-compile-status" data-compile-status data-kind="info">点「✨ 编译」开始,LLM 会按 Polaris 风格翻译并把图片/表格嵌到对应位置。结果存到浏览器 localStorage,下次访问自动加载。</p>
                <div class="paper-compile-output markdown" data-compile-output></div>
              </div>
            </section>
          )}

          {/* 我的笔记 — 失焦防抖保存,本地 + Gist 同步。
              broken 论文 / 404 不挂(notes editor 内部 null-safe 退出)。
              data-paper-index 用于 wikilink 自动补全(JSON 字符串)。 */}
          {paper && !paper.isBroken && (
            <section
              class="paper-notes"
              id="paper-notes-section"
              aria-label="我的笔记"
              data-paper-index={JSON.stringify(
                (await listPapers({ limit: 200, sortBy: 'date' })).map((p) => ({
                  id: p.id.split('/').pop() || p.id,
                  canonicalArxivId: p.canonicalArxivId,
                  title: p.title,
                  title_zh: p.title_zh,
                  title_plain: p.title_plain,
                  title_zh_plain: p.title_zh_plain,
                }))
              )}
            >
              <div class="container">
                <div class="paper-notes-header">
                  <h3>📓 我的笔记</h3>
                  <div class="paper-notes-toolbar">
                    <button
                      type="button"
                      id="paper-notes-toggle"
                      class="paper-notes-toggle"
                      aria-label="切换预览/编辑"
                    >👁 预览</button>
                    <span class="paper-notes-saved" id="paper-notes-saved" hidden>已保存 ✓</span>
                  </div>
                </div>
                <textarea
                  id="paper-notes-textarea"
                  class="paper-notes-textarea"
                  placeholder="在这里记录你的想法 / 关键句 / 实验思路…(失焦或停顿 1s 后自动保存)"
                  spellcheck="true"
                  rows="8"
                ></textarea>
                <div id="paper-notes-preview" class="paper-notes-preview markdown" hidden></div>
              </div>
            </section>
          )}
        </article>
      )
    ) : (
      <div class="container">
        <h1>404</h1>
        <p>找不到论文:{id}</p>
        <p><a href={`${base}`}>← 返回首页</a></p>
      </div>
    )}

    {/* 论文对话 dock — 数据载体(实际渲染由 paper-chat.ts 挂到 body 上作为 fixed 浮层)。
        broken 论文和 404 时不渲染,避免误导。
        data-fulltext 默认给一个空格占位,确保 Astro 输出 attribute="..." 而不是布尔属性;
        没 .txt 的论文 fulltextInline 是 '' → 用空格,客户端 atob 后是 ' ' → sanity check 失败
        → 当成"无内联"走 fetch 兜底。*/}
    {paper && !paper.isBroken && (
      <section
        id="paper-chat"
        aria-hidden="true"
        data-title={plainEn || paper.title || ''}
        data-title-zh={plainZh || paper.title_zh || ''}
        data-authors={paper.authors || ''}
        data-tldr={paper.tldr || ''}
        data-motivation={paper.motivation || ''}
        data-method={paper.method || ''}
        data-result={paper.result || ''}
        data-conclusion={paper.conclusion || ''}
        data-tags={flattenCategories(paper.categories).join(',')}
        data-arxiv-id={paper.arxivId || ' '}
        data-canonical-arxiv-id={paper.canonicalArxivId || ' '}
        data-fulltext={fulltextInline || ' '}
        data-txt-name={`${arxiv}.txt`}
      ></section>
    )}

    {/* 论文"隐藏"按钮数据载体 — 复用 #paper-chat 的 section-as-data-carrier 模式。
        broken 论文和 404 时不渲染,避免误导(实际按钮见 .paper-header-row 右上)。 */}
    {paper && !paper.isBroken && (
      <section
        id="paper-hide"
        aria-hidden="true"
        data-arxiv-id={paper.arxivId || ' '}
        data-canonical-arxiv-id={paper.canonicalArxivId || ' '}
      ></section>
    )}

    {/* "选入主题探索"按钮数据载体 — 跟 #paper-hide 同样的 section-as-data-carrier 模式。
        broken 论文 / 404 不挂,避免误导。 */}
    {paper && !paper.isBroken && (
      <section
        id="paper-select"
        aria-hidden="true"
        data-arxiv-id={paper.arxivId || ' '}
        data-canonical-arxiv-id={paper.canonicalArxivId || ' '}
        data-title={plainEn || paper.title || ''}
        data-title-zh={plainZh || paper.title_zh || ''}
        data-tldr={paper.tldr || ''}
        data-motivation={paper.motivation || ''}
        data-method={paper.method || ''}
        data-result={paper.result || ''}
        data-conclusion={paper.conclusion || ''}
        data-tags={flattenCategories(paper.categories).join(',')}
      ></section>
    )}

    {/* 阅读态(星标 / 状态)按钮数据载体 — 同 section-as-data-carrier 模式。
        script 在 .paper-header-actions 里找按钮,与数据载体解耦。 */}
    {paper && !paper.isBroken && (
      <section
        id="paper-library-state"
        aria-hidden="true"
        data-canonical-arxiv-id={paper.canonicalArxivId || ' '}
      ></section>
    )}

    {/* 「编译论文」数据载体(Stage 11+ 用户主动要求)—— 客户端 paper-compile-ui
        读 figures/tables,流式调 LLM,渲染到 #paper-compile-output。
        broken / 404 不挂(SSR 端 null 客户端直接退出)。 */}
    {paper && !paper.isBroken && (
      <section
        id="paper-compile-data"
        aria-hidden="true"
        data-canonical-id={paper.canonicalArxivId || ' '}
        data-title-zh={paper.title_zh || paper.title || ' '}
        data-title-en={paper.title || ' '}
        data-abstract={paper.tldr || paper.evidence || ' '}
        data-fulltext=" "
        data-figures={JSON.stringify(
          (paper.figures || []).map((f) => ({
            index: f.index, caption: f.caption, page: f.page,
            url: (base + '/' + (f.url || '').replace(/^\.\//, '')),
          }))
        )}
        data-tables={JSON.stringify([])}
      ></section>
    )}

    {/* Stage 7 —— "内容相似论文"卡。客户端 paper-related.ts 拉 paper-relations.json,
        按 data-arxiv-id 命中,渲染 ≤8 条。inline ~30 行渲染,不另开脚本文件。 */}
    {paper && !paper.isBroken && (
      <section
        id="paper-related"
        class="paper-related-card"
        data-canonical-arxiv-id={paper.canonicalArxivId || ' '}
        data-relations-url="/paper-relations.json"
        hidden
      >
        <h3 class="paper-related-title">内容相似论文</h3>
        <p class="paper-related-meta">基于分类 jaccard + 标题/摘要 tf-idf · 仅按文本相似,非引用关系</p>
        <ul class="paper-related-list" data-paper-related-list></ul>
      </section>
    )}
  </main>

  <script>
    import '../../scripts/paper-chat.ts';
    import '../../scripts/paper-figures.ts';
    import '../../scripts/paper-hide.ts';
    import '../../scripts/paper-selection.ts';
    import '../../scripts/paper-notes-editor.ts';
    import '../../scripts/paper-library-detail.ts';
    import '../../scripts/paper-related.ts';
    import '../../scripts/paper-highlights.ts';
    import '../../scripts/user-libraries-ui.ts';
    import '../../scripts/paper-compile-ui.ts';
    import '../../scripts/paper-cross-libraries.ts';

    // 方法对比:客户端 LLM 调用 + DOM 更新
    // -------------------------------------------------------
    (function () {
      const STORAGE_KEY_PREFIX = 'dpr_method_debate_';

      // 检查 localStorage 兜底
      function getStoredDebate(arxivId: string): { prosCons: Record<string, { pros: string[]; cons: string[] }>; comparison: string } | null {
        try {
          const raw = localStorage.getItem(STORAGE_KEY_PREFIX + arxivId);
          if (!raw) return null;
          const data = JSON.parse(raw);
          return data && data.prosCons && data.comparison ? data : null;
        } catch { return null; }
      }

      // 保存到 localStorage
      function saveDebate(arxivId: string, prosCons: Record<string, { pros: string[]; cons: string[] }>, comparison: string): void {
        try {
          localStorage.setItem(STORAGE_KEY_PREFIX + arxivId, JSON.stringify({ prosCons, comparison }));
        } catch { /* 忽略存储失败 */ }
      }

      // 从设置读取 LLM 配置
      function loadLLMConfig(): { apiKey: string; baseUrl: string; model: string } | null {
        try {
          const stored = localStorage.getItem('dpr_settings');
          if (!stored) return null;
          const s = JSON.parse(stored);
          if (!s.apiKey || !s.baseUrl || !s.model) return null;
          return { apiKey: s.apiKey, baseUrl: s.baseUrl, model: s.model };
        } catch { return null; }
      }

      // 调用 LLM 生成方法对比
      async function generateMethodDebate(arxivId: string, methodText: string, paperTitle: string): Promise<{ prosCons: Record<string, { pros: string[]; cons: string[] }>; comparison: string }> {
        const cfg = loadLLMConfig();
        if (!cfg) throw new Error('请先在设置页填写 API Key');

        const systemPrompt = `你是一篇学术论文的方法分析助手。
论文: ${paperTitle}
方法描述: ${methodText}

请分析这篇论文中使用的**所有方法**,为每种方法列出:
1. 优点 (pros): 该方法相比其他方法的优势,用 2-4 个要点描述
2. 缺点 (cons): 该方法的局限性或劣势,用 2-4 个要点描述

最后用 1-2 句话总结各方法之间的对比。

请返回 JSON 格式:
{
  "prosCons": {
    "方法名1": { "pros": ["优点1", "优点2"], "cons": ["缺点1"] },
    "方法名2": { "pros": ["优点1"], "cons": ["缺点1", "缺点2"] }
  },
  "comparison": "跨方法对比总结"
}`;

        const response = await fetch(`${cfg.baseUrl.replace(/\/+$/, '')}/v1/chat/completions`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${cfg.apiKey}`,
          },
          body: JSON.stringify({
            model: cfg.model,
            messages: [
              { role: 'system', content: systemPrompt },
              { role: 'user', content: '请分析这篇论文的方法并返回 JSON' },
            ],
            temperature: 0.5,
            max_tokens: 4000,
          }),
        });

        if (!response.ok) {
          const err = await response.text().catch(() => '');
          throw new Error(`LLM 调用失败 (${response.status}): ${err.slice(0, 100)}`);
        }

        const data = await response.json();
        const content = data?.choices?.[0]?.message?.content || '';

        // 尝试提取 JSON
        const jsonMatch = content.match(/\{[\s\S]*\}/);
        if (!jsonMatch) throw new Error('LLM 返回格式错误,无法解析 JSON');

        const parsed = JSON.parse(jsonMatch[0]);
        if (!parsed.prosCons || !parsed.comparison) throw new Error('LLM 返回缺少必要字段');

        return parsed;
      }

      // 渲染方法对比卡片
      function renderCards(prosCons: Record<string, { pros: string[]; cons: string[] }>, comparison: string): string {
        const cardsHtml = Object.entries(prosCons).map(([method, { pros, cons }]) => {
          const slug = method.replace(/\s+/g, '-').toLowerCase();
          const prosHtml = pros?.length
            ? `<div class="method-debate-pros"><div class="method-debate-pros-label">✓ 优点</div><ul class="method-debate-pros-list">${pros.map((p, i) => `<li key="pro-${i}">${p}</li>`).join('')}</ul></div>`
            : '';
          const consHtml = cons?.length
            ? `<div class="method-debate-cons"><div class="method-debate-cons-label">✗ 缺点</div><ul class="method-debate-cons-list">${cons.map((c, i) => `<li key="con-${i}">${c}</li>`).join('')}</ul></div>`
            : '';
          return `<section class="method-debate-card" aria-labelledby="method-${slug}"><h4 id="method-${slug}" class="method-debate-card-header">${method}</h4><div class="method-debate-card-body">${prosHtml}${consHtml}</div></section>`;
        }).join('');

        const comparisonHtml = comparison ? `<p class="method-debate-comparison"><em>${comparison}</em></p>` : '';
        const regenBtn = document.querySelector('.method-debate-regen-btn') as HTMLButtonElement;
        const arxivId = regenBtn?.dataset.arxiv || '';

        return `<div class="method-debate-cards">${cardsHtml}</div>${comparisonHtml}<button type="button" class="method-debate-regen-btn" data-action="regen-method-debate" data-arxiv="${arxivId}">🔄 重新生成</button>`;
      }

      // 深度抽取:storage key
      const DEEP_EXTRACT_KEY_PREFIX = 'dpr_deep_extract_';

      function getStoredDeepExtract(arxivId: string): {
        reportedMetrics: Array<{ name: string; value: string; context?: string }>;
        datasets: Array<{ name: string; role: string; size?: string }>;
        computeRequirements: { params?: string; gpuHours?: string; modelSize?: string; flops?: string };
        limitations: string[];
        replicabilityScore: number;
        replicabilityReason: string;
      } | null {
        try {
          const raw = localStorage.getItem(DEEP_EXTRACT_KEY_PREFIX + arxivId);
          if (!raw) return null;
          const data = JSON.parse(raw);
          return data && data.replicabilityScore ? data : null;
        } catch { return null; }
      }

      function saveDeepExtract(arxivId: string, data: {
        reportedMetrics: Array<{ name: string; value: string; context?: string }>;
        datasets: Array<{ name: string; role: string; size?: string }>;
        computeRequirements: { params?: string; gpuHours?: string; modelSize?: string; flops?: string };
        limitations: string[];
        replicabilityScore: number;
        replicabilityReason: string;
      }): void {
        try {
          localStorage.setItem(DEEP_EXTRACT_KEY_PREFIX + arxivId, JSON.stringify(data));
        } catch { /* ignore */ }
      }

      async function generateDeepExtract(
        arxivId: string,
        paperTitle: string,
        paperAbstract: string,
        paperText?: string
      ): Promise<{
        reportedMetrics: Array<{ name: string; value: string; context?: string }>;
        datasets: Array<{ name: string; role: string; size?: string }>;
        computeRequirements: { params?: string; gpuHours?: string; modelSize?: string; flops?: string };
        limitations: string[];
        replicabilityScore: number;
        replicabilityReason: string;
      }> {
        const cfg = loadLLMConfig();
        if (!cfg) throw new Error('请先在设置页填写 API Key');

        const systemPrompt = `你是论文深度分析助手。请从论文中提取以下 5 个维度的结构化信息：

1. reported_metrics: 论文报告的具体数值指标（如 BLEU-4: 32.4）
2. datasets: 使用的数据集/基准（如 ImageNet-1k）
3. compute_requirements: 训练算力需求（参数量、GPU 小时、模型大小等）
4. limitations: 论文局限性（作者承认的 + LLM 推断的）
5. replicability_score: 1-5 分可复现性评分 + 理由

论文标题: ${paperTitle}
论文摘要: ${paperAbstract}
${paperText ? `\n论文正文(前 8000 字符):\n${paperText.slice(0, 8000)}` : ''}

请返回严格 JSON 格式：
{
  "reported_metrics": [{"name": "指标", "value": "数值", "context": "环境"}],
  "datasets": [{"name": "数据集", "role": "训练/评估/两者", "size": "规模"}],
  "compute_requirements": {"params": "7B", "gpu_hours": "1000", "model_size": "14GB", "flops": "1e22"},
  "limitations": ["局限1", "局限2"],
  "replicability_score": 3,
  "replicability_reason": "理由"
}

如果某信息未在论文中提及，不要编造，直接省略该字段。`;

        const response = await fetch(`${cfg.baseUrl.replace(/\/+$/, '')}/v1/chat/completions`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${cfg.apiKey}`,
          },
          body: JSON.stringify({
            model: cfg.model,
            messages: [
              { role: 'system', content: systemPrompt },
              { role: 'user', content: '请分析这篇论文并返回 JSON' },
            ],
            temperature: 0.3,
            max_tokens: 4000,
          }),
        });

        if (!response.ok) {
          const err = await response.text().catch(() => '');
          throw new Error(`LLM 调用失败 (${response.status}): ${err.slice(0, 100)}`);
        }

        const data = await response.json();
        const content = data?.choices?.[0]?.message?.content || '';

        const jsonMatch = content.match(/\{[\s\S]*\}/);
        if (!jsonMatch) throw new Error('LLM 返回格式错误,无法解析 JSON');

        const parsed = JSON.parse(jsonMatch[0]);

        return {
          reportedMetrics: parsed.reported_metrics || [],
          datasets: parsed.datasets || [],
          computeRequirements: {
            params: parsed.compute_requirements?.params,
            gpuHours: parsed.compute_requirements?.gpu_hours,
            modelSize: parsed.compute_requirements?.model_size,
            flops: parsed.compute_requirements?.flops,
          },
          limitations: parsed.limitations || [],
          replicabilityScore: parsed.replicability_score || 3,
          replicabilityReason: parsed.replicability_reason || '',
        };
      }

      function renderDeepExtract(data: {
        reportedMetrics: Array<{ name: string; value: string; context?: string }>;
        datasets: Array<{ name: string; role: string; size?: string }>;
        computeRequirements: { params?: string; gpuHours?: string; modelSize?: string; flops?: string };
        limitations: string[];
        replicabilityScore: number;
        replicabilityReason: string;
      }): string {
        let html = '';

        // Metrics
        if (data.reportedMetrics && data.reportedMetrics.length > 0) {
          html += '<div class="deep-extract-section"><h4 class="deep-extract-section-title">📊 报告指标</h4>';
          html += '<div class="deep-extract-metrics-grid">';
          for (const m of data.reportedMetrics) {
            html += `<div class="deep-extract-metric">
              <div class="deep-extract-metric-name">${m.name}</div>
              <div class="deep-extract-metric-value">${m.value}</div>
              ${m.context ? `<div class="deep-extract-metric-context">${m.context}</div>` : ''}
            </div>`;
          }
          html += '</div></div>';
        }

        // Datasets
        if (data.datasets && data.datasets.length > 0) {
          html += '<div class="deep-extract-section"><h4 class="deep-extract-section-title">📁 数据集</h4>';
          html += '<div class="deep-extract-datasets-list">';
          for (const d of data.datasets) {
            html += `<div class="deep-extract-dataset">
              <span class="deep-extract-dataset-name">${d.name}</span>
              <span class="deep-extract-dataset-role">${d.role}</span>
              ${d.size ? `<span class="deep-extract-dataset-size">${d.size}</span>` : ''}
            </div>`;
          }
          html += '</div></div>';
        }

        // Compute requirements
        if (data.computeRequirements && Object.keys(data.computeRequirements).length > 0) {
          html += '<div class="deep-extract-section"><h4 class="deep-extract-section-title">🖥️ 算力需求</h4>';
          html += '<div class="deep-extract-compute-grid">';
          const cr = data.computeRequirements;
          if (cr.params) html += `<div class="deep-extract-compute-item"><span class="deep-extract-compute-label">参数量</span><span class="deep-extract-compute-value">${cr.params}</span></div>`;
          if (cr.gpuHours) html += `<div class="deep-extract-compute-item"><span class="deep-extract-compute-label">GPU小时</span><span class="deep-extract-compute-value">${cr.gpuHours}</span></div>`;
          if (cr.modelSize) html += `<div class="deep-extract-compute-item"><span class="deep-extract-compute-label">模型大小</span><span class="deep-extract-compute-value">${cr.modelSize}</span></div>`;
          if (cr.flops) html += `<div class="deep-extract-compute-item"><span class="deep-extract-compute-label">FLOPs</span><span class="deep-extract-compute-value">${cr.flops}</span></div>`;
          html += '</div></div>';
        }

        // Limitations
        if (data.limitations && data.limitations.length > 0) {
          html += '<div class="deep-extract-section"><h4 class="deep-extract-section-title">⚠️ 局限性</h4>';
          html += '<ul class="deep-extract-limitations-list">';
          for (const l of data.limitations) {
            html += `<li class="deep-extract-limitation">${l}</li>`;
          }
          html += '</ul></div>';
        }

        // Replicability score
        html += '<div class="deep-extract-section"><h4 class="deep-extract-section-title">🔄 可复现性评分</h4>';
        html += `<div class="deep-extract-replicability">
          <div class="deep-extract-replicability-score">${'★'.repeat(data.replicabilityScore)}${'☆'.repeat(5 - data.replicabilityScore)} <span class="deep-extract-replicability-value">${data.replicabilityScore}/5</span></div>
          <div class="deep-extract-replicability-reason">${data.replicabilityReason}</div>
        </div></div>`;

        return html;
      }

      // 显示 toast (复用 toast.ts 的逻辑)
      function showToast(msg: string, level: 'info' | 'success' | 'error' = 'info'): void {
        const toast = document.createElement('div');
        toast.className = `dpr-toast dpr-toast--${level}`;
        toast.textContent = msg;
        document.body.appendChild(toast);
        setTimeout(() => toast.remove(), 3000);
      }

      // 处理按钮点击
      document.addEventListener('click', async (e) => {
        const btn = (e.target as HTMLElement).closest('[data-action="generate-method-debate"], [data-action="regen-method-debate"]') as HTMLButtonElement;
        if (!btn) return;

        const action = btn.dataset.action;
        const arxivId = btn.dataset.arxiv;
        if (!arxivId) return;

        const section = document.getElementById('method-debate-section');
        const content = section?.querySelector('.method-debate-content') as HTMLElement;
        if (!content) return;

        // 禁用按钮,显示加载状态
        btn.disabled = true;
        const originalText = btn.textContent;
        btn.textContent = '生成中...';

        try {
          // 从页面读取 method 字段
          const methodEl = document.querySelector('[data-method]') as HTMLElement;
          const methodText = methodEl?.dataset.method || '';
          const titleEl = document.querySelector('h1') as HTMLElement;
          const paperTitle = titleEl?.textContent || '';

          if (!methodText) throw new Error('论文缺少方法描述字段');

          const result = await generateMethodDebate(arxivId, methodText, paperTitle);

          // 保存到 localStorage
          saveDebate(arxivId, result.prosCons, result.comparison);

          // 渲染卡片
          content.innerHTML = renderCards(result.prosCons, result.comparison);

          showToast('已重新生成', 'success');
        } catch (err) {
          const msg = err instanceof Error ? err.message : '生成失败';
          showToast(`生成失败 — ${msg}`, 'error');
        } finally {
          btn.disabled = false;
          btn.textContent = originalText;
        }
      });

      // 深度抽取按钮点击处理
      document.addEventListener('click', async (e) => {
        const btn = (e.target as HTMLElement).closest('[data-action="generate-deep-extract"], [data-action="regen-deep-extract"]') as HTMLButtonElement;
        if (!btn) return;

        const arxivId = btn.dataset.arxiv;
        const paperTitle = btn.dataset.title || '';
        const paperAbstract = btn.dataset.abstract || '';
        if (!arxivId) return;

        const section = document.getElementById('deep-extract-section');
        const content = section?.querySelector('.deep-extract-content') as HTMLElement;
        if (!content) return;

        // 禁用按钮,显示加载状态
        btn.disabled = true;
        const originalText = btn.textContent;
        btn.textContent = '生成中...';

        try {
          // 从 localStorage 读取论文正文
          let paperText = '';
          const textKey = `dpr_paper_text_${arxivId}`;
          const storedText = localStorage.getItem(textKey);
          if (storedText) {
            paperText = storedText;
          }

          const result = await generateDeepExtract(arxivId, paperTitle, paperAbstract, paperText || undefined);

          // 保存到 localStorage
          saveDeepExtract(arxivId, result);

          // 渲染卡片
          content.innerHTML = renderDeepExtract(result) + `<button type="button" class="deep-extract-regen-btn" data-action="regen-deep-extract" data-arxiv="${arxivId}" data-title="${paperTitle}" data-abstract="${paperAbstract}">🔄 重新生成</button>`;

          showToast('深度抽取完成', 'success');
        } catch (err) {
          const msg = err instanceof Error ? err.message : '生成失败';
          showToast(`生成失败 — ${msg}`, 'error');
        } finally {
          btn.disabled = false;
          btn.textContent = originalText;
        }
      });

      // 深入追问:点击问题后通过 postMessage 发送给 paper-chat
      document.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest('.follow-up-question-btn') as HTMLButtonElement;
        if (!btn) return;
        const question = btn.dataset.question;
        if (!question) return;
        window.postMessage({ type: 'dpr-ask-question', question }, '*');
      });
    })();

    // 智能预热:用户首次 focus chat 输入框或点 FAB 打开侧栏时,
    // 如果当前 mode 是 fulltext,paper-chat.ts 内部会触发 loadFulltextSkeleton。
    // 切到 summary 的用户不发任何 arxiv 请求,首屏零开销。

    // 跨论文对比按钮
    // -------------------------------------------------------
    (async function () {
      const btn = document.getElementById('paper-compare-btn');
      if (!btn) return;
      const arxivId = btn.getAttribute('data-arxiv-id');
      if (!arxivId || arxivId === ' ') return;

      // 动态导入避免 SSR 问题
      const { addToCompare, removeFromCompare, isInCompare, getCompareSet, subscribeCompare } = await import('../../lib/projects/compare');

      // 显示按钮
      btn.hidden = false;

      // 同步按钮状态
      function syncBtn(): void {
        const set = getCompareSet();
        const inSet = isInCompare(arxivId);
        const count = set?.arxivIds.length ?? 0;
        btn.textContent = inSet ? `✓ 在对比中 (${count})` : '➕ 加入对比';
        btn.classList.toggle('paper-compare-btn--active', inSet);
      }

      // 点击处理
      btn.addEventListener('click', () => {
        if (isInCompare(arxivId)) {
          removeFromCompare(arxivId);
        } else {
          const result = addToCompare(arxivId);
          if (!result) {
            // 集合已满或其他错误
            alert('对比集合已满(最多4篇),请先移除一篇后再添加。');
          }
        }
      });

      // 订阅变化事件
      const unsub = subscribeCompare(syncBtn);
      // 页面卸载时取消订阅
      window.addEventListener('unload', unsub);

      // 初始化状态
      syncBtn();
    })();
  </script>
</BaseLayout>

