---
// astro-src/pages/papers/[arxiv].astro
// 单篇论文页:用 lib/paper.ts 读 MD 文件(兼容坏文件)
// 路径格式:docs/papers/{arxiv_id}-{slug}.md -> /papers/{arxiv_id}-{slug}/
import type { GetStaticPaths } from 'astro';
import { readFile } from 'node:fs/promises';
import { join } from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import { readPaper, listAllPaperIds, flattenCategories } from '../../lib/paper';
import { renderMarkdownBody } from '../../lib/markdown';
import '../../styles/paper-chat.css';
import '../../styles/hidden-toast.css';
import '../../styles/paper-selection.css';

// 全文 inline 上限。超过这个大小(原始 utf-8 字节计)就不内联,让客户端走 fetch /papers/{id}.txt。
// 200KB 原文 base64 后 ~270KB 进 HTML,论文单页就这样大了;能覆盖绝大多数 arXiv 短文(< 30 页),
// 超长论文(> 30 页)不内联,让客户端 fetch。
// 1 KB 以下的视为 404 HTML/空,也不内联。
const FULLTEXT_INLINE_MAX_BYTES = 200 * 1024;

/**
 * SSR 阶段直接 fs 读 docs/papers/{arxiv}-slug.txt,base64 编码后塞进页面。
 * 客户端 paper-chat.ts::loadFulltextSkeleton 优先用 inline 内容,不走 HTTP。
 *
 * 为什么这么做:
 *   - 用户体感「为什么 chat 读全文要经网站」— fs.readFile 是直接的 IO,
 *     HTTP fetch 看起来多绕一圈;虽然 fetch 本地静态资源没真成本,但"路径感"
 *     不直观。
 *   - 内联到 HTML 的代价是单篇页面大 ~60KB,但 chat 默认不展开全文,
 *     大多数用户不会切 — 切了才付 token,但读 60KB HTML 是单次发生,缓存友好。
 *   - 没 .txt 的论文(早期 pipeline 漏抓)SSR 拿不到,data-fulltext 空,
 *     客户端走 fetch 兜底,保留 f40bc41 的 fetch 链不破。
 */
async function readFulltextInline(id: string): Promise<string> {
  try {
    // docs/papers/ 现在按 arxiv id 的 YYMM 分桶到 <YYYY>/<MM>/ 子目录,
    // id 形如 `papers/2026/06/2606.26155v1-detecting-and...`,直接 join 即可。
    const txtPath = join(process.cwd(), 'docs', `${id}.txt`);
    const buf = await readFile(txtPath);
    if (buf.byteLength > FULLTEXT_INLINE_MAX_BYTES || buf.byteLength < 1000) {
      // 太大 → 不内联,客户端 fetch;太小 → 视为异常(404 HTML/空),不内联
      return '';
    }
    return buf.toString('base64');
  } catch {
    return '';
  }
}

export const getStaticPaths: GetStaticPaths = async () => {
  const ids = await listAllPaperIds();
  // 仅处理 papers/ 段(子目录分桶后 id 含 /YYYY/MM/,但 URL 路由仍是 basename)。
  // 把 basename 当 params.arxiv 喂给 page,内部用全 id 走 readPaper/readFulltextInline。
  return ids
    .filter((id) => id.startsWith('papers/'))
    .map((id) => ({
      params: {
        // basename = 文件名段(无目录前缀)。例如
        //   papers/2026/06/2606.26155v1-foo  →  arxiv = "2606.26155v1-foo"
        arxiv: id.split('/').pop() || '',
      },
      props: {
        // 顺手把完整 id 通过 props 喂进去,避免 page 端用 basename 反推时拼错目录。
        // Astro getStaticPaths 的 props 会作为 Astro.props.fullId 暴露。
        fullId: id,
      },
    }));
};

const { arxiv } = Astro.params;
const { fullId } = Astro.props;
const id = fullId || `papers/${arxiv}`;
const paper = await readPaper(id);
const base = import.meta.env.BASE_URL;
const fulltextInline = paper && !paper.isBroken ? await readFulltextInline(id) : '';
---

<BaseLayout title={paper?.title_zh || paper?.title || id}>
  <Navbar />
  <main class="paper-page">
    {paper ? (
      paper.isBroken ? (
        <div class="container">
          <article class="paper-broken">
            <h1>⚠️ 论文摘要解析失败</h1>
            <p>这篇论文({id})的 frontmatter YAML 损坏,无法读取标题和摘要。</p>
            <p>原因:{paper.brokenReason}</p>
            <p>这是 daily pipeline 写入 figures_json 字段时的已知 bug,源文件保留供后续修复。</p>
            <p>如果你需要这篇论文内容,请用其他渠道获取 arxiv ID <code>{paper.arxivId}</code>。</p>
            <p><a href={`${base}`}>← 返回首页</a></p>
          </article>
        </div>
      ) : (
        <article class="paper-article">
          <header class="paper-header">
            <div class="container">
              <div class="paper-header-row">
                <div class="paper-meta-line">
                  arXiv {paper.arxivId}
                  {paper.date && <span> · 发布 {paper.date}</span>}
                </div>
                {!paper.isBroken && (
                  <div class="paper-header-actions">
                    <button
                      type="button"
                      id="paper-select-btn"
                      class="paper-select-btn"
                      hidden
                      aria-label="把这篇论文加入主题探索"
                    >📌 选入探索</button>
                    <button
                      type="button"
                      id="paper-hide-btn"
                      class="paper-hide-btn"
                      hidden
                      aria-label="隐藏或恢复这篇论文"
                    >🗑 隐藏</button>
                  </div>
                )}
              </div>
              <h1 class="paper-title-zh">{paper.title_zh || paper.title}</h1>
              {paper.title_zh && paper.title && paper.title !== paper.title_zh && (
                <h2 class="paper-title-en">{paper.title}</h2>
              )}
              <div class="paper-meta">
                {paper.authors && (
                  <div class="meta-row">
                    <span class="meta-label">AUTHORS</span>
                    <span class="meta-value">{paper.authors}</span>
                  </div>
                )}
                {paper.evidence && (
                  <div class="meta-row">
                    <span class="meta-label">EVIDENCE</span>
                    <span class="meta-value">{paper.evidence}</span>
                  </div>
                )}
                {paper.score !== undefined && (
                  <div class="meta-row">
                    <span class="meta-label">SCORE</span>
                    <span class="meta-value score-pill">{paper.score.toFixed(1)}</span>
                  </div>
                )}
                {paper.categories && (paper.categories.venue.length + paper.categories.task.length + paper.categories.method.length + paper.categories.type.length) > 0 && (
                  <div class="meta-row meta-row--categories">
                    <span class="meta-label">CATEGORIES</span>
                    <span class="meta-value meta-categories">
                      {(['venue', 'task', 'method', 'type'] as const).map((dim) => {
                        const labels = paper.categories && paper.categories[dim];
                        if (!labels || labels.length === 0) return null;
                        return (
                          <span class="category-dim">
                            <span class="category-dim-label">{dim.toUpperCase()}</span>
                            {labels.map((label: string) => (
                              <span class={`tag tag-${dim}${paper.accepted && dim === 'venue' ? ' tag-venue--accepted' : ''}`}>{label}</span>
                            ))}
                          </span>
                        );
                      })}
                    </span>
                  </div>
                )}
                {paper.pdf && (
                  <div class="meta-row">
                    <span class="meta-label">PDF</span>
                    <a class="meta-value pdf-link" href={paper.pdf} target="_blank" rel="noopener">↗ {paper.arxivId}.pdf</a>
                  </div>
                )}
                {paper.generated_at && (
                  <div class="meta-row">
                    <span class="meta-label">GENERATED</span>
                    <span class="meta-value">{paper.generated_at}</span>
                  </div>
                )}
              </div>
            </div>
          </header>

          {paper.tldr && (
            <section class="paper-glance">
              <div class="container">
                <h3>📝 TLDR</h3>
                <p>{paper.tldr}</p>
              </div>
            </section>
          )}

          {(paper.motivation || paper.method || paper.result || paper.conclusion) && (
            <section class="paper-summary">
              <div class="container">
                <h3>🧭 速览</h3>
                {paper.motivation && (
                  <div class="glance-card">
                    <div class="glance-label">动机</div>
                    <p>{paper.motivation}</p>
                  </div>
                )}
                {paper.method && (
                  <div class="glance-card">
                    <div class="glance-label">方法</div>
                    <p>{paper.method}</p>
                  </div>
                )}
                {paper.result && (
                  <div class="glance-card">
                    <div class="glance-label">结果</div>
                    <p>{paper.result}</p>
                  </div>
                )}
                {paper.conclusion && (
                  <div class="glance-card">
                    <div class="glance-label">结论</div>
                    <p>{paper.conclusion}</p>
                  </div>
                )}
              </div>
            </section>
          )}

          {paper.body && (
            <section class="paper-body">
              <div class="container">
                <article class="markdown" set:html={renderMarkdownBody(paper.body, { figures: paper.figures, base })} />
              </div>
            </section>
          )}
        </article>
      )
    ) : (
      <div class="container">
        <h1>404</h1>
        <p>找不到论文:{id}</p>
        <p><a href={`${base}`}>← 返回首页</a></p>
      </div>
    )}

    {/* 论文对话 dock — 数据载体(实际渲染由 paper-chat.ts 挂到 body 上作为 fixed 浮层)。
        broken 论文和 404 时不渲染,避免误导。
        data-fulltext 默认给一个空格占位,确保 Astro 输出 attribute="..." 而不是布尔属性;
        没 .txt 的论文 fulltextInline 是 '' → 用空格,客户端 atob 后是 ' ' → sanity check 失败
        → 当成"无内联"走 fetch 兜底。*/}
    {paper && !paper.isBroken && (
      <section
        id="paper-chat"
        aria-hidden="true"
        data-title={paper.title || ''}
        data-title-zh={paper.title_zh || ''}
        data-authors={paper.authors || ''}
        data-tldr={paper.tldr || ''}
        data-motivation={paper.motivation || ''}
        data-method={paper.method || ''}
        data-result={paper.result || ''}
        data-conclusion={paper.conclusion || ''}
        data-tags={flattenCategories(paper.categories).join(',')}
        data-arxiv-id={paper.arxivId || ' '}
        data-fulltext={fulltextInline || ' '}
        data-txt-name={`${arxiv}.txt`}
      ></section>
    )}

    {/* 论文"隐藏"按钮数据载体 — 复用 #paper-chat 的 section-as-data-carrier 模式。
        broken 论文和 404 时不渲染,避免误导(实际按钮见 .paper-header-row 右上)。 */}
    {paper && !paper.isBroken && (
      <section
        id="paper-hide"
        aria-hidden="true"
        data-arxiv-id={paper.arxivId || ''}
      ></section>
    )}

    {/* "选入主题探索"按钮数据载体 — 跟 #paper-hide 同样的 section-as-data-carrier 模式。
        broken 论文 / 404 不挂,避免误导。 */}
    {paper && !paper.isBroken && (
      <section
        id="paper-select"
        aria-hidden="true"
        data-arxiv-id={paper.arxivId || ''}
        data-title={paper.title || ''}
        data-title-zh={paper.title_zh || ''}
        data-tldr={paper.tldr || ''}
        data-motivation={paper.motivation || ''}
        data-method={paper.method || ''}
        data-result={paper.result || ''}
        data-conclusion={paper.conclusion || ''}
        data-tags={flattenCategories(paper.categories).join(',')}
      ></section>
    )}
  </main>

  <script>
    import '../../scripts/paper-chat.ts';
    import '../../scripts/paper-figures.ts';
    import '../../scripts/paper-hide.ts';
    import '../../scripts/paper-selection.ts';

    // 智能预热:用户首次 focus chat 输入框或点 FAB 打开侧栏时,
    // 如果当前 mode 是 fulltext,paper-chat.ts 内部会触发 loadFulltextSkeleton。
    // 切到 summary 的用户不发任何 arxiv 请求,首屏零开销。
  </script>
</BaseLayout>

<style>
  .paper-page { padding-bottom: 4rem; }
  .container { max-width: var(--content-max-width); margin: 0 auto; padding: 0 1.5rem; }
  /* 对话侧栏是 position: fixed,纯浮在右侧覆盖主区;主体宽度与 padding
     全程不随侧栏状态变化,避免开启/关闭时正文突然重排。 */

  .paper-broken {
    padding: 3rem 0;
    text-align: center;
    color: var(--fg-muted);
  }
  .paper-broken h1 { color: var(--accent); margin-bottom: 1rem; }
  .paper-broken code { background: var(--code-bg); padding: 0.1em 0.4em; border-radius: 4px; }

  .paper-article { background: var(--bg); }

  .paper-header {
    border-bottom: 1px solid var(--border);
    padding: 2rem 0;
    background: var(--bg-elevated);
  }
  .paper-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .paper-hide-btn {
    font-size: 0.85rem;
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background: var(--bg);
    color: var(--fg-muted);
    cursor: pointer;
    transition: all 150ms;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .paper-hide-btn:hover {
    background: var(--bg-elevated);
    color: var(--fg);
    border-color: var(--accent);
  }
  /* 当前已隐藏 — 按钮文案 "取消隐藏",描边强调 */
  .paper-hide-btn--hidden {
    color: var(--accent);
    border-color: var(--accent);
  }
  .paper-hide-btn--hidden:hover {
    background: color-mix(in srgb, var(--accent) 8%, var(--bg-elevated));
  }
  .paper-meta-line {
    font-size: 0.85rem;
    color: var(--fg-subtle);
    font-family: var(--font-mono);
    margin-bottom: 0.5rem;
  }
  .paper-title-zh {
    font-size: 1.85rem;
    margin: 0 0 0.5rem;
    line-height: 1.3;
  }
  .paper-title-en {
    font-size: 1.1rem;
    font-weight: 400;
    color: var(--fg-muted);
    margin: 0 0 1.5rem;
    font-style: italic;
  }
  .paper-meta { display: flex; flex-direction: column; gap: 0.5rem; }
  .meta-row { display: flex; gap: 1rem; align-items: baseline; }
  .meta-label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--fg-subtle);
    min-width: 90px;
  }
  .meta-value { color: var(--fg); font-size: 0.95rem; }
  .score-pill {
    display: inline-block;
    background: var(--accent-soft);
    color: var(--accent);
    padding: 0.15em 0.5em;
    border-radius: var(--radius-sm);
    font-weight: 700;
  }
  .tag {
    display: inline-block;
    background: var(--tag-bg);
    color: var(--tag-fg);
    padding: 0.1em 0.5em;
    border-radius: var(--radius-sm);
    font-size: 0.8rem;
    margin-right: 0.3em;
  }
  .pdf-link { color: var(--accent); font-family: var(--font-mono); font-size: 0.9rem; }

  /* categories 4-dim — 每组有自己的调色板 */
  .meta-row--categories { flex-wrap: wrap; row-gap: 0.4rem; }
  .meta-categories { display: flex; flex-wrap: wrap; gap: 0.6rem; align-items: center; }
  .category-dim {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
  }
  .category-dim-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    color: var(--fg-subtle);
    padding-right: 0.35em;
    border-right: 1px solid var(--border);
  }
  .tag-venue { background: #fef2f2; color: #b31b1b; border: 1px solid #fecaca; }
  .tag-venue--accepted { background: #fee2e2; border-color: #b31b1b; font-weight: 600; }
  .tag-task { background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; }
  .tag-method { background: #faf5ff; color: #9333ea; border: 1px solid #e9d5ff; }
  .tag-type { background: #ecfeff; color: #0891b2; border: 1px solid #a5f3fc; }
  .tag-other { background: var(--tag-bg); color: var(--fg-muted); }

  /* 会议接受徽章 — 论文被会议接收时显示,非会议论文 venue="" 整体不渲染 */
  .venue-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.15em 0.6em;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    font-size: 0.85rem;
    font-family: var(--font-mono);
    background: var(--bg);
    color: var(--fg-muted);
  }
  .venue-badge--accepted {
    background: color-mix(in srgb, var(--accent) 12%, var(--bg));
    border-color: var(--accent);
    color: var(--accent);
    font-weight: 600;
  }
  .venue-badge-tick {
    font-size: 0.75em;
    padding-left: 0.4em;
    border-left: 1px solid currentColor;
  }

  .paper-glance {
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--border);
  }
  .paper-glance h3 { margin-top: 0; color: var(--fg); }
  .paper-glance p { color: var(--fg); line-height: 1.6; }

  .paper-summary { padding: 1.5rem 0; border-bottom: 1px solid var(--border); }
  .paper-summary h3 { margin-top: 0; }
  .glance-card {
    border-left: 3px solid var(--accent);
    padding: 0.5rem 1rem;
    margin: 0.75rem 0;
    background: var(--bg-elevated);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
  }
  .glance-label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin-bottom: 0.3rem;
  }
  .glance-card p { margin: 0; color: var(--fg); }

  .paper-body { padding: 2rem 0; }
  .paper-body .markdown { line-height: 1.7; }
  .paper-body .markdown h1 { font-size: 1.6rem; margin-top: 1.5em; }
  .paper-body .markdown h2 { font-size: 1.35rem; margin-top: 1.5em; }
  .paper-body .markdown h3 { font-size: 1.15rem; margin-top: 1.3em; }
  .paper-body .markdown p { color: var(--fg); margin: 0 0 1em; }
  .paper-body .markdown hr { border: 0; border-top: 1px solid var(--border); margin: 1.5rem 0; }
  .paper-body .markdown ul { margin: 0.5em 0 1em 1.5em; }
  .paper-body .markdown li { margin: 0.3em 0; }
  .paper-body .markdown code { background: var(--code-bg); color: var(--code-fg); padding: 0.1em 0.35em; border-radius: 3px; font-size: 0.9em; font-family: var(--font-mono); }
  .paper-body .markdown code.math-inline { background: var(--accent-soft); color: var(--accent); }

  /* Markdown 表格(由 renderMarkdownBody 解析 | ... | 行渲染) */
  .paper-body .markdown .paper-md-table {
    width: 100%;
    border-collapse: collapse;
    margin: 1em 0 1.5em;
    font-size: 0.95em;
    display: block;
    overflow-x: auto;
  }
  .paper-body .markdown .paper-md-table th,
  .paper-body .markdown .paper-md-table td {
    border: 1px solid var(--border);
    padding: 0.5em 0.75em;
    vertical-align: top;
  }
  .paper-body .markdown .paper-md-table th {
    background: var(--code-bg, rgba(127,127,127,0.08));
    font-weight: 600;
    color: var(--fg);
  }
  .paper-body .markdown .paper-md-table tbody tr:nth-child(even) td {
    background: rgba(127,127,127,0.04);
  }
  .paper-body .markdown .paper-md-table p { margin: 0; }

  /* 论文图表区块(由 renderMarkdownBody 在 body 末尾追加) */
  .paper-figures-wrap { margin: 1.5rem 0; }
  .paper-figures-wrap > summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--accent);
    padding: 0.6rem 0;
    list-style: none;
  }
  .paper-figures-wrap > summary::-webkit-details-marker { display: none; }
  .paper-figures-wrap > summary::before { content: '▶ '; transition: transform 150ms; display: inline-block; }
  .paper-figures-wrap[open] > summary::before { transform: rotate(90deg); }

  /* 精读里 LLM 插入的图片(行内) */
  .paper-body .markdown img {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    margin: 0.5rem 0;
  }
</style>

<style is:global>
/* 论文图表 carousel(由 renderMarkdownBody SSR,不走 Astro scoped attribute 回填,
   所以这里必须 is:global,否则 .paper-slide/... 选择器带上 [data-astro-cid-*] 就匹配不到动态拼出的 HTML) */
.paper-carousel {
  position: relative;
  background: var(--bg-elevated);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: 1rem 3rem 0.5rem;
  margin-top: 0.8rem;
  outline: none;
}
.paper-carousel:focus-visible { border-color: var(--accent); }

.paper-carousel-track {
  position: relative;
  overflow: hidden;
  border-radius: var(--radius-md);
  background: var(--bg);
  height: clamp(320px, 65vh, 720px);
}

.paper-slide {
  margin: 0;
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 200ms ease-out;
  pointer-events: none;
}
.paper-slide.is-active {
  opacity: 1;
  pointer-events: auto;
}
.paper-slide-frame {
  flex: 1 1 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 0;
}
.paper-slide-frame img {
  max-width: 100%;
  max-height: 100%;
  width: auto;
  height: auto;
  object-fit: contain;
  display: block;
}
.paper-slide figcaption {
  font-size: 0.85rem;
  color: var(--fg-muted);
  padding: 0.5rem 0;
  text-align: center;
  max-width: 90%;
}

.paper-carousel-btn {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 2.25rem;
  height: 2.25rem;
  border-radius: 50%;
  border: 1px solid var(--border);
  background: var(--bg-elevated);
  color: var(--fg);
  font-size: 1.5rem;
  line-height: 1;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background var(--transition), border-color var(--transition), color var(--transition);
  /* 必须高于 .paper-chat-panel(z-index:9991)。对话侧栏展开时 fixed 浮在右侧,
     不提上来按钮就被侧栏挡住点不到。 */
  z-index: 9992;
}
.paper-carousel-btn:hover { background: var(--accent-soft); border-color: var(--accent); color: var(--accent); }
.paper-carousel-btn:disabled { opacity: 0.35; cursor: not-allowed; }
.paper-carousel-prev { left: 0.5rem; }
.paper-carousel-next { right: 0.5rem; }

.paper-carousel-dots {
  display: flex;
  justify-content: center;
  gap: 0.4rem;
  padding: 0.6rem 0 0.2rem;
}
.paper-carousel-dot {
  width: 0.55rem;
  height: 0.55rem;
  border-radius: 50%;
  border: 1px solid var(--border-strong);
  background: transparent;
  padding: 0;
  cursor: pointer;
  transition: background var(--transition), transform var(--transition), border-color var(--transition);
}
.paper-carousel-dot.is-active {
  background: var(--accent);
  border-color: var(--accent);
  transform: scale(1.2);
}

@media (max-width: 640px) {
  .paper-carousel { padding: 0.5rem 0.5rem 0; }
  .paper-carousel-track { height: clamp(240px, 55vh, 480px); }
  .paper-carousel-btn { width: 2rem; height: 2rem; font-size: 1.25rem; }
}
</style>
</content>
