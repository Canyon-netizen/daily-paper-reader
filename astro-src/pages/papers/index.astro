---
// /papers/ 论文库 + 节点网络
// 1) SSR 期:PaperRepository 拿全量论文(走 lib/paper-repository/ 缓存层)
// 2) 顶部 hero + 统计(总篇数 / 今日新增 / 唯一标签数)
// 3) 把数据序列化到 <script id="papers-data" type="application/json"> 给客户端
// 4) 挂载 <PaperLibrary /> — 客户端脚本接管分屏布局、cytoscape 节点网络、抽屉编辑
// 5) 工作台(Stage 10):<PaperWorkbenchTabs /> + <PaperWorkbenchFilter /> 顶
//    tab 切换 / 7 维筛选;hash #f=... 复原;listTrashed() 在回收站 tab 渲染。
import type { GetStaticPaths } from 'astro';
import { flattenCategories } from '../../lib/paper';
import { defaultPaperRepository } from '../../lib/paper-repository';
import { paperPlainTitle } from '../../lib/title';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import PaperLibrary from '../../components/PaperLibrary.astro';
import PaperWorkbenchTabs from '../../components/PaperWorkbenchTabs.astro';
import PaperWorkbenchFilter from '../../components/PaperWorkbenchFilter.astro';
import '../../styles/papers.css';
import '../../styles/papers-workbench.css';
import '../../styles/toast.css';

// /papers/ 是静态索引页 — 不需要 getStaticPaths,SSR 时一次性拉全量数据
export const getStaticPaths: GetStaticPaths = async () => [{ params: {} }];

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const repo = defaultPaperRepository;

// 全量论文(去重 + 按 ?sort= 控制;默认 'score' 相关度倒序,因为论文都有 frontmatter
// score 字段;不传 ?sort= 或传 ?sort=date 走日期倒序,保留历史/无 score 论文置顶的可能)
const sortKey = (Astro.url.searchParams.get('sort') === 'date' ? 'date' : 'score') as 'date' | 'score';
const papers = await repo.list({ dedup: true, sortBy: sortKey, base });

// 今日新增(按 YYYY-MM-DD)
const today = new Date().toISOString().slice(0, 10);
const todayCount = papers.filter((p) => p.date === today).length;

// 主题分类数:走仓库 groupByTask() 统一桶定义,与首页 / 日历主题 select 对齐。
// 不要在此处按 4 维全 token 去重,那会得到 venue/task/method/type 总和(8)。
const byTag = await repo.groupByTask();
const uniqueTagCount = byTag.size;

// 客户端载荷:把 categories 拍平为 'dim:label' tokens,与 B4 paper-selection 一致
const clientPapers = papers.map((p) => ({
  id: p.id,
  title: paperPlainTitle(p.title, p.title_plain),
  title_zh: paperPlainTitle(p.title_zh, p.title_zh_plain),
  authors: p.authors || '',
  date: p.date || '',
  pdf: p.pdf || '',
  tags: flattenCategories(p.categories),
  tldr: p.tldr || '',
  arxivId: p.arxivId || '',
  slug: p.slug || '',
  thumbnail: p.thumbnail || '',
  categories: p.categories || { venue: [], task: [], method: [], type: [] },
}));

const payload = {
  papers: clientPapers,
  generatedAt: new Date().toISOString(),
};
---

<BaseLayout
  title="论文库 · 节点网络"
  description="浏览全部论文,按标签筛选,可视化节点网络查看论文之间的相似度关联。"
>
  <Navbar />

  <main class="papers-page">
    <header class="papers-hero">
      <div class="papers-hero-inner">
        <h1 class="papers-hero-title">📚 论文库 · 节点网络</h1>
        <p class="papers-hero-sub">
          浏览全部论文 · 按标签筛选 · 节点网络展示论文之间的相似度关联 ·
          点节点打开右侧抽屉编辑自定义标签
        </p>
        <div class="papers-hero-stats">
          <div class="papers-hero-stat">
            <span class="papers-hero-stat-label">总篇数</span>
            <span class="papers-hero-stat-value papers-hero-stat-value--accent">{papers.length}</span>
          </div>
          <div class="papers-hero-stat">
            <span class="papers-hero-stat-label">今日新增</span>
            <span class="papers-hero-stat-value">{todayCount}</span>
          </div>
          <div class="papers-hero-stat">
            <span class="papers-hero-stat-label">主题分类</span>
            <span class="papers-hero-stat-value">{uniqueTagCount}</span>
          </div>
          <div class="papers-hero-stat papers-hero-sort">
            <span class="papers-hero-stat-label">排序</span>
            <span class="papers-hero-sort-options">
              <a class={`filter-pill ${sortKey === 'score' ? 'active' : ''}`}
                 href={base + '/papers/'}>⭐ 相关度</a>
              <a class={`filter-pill ${sortKey === 'date' ? 'active' : ''}`}
                 href={base + '/papers/?sort=date'}>📅 时间</a>
            </span>
          </div>
        </div>
      </div>
    </header>

    <PaperWorkbenchTabs />

    <div class="papers-workbench-body">
      <PaperWorkbenchFilter />
      <PaperLibrary />
    </div>
  </main>

  <!-- 客户端数据载体 — PaperLibrary 客户端脚本从这里读数据 -->
  <script id="papers-data" type="application/json" set:html={JSON.stringify(payload)} />

  <Footer />
</BaseLayout>