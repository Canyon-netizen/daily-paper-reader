---
// /papers/ 论文库 + 节点网络
// 1) SSR 期:listPapers({dedup:true, sortBy:'date'}) 拿全量论文
// 2) 顶部 hero + 统计(总篇数 / 今日新增 / 唯一标签数)
// 3) 把数据序列化到 <script id="papers-data" type="application/json"> 给客户端
// 4) 挂载 <PaperLibrary /> — 客户端脚本接管分屏布局、cytoscape 节点网络、抽屉编辑
import type { GetStaticPaths } from 'astro';
import { listPapers, flattenCategories, listAllPapersByTag } from '../../lib/paper';
import { paperPlainTitle } from '../../lib/title';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import PaperLibrary from '../../components/PaperLibrary.astro';
import '../../styles/papers.css';
import '../../styles/toast.css';

// /papers/ 是静态索引页 — 不需要 getStaticPaths,SSR 时一次性拉全量数据
export const getStaticPaths: GetStaticPaths = async () => [{ params: {} }];

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');

// 全量论文(去重 + 按日期倒序)
const papers = await listPapers({ dedup: true, sortBy: 'date', base });

// 今日新增(按 YYYY-MM-DD)
const today = new Date().toISOString().slice(0, 10);
const todayCount = papers.filter((p) => p.date === today).length;

// 主题分类数:复用 listAllPapersByTag(),
// 其内部按每篇 flattenCategories 的首个 token 分桶,byTag.size 即主题分类数。
// 不要在此处按 4 维全 token 去重,那会得到 venue/task/method/type 总和(8)。
const byTag = await listAllPapersByTag();
const uniqueTagCount = byTag.size;

// 客户端载荷:把 categories 拍平为 'dim:label' tokens,与 B4 paper-selection 一致
const clientPapers = papers.map((p) => ({
  id: p.id,
  title: paperPlainTitle(p.title, p.title_plain),
  title_zh: paperPlainTitle(p.title_zh, p.title_zh_plain),
  authors: p.authors || '',
  date: p.date || '',
  pdf: p.pdf || '',
  tags: flattenCategories(p.categories),
  tldr: p.tldr || '',
  arxivId: p.arxivId || '',
  slug: p.slug || '',
  thumbnail: p.thumbnail || '',
}));

const payload = {
  papers: clientPapers,
  generatedAt: new Date().toISOString(),
};
---

<BaseLayout
  title="论文库 · 节点网络"
  description="浏览全部论文,按标签筛选,可视化节点网络查看论文之间的相似度关联。"
>
  <Navbar />

  <main class="papers-page">
    <header class="papers-hero">
      <div class="papers-hero-inner">
        <h1 class="papers-hero-title">📚 论文库 · 节点网络</h1>
        <p class="papers-hero-sub">
          浏览全部论文 · 按标签筛选 · 节点网络展示论文之间的相似度关联 ·
          点节点打开右侧抽屉编辑自定义标签
        </p>
        <div class="papers-hero-stats">
          <div class="papers-hero-stat">
            <span class="papers-hero-stat-label">总篇数</span>
            <span class="papers-hero-stat-value papers-hero-stat-value--accent">{papers.length}</span>
          </div>
          <div class="papers-hero-stat">
            <span class="papers-hero-stat-label">今日新增</span>
            <span class="papers-hero-stat-value">{todayCount}</span>
          </div>
          <div class="papers-hero-stat">
            <span class="papers-hero-stat-label">主题分类</span>
            <span class="papers-hero-stat-value">{uniqueTagCount}</span>
          </div>
        </div>
      </div>
    </header>

    <PaperLibrary />
  </main>

  <!-- 客户端数据载体 — PaperLibrary 客户端脚本从这里读数据 -->
  <script id="papers-data" type="application/json" set:html={JSON.stringify(payload)} />

  <Footer />
</BaseLayout>